{
  "_comment": "Codex hook registration template for agent-do. Merge with existing ~/.codex/hooks.json entries. Installed wrappers delegate to checked-in repo hooks; the now stamp, pulse recorder, and coordination doorbell share their Claude-side sources. The doorbell emits fixed context at UserPromptSubmit or requests one Stop continuation, guarded by stop_hook_active. It never carries ledger content or replaces notify. agent-do does not bundle auto-commit. Codex hook delivery shapes were verified against official documentation on 2026-09-22.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.codex/hooks/agent-do-session-start.py",
            "timeout": 10,
            "statusMessage": "Loading agent-do project context"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.codex/hooks/agent-do-coord-doorbell.py",
            "timeout": 5,
            "statusMessage": "Checking the coordination ledger bell"
          },
          {
            "type": "command",
            "command": "python3 ~/.codex/hooks/agent-do-prompt-router.py",
            "timeout": 5,
            "statusMessage": "Checking agent-do routing"
          },
          {
            "type": "command",
            "command": "python3 ~/.codex/hooks/agent-do-now-stamp.py",
            "timeout": 5,
            "statusMessage": "Stamping the current time"
          },
          {
            "type": "command",
            "command": "~/.codex/hooks/agent-do-pulse-record.sh",
            "timeout": 5,
            "statusMessage": "Recording session pulse"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.codex/hooks/agent-do-pretooluse-check.py",
            "timeout": 10,
            "statusMessage": "Checking agent-do tool preference"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.codex/hooks/agent-do-pulse-record.sh",
            "timeout": 5,
            "statusMessage": "Recording session pulse"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.codex/hooks/agent-do-touch-ledger.py",
            "timeout": 5,
            "statusMessage": "Recording touched files"
          },
          {
            "type": "command",
            "command": "~/.codex/hooks/agent-do-pulse-record.sh",
            "timeout": 5,
            "statusMessage": "Recording session pulse"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.codex/hooks/agent-do-coord-doorbell.py",
            "timeout": 5,
            "statusMessage": "Checking the coordination ledger bell"
          },
          {
            "type": "command",
            "command": "~/.codex/hooks/stop-quality-gate.sh",
            "timeout": 30,
            "statusMessage": "Finalizing turn"
          },
          {
            "type": "command",
            "command": "~/.codex/hooks/agent-do-pulse-record.sh",
            "timeout": 5,
            "statusMessage": "Recording session pulse"
          }
        ]
      }
    ]
  }
}
