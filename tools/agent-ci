#!/usr/bin/env bash
# agent-ci - CI/CD pipeline management

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

# Shared --json helpers (json_error, OUTPUT_FORMAT). Sourcing is best-effort so
# the tool still works standalone; the JSON paths below guard on OUTPUT_FORMAT.
if [[ -f "$REPO_ROOT/lib/json-output.sh" ]]; then
    # shellcheck source=lib/json-output.sh
    source "$REPO_ROOT/lib/json-output.sh"
fi
OUTPUT_FORMAT="${OUTPUT_FORMAT:-text}"

# Emit a single valid JSON document built from key/value/raw triples.
# Usage: emit_json key1 value1 key2 value2 ...   (values are JSON strings)
#        emit_json_raw '<json>'                   (pass a pre-built document)
emit_json_raw() {
    local doc="$1"
    python3 -c '
import json, sys
raw = sys.argv[1]
try:
    print(json.dumps(json.loads(raw), indent=2))
except Exception:
    print(json.dumps({"success": True, "result": raw}, indent=2))
' "$doc"
}

emit_json_text() {
    # Wrap arbitrary text output as a JSON success document.
    local text="$1"
    python3 -c '
import json, sys
print(json.dumps({"success": True, "result": sys.argv[1]}, indent=2))
' "$text"
}

emit_json_error() {
    # Structured JSON error to stdout (the audit reads stdout), nonzero exit.
    local message="$1"
    local code="${2:-1}"
    python3 -c '
import json, sys
print(json.dumps({"success": False, "error": sys.argv[1], "code": int(sys.argv[2])}, indent=2))
' "$message" "$code"
    return "$code"
}

show_help() {
    cat << 'EOF'
agent-ci - CI/CD pipeline management

Commands:
  status [workflow]          Show workflow status
  runs [workflow]            List recent runs
  trigger <workflow> [ref]   Trigger workflow (-f key=value per workflow_dispatch input)
  logs <run-id>              View run logs
  cancel <run-id>            Cancel running workflow
  artifacts <run-id>         Download artifacts
  secrets                    List secrets (names only)
  triage <run-id> [--repo R] Classify a failed run and draft a triage summary (dry-run)

Supported platforms:
  - GitHub Actions (auto-detected via gh CLI)

Examples:
  agent-ci status
  agent-ci runs deploy
  agent-ci trigger deploy.yml
  agent-ci logs 12345
  agent-ci artifacts 12345
  agent-ci triage 12345 --repo owner/repo
EOF
}

# Check for gh CLI. In JSON mode, emit a structured error instead of plain text.
check_gh() {
    if ! command -v gh &> /dev/null; then
        if [[ "$OUTPUT_FORMAT" == "json" ]]; then
            emit_json_error "gh CLI not found (install: brew install gh)"
            exit 1
        fi
        echo "Error: gh CLI not found"
        echo "Install: brew install gh"
        exit 1
    fi
}

# Get repo from git remote. Tolerant of missing remote under set -e/pipefail:
# a non-GitHub or absent origin yields empty output, never a nonzero exit.
get_repo() {
    { git remote get-url origin 2>/dev/null || true; } \
        | sed -E 's/.*github.com[:/]([^/]+\/[^.]+)(\.git)?/\1/'
}

# Emit a no-repo error in the active format.
no_repo_error() {
    if [[ "$OUTPUT_FORMAT" == "json" ]]; then
        emit_json_error "Not in a git repository with GitHub remote"
        return 1
    fi
    echo "Error: Not in a git repository with GitHub remote"
    return 1
}

cmd_status() {
    check_gh
    local workflow="${1:-}"
    local repo
    repo=$(get_repo)

    if [[ -z "$repo" ]]; then
        no_repo_error
        return 1
    fi

    if [[ "$OUTPUT_FORMAT" == "json" ]]; then
        local fields="databaseId,name,displayTitle,status,conclusion,headBranch,event,createdAt,url"
        local out
        if [[ -n "$workflow" ]]; then
            out=$(gh run list --workflow "$workflow" --limit 5 --repo "$repo" --json "$fields" 2>&1) || {
                emit_json_error "$out"
                return 1
            }
        else
            out=$(gh run list --limit 10 --repo "$repo" --json "$fields" 2>&1) || {
                emit_json_error "$out"
                return 1
            }
        fi
        emit_json_raw "$out"
        return 0
    fi

    if [[ -n "$workflow" ]]; then
        gh run list --workflow "$workflow" --limit 5 --repo "$repo"
    else
        gh run list --limit 10 --repo "$repo"
    fi
}

cmd_runs() {
    check_gh
    local workflow="${1:-}"
    local repo
    repo=$(get_repo)

    if [[ -z "$repo" ]]; then
        no_repo_error
        return 1
    fi

    if [[ "$OUTPUT_FORMAT" == "json" ]]; then
        local fields="databaseId,name,displayTitle,status,conclusion,headBranch,event,createdAt,url"
        local out
        if [[ -n "$workflow" ]]; then
            out=$(gh run list --limit 20 --repo "$repo" --workflow "$workflow" --json "$fields" 2>&1) || {
                emit_json_error "$out"
                return 1
            }
        else
            out=$(gh run list --limit 20 --repo "$repo" --json "$fields" 2>&1) || {
                emit_json_error "$out"
                return 1
            }
        fi
        emit_json_raw "$out"
        return 0
    fi

    local args=(--limit 20 --repo "$repo")
    [[ -n "$workflow" ]] && args+=(--workflow "$workflow")

    gh run list "${args[@]}"
}

cmd_trigger() {
    check_gh
    local workflow="" ref="" positional_ref=""
    # workflow_dispatch inputs, passed to `gh workflow run` as raw string
    # fields (-f): no @file expansion, so a value is never read from disk.
    local -a fields=()
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -f|--field|--input)
                local pair="${2:-}"
                if [[ ! "$pair" =~ ^[A-Za-z_][A-Za-z0-9_-]*=.*$ ]]; then
                    echo "Error: $1 takes key=value (got '${pair}')" >&2
                    return 2
                fi
                fields+=(-f "$pair")
                shift 2
                ;;
            -r|--ref)
                ref="${2:-}"
                [[ -n "$ref" ]] || { echo "Error: $1 needs a branch or tag" >&2; return 2; }
                shift 2
                ;;
            -*)
                echo "Error: unknown trigger option '$1'" >&2
                return 2
                ;;
            *)
                if [[ -z "$workflow" ]]; then
                    workflow="$1"
                elif [[ -z "$positional_ref" ]]; then
                    positional_ref="$1"
                else
                    echo "Error: unexpected argument '$1'" >&2
                    return 2
                fi
                shift
                ;;
        esac
    done
    [[ -z "$ref" ]] && ref="$positional_ref"
    [[ -z "$ref" ]] && ref="$(git branch --show-current 2>/dev/null)"
    local repo
    repo=$(get_repo)

    if [[ -z "$workflow" ]]; then
        if [[ "$OUTPUT_FORMAT" == "json" ]]; then
            emit_json_error "Workflow file required (usage: agent-ci trigger <workflow.yml> [ref] [-f key=value]...)"
            return 1
        fi
        echo "Error: Workflow file required"
        echo "Usage: agent-ci trigger <workflow.yml> [ref|--ref R] [-f key=value]..."
        return 1
    fi

    if [[ -z "$repo" ]]; then
        no_repo_error
        return 1
    fi

    local -a gh_args=(workflow run "$workflow" --ref "$ref" --repo "$repo" ${fields[@]+"${fields[@]}"})
    local inputs_note=""
    (( ${#fields[@]} > 0 )) && inputs_note=" with $(( ${#fields[@]} / 2 )) input(s)"

    if [[ "$OUTPUT_FORMAT" == "json" ]]; then
        local out
        out=$(gh "${gh_args[@]}" 2>&1) || {
            emit_json_error "$out"
            return 1
        }
        emit_json_text "Triggered $workflow on $ref$inputs_note"
        return 0
    fi

    gh "${gh_args[@]}" || return 1
    echo "Triggered $workflow on $ref$inputs_note"
}

cmd_logs() {
    check_gh
    local run_id="${1:-}"
    local repo
    repo=$(get_repo)

    if [[ -z "$run_id" ]]; then
        # Get latest run
        run_id=$(gh run list --limit 1 --json databaseId --jq '.[0].databaseId' --repo "$repo" 2>/dev/null || true)
        if [[ -z "$run_id" ]]; then
            if [[ "$OUTPUT_FORMAT" == "json" ]]; then
                emit_json_error "No runs found"
                return 1
            fi
            echo "Error: No runs found"
            return 1
        fi
        if [[ "$OUTPUT_FORMAT" != "json" ]]; then
            echo "Showing logs for latest run: $run_id"
        fi
    fi

    if [[ "$OUTPUT_FORMAT" == "json" ]]; then
        local out
        out=$(gh run view "$run_id" --log --repo "$repo" 2>&1) || {
            emit_json_error "$out"
            return 1
        }
        python3 -c '
import json, sys
print(json.dumps({"success": True, "run_id": sys.argv[1], "log": sys.argv[2]}, indent=2))
' "$run_id" "$out"
        return 0
    fi

    gh run view "$run_id" --log --repo "$repo"
}

cmd_cancel() {
    check_gh
    local run_id="${1:-}"
    local repo
    repo=$(get_repo)

    if [[ -z "$run_id" ]]; then
        if [[ "$OUTPUT_FORMAT" == "json" ]]; then
            emit_json_error "Run ID required"
            return 1
        fi
        echo "Error: Run ID required"
        return 1
    fi

    if [[ "$OUTPUT_FORMAT" == "json" ]]; then
        local out
        out=$(gh run cancel "$run_id" --repo "$repo" 2>&1) || {
            emit_json_error "$out"
            return 1
        }
        emit_json_text "Cancelled run $run_id"
        return 0
    fi

    gh run cancel "$run_id" --repo "$repo"
    echo "Cancelled run $run_id"
}

cmd_artifacts() {
    check_gh
    local run_id="${1:-}"
    local output="${2:-.}"
    local repo
    repo=$(get_repo)

    if [[ -z "$run_id" ]]; then
        if [[ "$OUTPUT_FORMAT" == "json" ]]; then
            emit_json_error "Run ID required"
            return 1
        fi
        echo "Error: Run ID required"
        return 1
    fi

    if [[ "$OUTPUT_FORMAT" == "json" ]]; then
        local out
        out=$(gh run download "$run_id" --dir "$output" --repo "$repo" 2>&1) || {
            emit_json_error "$out"
            return 1
        }
        emit_json_text "Downloaded artifacts to $output"
        return 0
    fi

    gh run download "$run_id" --dir "$output" --repo "$repo"
    echo "Downloaded artifacts to $output"
}

cmd_secrets() {
    check_gh
    local repo
    repo=$(get_repo)

    if [[ -z "$repo" ]]; then
        no_repo_error
        return 1
    fi

    if [[ "$OUTPUT_FORMAT" == "json" ]]; then
        local out
        out=$(gh secret list --repo "$repo" 2>&1) || {
            emit_json_error "$out"
            return 1
        }
        python3 -c '
import json, sys
names = [line.split()[0] for line in sys.argv[1].splitlines() if line.strip()]
print(json.dumps({"success": True, "secrets": names}, indent=2))
' "$out"
        return 0
    fi

    echo "Repository secrets:"
    gh secret list --repo "$repo"
}

cmd_watch() {
    check_gh
    local run_id="${1:-}"
    local repo
    repo=$(get_repo)

    if [[ -z "$run_id" ]]; then
        # Get latest in-progress run
        run_id=$(gh run list --status in_progress --limit 1 --json databaseId --jq '.[0].databaseId' --repo "$repo" 2>/dev/null || true)
        if [[ -z "$run_id" ]]; then
            if [[ "$OUTPUT_FORMAT" == "json" ]]; then
                emit_json_text "No in-progress runs"
                return 0
            fi
            echo "No in-progress runs"
            return 0
        fi
    fi

    if [[ "$OUTPUT_FORMAT" == "json" ]]; then
        local out
        out=$(gh run watch "$run_id" --repo "$repo" 2>&1) || {
            emit_json_error "$out"
            return 1
        }
        python3 -c '
import json, sys
print(json.dumps({"success": True, "run_id": sys.argv[1], "result": sys.argv[2]}, indent=2))
' "$run_id" "$out"
        return 0
    fi

    gh run watch "$run_id" --repo "$repo"
}

cmd_triage() {
    check_gh
    local run_id="" repo="" post=0
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --repo)
                if [[ $# -lt 2 || -z "${2:-}" ]]; then
                    emit_json_error "--repo requires owner/repo"
                    return 1
                fi
                repo="${2:-}"
                shift 2
                ;;
            --post)
                post=1
                shift
                ;;
            -*)
                emit_json_error "Unknown triage option: $1"
                return 1
                ;;
            *)
                if [[ -n "$run_id" ]]; then
                    emit_json_error "Only one run ID may be supplied"
                    return 1
                fi
                run_id="$1"
                shift
                ;;
        esac
    done

    if [[ -z "$run_id" ]]; then
        if [[ "$OUTPUT_FORMAT" == "json" ]]; then
            emit_json_error "Run ID required (usage: agent-ci triage <run-id> [--repo owner/repo])"
            return 1
        fi
        echo "Error: Run ID required"
        echo "Usage: agent-ci triage <run-id> [--repo owner/repo]"
        return 1
    fi

    [[ -z "$repo" ]] && repo=$(get_repo)
    if [[ -z "$repo" ]]; then
        no_repo_error
        return 1
    fi

    local py_args=("$REPO_ROOT/lib/ci_triage.py" "$run_id" --repo "$repo")
    [[ "$OUTPUT_FORMAT" == "json" ]] && py_args+=(--json)
    [[ "$post" -eq 1 ]] && py_args+=(--post)
    python3 "${py_args[@]}"
}

# Strip --json from the argument list (anywhere) so it never leaks to gh, and
# set OUTPUT_FORMAT. Plain-mode invocations are untouched.
ARGS=()
for arg in "$@"; do
    if [[ "$arg" == "--json" ]]; then
        OUTPUT_FORMAT="json"
    else
        ARGS+=("$arg")
    fi
done
set -- ${ARGS[@]+"${ARGS[@]}"}

# Main
case "${1:-help}" in
    status|st)
        shift || true
        cmd_status "$@"
        ;;
    runs|list|ls)
        shift || true
        cmd_runs "$@"
        ;;
    trigger|run|start)
        shift
        cmd_trigger "$@"
        ;;
    logs|log|view)
        shift || true
        cmd_logs "$@"
        ;;
    cancel|stop|abort)
        shift
        cmd_cancel "$@"
        ;;
    artifacts|download)
        shift
        cmd_artifacts "$@"
        ;;
    secrets)
        cmd_secrets
        ;;
    watch|follow)
        shift || true
        cmd_watch "$@"
        ;;
    triage)
        shift
        cmd_triage "$@"
        ;;
    help|--help|-h)
        show_help
        ;;
    *)
        echo "Unknown command: $1"
        echo "Try: agent-ci help"
        exit 1
        ;;
esac
