#!/usr/bin/env bash
# agent-ci - CI/CD pipeline management

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

# Shared --json helpers (json_error, OUTPUT_FORMAT). Sourcing is best-effort so
# the tool still works standalone; the JSON paths below guard on OUTPUT_FORMAT.
if [[ -f "$REPO_ROOT/lib/json-output.sh" ]]; then
    # shellcheck source=lib/json-output.sh
    source "$REPO_ROOT/lib/json-output.sh"
fi
OUTPUT_FORMAT="${OUTPUT_FORMAT:-text}"

# Emit a single valid JSON document built from key/value/raw triples.
# Usage: emit_json key1 value1 key2 value2 ...   (values are JSON strings)
#        emit_json_raw '<json>'                   (pass a pre-built document)
emit_json_raw() {
    local doc="$1"
    python3 -c '
import json, sys
raw = sys.argv[1]
try:
    print(json.dumps(json.loads(raw), indent=2))
except Exception:
    print(json.dumps({"success": True, "result": raw}, indent=2))
' "$doc"
}

emit_json_text() {
    # Wrap arbitrary text output as a JSON success document.
    local text="$1"
    python3 -c '
import json, sys
print(json.dumps({"success": True, "result": sys.argv[1]}, indent=2))
' "$text"
}

emit_json_error() {
    # Structured JSON error to stdout (the audit reads stdout), nonzero exit.
    local message="$1"
    local code="${2:-1}"
    python3 -c '
import json, sys
print(json.dumps({"success": False, "error": sys.argv[1], "code": int(sys.argv[2])}, indent=2))
' "$message" "$code"
    return "$code"
}

show_help() {
    cat << 'EOF'
agent-ci - CI/CD pipeline management

Commands:
  status [workflow]          Show workflow status
  runs [workflow]            List recent runs
  details <run-id>           Show one workflow run and its jobs as trace facts
  trigger <workflow>         Trigger workflow
  logs <run-id>              View a bounded, redacted run-log excerpt
  cancel <run-id>            Cancel running workflow
  artifacts <run-id>         Download artifacts
  secrets                    List secrets (names only)
  triage <run-id> [--repo R] Classify a failed run and draft a triage summary (dry-run)

Global options (any position):
  --repo owner/repo          Target another repository instead of the origin remote
  --json                     Structured output

Supported platforms:
  - GitHub Actions (auto-detected via gh CLI)

Examples:
  agent-ci status
  agent-ci runs deploy
  agent-ci trigger deploy.yml
  agent-ci details 12345 --repo owner/repo --json
  agent-ci logs 12345 --failed --tail 200 --max-bytes 65536 --json
  agent-ci logs 12345
  agent-ci artifacts 12345
  agent-ci triage 12345 --repo owner/repo
  agent-ci runs --repo owner/other-repo --json
EOF
}

# GitHub CLI fields deliberately cover evidence an incident tracker needs to
# cite: exact deployed source, workflow identity, lifecycle timestamps, and
# per-job/per-step outcomes. Keeping the list in one place makes the CLI
# contract explicit and testable.
DETAIL_FIELDS="databaseId,workflowName,workflowDatabaseId,displayTitle,status,conclusion,headBranch,headSha,event,createdAt,startedAt,updatedAt,url,jobs"

cmd_details() {
    check_gh
    local run_id="${1:-}"
    local repo
    repo=$(get_repo)

    if [[ -z "$run_id" ]]; then
        if [[ "$OUTPUT_FORMAT" == "json" ]]; then
            emit_json_error "Run ID required (usage: agent-ci details <run-id>)" 2
        else
            echo "Error: Run ID required"
            echo "Usage: agent-ci details <run-id>"
        fi
        return 2
    fi
    if [[ -z "$repo" ]]; then
        no_repo_error
        return 1
    fi

    local out
    out=$(gh run view "$run_id" --repo "$repo" --json "$DETAIL_FIELDS" 2>&1) || {
        emit_json_error "$out"
        return 1
    }
    # GitHub deployment records are optional evidence. A caller must be able to
    # distinguish an empty list from an unavailable API scope, so fetch them
    # separately and represent failures as degraded rather than failing the
    # otherwise useful workflow-run receipt.
    local head_sha deployment_file deployment_error=""
    head_sha=$(printf '%s' "$out" | python3 -c 'import json, sys; print(json.load(sys.stdin).get("headSha", ""))') || {
        emit_json_error "GitHub run details were not valid JSON"
        return 1
    }
    deployment_file=$(mktemp) || {
        emit_json_error "Unable to create temporary storage for deployment evidence"
        return 1
    }
    if ! gh api --paginate --slurp "repos/$repo/deployments?sha=$head_sha&per_page=100" >"$deployment_file" 2>/dev/null; then
        rm -f "$deployment_file"
        deployment_file=""
        deployment_error="GitHub deployment records unavailable for this repository or credential"
    fi
    if [[ "$OUTPUT_FORMAT" == "json" ]]; then
        local details_args=(normalize-run "$repo")
        [[ -n "$deployment_file" ]] && details_args+=(--deployments-file "$deployment_file")
        [[ -n "$deployment_error" ]] && details_args+=(--deployment-error "$deployment_error")
        printf '%s' "$out" | python3 "$REPO_ROOT/lib/ci_trace.py" "${details_args[@]}"
        local rc=$?
        rm -f "$deployment_file"
        return $rc
    fi
    rm -f "$deployment_file"
    printf '%s' "$out" | python3 -c '
import json, sys
run = json.load(sys.stdin)
print("Run:       {}".format(run.get("databaseId", "unknown")))
print("Workflow:  {}".format(run.get("workflowName", "unknown")))
print("Commit:    {}".format(run.get("headSha", "unknown")))
print("Result:    {} ({})".format(run.get("conclusion") or "pending", run.get("status", "unknown")))
print("Started:   {}".format(run.get("startedAt") or "not started"))
print("Updated:   {}".format(run.get("updatedAt") or "not updated"))
print("URL:       {}".format(run.get("url", "unknown")))
for job in run.get("jobs") or []:
    print("- {}: {}".format(job.get("name", "unknown"), job.get("conclusion") or job.get("status", "unknown")))
'
}

# Check for gh CLI. In JSON mode, emit a structured error instead of plain text.
check_gh() {
    if ! command -v gh &> /dev/null; then
        if [[ "$OUTPUT_FORMAT" == "json" ]]; then
            emit_json_error "gh CLI not found (install: brew install gh)"
            exit 1
        fi
        echo "Error: gh CLI not found"
        echo "Install: brew install gh"
        exit 1
    fi
}

# Get repo from git remote. Tolerant of missing remote under set -e/pipefail:
# a non-GitHub or absent origin yields empty output, never a nonzero exit.
get_repo() {
    if [[ -n "${CI_REPO:-}" ]]; then
        printf '%s\n' "$CI_REPO"
        return 0
    fi
    { git remote get-url origin 2>/dev/null || true; } \
        | sed -E 's/.*github.com[:/]([^/]+\/[^.]+)(\.git)?/\1/'
}

# Emit a no-repo error in the active format.
no_repo_error() {
    if [[ "$OUTPUT_FORMAT" == "json" ]]; then
        emit_json_error "Not in a git repository with GitHub remote"
        return 1
    fi
    echo "Error: Not in a git repository with GitHub remote"
    return 1
}

cmd_status() {
    check_gh
    local workflow="${1:-}"
    local repo
    repo=$(get_repo)

    if [[ -z "$repo" ]]; then
        no_repo_error
        return 1
    fi

    if [[ "$OUTPUT_FORMAT" == "json" ]]; then
        local fields="databaseId,name,displayTitle,status,conclusion,headBranch,event,createdAt,url"
        local out
        if [[ -n "$workflow" ]]; then
            out=$(gh run list --workflow "$workflow" --limit 5 --repo "$repo" --json "$fields" 2>&1) || {
                emit_json_error "$out"
                return 1
            }
        else
            out=$(gh run list --limit 10 --repo "$repo" --json "$fields" 2>&1) || {
                emit_json_error "$out"
                return 1
            }
        fi
        emit_json_raw "$out"
        return 0
    fi

    if [[ -n "$workflow" ]]; then
        gh run list --workflow "$workflow" --limit 5 --repo "$repo"
    else
        gh run list --limit 10 --repo "$repo"
    fi
}

cmd_runs() {
    check_gh
    local workflow="${1:-}"
    local repo
    repo=$(get_repo)

    if [[ -z "$repo" ]]; then
        no_repo_error
        return 1
    fi

    if [[ "$OUTPUT_FORMAT" == "json" ]]; then
        local fields="databaseId,name,displayTitle,status,conclusion,headBranch,event,createdAt,url"
        local out
        if [[ -n "$workflow" ]]; then
            out=$(gh run list --limit 20 --repo "$repo" --workflow "$workflow" --json "$fields" 2>&1) || {
                emit_json_error "$out"
                return 1
            }
        else
            out=$(gh run list --limit 20 --repo "$repo" --json "$fields" 2>&1) || {
                emit_json_error "$out"
                return 1
            }
        fi
        emit_json_raw "$out"
        return 0
    fi

    local args=(--limit 20 --repo "$repo")
    [[ -n "$workflow" ]] && args+=(--workflow "$workflow")

    gh run list "${args[@]}"
}

cmd_trigger() {
    check_gh
    local workflow="${1:-}"
    local ref="${2:-$(git branch --show-current)}"
    local repo
    repo=$(get_repo)

    if [[ -z "$workflow" ]]; then
        if [[ "$OUTPUT_FORMAT" == "json" ]]; then
            emit_json_error "Workflow file required (usage: agent-ci trigger <workflow.yml> [ref])"
            return 1
        fi
        echo "Error: Workflow file required"
        echo "Usage: agent-ci trigger <workflow.yml> [ref]"
        return 1
    fi

    if [[ -z "$repo" ]]; then
        no_repo_error
        return 1
    fi

    if [[ "$OUTPUT_FORMAT" == "json" ]]; then
        local out
        out=$(gh workflow run "$workflow" --ref "$ref" --repo "$repo" 2>&1) || {
            emit_json_error "$out"
            return 1
        }
        emit_json_text "Triggered $workflow on $ref"
        return 0
    fi

    gh workflow run "$workflow" --ref "$ref" --repo "$repo"
    echo "Triggered $workflow on $ref"
}

cmd_logs() {
    check_gh
    local run_id=""
    local failed_only=0
    local tail=200
    local max_bytes=65536
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --failed|--failed-only) failed_only=1; shift ;;
            --tail)
                [[ $# -ge 2 ]] || { emit_json_error "--tail requires a value" 2; return 2; }
                tail="$2"; shift 2 ;;
            --max-bytes)
                [[ $# -ge 2 ]] || { emit_json_error "--max-bytes requires a value" 2; return 2; }
                max_bytes="$2"; shift 2 ;;
            -*) emit_json_error "Unknown logs option: $1" 2; return 2 ;;
            *)
                [[ -z "$run_id" ]] || { emit_json_error "Only one run ID may be supplied" 2; return 2; }
                run_id="$1"; shift ;;
        esac
    done
    local repo
    repo=$(get_repo)

    if [[ -z "$run_id" ]]; then
        # Get latest run
        run_id=$(gh run list --limit 1 --json databaseId --jq '.[0].databaseId' --repo "$repo" 2>/dev/null || true)
        if [[ -z "$run_id" ]]; then
            if [[ "$OUTPUT_FORMAT" == "json" ]]; then
                emit_json_error "No runs found"
                return 1
            fi
            echo "Error: No runs found"
            return 1
        fi
        if [[ "$OUTPUT_FORMAT" != "json" ]]; then
            echo "Showing logs for latest run: $run_id"
        fi
    fi

    local log_flag="--log"
    [[ "$failed_only" -eq 1 ]] && log_flag="--log-failed"
    local trace_args=(bounded-log "$run_id")
    [[ "$failed_only" -eq 1 ]] && trace_args+=(--failed-only)
    trace_args+=(--tail "$tail" --max-bytes "$max_bytes")
    local trace_file error_file error_message
    trace_file=$(mktemp) || { emit_json_error "Unable to create temporary log excerpt storage"; return 1; }
    error_file=$(mktemp) || { rm -f "$trace_file"; emit_json_error "Unable to create temporary log error storage"; return 1; }
    # Stream the CLI output into a bounded ring in ci_trace.py.  Do not capture
    # a workflow's complete log in a shell variable before enforcing its cap.
    set +e
    gh run view "$run_id" "$log_flag" --repo "$repo" 2>"$error_file" \
        | python3 "$REPO_ROOT/lib/ci_trace.py" bounded-log-stream "$run_id" "${trace_args[@]:2}" >"$trace_file"
    local gh_rc=${PIPESTATUS[0]} trace_rc=${PIPESTATUS[1]}
    set -e
    if [[ "$trace_rc" -ne 0 ]]; then
        cat "$trace_file"
        rm -f "$trace_file" "$error_file"
        return "$trace_rc"
    fi
    if [[ "$gh_rc" -ne 0 ]]; then
        error_message=$(<"$error_file")
        rm -f "$trace_file" "$error_file"
        emit_json_error "${error_message:-Unable to read workflow logs}"
        return 1
    fi
    rm -f "$error_file"
    if [[ "$OUTPUT_FORMAT" == "json" ]]; then
        cat "$trace_file"
        rm -f "$trace_file"
        return 0
    fi
    python3 -c '
import json, sys
result = json.load(sys.stdin)
if not result.get("success"):
    raise SystemExit(result.get("error", "Unable to read logs"))
print(result["log"])
if result["truncated"]["any"]:
    print("\n[Excerpt truncated: line or byte limit reached]", file=sys.stderr)
' <"$trace_file"
    local rc=$?
    rm -f "$trace_file"
    return $rc
}

cmd_cancel() {
    check_gh
    local run_id="${1:-}"
    local repo
    repo=$(get_repo)

    if [[ -z "$run_id" ]]; then
        if [[ "$OUTPUT_FORMAT" == "json" ]]; then
            emit_json_error "Run ID required"
            return 1
        fi
        echo "Error: Run ID required"
        return 1
    fi

    if [[ "$OUTPUT_FORMAT" == "json" ]]; then
        local out
        out=$(gh run cancel "$run_id" --repo "$repo" 2>&1) || {
            emit_json_error "$out"
            return 1
        }
        emit_json_text "Cancelled run $run_id"
        return 0
    fi

    gh run cancel "$run_id" --repo "$repo"
    echo "Cancelled run $run_id"
}

cmd_artifacts() {
    check_gh
    local run_id="${1:-}"
    local output="${2:-.}"
    local repo
    repo=$(get_repo)

    if [[ -z "$run_id" ]]; then
        if [[ "$OUTPUT_FORMAT" == "json" ]]; then
            emit_json_error "Run ID required"
            return 1
        fi
        echo "Error: Run ID required"
        return 1
    fi

    if [[ "$OUTPUT_FORMAT" == "json" ]]; then
        local out
        out=$(gh run download "$run_id" --dir "$output" --repo "$repo" 2>&1) || {
            emit_json_error "$out"
            return 1
        }
        emit_json_text "Downloaded artifacts to $output"
        return 0
    fi

    gh run download "$run_id" --dir "$output" --repo "$repo"
    echo "Downloaded artifacts to $output"
}

cmd_secrets() {
    check_gh
    local repo
    repo=$(get_repo)

    if [[ -z "$repo" ]]; then
        no_repo_error
        return 1
    fi

    if [[ "$OUTPUT_FORMAT" == "json" ]]; then
        local out
        out=$(gh secret list --repo "$repo" 2>&1) || {
            emit_json_error "$out"
            return 1
        }
        python3 -c '
import json, sys
names = [line.split()[0] for line in sys.argv[1].splitlines() if line.strip()]
print(json.dumps({"success": True, "secrets": names}, indent=2))
' "$out"
        return 0
    fi

    echo "Repository secrets:"
    gh secret list --repo "$repo"
}

cmd_watch() {
    check_gh
    local run_id="${1:-}"
    local repo
    repo=$(get_repo)

    if [[ -z "$run_id" ]]; then
        # Get latest in-progress run
        run_id=$(gh run list --status in_progress --limit 1 --json databaseId --jq '.[0].databaseId' --repo "$repo" 2>/dev/null || true)
        if [[ -z "$run_id" ]]; then
            if [[ "$OUTPUT_FORMAT" == "json" ]]; then
                emit_json_text "No in-progress runs"
                return 0
            fi
            echo "No in-progress runs"
            return 0
        fi
    fi

    if [[ "$OUTPUT_FORMAT" == "json" ]]; then
        local out
        out=$(gh run watch "$run_id" --repo "$repo" 2>&1) || {
            emit_json_error "$out"
            return 1
        }
        python3 -c '
import json, sys
print(json.dumps({"success": True, "run_id": sys.argv[1], "result": sys.argv[2]}, indent=2))
' "$run_id" "$out"
        return 0
    fi

    gh run watch "$run_id" --repo "$repo"
}

cmd_triage() {
    check_gh
    local run_id="" repo="" post=0
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --repo)
                if [[ $# -lt 2 || -z "${2:-}" ]]; then
                    emit_json_error "--repo requires owner/repo"
                    return 1
                fi
                repo="${2:-}"
                shift 2
                ;;
            --post)
                post=1
                shift
                ;;
            -*)
                emit_json_error "Unknown triage option: $1"
                return 1
                ;;
            *)
                if [[ -n "$run_id" ]]; then
                    emit_json_error "Only one run ID may be supplied"
                    return 1
                fi
                run_id="$1"
                shift
                ;;
        esac
    done

    if [[ -z "$run_id" ]]; then
        if [[ "$OUTPUT_FORMAT" == "json" ]]; then
            emit_json_error "Run ID required (usage: agent-ci triage <run-id> [--repo owner/repo])"
            return 1
        fi
        echo "Error: Run ID required"
        echo "Usage: agent-ci triage <run-id> [--repo owner/repo]"
        return 1
    fi

    [[ -z "$repo" ]] && repo=$(get_repo)
    if [[ -z "$repo" ]]; then
        no_repo_error
        return 1
    fi

    local py_args=("$REPO_ROOT/lib/ci_triage.py" "$run_id" --repo "$repo")
    [[ "$OUTPUT_FORMAT" == "json" ]] && py_args+=(--json)
    [[ "$post" -eq 1 ]] && py_args+=(--post)
    python3 "${py_args[@]}"
}

# Strip --json and --repo <owner/repo> from the argument list (anywhere) so
# neither leaks to gh as a positional. --json sets OUTPUT_FORMAT; --repo sets
# CI_REPO, which get_repo() prefers over the origin remote so every verb can
# target another repository. Plain-mode invocations are untouched.
ARGS=()
CI_REPO="${CI_REPO:-}"
_expect_repo=0
for arg in "$@"; do
    if [[ "$_expect_repo" == "1" ]]; then
        CI_REPO="$arg"; _expect_repo=0
    elif [[ "$arg" == "--json" ]]; then
        OUTPUT_FORMAT="json"
    elif [[ "$arg" == "--repo" ]]; then
        _expect_repo=1
    elif [[ "$arg" == --repo=* ]]; then
        CI_REPO="${arg#--repo=}"
    else
        ARGS+=("$arg")
    fi
done
if [[ "$_expect_repo" == "1" ]]; then
    echo "Error: --repo requires a value (owner/repo)" >&2
    exit 2
fi
if [[ -n "$CI_REPO" && ! "$CI_REPO" =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]]; then
    echo "Error: --repo must be owner/repo, got '$CI_REPO'" >&2
    exit 2
fi
set -- ${ARGS[@]+"${ARGS[@]}"}

# Main
case "${1:-help}" in
    status|st)
        shift || true
        cmd_status "$@"
        ;;
    runs|list|ls)
        shift || true
        cmd_runs "$@"
        ;;
    details|detail|show)
        shift
        cmd_details "$@"
        ;;
    trigger|run|start)
        shift
        cmd_trigger "$@"
        ;;
    logs|log|view)
        shift || true
        cmd_logs "$@"
        ;;
    cancel|stop|abort)
        shift
        cmd_cancel "$@"
        ;;
    artifacts|download)
        shift
        cmd_artifacts "$@"
        ;;
    secrets)
        cmd_secrets
        ;;
    watch|follow)
        shift || true
        cmd_watch "$@"
        ;;
    triage)
        shift
        cmd_triage "$@"
        ;;
    help|--help|-h)
        show_help
        ;;
    *)
        echo "Unknown command: $1"
        echo "Try: agent-ci help"
        exit 1
        ;;
esac
