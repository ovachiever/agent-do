{
  "manifest_version": 3,
  "name": "agent-do transcribe tab capture",
  "version": "1.0.0",
  "permissions": [
    "activeTab",
    "desktopCapture",
    "offscreen",
    "tabCapture",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
