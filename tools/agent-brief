    return 0


def run_threads(args: argparse.Namespace) -> int:
    repo = resolve_repo(args.focused_repo)
    board_dir, board_tried = resolve_board(args.focused_board, repo)
    payload = assemble(repo, board_dir, args.since, args.timeout, use_model=False, peek=True, board_tried=board_tried)
    # A threads view carries no paragraph, so a voice annotation would be
    # noise about a capability nobody asked for here.
    annotations = [a for a in payload["annotations"] if a.get("kind") != "voice"]
    if args.json:
        subset = {
            "contract": payload["contract"],
            "generated_at": payload["generated_at"],
            "threads": payload["threads"],
            "threads_total": payload["threads_total"],
            "ranking": payload["ranking"],
            "annotations": annotations,
            "receipts": payload["receipts"],
            "sources": payload["sources"],
        }
        print(json.dumps(subset, indent=2, sort_keys=True))
        return 0
    print(f"{payload['threads_total']} thread(s); ranking mode {payload['ranking']['mode']}")
    for thread in payload["threads"]:
        marks = "".join([
            "!" if thread["needs_me"] else " ",
            "*" if thread["pinned"] else " ",
            "z" if thread["snoozed"] else " ",
        ])
        joined = "+".join(
            part for part, present in (
                ("mn", thread["manna"]), ("pr", thread["pr"]),
                ("live", thread["session"]), ("commit", thread["last_commit"]),
            ) if present
        ) or "-"
        print(f"  {marks} [{thread['rank']['score']:>6.2f}] {thread['id']}  ({joined})  {thread['title']}")
        for why in thread["why"]:
            print(f"           - {why['reason']} [{why['receipt']}]")
    for note in annotations:
        print(f"  ! {note.get('source', note.get('kind'))}: {note.get('reason', '')}")
    return 0


def run_now(args: argparse.Namespace) -> int:
    repo = resolve_repo(args.focused_repo)
    board_dir, board_tried = resolve_board(args.focused_board, repo)
    payload = assemble(repo, board_dir, args.since, args.timeout, not args.no_model, args.peek, board_tried)
    if args.json:
        print(json.dumps(payload, indent=2, sort_keys=True))
        return 0
    paragraph = payload["paragraph"]
    print(paragraph["text"])
    voice = paragraph["mode"] + (f" ({paragraph['model']})" if paragraph.get("model") else "")
    print(f"\n  voice: {voice}")
    need = [t for t in payload["threads"] if t["needs_me"] and not t["snoozed"]]
    for thread in need:
        print(f"  ! {thread['id']}: {thread['title']}  [{', '.join(thread['receipts'])}]")
    for suggestion in payload["suggestions"]:
        tap = f"  $ {suggestion['command']}" if suggestion.get("command") else ""
        print(f"  > {suggestion['label']}{tap}")
    for note in payload["annotations"]:
        print(f"  ! {note.get('source', note.get('kind'))}: {note.get('reason', '')}")
    return 0


def run_pin(args: argparse.Namespace, pinned: bool) -> int:
    state = load_state()
    if pinned:
        state["pins"][args.thread] = {"at": iso(now_utc())}
        journal_append({"ts": iso(now_utc()), "thread": args.thread, "kind": thread_kind_of(args.thread), "action": "pinned"})
    else:
        if args.thread not in state["pins"]:
            print(json.dumps({"success": False, "error": f"{args.thread} is not pinned"}))
            return 1
        state["pins"].pop(args.thread, None)
    save_state(state)
    print(json.dumps({"success": True, "thread": args.thread, "pinned": pinned}))
    return 0


def run_snooze(args: argparse.Namespace) -> int:
    if not args.until and not args.until_changed:
        print(json.dumps({
            "success": False,
            "error": "snooze needs --until <iso8601> or --until-changed; an unbounded snooze is a hidden delete",
        }))
        return 2
    entry: dict[str, Any] = {"at": iso(now_utc())}
    if args.until:
        until = parse_iso(args.until)
        if until is None:
            print(json.dumps({"success": False, "error": f"unparseable --until: {args.until}"}))
            return 2
        entry["until"] = iso(until)
    if args.until_changed:
        entry["until_changed"] = True
        if args.fingerprint:
            entry["fingerprint"] = args.fingerprint
        else:
            repo = resolve_repo(args.focused_repo)
            board_dir, board_tried = resolve_board(args.focused_board, repo)
            payload = assemble(repo, board_dir, None, args.timeout, use_model=False, peek=True)
            match = next((t for t in payload["threads"] if t["id"] == args.thread), None)
            if match is None:
                print(json.dumps({
                    "success": False,
                    "error": f"{args.thread} is not a current thread; cannot fingerprint it for until-changed",
                }))
                return 2
            entry["fingerprint"] = match["fingerprint"]
    state = load_state()
    state["snoozes"][args.thread] = entry
    save_state(state)
    journal_append({"ts": iso(now_utc()), "thread": args.thread, "kind": thread_kind_of(args.thread), "action": "snoozed"})
    print(json.dumps({"success": True, "thread": args.thread, "snooze": entry}))
    return 0


def run_unsnooze(args: argparse.Namespace) -> int:
    state = load_state()
    if args.thread not in state["snoozes"]:
        print(json.dumps({"success": False, "error": f"{args.thread} is not snoozed"}))
        return 1
    state["snoozes"].pop(args.thread)
    save_state(state)
    print(json.dumps({"success": True, "thread": args.thread, "snoozed": False}))
    return 0


OBSERVE_ACTIONS = ("acted", "ignored", "snoozed", "pinned", "opened")


def run_observe(args: argparse.Namespace) -> int:
    if args.action not in OBSERVE_ACTIONS:
        print(json.dumps({
            "success": False,
            "error": f"unknown action '{args.action}'; one of: {', '.join(OBSERVE_ACTIONS)}",
        }))
        return 2
    entry = {
        "ts": iso(now_utc()),
        "thread": args.thread,
        "kind": thread_kind_of(args.thread),
        "action": args.action,
    }
    if args.note:
        entry["note"] = args.note
    journal_append(entry)
    print(json.dumps({"success": True, "observed": entry}))
    return 0


def run_state(args: argparse.Namespace) -> int:
    state = load_state()
    journal = journal_read()
    payload = {
        "success": True,
        "store": str(BRIEF_DIR),
        "callers": state.get("callers", {}),
        "pins": state.get("pins", {}),
        "snoozes": state.get("snoozes", {}),
        "calibration": state.get("calibration", {}),
        "journal_observations": len(journal),
    }
    print(json.dumps(payload, indent=2, sort_keys=True))
    return 0


