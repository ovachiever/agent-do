def run_holy(args: argparse.Namespace) -> int:
    repo = resolve_repo(args.focused_repo)
    board_dir, board_tried = resolve_board(args.focused_board, repo)
    payload = assemble(repo, board_dir, args.since, args.timeout, not args.no_model, args.peek, board_tried)
