HELP_EPILOG = """
Commands:
  now       Human-readable estate brief (model voice when configured, honest
            deterministic fallback otherwise)
  threads   Joined thread objects: gh PR <-> manna item <-> live session <->
            last commit <-> claim state
  ask       Answer a question over the estate (sessions, git, board, zpc);
            every claim carries a receipt id
  holy      The full composite contract as JSON (versioned; consumers fail
            closed on drift)
  pin       Pin a thread (rank boost, survives restarts)
  unpin     Remove a pin
  snooze    Snooze a thread (--until <iso8601> or --until-changed)
  unsnooze  Clear a snooze
  observe   Record observed behavior on a thread (acted|ignored|snoozed|
            pinned|opened) — feeds the ranker
  state     Show the read-state store and journal size

Context flags (now/threads/ask/holy/snooze):
  --focused-repo <path>    Repo checkout the caller has focused (default: cwd)
  --focused-board <path>   .manna directory (default: <repo>/.manna)
  --since <iso8601>        Delta baseline; otherwise read-state, else first look
  --timeout <seconds>      Per-source budget for every source. Default: local
                           sources get the shared read-probe budget; the GitHub
                           sweep self-calibrates to twice its last observed
                           duration (bootstrap: twice the probe budget). One
                           successful run with an explicit --timeout teaches
                           the default.
  --no-model               Skip the model voice even when configured
  --peek                   Do not advance read-state

Fixtures: set AGENT_BRIEF_FIXTURES=<dir> to read {github,manna,reconcile,
coord,sessions,git}.json instead of live sources (origin is reported).
"""


def add_context_flags(parser: argparse.ArgumentParser) -> None:
    parser.add_argument("--focused-repo", help="path to the focused repo checkout (default: cwd)")
    parser.add_argument("--focused-board", help="path to the .manna board directory (default: <repo>/.manna)")
    parser.add_argument("--since", help="ISO8601 delta baseline")
    parser.add_argument(
        "--timeout", type=float, default=None,
        help="per-source budget in seconds for every source (default: the shared "
             "read-probe budget locally; the GitHub sweep self-calibrates from "
             "its last observed duration, bootstrapping at twice the probe budget)",
    )
    parser.add_argument("--no-model", action="store_true", help="skip the model voice")
    parser.add_argument("--peek", action="store_true", help="do not advance read-state")
    parser.add_argument("--json", action="store_true", help="structured JSON output")


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        prog="agent-brief",
        description="Estate briefing engine — ranked threads, delta, suggestions, receipts.",
        epilog=HELP_EPILOG,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    sub = parser.add_subparsers(dest="command")

    p_now = sub.add_parser("now", help="human-readable estate brief")
    add_context_flags(p_now)

    p_threads = sub.add_parser("threads", help="joined thread objects")
    add_context_flags(p_threads)

    p_ask = sub.add_parser("ask", help="question over the estate")
    p_ask.add_argument("question")
    add_context_flags(p_ask)

    p_holy = sub.add_parser("holy", help="composite contract JSON for the Holy panel")
    add_context_flags(p_holy)

    p_pin = sub.add_parser("pin", help="pin a thread")
    p_pin.add_argument("thread")
    p_unpin = sub.add_parser("unpin", help="unpin a thread")
    p_unpin.add_argument("thread")

    p_snooze = sub.add_parser("snooze", help="snooze a thread")
    p_snooze.add_argument("thread")
    p_snooze.add_argument("--until", help="ISO8601 timestamp the snooze expires at")
    p_snooze.add_argument("--until-changed", action="store_true", help="snooze until the thread changes")
    p_snooze.add_argument("--fingerprint", help="explicit fingerprint (else computed live)")
    add_context_flags(p_snooze)

    p_unsnooze = sub.add_parser("unsnooze", help="clear a snooze")
    p_unsnooze.add_argument("thread")

    p_observe = sub.add_parser("observe", help="record observed behavior on a thread")
    p_observe.add_argument("thread")
    p_observe.add_argument("action", help="acted|ignored|snoozed|pinned|opened")
    p_observe.add_argument("--note", help="optional context")

    p_state = sub.add_parser("state", help="show the read-state store")
    p_state.add_argument("--json", action="store_true", help="structured JSON output")

    args = parser.parse_args(argv)
    if not args.command:
        parser.print_help()
        return 0
    try:
        if args.command == "now":
            return run_now(args)
        if args.command == "threads":
            return run_threads(args)
        if args.command == "ask":
            return run_ask(args)
        if args.command == "holy":
            return run_holy(args)
        if args.command == "pin":
            return run_pin(args, pinned=True)
        if args.command == "unpin":
            return run_pin(args, pinned=False)
        if args.command == "snooze":
            return run_snooze(args)
        if args.command == "unsnooze":
            return run_unsnooze(args)
        if args.command == "observe":
            return run_observe(args)
        if args.command == "state":
            return run_state(args)
    except KeyboardInterrupt:
        return 130
    parser.print_help()
    return 1


if __name__ == "__main__":
    sys.exit(main())
