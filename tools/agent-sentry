cmd_issues() {
    local -a args=()
    _pop_json_flag "$@"
    args=("${_JSON_ARGS[@]}")
    local base_url org project="" query="is:unresolved" sort="date" limit="25"
    base_url=$(sentry_base_url) || return 1
    org=$(sentry_org) || return 1

    while [[ ${#args[@]} -gt 0 ]]; do
        case "${args[0]}" in
            --project)
                if [[ ${#args[@]} -lt 2 ]]; then echo "Error: --project requires a value" >&2; return 1; fi
                project="${args[1]}"; args=("${args[@]:2}") ;;
            --query)
                if [[ ${#args[@]} -lt 2 ]]; then echo "Error: --query requires a value" >&2; return 1; fi
                query="${args[1]}"; args=("${args[@]:2}") ;;
            --sort)
                if [[ ${#args[@]} -lt 2 ]]; then echo "Error: --sort requires a value" >&2; return 1; fi
                sort="${args[1]}"; args=("${args[@]:2}") ;;
            --limit)
                if [[ ${#args[@]} -lt 2 ]]; then echo "Error: --limit requires a value" >&2; return 1; fi
                limit="${args[1]}"; args=("${args[@]:2}") ;;
            *) echo "Unknown option: ${args[0]}" >&2; return 1 ;;
        esac
    done

    # Prepend project filter to query string if specified
    if [[ -n "$project" ]]; then
        query="project:${project} ${query}"
    fi

    # URL-encode the query safely via env var (no shell interpolation in Python)
    local encoded_query
    encoded_query=$(SENTRY_QUERY="$query" python3 -c "
import os, urllib.parse
print(urllib.parse.quote(os.environ['SENTRY_QUERY']))
") || return 1

    local url="${base_url}/organizations/${org}/issues/?query=${encoded_query}&sort=${sort}&limit=${limit}"

    local result
    result=$(sentry_get "$url") || return 1

    if $_json_mode; then
        _emit_json "$result"
        return
    fi

    printf '%s' "$result" | python3 -c "
import sys, json
data = json.load(sys.stdin)
if isinstance(data, dict) and 'detail' in data:
    print('Error:', data['detail'], file=sys.stderr)
    sys.exit(1)
if not data:
    print('No issues found.')
    sys.exit(0)
fmt = '{:<22} {:<50} {:<6} {:<6} {:<12}'
print(fmt.format('ID', 'TITLE', 'EVENTS', 'USERS', 'LAST SEEN'))
print('-' * 96)
for i in data:
    print(fmt.format(
        i.get('shortId', '')[:22],
        i.get('title', '')[:50],
        str(i.get('count', ''))[:6],
        str(i.get('userCount', ''))[:6],
        (i.get('lastSeen', '') or '')[:12],
    ))
"
}

