    local short_id="${args[0]:?Usage: agent-sentry unresolve <short_id>}"
    local base_url org
    base_url=$(sentry_base_url) || return 1
    org=$(sentry_org) || return 1

    local issue_id
    issue_id=$(resolve_issue_id "$short_id") || return 1

