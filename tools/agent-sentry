cmd_ignore() {
    local -a args=()
    _pop_json_flag "$@"
    args=("${_JSON_ARGS[@]}")
    local short_id="${args[0]:?Usage: agent-sentry ignore <short_id>}"
    local base_url org
    base_url=$(sentry_base_url) || return 1
    org=$(sentry_org) || return 1

    local issue_id
    issue_id=$(resolve_issue_id "$short_id") || return 1

    local result
    # substatus archived_until_escalating applies reliably via org bulk update, not single-issue PUT
    result=$(sentry_put "${base_url}/organizations/${org}/issues/?id=${issue_id}" '{"status":"ignored","substatus":"archived_until_escalating"}') || return 1
    result=$(printf '%s' "$result" | python3 -c "
import json, sys
raw = json.load(sys.stdin)
if isinstance(raw, dict) and 'detail' in raw:
    print(json.dumps(raw))
elif isinstance(raw, list):
    if not raw:
        print(json.dumps({'detail': 'no issue updated'}))
    else:
        print(json.dumps(raw[0]))
else:
    print(json.dumps(raw))
")
    _emit_action_json ignore "$result"
}

cmd_assign() {
    local -a args=()
    _pop_json_flag "$@"
    args=("${_JSON_ARGS[@]}")
    local short_id="${args[0]:?Usage: agent-sentry assign <short_id> <email>}"
    local email="${args[1]:?Usage: agent-sentry assign <short_id> <email>}"
    local base_url org
    base_url=$(sentry_base_url) || return 1
    org=$(sentry_org) || return 1

    local issue_id
    issue_id=$(resolve_issue_id "$short_id") || return 1

    local payload
    payload=$(SENTRY_ASSIGN_EMAIL="$email" python3 -c "
import os, json
print(json.dumps({'assignedTo': os.environ['SENTRY_ASSIGN_EMAIL']}))
") || return 1

    local result
    result=$(sentry_put "${base_url}/organizations/${org}/issues/${issue_id}/" "$payload") || return 1
    _emit_action_json assign "$result"
}

