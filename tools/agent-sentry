# --- Token and Auth Helpers ---

sentry_token() {
    local token="${SENTRY_AUTH_TOKEN:-}"
    if [[ -z "$token" ]]; then
        echo "Error: SENTRY_AUTH_TOKEN not set" >&2
        echo "  Store it with: agent-do creds store SENTRY_AUTH_TOKEN --stdin" >&2
        return 1
    fi
    printf '%s' "$token"
}

# Extract org slug and region URL from the sntrys_ token payload.
# Token format: sntrys_<base64_payload>_<signature>
# Payload JSON: {"iat":...,"url":"...","region_url":"...","org":"..."}
sentry_token_payload() {
    local token
    token=$(sentry_token) || return 1
    if [[ "$token" != sntrys_* ]]; then
        return 1
    fi
    local payload
    payload="${token#sntrys_}"
    payload="${payload%%_*}"
    # base64url decode — cross-platform via python3 (macOS base64 lacks -d;
    # sntrys_ tokens use URL-safe base64 which requires urlsafe_b64decode)
    local padded="$payload"
    local mod=$(( ${#padded} % 4 ))
    if (( mod == 2 )); then padded+="=="
    elif (( mod == 3 )); then padded+="="
    fi
    printf '%s' "$padded" | python3 -c "
import sys, base64
sys.stdout.buffer.write(base64.urlsafe_b64decode(sys.stdin.read().strip()))
" 2>/dev/null
}

sentry_org() {
    local org="${SENTRY_ORG:-}"
    if [[ -n "$org" ]]; then
        printf '%s' "$org"
        return 0
    fi
    local payload
    payload=$(sentry_token_payload 2>/dev/null) || true
    if [[ -n "$payload" ]]; then
        org=$(printf '%s' "$payload" | python3 -c "import sys,json; print(json.load(sys.stdin).get('org',''))" 2>/dev/null)
    fi
    if [[ -z "$org" ]]; then
        echo "Error: cannot determine org slug. Set SENTRY_ORG or use an sntrys_ org token." >&2
        return 1
    fi
    printf '%s' "$org"
}

sentry_base_url() {
    local region="${SENTRY_REGION_URL:-}"
    if [[ -n "$region" ]]; then
        printf '%s/api/0' "$region"
        return 0
    fi
    local payload
    payload=$(sentry_token_payload 2>/dev/null) || true
    if [[ -n "$payload" ]]; then
        region=$(printf '%s' "$payload" | python3 -c "import sys,json; print(json.load(sys.stdin).get('region_url',''))" 2>/dev/null)
    fi
    if [[ -z "$region" ]]; then
        region="https://sentry.io"
    fi
    printf '%s/api/0' "$region"
}

# --- HTTP Helpers ---

sentry_get() {
    local url="$1"
    local token
    token=$(sentry_token) || return 1

    local response
    response=$(stall_detect 70 api_request GET "$url" \
        --connect-timeout 10 --max-time 60 \
        -H "Authorization: Bearer ${token}" \
        -H "Accept: application/json") || {
        if [[ -n "$response" ]]; then
            printf '%s' "$response"
            return 0
        fi
        return 1
    }
    printf '%s' "$response"
}

sentry_put() {
    local url="$1"
    local data="$2"
    local token
    token=$(sentry_token) || return 1

    local response
    response=$(stall_detect 70 api_request PUT "$url" \
        --connect-timeout 10 --max-time 60 \
        -H "Authorization: Bearer ${token}" \
        -H "Accept: application/json" \
        -H "Content-Type: application/json" \
        -d "$data") || {
        if [[ -n "$response" ]]; then
            printf '%s' "$response"
            return 0
        fi
        return 1
    }
    printf '%s' "$response"
}

# --- Resolvers ---

# Resolve a short ID (e.g. VERSOVA-CHAT-B) to a numeric issue ID.
# If input is already numeric, return it directly.
resolve_issue_id() {
    local id_or_short="$1"
    local base_url org

    # Purely numeric — use directly
    if [[ "$id_or_short" =~ ^[0-9]+$ ]]; then
        printf '%s' "$id_or_short"
        return 0
    fi

    base_url=$(sentry_base_url) || return 1
    org=$(sentry_org) || return 1

    local result
    result=$(sentry_get "${base_url}/organizations/${org}/shortids/${id_or_short}/") || return 1

    local numeric_id
    numeric_id=$(printf '%s' "$result" | python3 -c "
import sys, json
d = json.load(sys.stdin)
if 'detail' in d:
    print('', end='')
else:
    g = d.get('group', {})
    print(g.get('id', ''), end='')
" 2>/dev/null)

    if [[ -z "$numeric_id" ]]; then
        echo "Error: Issue '${id_or_short}' not found" >&2
        return 1
    fi

    printf '%s' "$numeric_id"
}

# --- Commands ---

cmd_projects() {
    local -a args=()
    _pop_json_flag "$@"
    args=("${_JSON_ARGS[@]}")
    local base_url org
    base_url=$(sentry_base_url) || return 1
    org=$(sentry_org) || return 1

    local result
    result=$(sentry_get "${base_url}/organizations/${org}/projects/") || return 1

    if $_json_mode; then
        _emit_json "$result"
        return
    fi

    printf '%s' "$result" | python3 -c "
import sys, json
data = json.load(sys.stdin)
if isinstance(data, dict) and 'detail' in data:
    print('Error:', data['detail'], file=sys.stderr)
    sys.exit(1)
if not data:
    print('No projects found.')
    sys.exit(0)
fmt = '{:<35} {:<15} {:<10} {:<20}'
print(fmt.format('SLUG', 'PLATFORM', 'STATUS', 'TEAM'))
print('-' * 80)
for p in data:
    team = ''
    if p.get('team'):
        team = p['team'].get('slug', '')
    elif p.get('teams'):
        team = ', '.join(t.get('slug','') for t in p['teams'][:2])
    print(fmt.format(
        p.get('slug', '')[:35],
        (p.get('platform') or '-')[:15],
        p.get('status', '')[:10],
        team[:20],
    ))
"
}

