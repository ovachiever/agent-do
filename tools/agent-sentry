#!/usr/bin/env bash
# agent-sentry - Sentry error tracking and performance monitoring

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=/dev/null
source "${SCRIPT_DIR}/../lib/json-output.sh" 2>/dev/null || true

_json_mode=false
_JSON_ARGS=()

_pop_json_flag() {
    _json_mode=false
    _JSON_ARGS=()
    for arg in "$@"; do
        if [[ "$arg" == "--json" ]]; then
            _json_mode=true
        else
            _JSON_ARGS+=("$arg")
        fi
    done
}

_emit_json() {
    printf '%s' "$1" | python3 -m json.tool 2>/dev/null || printf '%s\n' "$1"
}

_emit_action_json() {
    local action="$1"
    local raw="$2"
    if $_json_mode; then
        printf '%s' "$raw" | python3 -c "
import json, sys
action = sys.argv[1]
d = json.load(sys.stdin)
if 'detail' in d:
    print(json.dumps({'ok': False, 'error': d['detail']}, indent=2))
    sys.exit(1)
print(json.dumps({'ok': True, 'action': action, 'issue': d}, indent=2))
" "$action"
        return
    fi
    printf '%s' "$raw" | python3 -c "
import sys, json
action = sys.argv[1]
d = json.load(sys.stdin)
if 'detail' in d:
    print('Error:', d['detail'], file=sys.stderr)
    sys.exit(1)
label = {'resolve': 'resolved', 'unresolve': 'reopened', 'ignore': 'ignored', 'assign': 'assigned'}.get(action, action)
sid = d.get('shortId', d.get('id', ''))
if action == 'assign':
    assignee = d.get('assignedTo') or {}
    who = assignee.get('email') or assignee.get('name', 'nobody')
    print('Issue', sid, 'assigned to', who)
else:
    print('Issue', sid, label + '.')
" "$action"
}

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "${SCRIPT_DIR}/../lib/retry.sh"
source "${SCRIPT_DIR}/../lib/snapshot.sh"

