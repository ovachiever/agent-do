    printf '%s' "$result" | python3 -c "
import sys, json
data = json.load(sys.stdin)
if isinstance(data, dict) and 'detail' in data:
    print('Error:', data['detail'], file=sys.stderr)
    sys.exit(1)
if not data:
    print('No alert rules found.')
    sys.exit(0)
fmt = '{:<8} {:<35} {:<12} {:<15} {:<20}'
print(fmt.format('ID', 'NAME', 'TYPE', 'STATUS', 'PROJECT'))
print('-' * 90)
for r in data:
    rtype = r.get('type', 'unknown')
    status = ''
    proj = ''
    if rtype == 'alert_rule':
