cmd_resolve() {
    local -a args=()
    _pop_json_flag "$@"
    args=("${_JSON_ARGS[@]}")
    local short_id="${args[0]:?Usage: agent-sentry resolve <short_id>}"
    local base_url org
    base_url=$(sentry_base_url) || return 1
    org=$(sentry_org) || return 1

    local issue_id
    issue_id=$(resolve_issue_id "$short_id") || return 1

    local result
    result=$(sentry_put "${base_url}/organizations/${org}/issues/${issue_id}/" '{"status":"resolved"}') || return 1
    _emit_action_json resolve "$result"
}

