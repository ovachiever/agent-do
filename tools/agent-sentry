    _pop_json_flag "$@"
    args=("${_JSON_ARGS[@]}")
    local base_url org project=""
    base_url=$(sentry_base_url) || return 1
    org=$(sentry_org) || return 1

    while [[ ${#args[@]} -gt 0 ]]; do
        case "${args[0]}" in
            --project)
                if [[ ${#args[@]} -lt 2 ]]; then echo "Error: --project requires a value" >&2; return 1; fi
                project="${args[1]}"; args=("${args[@]:2}") ;;
            *) echo "Unknown option: ${args[0]}" >&2; return 1 ;;
        esac
    done

    local url="${base_url}/organizations/${org}/releases/?per_page=25"

    local result
    result=$(sentry_get "$url") || return 1

    if $_json_mode; then
        printf '%s' "$result" | SENTRY_RELEASE_PROJECT="$project" python3 -c "
import os, sys, json
data = json.load(sys.stdin)
project = os.environ.get('SENTRY_RELEASE_PROJECT', '')
if project:
    data = [
        r for r in data
        if any(
            str(p.get('slug', '')) == project
            or str(p.get('id', '')) == project
            or str(p.get('name', '')) == project
            for p in r.get('projects', [])
        )
    ]
print(json.dumps(data, indent=2))
"
        return
    fi

    printf '%s' "$result" | SENTRY_RELEASE_PROJECT="$project" python3 -c "
import os, sys, json
data = json.load(sys.stdin)
if isinstance(data, dict) and 'detail' in data:
    print('Error:', data['detail'], file=sys.stderr)
    sys.exit(1)
project = os.environ.get('SENTRY_RELEASE_PROJECT', '')
if project:
    data = [
        r for r in data
        if any(
            str(p.get('slug', '')) == project
            or str(p.get('id', '')) == project
            or str(p.get('name', '')) == project
            for p in r.get('projects', [])
        )
    ]
if not data:
    print('No releases found.')
    sys.exit(0)
fmt = '{:<30} {:<24} {:<10} {:<10}'
print(fmt.format('VERSION', 'DATE', 'NEW ISSUES', 'PROJECTS'))
print('-' * 74)
for r in data:
    projs = ','.join(p.get('slug','') for p in r.get('projects', [])[:3])
    print(fmt.format(
        r.get('shortVersion', r.get('version', ''))[:30],
        (r.get('dateCreated', '') or '')[:24],
        str(r.get('newGroups', ''))[:10],
        projs[:10],
    ))
"
}

# Cron monitors (Sentry Crons): one row per monitor and environment, with
# Sentry's own status. GET /organizations/{org}/monitors/ (alerts:read or
# org:read); filters map to the documented project/environment parameters.
cmd_monitors() {
    local -a args=() query=()
    _pop_json_flag "$@"
    args=("${_JSON_ARGS[@]+"${_JSON_ARGS[@]}"}")
    set -- "${args[@]+"${args[@]}"}"
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --project|--environment)
                if [[ $# -lt 2 || "$2" == --* ]]; then
                    echo "Error: $1 needs a value" >&2
                    return 2
                fi
                query+=("${1#--}=$(python3 -c 'import sys, urllib.parse; print(urllib.parse.quote_plus(sys.argv[1]))' "$2")")
                shift 2 ;;
            *)
                echo "Error: unknown option '$1'" >&2
                echo "Usage: agent-sentry monitors [--project <slug>]... [--environment <name>]... [--json]" >&2
                return 2 ;;
        esac
    done

    local base_url org url result
    base_url=$(sentry_base_url) || return 1
    org=$(sentry_org) || return 1
    url="${base_url}/organizations/${org}/monitors/"
    if [[ ${#query[@]} -gt 0 ]]; then
        url+="?$(IFS='&'; printf '%s' "${query[*]}")"
    fi
    result=$(sentry_get "$url") || return 1

    local json_flag=0
    $_json_mode && json_flag=1
    local has_project=0
    [[ "${query[*]+"${query[*]}"}" == *project=* ]] && has_project=1
    printf '%s' "$result" | JSON_MODE="$json_flag" HAS_PROJECT="$has_project" python3 -c '
import json, os, sys
try:
    data = json.load(sys.stdin)
except ValueError:
    print("Error: Sentry returned a non-JSON response for monitors", file=sys.stderr)
    sys.exit(1)
if isinstance(data, dict):
    detail = data.get("detail") or data
    print(f"Error: Sentry refused the monitors request: {detail}", file=sys.stderr)
    print("  (needs a token with alerts:read or org:read)", file=sys.stderr)
    if os.environ["HAS_PROJECT"] == "1":
        print("  (Sentry also answers this way when a --project slug does not exist)", file=sys.stderr)
    sys.exit(1)
if len(data) >= 100:
    print(f"Warning: {len(data)} monitors returned — Sentry pages at 100, so there may be more", file=sys.stderr)
if os.environ["JSON_MODE"] == "1":
    print(json.dumps(data, indent=2))
    sys.exit(0)
if not data:
    print("No cron monitors.")
    sys.exit(0)
BAD = {"error", "missed_checkin", "timeout"}
fmt = "{:<30} {:<26} {:<20} {:<12} {:<15} {:<21} {:<21} {}"
print(fmt.format("MONITOR", "PROJECT", "SCHEDULE", "ENV", "STATUS", "LAST CHECK-IN", "NEXT CHECK-IN", "MUTED"))
print("-" * 155)
envs_total = not_ok = 0
for m in data:
    cfg = m.get("config") or {}
    sched = " ".join(x for x in (cfg.get("schedule") or "-", cfg.get("timezone") or "") if x)
    slug = str(m.get("slug") or "")[:30]
    project = str((m.get("project") or {}).get("slug") or "-")[:26]
    envs = m.get("environments") or []
    if not envs:
        mstatus = str(m.get("status") or "-")
        print(fmt.format(slug, project, sched[:20], "-", mstatus, "no check-ins yet", "", ""))
        continue
    for e in envs:
        envs_total += 1
        status = str(e.get("status") or "-")
        if status in BAD:
            not_ok += 1
        muted = "yes" if (e.get("isMuted") or m.get("isMuted")) else "no"
        print(fmt.format(slug, project, sched[:20], str(e.get("name") or "-")[:12], status,
                         str(e.get("lastCheckIn") or "never")[:21], str(e.get("nextCheckIn") or "-")[:21], muted))
print()
print(f"{len(data)} monitors, {envs_total} environments: {not_ok} not ok (error, missed check-in or timeout)")
'
}

cmd_snapshot() {
    _pop_json_flag "$@"
    local token
    token=$(sentry_token) || { snapshot_error "SENTRY_AUTH_TOKEN not set" "sentry"; return 1; }
    local org
    org=$(sentry_org 2>/dev/null) || { snapshot_error "cannot determine org" "sentry"; return 1; }
    local base_url
    base_url=$(sentry_base_url) || { snapshot_error "cannot determine base URL" "sentry"; return 1; }

    local snapshot_payload
    snapshot_payload=$(SENTRY_AUTH_TOKEN="$token" SENTRY_SNAP_ORG="$org" SENTRY_SNAP_BASE="$base_url" python3 -c "
import json, sys, os
from urllib.request import Request, urlopen
from urllib.error import HTTPError
ORG = os.environ['SENTRY_SNAP_ORG']
TOKEN = os.environ.get('SENTRY_AUTH_TOKEN', '')
BASE = os.environ['SENTRY_SNAP_BASE']

def api_get(url):
    req = Request(url, headers={
        'Authorization': 'Bearer ' + TOKEN,
        'Accept': 'application/json',
    })
    try:
        with urlopen(req, timeout=30) as resp:
            return json.loads(resp.read())
    except HTTPError as e:
        body = ''
        try:
            body = e.read().decode('utf-8', errors='replace')
            detail = json.loads(body).get('detail', str(e))
        except Exception:
            detail = body or str(e)
        return {'error': detail, 'status': e.code}
    except Exception as e:
        return {'error': str(e)}

def fetch_paginated(url, max_pages=10):
    all_items = []
    pages = 0
    while url and pages < max_pages:
        req = Request(url, headers={
            'Authorization': 'Bearer ' + TOKEN,
            'Accept': 'application/json',
        })
        try:
            with urlopen(req, timeout=30) as resp:
                data = json.loads(resp.read())
                if isinstance(data, dict) and 'error' in data:
                    return data
                if isinstance(data, list):
                    all_items.extend(data)
                else:
                    return data
                link_header = resp.getheader('Link', '')
                url = None
                for part in link_header.split(','):
                    if 'rel=\"next\"' in part and 'results=\"true\"' in part:
                        # Extract URL between angle brackets
                        if '<' in part and '>' in part:
                            url = part.split('<')[1].split('>')[0].strip()
                        break
                pages += 1
        except HTTPError as e:
            return {'error': str(e), 'status': e.code}
        except Exception as e:
            return {'error': str(e)}
    return all_items

token_valid = True

# --- Projects ---
raw_projects = fetch_paginated(BASE + '/organizations/' + ORG + '/projects/')
if isinstance(raw_projects, dict) and 'error' in raw_projects:
    token_valid = False
    projects = []
    projects_by_platform = {}
else:
    projects = []
    projects_by_platform = {}
    for p in raw_projects:
        platform = p.get('platform') or 'unknown'
        projects_by_platform[platform] = projects_by_platform.get(platform, 0) + 1
        teams = [t.get('slug', '') for t in p.get('teams', [])]
        projects.append({
            'id': p.get('id', ''),
            'slug': p.get('slug', ''),
            'name': p.get('name', ''),
            'platform': platform,
            'status': p.get('status', ''),
            'dateCreated': p.get('dateCreated', ''),
            'firstEvent': p.get('firstEvent'),
            'teams': teams,
        })

# --- Unresolved Issues ---
raw_issues = fetch_paginated(
    BASE + '/organizations/' + ORG + '/issues/?query=is%3Aunresolved&sort=date&limit=100',
    max_pages=3
)
issues = []
issues_by_level = {}
issues_by_project = {}
if isinstance(raw_issues, list):
    for i in raw_issues:
        level = i.get('level', 'unknown')
        issues_by_level[level] = issues_by_level.get(level, 0) + 1
        proj = i.get('project', {}).get('slug', 'unknown')
        issues_by_project[proj] = issues_by_project.get(proj, 0) + 1
        issues.append({
            'id': i.get('id', ''),
            'shortId': i.get('shortId', ''),
            'title': i.get('title', ''),
            'culprit': i.get('culprit', ''),
            'level': level,
            'status': i.get('status', ''),
            'count': i.get('count', ''),
            'userCount': i.get('userCount', 0),
            'firstSeen': i.get('firstSeen', ''),
            'lastSeen': i.get('lastSeen', ''),
            'project': proj,
        })

# --- Alert Rules ---
raw_alerts = api_get(BASE + '/organizations/' + ORG + '/combined-rules/')
alerts = []
if isinstance(raw_alerts, list):
    for r in raw_alerts:
        projs = r.get('projects', [])
        alerts.append({
            'id': r.get('id', ''),
            'name': r.get('name', ''),
            'type': r.get('type', ''),
            'status': r.get('status', ''),
            'projects': projs,
            'dateCreated': r.get('dateCreated', ''),
        })

# --- Releases (last 25) ---
raw_releases = api_get(BASE + '/organizations/' + ORG + '/releases/?per_page=25')
releases = []
if isinstance(raw_releases, list):
    for r in raw_releases:
        projs = [p.get('slug', '') for p in r.get('projects', [])]
        releases.append({
            'version': r.get('version', ''),
            'shortVersion': r.get('shortVersion', ''),
            'dateCreated': r.get('dateCreated', ''),
            'newGroups': r.get('newGroups', 0),
            'projects': projs,
        })

# --- Assemble ---
snapshot = {
    'org': ORG,
    'base_url': BASE,
    'projects': {
        'count': len(projects),
        'by_platform': projects_by_platform,
        'items': projects,
    },
    'issues': {
        'unresolved_count': len(issues),
        'by_level': issues_by_level,
        'by_project': issues_by_project,
        'items': issues,
    },
    'alerts': {
        'count': len(alerts),
        'items': alerts,
    },
    'releases': {
        'count': len(releases),
        'items': releases,
    },
    'token_valid': token_valid,
}

print(json.dumps(snapshot, separators=(',', ':')))
")

    local projects_json issues_json alerts_json releases_json token_valid_json
    projects_json=$(printf '%s' "$snapshot_payload" | python3 -c "import sys,json; print(json.dumps(json.load(sys.stdin)['projects']))")
    issues_json=$(printf '%s' "$snapshot_payload" | python3 -c "import sys,json; print(json.dumps(json.load(sys.stdin)['issues']))")
    alerts_json=$(printf '%s' "$snapshot_payload" | python3 -c "import sys,json; print(json.dumps(json.load(sys.stdin)['alerts']))")
    releases_json=$(printf '%s' "$snapshot_payload" | python3 -c "import sys,json; print(json.dumps(json.load(sys.stdin)['releases']))")
    token_valid_json=$(printf '%s' "$snapshot_payload" | python3 -c "import sys,json; print('true' if json.load(sys.stdin)['token_valid'] else 'false')")

    snapshot_begin "sentry"
    snapshot_field "org" "$org"
    snapshot_field "base_url" "$base_url"
    snapshot_json_field "projects" "$projects_json"
    snapshot_json_field "issues" "$issues_json"
    snapshot_json_field "alerts" "$alerts_json"
    snapshot_json_field "releases" "$releases_json"
    snapshot_bool_field "token_valid" "$token_valid_json"
    snapshot_end
}

