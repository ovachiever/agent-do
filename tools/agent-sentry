        status = r.get('status', '')
        proj_list = r.get('projects', [])
        proj = proj_list[0] if proj_list else ''
    print(fmt.format(
        str(r.get('id', ''))[:8],
        r.get('name', '')[:35],
        rtype[:12],
        str(status)[:15],
        str(proj)[:20],
    ))
"
}

