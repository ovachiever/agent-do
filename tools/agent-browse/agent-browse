#!/usr/bin/env bash
# agent-browse - AI-first browser automation CLI
# Part of the agent-do ecosystem

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DAEMON_DIR="$SCRIPT_DIR"

derive_auto_session() {
    python3 <<'PY'
import os
import re

def sanitize(value: str) -> str:
    value = re.sub(r'[^a-zA-Z0-9._-]+', '-', value).strip('-_.').lower()
    return value[:24]

def compact(value: str) -> str:
    value = re.sub(r'[^a-zA-Z0-9]+', '', value).lower()
    return value[:16]

candidates = [
    ("codex", os.environ.get("CODEX_THREAD_ID")),
    ("claude", os.environ.get("CLAUDE_THREAD_ID")),
    ("claude", os.environ.get("CLAUDE_SESSION_ID")),
    ("claude", os.environ.get("CLAUDE_AGENT_ID")),
]

for prefix, value in candidates:
    if not value:
        continue
    short = compact(value)
    if short:
        print(f"{prefix}-{short}")
        raise SystemExit(0)

tmux_pane = os.environ.get("TMUX_PANE")
if tmux_pane:
    short = sanitize(tmux_pane).lstrip("%")
    if short:
        print(f"tmux-{short}")
        raise SystemExit(0)

print("default")
PY
}

if [[ -n "${AGENT_BROWSER_SESSION:-}" ]]; then
    SESSION="$AGENT_BROWSER_SESSION"
    SESSION_SOURCE="AGENT_BROWSER_SESSION"
else
    SESSION="$(derive_auto_session)"
    SESSION_SOURCE="auto identity/default"
fi
# Note: daemon.js uses os.tmpdir() which on macOS is /var/folders/...
TMPDIR_ACTUAL="$(python3 -c 'import tempfile; print(tempfile.gettempdir())')"
refresh_session_paths() {
    SOCKET_PATH="${TMPDIR_ACTUAL}/agent-browser-${SESSION}.sock"
    PID_FILE="${TMPDIR_ACTUAL}/agent-browser-${SESSION}.pid"
    STREAM_PORT_FILE="${TMPDIR_ACTUAL}/agent-browser-${SESSION}.stream"
    DAEMON_LOG="${TMPDIR_ACTUAL}/agent-browser-${SESSION}.log"
}
refresh_session_paths
PERSISTENT_SESSIONS_DIR="${HOME}/.agent-browse/sessions"

saved_session_path() {
    local name="$1"
    printf '%s/%s' "$PERSISTENT_SESSIONS_DIR" "$name"
}

saved_session_exists() {
    local name="$1"
    [[ -f "$(saved_session_path "$name")/storage.json" ]]
}

agent_scoped_saved_name() {
    local name="$1"
    if [[ "$name" == *@* ]]; then
        printf '%s\n' "$name"
        return 0
    fi
    printf '%s@%s\n' "$name" "$SESSION"
}

resolve_save_target_name() {
    local requested="$1"
    local shared="${2:-false}"

    if [[ "$shared" == "true" ]]; then
        printf '%s\n' "$requested"
        return 0
    fi

    if [[ "$SESSION" == "default" ]]; then
        printf '%s\n' "$requested"
        return 0
    fi

    if [[ "$requested" == *@* ]]; then
        printf '%s\n' "$requested"
        return 0
    fi

    if saved_session_exists "$requested"; then
        agent_scoped_saved_name "$requested"
        return 0
    fi

    printf '%s\n' "$requested"
}

resolve_login_done_save_name() {
    # A human-completed interactive login is the shared credential: it updates
    # the literal name unless --fork explicitly asks for an agent-scoped copy.
    local name="$1" fork="${2:-false}"
    if [[ "$fork" == "true" ]]; then
        resolve_save_target_name "$name" false
    else
        resolve_save_target_name "$name" true
    fi
}

warn_if_forked() {
    local requested="$1" resolved="$2"
    if [[ "$resolved" != "$requested" ]]; then
        echo "warning: saved as '$resolved' — '$requested' already exists and this daemon is agent-scoped; pass --shared to update '$requested' itself" >&2
    fi
}

file_mtime() {
    stat -f %m "$1" 2>/dev/null || stat -c %Y "$1" 2>/dev/null || echo 0
}

warn_fresher_fork() {
    # Loading a canonical name while a newer agent-scoped fork exists usually
    # means a fresh login was forked away; staleness beats name purity.
    local name="$1"
    [[ "$name" == *@* ]] && return 0
    local canonical_mtime=0
    local canonical_path
    canonical_path="$(saved_session_path "$name")/storage.json"
    [[ -f "$canonical_path" ]] && canonical_mtime="$(file_mtime "$canonical_path")"
    local fork newest_fork="" newest_mtime="$canonical_mtime"
    for fork in "$PERSISTENT_SESSIONS_DIR/$name"@*/storage.json; do
        [[ -f "$fork" ]] || continue
        local mtime
        mtime="$(file_mtime "$fork")"
        if (( mtime > newest_mtime )); then
            newest_mtime="$mtime"
            newest_fork="$(basename "$(dirname "$fork")")"
        fi
    done
    if [[ -n "$newest_fork" ]]; then
        echo "warning: '$newest_fork' is newer than '$name' — a fresher login may live there; load it, or promote it: session load $newest_fork && session save $name --shared" >&2
    fi
}

