# ============================================================================
# DAEMON MANAGEMENT
# ============================================================================

is_daemon_running() {
    if [[ ! -f "$PID_FILE" ]]; then
        return 1
    fi
    local pid
    pid=$(cat "$PID_FILE" 2>/dev/null) || { cleanup_session_files; return 1; }
    if ! daemon_identity_matches "$pid"; then
        cleanup_session_files
        return 1
    fi
    return 0
}

cleanup_session_files() {
    rm -f "$SOCKET_PATH" "$PID_FILE" "$STREAM_PORT_FILE" "$DAEMON_LOG"
}

daemon_identity_matches() {
    local pid="${1:-}"
    [[ "$pid" =~ ^[0-9]+$ ]] || return 1
    kill -0 "$pid" 2>/dev/null || return 1
    local command
    command=$(ps -p "$pid" -o command= 2>/dev/null) || return 1
    _BROWSE_DAEMON_COMMAND="$command" \
    _BROWSE_DAEMON_SESSION="$SESSION" \
    _BROWSE_DAEMON_SOCKET="$SOCKET_PATH" \
    python3 <<'PYEOF' >/dev/null 2>&1
import os
import shlex
import sys
from pathlib import Path

try:
    argv = shlex.split(os.environ["_BROWSE_DAEMON_COMMAND"])
except ValueError:
    raise SystemExit(1)

def has_pair(flag, value):
    return any(argv[index:index + 2] == [flag, value] for index in range(len(argv) - 1))

is_daemon = any(Path(arg).name == "daemon.js" for arg in argv)
ok = (
    is_daemon
    and has_pair("--session", os.environ["_BROWSE_DAEMON_SESSION"])
    and has_pair("--socket", os.environ["_BROWSE_DAEMON_SOCKET"])
)
sys.exit(0 if ok else 1)
PYEOF
}

signal_daemon() {
    local pid="$1"
    local signal_name="$2"
    daemon_identity_matches "$pid" || return 1
    kill -"$signal_name" "$pid" 2>/dev/null
}

raw_socket_command() {
    local json="$1"
    local timeout="${2:-1}"
    [[ -S "$SOCKET_PATH" ]] || return 1
    _BROWSE_CMD="$json" _BROWSE_SOCK="$SOCKET_PATH" _BROWSE_TIMEOUT="$timeout" python3 <<'PYEOF'
import json, os, socket, sys

msg = os.environ["_BROWSE_CMD"].encode("utf-8") + b"\n"
s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
s.settimeout(float(os.environ["_BROWSE_TIMEOUT"]))
try:
    s.connect(os.environ["_BROWSE_SOCK"])
    s.sendall(msg)
    raw = b""
    while True:
        chunk = s.recv(4096)
        if not chunk:
            break
        raw += chunk
        if b"\n" in raw:
            break
    resp = json.loads(raw.decode("utf-8").strip())
    print(json.dumps(resp, separators=(",", ":")))
    sys.exit(0 if resp.get("success") else 1)
except Exception:
    sys.exit(1)
finally:
    try:
        s.close()
    except Exception:
        pass
PYEOF
}

daemon_ping() {
    local response
    response=$(raw_socket_command '{"id":"ping","action":"ping"}' "${AGENT_BROWSER_PING_TIMEOUT:-1}") || return 1
    _BROWSE_PING="$response" _BROWSE_SESSION="$SESSION" python3 <<'PYEOF' >/dev/null 2>&1
import json
import os
import sys

try:
    payload = json.loads(os.environ["_BROWSE_PING"])
except (KeyError, json.JSONDecodeError):
    raise SystemExit(1)
sys.exit(0 if payload.get("success") is True and payload.get("session") == os.environ["_BROWSE_SESSION"] else 1)
PYEOF
    echo "$response"
}

daemon_page_responsive() {
    local response
    response=$(daemon_ping) || return 1
    _BROWSE_PING="$response" python3 -c 'import json, os, sys; sys.exit(0 if int(json.loads(os.environ["_BROWSE_PING"]).get("children", 0)) > 0 else 1)'
}

require_responsive_daemon() {
    # Emit a structured "no responsive daemon" error and exit when no live
    # browser is reachable within a few seconds. $1 = output format (text|json).
    local fmt="${1:-text}"
    if daemon_page_responsive; then
        return 0
    fi
    local msg="No responsive agent-browser daemon for session '$SESSION'. Start: agent-do browse open <url>"
    if [[ "$fmt" == "json" ]]; then
        _BROWSE_MSG="$msg" python3 -c 'import json, os; print(json.dumps({"success": False, "error": os.environ["_BROWSE_MSG"], "action_required": "START_BROWSER"}))'
    else
        echo "Error: $msg" >&2
    fi
    exit 1
}

start_daemon() {
    if is_daemon_running; then
        if [[ -S "$SOCKET_PATH" ]]; then
            return 0
        fi
        stop_daemon
    fi

    cleanup_session_files
    
    # Start daemon in background (disown so parent bash can exit cleanly)
    AGENT_BROWSER_SESSION="$SESSION" \
    AGENT_BROWSER_HEADED="${AGENT_BROWSER_HEADED:-0}" \
    node "$DAEMON_DIR/daemon.js" --session "$SESSION" --socket "$SOCKET_PATH" \
        </dev/null >>"$DAEMON_LOG" 2>&1 &

    local daemon_pid=$!
    disown "$daemon_pid" 2>/dev/null
    echo "$daemon_pid" > "$PID_FILE"
    
    # Wait for socket to appear
    local attempts=0
    while [[ ! -S "$SOCKET_PATH" ]] && [[ $attempts -lt 50 ]]; do
        sleep 0.1
        attempts=$((attempts + 1))
        # Check if daemon died
        if ! kill -0 "$daemon_pid" 2>/dev/null; then
            echo "Error: Daemon failed to start" >&2
            tail -n 20 "$DAEMON_LOG" >&2 2>/dev/null || true
            rm -f "$PID_FILE"
            return 1
        fi
    done
    
    if [[ ! -S "$SOCKET_PATH" ]]; then
        echo "Error: Daemon socket not created" >&2
        tail -n 20 "$DAEMON_LOG" >&2 2>/dev/null || true
        signal_daemon "$daemon_pid" TERM 2>/dev/null || true
        cleanup_session_files
        return 1
    fi
}

stop_daemon() {
    if [[ -f "$PID_FILE" ]]; then
        local pid
        pid=$(cat "$PID_FILE" 2>/dev/null) || true
        if [[ -n "$pid" ]] && daemon_identity_matches "$pid"; then
            signal_daemon "$pid" TERM 2>/dev/null || true
            local attempts=0
            while kill -0 "$pid" 2>/dev/null && [[ $attempts -lt 20 ]]; do
                sleep 0.1
                attempts=$((attempts + 1))
            done
            if kill -0 "$pid" 2>/dev/null; then
                signal_daemon "$pid" KILL 2>/dev/null || true
            fi
        fi
    fi
    cleanup_session_files
}

preflight_daemon() {
    if ! is_daemon_running; then
        start_daemon
        return
    fi
    if [[ ! -S "$SOCKET_PATH" ]]; then
        stop_daemon
        start_daemon
        return
    fi
    if daemon_ping >/dev/null; then
        return
    fi

    stop_daemon
    start_daemon
    echo "agent-browse: daemon for session '$SESSION' was wedged — auto-restarted (saved sessions persist on disk)" >&2
}

daemon_doctor() {
    local pid="" pid_present=false pid_alive=false identity_verified=false socket_present=false
    local pingable=false children=0 uptime_s=0 state diagnosis ping_response=""

    if [[ -f "$PID_FILE" ]]; then
        pid_present=true
        pid=$(cat "$PID_FILE" 2>/dev/null) || pid=""
    fi
    if [[ "$pid" =~ ^[0-9]+$ ]] && kill -0 "$pid" 2>/dev/null; then
        pid_alive=true
        if daemon_identity_matches "$pid"; then
            identity_verified=true
        fi
    fi
    [[ -S "$SOCKET_PATH" ]] && socket_present=true

    if [[ "$identity_verified" == "true" && "$socket_present" == "true" ]]; then
        if ping_response=$(daemon_ping); then
            pingable=true
            read -r children uptime_s < <(
                _BROWSE_PING="$ping_response" python3 -c 'import json, os; p=json.loads(os.environ["_BROWSE_PING"]); print(int(p.get("children", 0)), int(p.get("uptime_s", 0)))'
            )
        fi
    fi

    if [[ "$pid_present" == "false" ]]; then
        state="cold"
        diagnosis="No daemon pid file; the next browser command will cold-start this session."
    elif [[ ! "$pid" =~ ^[0-9]+$ ]]; then
        state="invalid-pid"
        diagnosis="The session pid file is invalid and will be cleaned on the next browser command."
    elif [[ "$pid_alive" == "false" ]]; then
        state="stale-pid"
        diagnosis="The recorded process is dead; this session will clean its files and cold-start."
    elif [[ "$identity_verified" == "false" ]]; then
        state="identity-mismatch"
        diagnosis="The pid belongs to another process; it will not be signaled. Only this session's files will be cleaned."
    elif [[ "$socket_present" == "false" ]]; then
        state="socket-missing"
        diagnosis="The verified daemon has no session socket and will be restarted."
    elif [[ "$pingable" == "false" ]]; then
        state="wedged"
        diagnosis="The verified daemon is not answering ping and will self-heal before the next browser command."
    elif [[ "$children" -eq 0 ]]; then
        state="healthy-idle"
        diagnosis="The daemon is healthy and idle; ping did not launch a browser page."
    else
        state="healthy"
        diagnosis="The daemon and browser page are responsive."
    fi

    _BROWSE_SESSION="$SESSION" \
    _BROWSE_SESSION_SOURCE="$SESSION_SOURCE" \
    _BROWSE_PID="$pid" \
    _BROWSE_PID_FILE="$PID_FILE" \
    _BROWSE_PID_PRESENT="$pid_present" \
    _BROWSE_PID_ALIVE="$pid_alive" \
    _BROWSE_IDENTITY="$identity_verified" \
    _BROWSE_SOCKET="$SOCKET_PATH" \
    _BROWSE_DAEMON_LOG="$DAEMON_LOG" \
    _BROWSE_SOCKET_PRESENT="$socket_present" \
    _BROWSE_PINGABLE="$pingable" \
    _BROWSE_CHILDREN="$children" \
    _BROWSE_UPTIME="$uptime_s" \
    _BROWSE_STATE="$state" \
    _BROWSE_DIAGNOSIS="$diagnosis" \
    python3 <<'PYEOF'
import json
import os

truth = lambda name: os.environ[name] == "true"
pid_text = os.environ["_BROWSE_PID"]
payload = {
    "success": True,
    "session": {
        "name": os.environ["_BROWSE_SESSION"],
        "derivation": os.environ["_BROWSE_SESSION_SOURCE"],
    },
    "pid": {
        "file": os.environ["_BROWSE_PID_FILE"],
        "present": truth("_BROWSE_PID_PRESENT"),
        "value": int(pid_text) if pid_text.isdigit() else None,
        "alive": truth("_BROWSE_PID_ALIVE"),
        "identity_verified": truth("_BROWSE_IDENTITY"),
    },
    "socket": {
        "path": os.environ["_BROWSE_SOCKET"],
        "present": truth("_BROWSE_SOCKET_PRESENT"),
    },
    "daemon": {
        "running": truth("_BROWSE_PID_ALIVE") and truth("_BROWSE_IDENTITY"),
        "pingable": truth("_BROWSE_PINGABLE"),
        "children": int(os.environ["_BROWSE_CHILDREN"]),
        "uptime_s": int(os.environ["_BROWSE_UPTIME"]),
        "log": os.environ["_BROWSE_DAEMON_LOG"],
    },
    "browser": {
        "responsive": truth("_BROWSE_PINGABLE") and int(os.environ["_BROWSE_CHILDREN"]) > 0,
    },
    "state": os.environ["_BROWSE_STATE"],
    "diagnosis": os.environ["_BROWSE_DIAGNOSIS"],
}
print(json.dumps(payload, indent=2))
PYEOF
}

send_command() {
    local json="$1"
    local timeout="${2:-60}"
    
    # Ensure daemon is running
    start_daemon || return 1
    
    # Send command via python for reliable bidirectional socket communication
    # JSON payload passed via env var to avoid quoting conflicts in Python source
    local response
    response=$(_BROWSE_CMD="$json" _BROWSE_SOCK="$SOCKET_PATH" _BROWSE_TIMEOUT="$timeout" python3 << 'PYEOF'
import socket, sys, os

payload = os.environ['_BROWSE_CMD'] + '\n'
sock_path = os.environ['_BROWSE_SOCK']
timeout = int(os.environ['_BROWSE_TIMEOUT'])

sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
try:
    sock.connect(sock_path)
    sock.settimeout(timeout)
    sock.sendall(payload.encode('utf-8'))

    response = b""
    while True:
        try:
            chunk = sock.recv(4096)
            if not chunk:
                break
            response += chunk
            if b"\n" in response:
                break
        except socket.timeout:
            print('{"success":false,"error":"Command timed out","partial":true}')
            sys.exit(0)

    print(response.decode().strip())
except Exception as e:
    import json
    print(json.dumps({"success": False, "error": str(e)}), file=sys.stderr)
    sys.exit(1)
finally:
    sock.close()
PYEOF
    ) || {
        echo "Error: Failed to communicate with daemon" >&2
        return 1
    }
    
    echo "$response"
}

# ============================================================================
# COMMAND BUILDERS
# ============================================================================

cmd_id() {
    echo "cmd-$(date +%s%N)"
}

build_launch_cmd() {
    local headless="true"
    [[ "${AGENT_BROWSER_HEADED:-0}" == "1" ]] && headless="false"
    
    cat << EOF
{"id":"$(cmd_id)","action":"launch","headless":$headless}
EOF
}

build_navigate_cmd() {
    local url="$1"
    cat << EOF
{"id":"$(cmd_id)","action":"navigate","url":"$url"}
EOF
}

build_click_cmd() {
    local selector="$1"
    cat << EOF
{"id":"$(cmd_id)","action":"click","selector":"$selector"}
EOF
}

build_fill_cmd() {
    local selector="$1"
    local value="$2"
    # Escape quotes in value
    value="${value//\"/\\\"}"
    cat << EOF
{"id":"$(cmd_id)","action":"fill","selector":"$selector","value":"$value"}
EOF
}

build_type_cmd() {
    local selector="$1"
    local text="$2"
    text="${text//\"/\\\"}"
    cat << EOF
{"id":"$(cmd_id)","action":"type","selector":"$selector","text":"$text"}
EOF
}

build_press_cmd() {
    local key="$1"
    cat << EOF
{"id":"$(cmd_id)","action":"press","key":"$key"}
EOF
}

build_screenshot_cmd() {
    local path="${1:-}"
    local full="${2:-false}"
    if [[ -n "$path" ]]; then
        cat << EOF
{"id":"$(cmd_id)","action":"screenshot","path":"$path","fullPage":$full}
EOF
    else
        cat << EOF
{"id":"$(cmd_id)","action":"screenshot","fullPage":$full}
EOF
    fi
}

build_snapshot_cmd() {
    local interactive="${1:-false}"
    local compact="${2:-false}"
    local depth="${3:-}"
    local selector="${4:-}"
    local format="${5:-}"
    local with_boxes="${6:-false}"
    
    local opts=""
    [[ "$interactive" == "true" ]] && opts="$opts,\"interactive\":true"
    [[ "$compact" == "true" ]] && opts="$opts,\"compact\":true"
    [[ -n "$depth" ]] && opts="$opts,\"maxDepth\":$depth"
    [[ -n "$selector" ]] && opts="$opts,\"selector\":\"$selector\""
    [[ -n "$format" ]] && opts="$opts,\"format\":\"$format\""
    [[ "$with_boxes" == "true" ]] && opts="$opts,\"withBoxes\":true"
    
    # Remove leading comma
    opts="${opts#,}"
    
    if [[ -n "$opts" ]]; then
        cat << EOF
{"id":"$(cmd_id)","action":"snapshot",$opts}
EOF
    else
        cat << EOF
{"id":"$(cmd_id)","action":"snapshot"}
EOF
    fi
}

build_wait_cmd() {
    python3 - "$(cmd_id)" "$@" <<'PYEOF'
import json
import sys

args = sys.argv[2:]
command = {"id": sys.argv[1], "action": "wait"}
try:
    target = args.pop(0)
    if target in ("--text", "--url", "--fn"):
        value = args.pop(0)
        if not value:
            raise ValueError("wait condition must not be empty")
        if target == "--fn":
            command.update(action="waitforfunction", expression=value)
        else:
            command[target[2:]] = value
    elif target in ("--stable", "--load"):
        command["state"] = "networkidle"
    elif target.isascii() and target.isdigit():
        if int(target) <= 0:
            raise ValueError("wait duration must be positive")
        command["timeout"] = int(target)
    elif target.startswith("--") or not target:
        raise ValueError("unknown or empty wait condition")
    else:
        command["selector"] = target
    if args:
        if len(args) != 2 or args[0] != "--timeout-ms" or "timeout" in command:
            raise ValueError("expected --timeout-ms <positive integer> after a condition")
        timeout = int(args[1])
        if timeout <= 0:
            raise ValueError("wait timeout must be positive")
        command["timeout"] = timeout
except (IndexError, ValueError) as error:
    print("Usage: agent-browse wait <selector|ms|--text text|--fn expression|--url pattern|--stable> [--timeout-ms ms]: " + str(error), file=sys.stderr)
    sys.exit(1)
print(json.dumps(command))
PYEOF
}

build_eval_cmd() {
    local script="$1"
    # Escape for JSON
    script="${script//\\/\\\\}"
    script="${script//\"/\\\"}"
    script="${script//$'\n'/\\n}"
    cat << EOF
{"id":"$(cmd_id)","action":"evaluate","script":"$script"}
EOF
}

build_clipboard_cmd() {
    local operation="$1"
    cat << EOF
{"id":"$(cmd_id)","action":"clipboard","operation":"$operation"}
EOF
}

build_get_cmd() {
    local what="$1"
    local selector="${2:-}"
    local extra="${3:-}"
    
    case "$what" in
        text)
            cat << EOF
{"id":"$(cmd_id)","action":"gettext","selector":"$selector"}
EOF
            ;;
        html)
            cat << EOF
{"id":"$(cmd_id)","action":"innerhtml","selector":"$selector"}
EOF
            ;;
        value)
            cat << EOF
{"id":"$(cmd_id)","action":"inputvalue","selector":"$selector"}
EOF
            ;;
        attr)
            cat << EOF
{"id":"$(cmd_id)","action":"getattribute","selector":"$extra","attribute":"$selector"}
EOF
            ;;
        title)
            cat << EOF
{"id":"$(cmd_id)","action":"title"}
EOF
            ;;
        url)
            cat << EOF
{"id":"$(cmd_id)","action":"url"}
EOF
            ;;
        count)
            cat << EOF
{"id":"$(cmd_id)","action":"count","selector":"$selector"}
EOF
            ;;
        options)
            # Get options from a select/combobox - selector is optional
            cat << EOF
{"id":"$(cmd_id)","action":"getoptions","selector":"$selector"}
EOF
            ;;
        *)
            echo "Error: Unknown get target: $what" >&2
            return 1
            ;;
    esac
}

build_close_cmd() {
    cat << EOF
{"id":"$(cmd_id)","action":"close"}
EOF
}

build_hover_cmd() {
    local selector="$1"
    cat << EOF
{"id":"$(cmd_id)","action":"hover","selector":"$selector"}
EOF
}

build_focus_cmd() {
    local selector="$1"
    cat << EOF
{"id":"$(cmd_id)","action":"focus","selector":"$selector"}
EOF
}

# ============================================================================
# RESPONSE PARSING
# ============================================================================

# Map error messages to specific exit codes for AI
# 0=success, 1=general, 2=user input needed, 3=browser crashed, 4=network, 5=ref collision, 6=stale refs, 7=not found, 8=timeout
error_to_exit_code() {
    local error="$1"
    case "$error" in
        *"Browser not launched"*|*"crashed"*) echo 3 ;;
        *"ERR_NAME_NOT_RESOLVED"*|*"net::"*|*"network"*) echo 4 ;;
        *"matched"*"elements"*) echo 5 ;;
        *"re-snapshot"*|*"stale"*) echo 6 ;;
        *"not found"*|*"not visible"*) echo 7 ;;
        *"Timeout"*|*"timeout"*) echo 8 ;;
        *) echo 1 ;;
    esac
}

parse_response() {
    local response="$1"
    local format="${2:-text}"
    
    # Check for error
    if echo "$response" | grep -q '"success":false'; then
        local error
        error=$(echo "$response" | python3 -c "import sys,json; r=json.load(sys.stdin); print(r.get('error','Unknown error'))" 2>/dev/null || echo "Unknown error")
        echo "Error: $error" >&2
        return $(error_to_exit_code "$error")
    fi
    
    # Extract result
    if [[ "$format" == "json" ]]; then
        echo "$response"
    else
        # Try to extract meaningful data from result
        local result
        result=$(echo "$response" | python3 -c "
import sys, json
try:
    r = json.load(sys.stdin)
    res = r.get('result', r)
    if isinstance(res, str):
        print(res)
    elif isinstance(res, dict):
        if 'tree' in res:
            print(res['tree'])
        elif 'path' in res:
            print(res['path'])
        elif 'value' in res:
            print(res['value'])
        elif 'text' in res:
            print(res['text'])
        elif 'url' in res:
            print(res['url'])
        elif 'title' in res:
            print(res['title'])
        else:
            print(json.dumps(res, indent=2))
    elif res is None:
        pass  # Silent success
    else:
        print(res)
except:
    print(sys.stdin.read())
" 2>/dev/null) || result="$response"
        echo "$result"
    fi
}

# ============================================================================
# MAIN COMMAND DISPATCH
# ============================================================================

main() {
    local output_format="text"
    local headed=false
    local debug=false
    local cmd_timeout=60
    
    # Parse global options
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --help|-h)
                show_help
                exit 0
                ;;
            --session)
                SESSION="$2"
                SESSION_SOURCE="--session"
                refresh_session_paths
                shift 2
                ;;
            --headed)
                export AGENT_BROWSER_HEADED=1
                shift
                ;;
            --json)
                output_format="json"
                shift
                ;;
            --debug)
                debug=true
                shift
                ;;
            --timeout)
                cmd_timeout="$2"
                shift 2
                ;;
            *)
                break
                ;;
        esac
    done
    
    if [[ $# -eq 0 ]]; then
        show_help
        exit 0
    fi
    
    local cmd="$1"
    shift

    case "$cmd" in
        open|back|forward|reload|click|dblclick|fill|type|press|hover|focus|check|uncheck|select|upload|snapshot|get|clipboard|wait|screenshot|pdf|eval|login|tab|network|vision|agent|capture|is|console|errors|highlight|viewport)
            preflight_daemon
            ;;
        auth)
            case "${1:-}" in
                check-creds|get-creds|store-creds) ;;
                *) preflight_daemon ;;
            esac
            ;;
        *) ;;
    esac
    
    local json response
    
    case "$cmd" in
        # Browser lifecycle
        launch)
            # Accept --headed as positional flag too (global --headed also works)
            if [[ "${1:-}" == "--headed" ]]; then
                export AGENT_BROWSER_HEADED=1
                shift
            fi
            json=$(build_launch_cmd)
            ;;
        # Navigation
        open)
            [[ $# -lt 1 ]] && { echo "Usage: agent-browse open <url>" >&2; exit 1; }
            json=$(build_navigate_cmd "$1")
            ;;
        back)
            json='{"id":"'$(cmd_id)'","action":"back"}'
            ;;
        forward)
            json='{"id":"'$(cmd_id)'","action":"forward"}'
            ;;
        reload)
            json='{"id":"'$(cmd_id)'","action":"reload"}'
            ;;
            
        # Interaction
        click)
            [[ $# -lt 1 ]] && { echo "Usage: agent-browse click <selector>" >&2; exit 1; }
            json=$(build_click_cmd "$1")
            ;;
        dblclick)
            [[ $# -lt 1 ]] && { echo "Usage: agent-browse dblclick <selector>" >&2; exit 1; }
            json='{"id":"'$(cmd_id)'","action":"dblclick","selector":"'"$1"'"}'
            ;;
        fill)
            [[ $# -lt 2 ]] && { echo "Usage: agent-browse fill <selector> <text>" >&2; exit 1; }
            json=$(build_fill_cmd "$1" "$2")
            ;;
        type)
            [[ $# -lt 2 ]] && { echo "Usage: agent-browse type <selector> <text>" >&2; exit 1; }
            json=$(build_type_cmd "$1" "$2")
            ;;
        press)
            [[ $# -lt 1 ]] && { echo "Usage: agent-browse press <key>" >&2; exit 1; }
            json=$(build_press_cmd "$1")
            ;;
        hover)
            [[ $# -lt 1 ]] && { echo "Usage: agent-browse hover <selector>" >&2; exit 1; }
            json=$(build_hover_cmd "$1")
            ;;
        focus)
            [[ $# -lt 1 ]] && { echo "Usage: agent-browse focus <selector>" >&2; exit 1; }
            json=$(build_focus_cmd "$1")
            ;;
        check)
            [[ $# -lt 1 ]] && { echo "Usage: agent-browse check <selector>" >&2; exit 1; }
            json='{"id":"'$(cmd_id)'","action":"check","selector":"'"$1"'"}'
            ;;
        uncheck)
            [[ $# -lt 1 ]] && { echo "Usage: agent-browse uncheck <selector>" >&2; exit 1; }
            json='{"id":"'$(cmd_id)'","action":"uncheck","selector":"'"$1"'"}'
            ;;
        select)
            [[ $# -lt 2 ]] && { echo "Usage: agent-browse select <selector> <value>" >&2; exit 1; }
            json='{"id":"'$(cmd_id)'","action":"select","selector":"'"$1"'","values":["'"$2"'"]}'
            ;;
        upload)
            [[ $# -lt 2 ]] && { echo "Usage: agent-browse upload <selector> <file>" >&2; exit 1; }
            json='{"id":"'$(cmd_id)'","action":"upload","selector":"'"$1"'","files":["'"$2"'"]}'
            ;;
            
        # Reading
        snapshot)
            local interactive=false compact=false depth="" selector="" format="" with_boxes=false
            while [[ $# -gt 0 ]]; do
                case "$1" in
                    -i|--interactive) interactive=true; shift ;;
                    -c|--compact) compact=true; shift ;;
                    -d|--depth) depth="$2"; shift 2 ;;
                    -s|--selector) selector="$2"; shift 2 ;;
                    --format) format="$2"; shift 2 ;;
                    --boxes|-b) with_boxes=true; shift ;;
                    --json) format="json"; shift ;;
                    --csv) format="csv"; shift ;;
                    --markdown|--md) format="markdown"; shift ;;
                    *) shift ;;
                esac
            done
            json=$(build_snapshot_cmd "$interactive" "$compact" "$depth" "$selector" "$format" "$with_boxes")
            ;;
        get)
            [[ $# -lt 1 ]] && { echo "Usage: agent-browse get <what> [selector]" >&2; exit 1; }
            json=$(build_get_cmd "$@")
            ;;
        clipboard)
            [[ $# -lt 1 ]] && { echo "Usage: agent-browse clipboard <read|copy|paste>" >&2; exit 1; }
            local clip_op="$1"; shift
            # Global option parsing only catches flags before the verb; honor a
            # trailing --json so `clipboard read --json` emits JSON, not text.
            while [[ $# -gt 0 ]]; do
                case "$1" in
                    --json) output_format="json"; shift ;;
                    *) shift ;;
                esac
            done
            case "$clip_op" in
                read|copy|paste)
                    # Clipboard is page-scoped. With no live browser the daemon
                    # auto-launches a blank page and navigator.clipboard.readText()
                    # never returns. Fail fast with a structured error instead.
                    require_responsive_daemon "$output_format"
                    json=$(build_clipboard_cmd "$clip_op")
                    ;;
                *)
                    echo "Usage: agent-browse clipboard <read|copy|paste>" >&2
                    exit 1
                    ;;
            esac
            ;;
            
        # Waiting
        wait)
            json=$(build_wait_cmd "$@") || return 1
            ;;
            
        # Screenshots
        screenshot)
            local path="" full=false
            while [[ $# -gt 0 ]]; do
                case "$1" in
                    --full|-f) full=true; shift ;;
                    --json) output_format="json"; shift ;;
                    *) path="$1"; shift ;;
                esac
            done
            json=$(build_screenshot_cmd "$path" "$full")
            ;;
        pdf)
            [[ $# -lt 1 ]] && { echo "Usage: agent-browse pdf <path>" >&2; exit 1; }
            json='{"id":"'$(cmd_id)'","action":"pdf","path":"'"$1"'"}'
            ;;
            
        # Evaluate
        eval)
            [[ $# -lt 1 ]] && { echo "Usage: agent-browse eval <javascript>" >&2; exit 1; }
            json=$(build_eval_cmd "$1")
            ;;
            
        # Login: headed browser for manual SSO/MFA, then handoff to headless
        login)
            if [[ $# -eq 0 ]]; then
                echo "Usage: agent-browse login <url> | done [--save <name>] | status | cancel" >&2
                exit 1
            fi
            case "$1" in
                done)
                    shift
                    local save_name=""
                    local fork_save=false
                    while [[ $# -gt 0 ]]; do
                        case "$1" in
                            --save) save_name="$2"; shift 2 ;;
                            --shared) fork_save=false; shift ;;
                            --fork) fork_save=true; shift ;;
                            *) shift ;;
                        esac
                    done
                    if [[ -n "$save_name" ]]; then
                        local requested_save="$save_name"
                        save_name="$(resolve_login_done_save_name "$save_name" "$fork_save")"
                        warn_if_forked "$requested_save" "$save_name"
                        json='{"id":"'$(cmd_id)'","action":"login_done","save":"'"$save_name"'"}'
                    else
                        json='{"id":"'$(cmd_id)'","action":"login_done"}'
                    fi
                    ;;
                status)
                    json='{"id":"'$(cmd_id)'","action":"login_status"}'
                    ;;
                cancel)
                    json='{"id":"'$(cmd_id)'","action":"login_cancel"}'
                    ;;
                *)
                    # Treat as URL
                    json='{"id":"'$(cmd_id)'","action":"login_start","url":"'"$1"'"}'
                    ;;
            esac
            ;;

        # Session/tabs
        session)
            if [[ $# -eq 0 ]]; then
                echo "Session: $SESSION"
                exit 0
            fi
            case "$1" in
                list)
                    # List saved sessions (persistent) 
                    json='{"id":"'$(cmd_id)'","action":"session_list"}'
                    ;;
                save)
                    [[ $# -lt 2 ]] && { echo "Usage: agent-browse session save <name> [description]" >&2; exit 1; }
                    local name="$2"
                    shift 2
                    local shared_save=false
                    local desc=""
                    while [[ $# -gt 0 ]]; do
                        case "$1" in
                            --shared) shared_save=true; shift ;;
                            *)
                                if [[ -z "$desc" ]]; then
                                    desc="$1"
                                else
                                    desc="$desc $1"
                                fi
                                shift
                                ;;
                        esac
                    done
                    local requested_name="$name"
                    name="$(resolve_save_target_name "$name" "$shared_save")"
                    warn_if_forked "$requested_name" "$name"
                    if [[ -n "$desc" ]]; then
                        json='{"id":"'$(cmd_id)'","action":"session_save","name":"'"$name"'","description":"'"$desc"'"}'
                    else
                        json='{"id":"'$(cmd_id)'","action":"session_save","name":"'"$name"'"}'
                    fi
                    ;;
                load)
                    [[ $# -lt 2 ]] && { echo "Usage: agent-browse session load <name>" >&2; exit 1; }
                    warn_fresher_fork "$2"
                    json='{"id":"'$(cmd_id)'","action":"session_load","name":"'"$2"'"}'
                    ;;
                delete)
                    [[ $# -lt 2 ]] && { echo "Usage: agent-browse session delete <name>" >&2; exit 1; }
                    json='{"id":"'$(cmd_id)'","action":"session_delete","name":"'"$2"'"}'
                    ;;
                export)
                    [[ $# -lt 3 ]] && { echo "Usage: agent-browse session export <name> <file>" >&2; exit 1; }
                    node "$DAEMON_DIR/session-cli.js" export "$2" "$3"
                    exit $?
                    ;;
                verify)
                    [[ $# -lt 2 ]] && { echo "Usage: agent-browse session verify <name> [--site youtube]" >&2; exit 2; }
                    local verify_name="$2" verify_site="youtube"
                    shift 2
                    if [[ $# -gt 0 ]]; then
                        [[ $# -eq 2 && "$1" == "--site" ]] || { echo "Usage: agent-browse session verify <name> [--site youtube]" >&2; exit 2; }
                        verify_site="$2"
                    fi
                    node "$DAEMON_DIR/session-cli.js" verify "$verify_name" "$verify_site"
                    exit $?
                    ;;
                import)
                    [[ $# -lt 2 ]] && { echo "Usage: agent-browse session import <file> [name]" >&2; exit 1; }
                    local file="$2"
                    local name="${3:-}"
                    if [[ -n "$name" ]]; then
                        json='{"id":"'$(cmd_id)'","action":"session_import","path":"'"$file"'","name":"'"$name"'"}'
                    else
                        json='{"id":"'$(cmd_id)'","action":"session_import","path":"'"$file"'"}'
                    fi
                    ;;
                import-browser)
                    # Extract cookies and browser storage from a real browser and create a browse session
                    # Usage: session import-browser <name> [--browser comet|atlas|chrome|arc|edge|brave] [--domain ".google.com"]
                    local sess_name="${2:-}"
                    [[ -z "$sess_name" ]] && { echo "Usage: agent-browse session import-browser <name> [--browser comet|atlas|chrome|arc|edge|brave] [--domain .example.com]" >&2; exit 1; }
                    shift 2
                    local browser_type="comet" domain_filter=""
                    while [[ $# -gt 0 ]]; do
                        case "$1" in
                            --browser) browser_type="$2"; shift 2 ;;
                            --domain) domain_filter="$2"; shift 2 ;;
                            *) shift ;;
                        esac
                    done

                    import_cmd=(python3 "$DAEMON_DIR/import_browser.py" --session "$sess_name" --browser "$browser_type")
                    if [[ -n "$domain_filter" ]]; then
                        import_cmd+=(--domain "$domain_filter")
                    fi
                    "${import_cmd[@]}"
                    exit $?
                    ;;
                active)
                    # List active daemon sessions
                    ls "${TMPDIR_ACTUAL}"/agent-browser-*.sock 2>/dev/null | sed "s|${TMPDIR_ACTUAL}/agent-browser-||;s|\.sock||" || echo "(none)"
                    exit 0
                    ;;
                *)
                    echo "Unknown session command: $1" >&2
                    echo "Usage: session list|save|load|delete|export|verify|import|import-browser|active" >&2
                    exit 1
                    ;;
            esac
            ;;
        tab)
            if [[ $# -eq 0 ]]; then
                json='{"id":"'$(cmd_id)'","action":"tab","subAction":"current"}'
            else
                case "$1" in
                    list) json='{"id":"'$(cmd_id)'","action":"tab","subAction":"list"}' ;;
                    new) json='{"id":"'$(cmd_id)'","action":"tab","subAction":"new","url":"'"${2:-about:blank}"'"}' ;;
                    close) json='{"id":"'$(cmd_id)'","action":"tab","subAction":"close"}' ;;
                    [0-9]*) json='{"id":"'$(cmd_id)'","action":"tab","subAction":"switch","index":'"$1"'}' ;;
                    *) echo "Unknown tab command: $1" >&2; exit 1 ;;
                esac
            fi
            ;;
            
        # Network commands
        network)
            [[ $# -eq 0 ]] && { echo "Usage: agent-browse network <requests|route|unroute|har|stats|throttle>" >&2; exit 1; }
            local subcmd="$1"; shift
            case "$subcmd" in
                requests)
                    local filter=""
                    [[ -n "${1:-}" && "$1" != "--"* ]] && filter="$1"
                    json='{"id":"'$(cmd_id)'","action":"requests"'
                    [[ -n "$filter" ]] && json="$json,\"filter\":\"$filter\""
                    json="$json}"
                    ;;
                route)
                    [[ $# -lt 1 ]] && { echo "Usage: network route <url> [--abort|--body <json>]" >&2; exit 1; }
                    local url="$1"; shift
                    json='{"id":"'$(cmd_id)'","action":"route","url":"'"$url"'"'
                    while [[ $# -gt 0 ]]; do
                        case "$1" in
                            --abort) json="$json,\"abort\":true"; shift ;;
                            --body) json="$json,\"response\":{\"body\":$2}"; shift 2 ;;
                            *) shift ;;
                        esac
                    done
                    json="$json}"
                    ;;
                unroute)
                    json='{"id":"'$(cmd_id)'","action":"unroute"'
                    [[ -n "${1:-}" ]] && json="$json,\"url\":\"$1\""
                    json="$json}"
                    ;;
                har)
                    [[ $# -lt 1 ]] && { echo "Usage: network har <start|stop <path>>" >&2; exit 1; }
                    case "$1" in
                        start)
                            json='{"id":"'$(cmd_id)'","action":"har_start"}'
                            ;;
                        stop)
                            [[ $# -lt 2 ]] && { echo "Usage: network har stop <path>" >&2; exit 1; }
                            json='{"id":"'$(cmd_id)'","action":"har_stop","path":"'"$2"'"}'
                            ;;
                        *)
                            echo "Unknown har command: $1" >&2; exit 1
                            ;;
                    esac
                    ;;
                stats)
                    json='{"id":"'$(cmd_id)'","action":"network_stats"}'
                    ;;
                throttle)
                    if [[ $# -eq 0 ]]; then
                        json='{"id":"'$(cmd_id)'","action":"throttle"}'
                    elif [[ "$1" == "--latency" || "$1" == "--download" || "$1" == "--upload" ]]; then
                        json='{"id":"'$(cmd_id)'","action":"throttle"'
                        while [[ $# -gt 0 ]]; do
                            case "$1" in
                                --latency) json="$json,\"latency\":$2"; shift 2 ;;
                                --download) json="$json,\"download\":$2"; shift 2 ;;
                                --upload) json="$json,\"upload\":$2"; shift 2 ;;
                                *) shift ;;
                            esac
                        done
                        json="$json}"
                    else
                        json='{"id":"'$(cmd_id)'","action":"throttle","preset":"'"$1"'"}'
                    fi
                    ;;
                reconnect)
                    # Force new browser context to clear DNS cache and connections
                    json=$(build_close_cmd)
                    response=$(send_command "$json" 2>/dev/null) || true
                    # Relaunch with fresh context
                    json='{"id":"'$(cmd_id)'","action":"launch"}'
                    ;;
                *)
                    echo "Unknown network command: $subcmd" >&2
                    exit 1
                    ;;
            esac
            ;;
        
        # Auth commands
        auth)
            [[ $# -eq 0 ]] && { echo "Usage: agent-browse auth <totp|detect-login|autofill|detect-captcha|wait-captcha>" >&2; exit 1; }
            local subcmd="$1"; shift
            case "$subcmd" in
                totp)
                    [[ $# -lt 1 ]] && { echo "Usage: auth totp <secret> [--fill <selector>]" >&2; exit 1; }
                    local secret="$1"; shift
                    json='{"id":"'$(cmd_id)'","action":"totp","secret":"'"$secret"'"'
                    if [[ "${1:-}" == "--fill" && -n "${2:-}" ]]; then
                        json="$json,\"fill\":\"$2\""
                    fi
                    json="$json}"
                    ;;
                detect-login)
                    json='{"id":"'$(cmd_id)'","action":"detect_login"}'
                    ;;
                autofill)
                    [[ $# -lt 2 ]] && { echo "Usage: auth autofill <username> <password> [--submit]" >&2; exit 1; }
                    local username="$1"
                    local password="$2"
                    shift 2
                    json='{"id":"'$(cmd_id)'","action":"autofill_login","username":"'"$username"'","password":"'"$password"'"'
                    [[ "${1:-}" == "--submit" ]] && json="$json,\"submit\":true"
                    json="$json}"
                    ;;
                detect-captcha)
                    json='{"id":"'$(cmd_id)'","action":"detect_captcha"}'
                    ;;
                wait-captcha)
                    local timeout="${1:-120000}"
                    json='{"id":"'$(cmd_id)'","action":"wait_captcha","timeout":'"$timeout"'}'
                    ;;
                check-creds)
                    # Check if credentials exist for a domain (env vars or keychain)
                    # Usage: auth check-creds <domain>
                    [[ $# -lt 1 ]] && { echo "Usage: auth check-creds <domain>" >&2; exit 1; }
                    local domain="$1"
                    local prefix
                    prefix=$(echo "$domain" | sed -E 's/^(www\.|app\.|eos\.)?//; s/\.[a-z]+$//; s/[^a-zA-Z0-9]/_/g' | tr '[:lower:]' '[:upper:]')
                    local email_var="${prefix}_EMAIL"
                    local pass_var="${prefix}_PASSWORD"
                    local platform
                    platform=$("$SCRIPT_DIR/creds-helper.sh" platform)
                    
                    # Try to get credentials (checks env vars then keychain)
                    local creds_output ready="false" source=""
                    if creds_output=$("$SCRIPT_DIR/creds-helper.sh" get "$domain" 2>/dev/null); then
                        ready="true"
                        source=$(echo "$creds_output" | tail -1)
                    fi
                    
                    echo "{"
                    echo "  \"domain\": \"$domain\","
                    echo "  \"prefix\": \"$prefix\","
                    echo "  \"email_var\": \"$email_var\","
                    echo "  \"password_var\": \"$pass_var\","
                    echo "  \"platform\": \"$platform\","
                    echo "  \"ready\": $ready,"
                    echo "  \"source\": \"$source\""
                    echo "}"
                    exit 0
                    ;;
                store-creds)
                    # Store credentials securely in OS keychain
                    # Usage: auth store-creds <domain> <email> <password>
                    [[ $# -lt 3 ]] && { echo "Usage: auth store-creds <domain> <email> <password>" >&2; exit 1; }
                    local domain="$1"
                    local email="$2"
                    local password="$3"
                    local platform
                    platform=$("$SCRIPT_DIR/creds-helper.sh" platform)
                    
                    # Store in OS keychain
                    if "$SCRIPT_DIR/creds-helper.sh" store "$domain" "$email" "$password"; then
                        echo "{"
                        echo "  \"stored\": true,"
                        echo "  \"domain\": \"$domain\","
                        echo "  \"platform\": \"$platform\","
                        echo "  \"storage\": \"keychain\","
                        echo "  \"note\": \"Credentials stored securely in $platform keychain\""
                        echo "}"
                        exit 0
                    else
                        echo "{"
                        echo "  \"error\": \"storage_failed\","
                        echo "  \"domain\": \"$domain\","
                        echo "  \"platform\": \"$platform\","
                        echo "  \"message\": \"Failed to store credentials in keychain\""
                        echo "}"
                        exit 1
                    fi
                    ;;
                delete-creds)
                    # Delete stored credentials
                    # Usage: auth delete-creds <domain>
                    [[ $# -lt 1 ]] && { echo "Usage: auth delete-creds <domain>" >&2; exit 1; }
                    local domain="$1"
                    "$SCRIPT_DIR/creds-helper.sh" delete "$domain"
                    echo "{"
                    echo "  \"deleted\": true,"
                    echo "  \"domain\": \"$domain\""
                    echo "}"
                    exit 0
                    ;;
                list-creds)
                    # List all stored credential domains
                    local domains
                    domains=$("$SCRIPT_DIR/creds-helper.sh" list 2>/dev/null || echo "")
                    echo "{"
                    echo "  \"domains\": ["
                    local first=true
                    while IFS= read -r d; do
                        [[ -z "$d" ]] && continue
                        [[ "$first" == "true" ]] && first=false || echo ","
                        echo -n "    \"$d\""
                    done <<< "$domains"
                    echo ""
                    echo "  ]"
                    echo "}"
                    exit 0
                    ;;
                get-creds)
                    # Get credentials for a domain (checks env vars then keychain)
                    # Usage: auth get-creds <domain>
                    [[ $# -lt 1 ]] && { echo "Usage: auth get-creds <domain>" >&2; exit 1; }
                    local domain="$1"
                    local prefix
                    prefix=$(echo "$domain" | sed -E 's/^(www\.|app\.|eos\.)?//; s/\.[a-z]+$//; s/[^a-zA-Z0-9]/_/g' | tr '[:lower:]' '[:upper:]')
                    
                    local creds_output
                    if creds_output=$("$SCRIPT_DIR/creds-helper.sh" get "$domain" 2>/dev/null); then
                        local email password source
                        email=$(echo "$creds_output" | sed -n '1p')
                        password=$(echo "$creds_output" | sed -n '2p')
                        source=$(echo "$creds_output" | sed -n '3p')
                        echo "{"
                        echo "  \"domain\": \"$domain\","
                        echo "  \"email\": \"$email\","
                        echo "  \"password\": \"$password\","
                        echo "  \"source\": \"$source\""
                        echo "}"
                        exit 0
                    else
                        echo "{"
                        echo "  \"error\": \"credentials_missing\","
                        echo "  \"domain\": \"$domain\","
                        echo "  \"env_vars\": [\"${prefix}_EMAIL\", \"${prefix}_PASSWORD\"],"
                        echo "  \"action_required\": \"ASK_USER_FOR_CREDENTIALS\","
                        echo "  \"message\": \"No credentials found. Ask user for credentials, then run: agent-browse auth store-creds $domain <email> <password>\""
                        echo "}"
                        exit 2
                    fi
                    ;;
                login)
                    # High-level login command: get creds from keychain/env, autofill, submit
                    # Usage: auth login <domain> [--submit] [--auto]
                    [[ $# -lt 1 ]] && { echo "Usage: auth login <domain> [--submit] [--auto]" >&2; exit 1; }
                    local domain="$1"; shift
                    local do_submit=false do_auto=false
                    while [[ $# -gt 0 ]]; do
                        case "$1" in
                            --submit) do_submit=true; shift ;;
                            --auto) do_auto=true; do_submit=true; shift ;;
                            *) shift ;;
                        esac
                    done
                    
                    local prefix
                    prefix=$(echo "$domain" | sed -E 's/^(www\.|app\.|eos\.)?//; s/\.[a-z]+$//; s/[^a-zA-Z0-9]/_/g' | tr '[:lower:]' '[:upper:]')
                    
                    local creds_output email_val pass_val
                    if creds_output=$("$SCRIPT_DIR/creds-helper.sh" get "$domain" 2>/dev/null); then
                        email_val=$(echo "$creds_output" | sed -n '1p')
                        pass_val=$(echo "$creds_output" | sed -n '2p')
                    else
                        echo "{"
                        echo "  \"error\": \"credentials_missing\","
                        echo "  \"domain\": \"$domain\","
                        echo "  \"env_vars\": [\"${prefix}_EMAIL\", \"${prefix}_PASSWORD\"],"
                        echo "  \"action_required\": \"STORE_CREDENTIALS\","
                        echo "  \"command\": \"auth store-creds $domain <email> <password>\""
                        echo "}"
                        exit 2
                    fi
                    
                    # --auto: navigate, fill, submit, wait, verify all in one
                    if [[ "$do_auto" == "true" ]]; then
                        # Navigate to login page
                        local login_url="https://${domain}/login"
                        "$0" open "$login_url" >/dev/null 2>&1 || true
                        sleep 2
                        # Autofill and submit
                        json='{"id":"'$(cmd_id)'","action":"autofill_login","username":"'"$email_val"'","password":"'"$pass_val"'","submit":true}'
                        response=$(send_command "$json" 2>/dev/null) || true
                        # Wait for navigation
                        "$0" wait --stable >/dev/null 2>&1 || true
                        # Get final URL to verify
                        local final_url
                        final_url=$("$0" get url 2>/dev/null | grep -o '"url":"[^"]*"' | cut -d'"' -f4)
                        local logged_in=false
                        [[ "$final_url" != *"/login"* ]] && logged_in=true
                        echo "{"
                        echo "  \"success\": $logged_in,"
                        echo "  \"domain\": \"$domain\","
                        echo "  \"url\": \"$final_url\""
                        echo "}"
                        [[ "$logged_in" == "true" ]] && exit 0 || exit 1
                    fi
                    
                    # Use autofill with the credentials
                    json='{"id":"'$(cmd_id)'","action":"autofill_login","username":"'"$email_val"'","password":"'"$pass_val"'"'
                    [[ "$do_submit" == "true" ]] && json="$json,\"submit\":true"
                    json="$json}"
                    ;;
                *)
                    echo "Unknown auth command: $subcmd" >&2
                    exit 1
                    ;;
            esac
            ;;
        
        # Vision commands (Phase 6)
        vision)
            [[ $# -eq 0 ]] && { echo "Usage: agent-browse vision <describe|find|click|analyze|explain|compare>" >&2; exit 1; }
            local subcmd="$1"; shift
            case "$subcmd" in
                describe)
                    json='{"id":"'$(cmd_id)'","action":"vision_describe"'
                    while [[ $# -gt 0 ]]; do
                        case "$1" in
                            --detail) json="$json,\"detail\":\"$2\""; shift 2 ;;
                            --focus) json="$json,\"focus\":\"$2\""; shift 2 ;;
                            --full) json="$json,\"fullPage\":true"; shift ;;
                            *) shift ;;
                        esac
                    done
                    json="$json}"
                    ;;
                find)
                    [[ $# -lt 1 ]] && { echo "Usage: vision find <description>" >&2; exit 1; }
                    local desc="$*"
                    json='{"id":"'$(cmd_id)'","action":"vision_find","description":"'"$desc"'"}'
                    ;;
                click)
                    [[ $# -lt 1 ]] && { echo "Usage: vision click <description>" >&2; exit 1; }
                    local desc="$*"
                    json='{"id":"'$(cmd_id)'","action":"vision_click","description":"'"$desc"'"}'
                    ;;
                analyze)
                    [[ $# -lt 1 ]] && { echo "Usage: vision analyze <pattern>" >&2; exit 1; }
                    local pattern="$1"; shift
                    json='{"id":"'$(cmd_id)'","action":"vision_analyze","pattern":"'"$pattern"'"'
                    [[ "${1:-}" == "--full" ]] && json="$json,\"fullPage\":true"
                    json="$json}"
                    ;;
                explain)
                    [[ $# -lt 2 ]] && { echo "Usage: vision explain <action> <target>" >&2; exit 1; }
                    local action_type="$1"
                    shift
                    local target="$*"
                    json='{"id":"'$(cmd_id)'","action":"vision_explain","action_type":"'"$action_type"'","target":"'"$target"'"}'
                    ;;
                compare)
                    [[ $# -lt 1 ]] && { echo "Usage: vision compare <before_image> [after_image]" >&2; exit 1; }
                    local before="$1"
                    local after="${2:-}"
                    json='{"id":"'$(cmd_id)'","action":"vision_compare","before":"'"$before"'"'
                    [[ -n "$after" ]] && json="$json,\"after\":\"$after\""
                    json="$json}"
                    ;;
                *)
                    echo "Unknown vision command: $subcmd" >&2
                    exit 1
                    ;;
            esac
            ;;
        
        # Agent commands (Phase 7)
        agent)
            [[ $# -eq 0 ]] && { echo "Usage: agent-browse agent <goal|explore|explain|recover>" >&2; exit 1; }
            local subcmd="$1"; shift
            case "$subcmd" in
                goal)
                    [[ $# -lt 1 ]] && { echo "Usage: agent goal <goal> [--max-steps N] [--verbose]" >&2; exit 1; }
                    local goal=""
                    local max_steps=""
                    local verbose="false"
                    while [[ $# -gt 0 ]]; do
                        case "$1" in
                            --max-steps) max_steps="$2"; shift 2 ;;
                            --verbose) verbose="true"; shift ;;
                            *) goal="$goal $1"; shift ;;
                        esac
                    done
                    goal="${goal# }"
                    json='{"id":"'$(cmd_id)'","action":"agent_goal","goal":"'"$goal"'"'
                    [[ -n "$max_steps" ]] && json="$json,\"maxSteps\":$max_steps"
                    [[ "$verbose" == "true" ]] && json="$json,\"verbose\":true"
                    json="$json}"
                    ;;
                explore)
                    json='{"id":"'$(cmd_id)'","action":"agent_explore"'
                    while [[ $# -gt 0 ]]; do
                        case "$1" in
                            --depth) json="$json,\"depth\":$2"; shift 2 ;;
                            --max-links) json="$json,\"maxLinks\":$2"; shift 2 ;;
                            --all-origins) json="$json,\"sameOrigin\":false"; shift ;;
                            *) shift ;;
                        esac
                    done
                    json="$json}"
                    ;;
                explain)
                    json='{"id":"'$(cmd_id)'","action":"agent_explain"}'
                    ;;
                recover)
                    json='{"id":"'$(cmd_id)'","action":"agent_recover"}'
                    ;;
                *)
                    echo "Unknown agent command: $subcmd" >&2
                    exit 1
                    ;;
            esac
            ;;

        # Capture (API skill generation)
        capture)
            [[ $# -eq 0 ]] && { echo "Usage: agent-browse capture <start|stop|status>" >&2; exit 1; }
            local subcmd="$1"; shift
            case "$subcmd" in
                start)
                    json='{"id":"'$(cmd_id)'","action":"capture_start"}'
                    ;;
                stop)
                    [[ $# -lt 1 ]] && { echo "Usage: capture stop <name>" >&2; exit 1; }
                    json='{"id":"'$(cmd_id)'","action":"capture_stop","name":"'"$1"'"}'
                    ;;
                status)
                    json='{"id":"'$(cmd_id)'","action":"capture_status"}'
                    ;;
                *)
                    echo "Unknown capture command: $subcmd" >&2
                    echo "Usage: capture start|stop|status" >&2
                    exit 1
                    ;;
            esac
            ;;

        # API skills (filesystem only, no daemon)
        api)
            local skills_dir="${HOME}/.agent-do/skills"
            if [[ $# -eq 0 ]]; then
                echo "Usage: agent-browse api <skill> <function> [args...]" >&2
                echo "       agent-browse api list|show|test|delete" >&2
                exit 1
            fi
            case "$1" in
                list)
                    local list_json=false
                    shift
                    while [[ $# -gt 0 ]]; do
                        case "$1" in
                            --json) list_json=true; shift ;;
                            *) shift ;;
                        esac
                    done
                    if [[ ! -d "$skills_dir" ]]; then
                        if [[ "$list_json" == "true" ]]; then
                            python3 -c "import json; print(json.dumps({'skills': []}))"
                        else
                            echo "(no skills yet)"
                        fi
                        exit 0
                    fi
                    local found_skill=false
                    local json_rows=""
                    for dir in "$skills_dir"/*/; do
                        [[ ! -d "$dir" ]] && continue
                        local sname
                        sname=$(basename "$dir")
                        if [[ -f "$dir/SKILL.md" ]]; then
                            found_skill=true
                            local count auth_type
                            count=$(grep -m1 'endpoint_count:' "$dir/SKILL.md" 2>/dev/null | awk '{print $2}') || count="?"
                            auth_type=$(grep -m1 'auth_type:' "$dir/SKILL.md" 2>/dev/null | awk '{print $2}') || auth_type="?"
                            if [[ "$list_json" == "true" ]]; then
                                json_rows+="${sname}"$'\t'"${count}"$'\t'"${auth_type}"$'\n'
                            else
                                echo "$sname  (${count} endpoints, auth: ${auth_type})"
                            fi
                        fi
                    done
                    if [[ "$list_json" == "true" ]]; then
                        printf '%s' "$json_rows" | python3 -c "
import sys, json
skills = []
for line in sys.stdin.read().splitlines():
    if not line:
        continue
    parts = line.split('\t')
    name = parts[0] if len(parts) > 0 else ''
    count = parts[1] if len(parts) > 1 else '?'
    auth = parts[2] if len(parts) > 2 else '?'
    try:
        endpoint_count = int(count)
    except (ValueError, TypeError):
        endpoint_count = count
    skills.append({'name': name, 'endpoint_count': endpoint_count, 'auth_type': auth})
print(json.dumps({'skills': skills}))
"
                    else
                        [[ "$found_skill" == "false" ]] && echo "(no skills yet)"
                    fi
                    exit 0
                    ;;
                show)
                    [[ $# -lt 2 ]] && { echo "Usage: api show <skill>" >&2; exit 1; }
                    local skill_file="$skills_dir/$2/SKILL.md"
                    [[ ! -f "$skill_file" ]] && { echo "Error: Skill '$2' not found" >&2; exit 1; }
                    cat "$skill_file"
                    exit 0
                    ;;
                test)
                    [[ $# -lt 2 ]] && { echo "Usage: api test <skill>" >&2; exit 1; }
                    exec "$SCRIPT_DIR/../agent-unbrowse/agent-unbrowse" test "$2"
                    ;;
                delete)
                    [[ $# -lt 2 ]] && { echo "Usage: api delete <skill>" >&2; exit 1; }
                    local skill_path="$skills_dir/$2"
                    [[ ! -d "$skill_path" ]] && { echo "Error: Skill '$2' not found" >&2; exit 1; }
                    rm -rf "$skill_path"
                    echo "Deleted skill: $2"
                    exit 0
                    ;;
                *)
                    # Treat as: api <skill> <function> [args...]
                    local skill="$1"; shift
                    local func="$1"; shift
                    local api_file="$skills_dir/$skill/api.sh"
                    [[ ! -f "$api_file" ]] && { echo "Error: Skill '$skill' not found (no api.sh)" >&2; exit 1; }
                    source "$api_file"
                    "$func" "$@"
                    exit $?
                    ;;
            esac
            ;;

        # State checks
        is)
            [[ $# -lt 2 ]] && { echo "Usage: agent-browse is <visible|enabled|checked> <selector>" >&2; exit 1; }
            json='{"id":"'$(cmd_id)'","action":"is'"${1^}"'","selector":"'"$2"'"}'
            ;;
            
        # Debug
        console)
            local clear=false
            [[ "${1:-}" == "--clear" ]] && clear=true
            json='{"id":"'$(cmd_id)'","action":"console","clear":'$clear'}'
            ;;
        errors)
            local clear=false
            [[ "${1:-}" == "--clear" ]] && clear=true
            json='{"id":"'$(cmd_id)'","action":"errors","clear":'$clear'}'
            ;;
        highlight)
            [[ $# -lt 1 ]] && { echo "Usage: agent-browse highlight <selector>" >&2; exit 1; }
            json='{"id":"'$(cmd_id)'","action":"highlight","selector":"'"$1"'"}'
            ;;
            
        # Browser control
        viewport)
            if [[ $# -ge 2 ]]; then
                # Set viewport
                local vw="$1" vh="$2"
                json='{"id":"'$(cmd_id)'","action":"viewport","width":'"$vw"',"height":'"$vh"'}'
            elif [[ $# -eq 1 && "$1" =~ ^([0-9]+)x([0-9]+)$ ]]; then
                # Support WxH format: viewport 1920x1080
                local vw="${BASH_REMATCH[1]}" vh="${BASH_REMATCH[2]}"
                json='{"id":"'$(cmd_id)'","action":"viewport","width":'"$vw"',"height":'"$vh"'}'
            else
                # Show current viewport
                json='{"id":"'$(cmd_id)'","action":"evaluate","script":"JSON.stringify((() => { const s = window.innerWidth + \"x\" + window.innerHeight; return { width: window.innerWidth, height: window.innerHeight, devicePixelRatio: window.devicePixelRatio, display: s }; })())"}'
            fi
            ;;
        install)
            echo "Installing Playwright browsers..."
            npx playwright install chromium
            exit $?
            ;;
        close)
            json=$(build_close_cmd)
            if is_daemon_running && daemon_ping >/dev/null; then
                raw_socket_command "$json" 5 >/dev/null 2>&1 || true
            fi
            stop_daemon
            echo "Browser closed"
            exit 0
            ;;
        restart)
            # Stop only the identity-verified daemon for this session.
            stop_daemon
            # Always relaunch: if URL provided, open it; otherwise just launch the browser
            if [[ $# -gt 0 ]]; then
                "$0" --session "$SESSION" open "$1"
                exit $?
            fi
            # Start daemon + browser, wait until responsive
            "$0" --session "$SESSION" launch > /dev/null 2>&1 || true
            # Poll until browser is responsive (up to 10 seconds)
            local ready=false
            for i in $(seq 1 20); do
                if url_result=$(send_command '{"id":"restart-check","action":"url"}' 2>/dev/null); then
                    if echo "$url_result" | grep -q '"success":true'; then
                        ready=true
                        break
                    fi
                fi
                sleep 0.5
            done
            if [[ "$ready" == "true" ]]; then
                echo '{"restarted": true, "browser": "responsive"}'
            else
                echo '{"restarted": true, "browser": "starting", "hint": "Browser still warming up. Run open <url> to navigate."}'
            fi
            exit 0
            ;;
        status)
            daemon_doctor
            exit 0
            ;;
        doctor)
            daemon_doctor
            exit 0
            ;;
            
        *)
            echo "Unknown command: $cmd" >&2
            # Suggest similar commands (prefix match)
            local commands="launch open back forward reload click dblclick fill type press hover focus check uncheck select upload snapshot get clipboard wait screenshot pdf eval login session tab network auth vision agent capture api is console errors highlight install close restart status doctor"
            local suggestions=""
            for c in $commands; do
                if [[ "$c" == "$cmd"* ]]; then
                    suggestions+="  $c"$'\n'
                fi
            done
            if [[ -n "$suggestions" ]]; then
                echo "Did you mean:" >&2
                echo -n "$suggestions" >&2
            else
                echo "Run 'agent-browse --help' for usage" >&2
            fi
            exit 1
            ;;
    esac
    
    # Send command and parse response
    [[ "$debug" == "true" ]] && echo "DEBUG: $json" >&2
    
    response=$(send_command "$json" "$cmd_timeout") || exit 1
    
    [[ "$debug" == "true" ]] && echo "DEBUG response: $response" >&2
    
    parse_response "$response" "$output_format"
}

main "$@"
