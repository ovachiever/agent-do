            local id; id=$(resolve_env_group "${1:-}") || return 1
            render_request GET "/env-groups/$id" | python3 -m json.tool
            ;;
        create)
            local name="" owner=""
            local -a vars=()
            while [[ $# -gt 0 ]]; do
                case "$1" in
                    --owner) owner="$2"; shift 2 ;;
                    --env) vars+=("$2"); shift 2 ;;
                    *) [[ -z "$name" ]] && name="$1" || true; shift ;;
                esac
            done
            [[ -z "$name" ]] && { echo "Usage: agent-render env-group create <name> [--env K=V]..."; return 1; }
            if [[ -z "$owner" ]]; then
                owner=$(default_owner_id) || true
                [[ -z "$owner" ]] && { echo "Error: --owner required" >&2; return 1; }
            else
                owner=$(resolve_owner "$owner") || return 1
            fi
            local body
            body=$(python3 -c "
import sys, json
name = sys.argv[1]; owner = sys.argv[2]
pairs = sys.argv[3:]
env_vars = []
for p in pairs:
    if '=' in p:
        k, v = p.split('=', 1)
        env_vars.append({'key': k, 'value': v})
print(json.dumps({'name': name, 'ownerId': owner, 'envVars': env_vars}))
" "$name" "$owner" "${vars[@]}")
            render_request_checked POST "/env-groups" "$body" | python3 -c "
import sys, json
g = json.load(sys.stdin)
print(f\"Created: {g.get('name', '')} ({g.get('id', '')})\")
"
            ;;
        delete|del|rm)
            local id; id=$(resolve_env_group "${1:-}") || return 1
            local confirm=0; shift
            while [[ $# -gt 0 ]]; do [[ "$1" == --yes ]] && confirm=1; shift; done
            [[ "$confirm" != "1" ]] && { echo "Refusing without --yes" >&2; return 1; }
            render_request_checked DELETE "/env-groups/$id" > /dev/null && echo "Deleted env group"
            ;;
        rename)
            local id; id=$(resolve_env_group "${1:-}") || return 1
            local new="${2:-}"
            [[ -z "$new" ]] && { echo "Usage: agent-render env-group rename <eg> <new-name>"; return 1; }
            local body; body=$(python3 -c "import json,sys; print(json.dumps({'name': sys.argv[1]}))" "$new")
            render_request_checked PATCH "/env-groups/$id" "$body" > /dev/null && echo "Renamed"
            ;;
        link)
            local id; id=$(resolve_env_group "${1:-}") || return 1
            local svc; svc=$(resolve_service "${2:-}") || return 1
            render_request_checked POST "/env-groups/$id/services/$svc" > /dev/null && \
                echo "Linked env group to service"
            ;;
        unlink)
            local id; id=$(resolve_env_group "${1:-}") || return 1
            local svc; svc=$(resolve_service "${2:-}") || return 1
            render_request_checked DELETE "/env-groups/$id/services/$svc" > /dev/null && \
                echo "Unlinked"
            ;;
        set)
            local id; id=$(resolve_env_group "${1:-}") || return 1
            local key="${2:-}" val="${3:-}"
            [[ -z "$key" ]] && { echo "Usage: agent-render env-group set <eg> <KEY> <VAL>"; return 1; }
            local body; body=$(python3 -c "import json,sys; print(json.dumps({'value': sys.argv[1]}))" "$val")
            render_request_checked PUT "/env-groups/$id/env-vars/$key" "$body" > /dev/null && echo "Set $key"
            ;;
        get)
            local id; id=$(resolve_env_group "${1:-}") || return 1
            local key="${2:-}"
            [[ -z "$key" ]] && { echo "Usage: agent-render env-group get <eg> <KEY>"; return 1; }
            render_request GET "/env-groups/$id/env-vars/$key" | python3 -c "
import sys, json
v = json.load(sys.stdin)
print(v.get('value', ''))
"
            ;;
        del-var|unset)
            local id; id=$(resolve_env_group "${1:-}") || return 1
            local key="${2:-}"
            [[ -z "$key" ]] && { echo "Usage: agent-render env-group del-var <eg> <KEY>"; return 1; }
            render_request_checked DELETE "/env-groups/$id/env-vars/$key" > /dev/null && echo "Deleted $key"
            ;;
        secret)
            local action="${1:-list}"; shift || true
            local id; id=$(resolve_env_group "${1:-}") || return 1
            local name="${2:-}"
            case "$action" in
                set)
                    local file="${3:-}"
                    [[ -z "$name" ]] && { echo "Usage: agent-render env-group secret set <eg> <name> [<file|->]"; return 1; }
                    local contents
                    if [[ -z "$file" || "$file" == "-" ]]; then contents=$(cat); else contents=$(cat "$file"); fi
                    local body; body=$(python3 -c "import json,sys; print(json.dumps({'contents': sys.stdin.read()}))" <<< "$contents")
                    render_request_checked PUT "/env-groups/$id/secret-files/$name" "$body" > /dev/null && echo "Set secret file $name"
                    ;;
                get)
                    [[ -z "$name" ]] && { echo "Usage: agent-render env-group secret get <eg> <name>"; return 1; }
                    render_request GET "/env-groups/$id/secret-files/$name" | python3 -c "import sys, json; print(json.load(sys.stdin).get('contents', ''))"
                    ;;
                del|rm)
                    [[ -z "$name" ]] && { echo "Usage: agent-render env-group secret del <eg> <name>"; return 1; }
                    render_request_checked DELETE "/env-groups/$id/secret-files/$name" > /dev/null && echo "Deleted"
                    ;;
                *) echo "Usage: agent-render env-group secret {set|get|del} <eg> <name> [file]"; return 1 ;;
            esac
            ;;
        *) echo "Usage: agent-render env-group {list|show|create|delete|rename|link|unlink|set|get|del-var|secret} ..."; return 1 ;;
    esac
}

# =====================================================================
# Blueprints (validate / list / show / patch / delete / sync-history)
# =====================================================================

resolve_blueprint() {
    local name_or_id="$1"
    if [[ "$name_or_id" == bp-* || "$name_or_id" == exs-* ]]; then echo "$name_or_id"; return 0; fi
    local result; result=$(render_request GET "/blueprints?limit=100")
    local id
    id=$(echo "$result" | python3 -c "
import sys, json
name = '$name_or_id'
items = json.load(sys.stdin)
for item in items:
    b = item.get('blueprint', item)
    if b.get('name', '') == name: print(b.get('id', '')); break
" 2>/dev/null)
    [[ -z "$id" ]] && { echo "Error: blueprint '$name_or_id' not found" >&2; return 1; }
    echo "$id"
}

cmd_blueprint() {
    local subcmd="${1:-list}"; shift || true
    case "$subcmd" in
        list|ls)
            render_request GET "/blueprints?limit=50" | python3 -c "
import sys, json
items = json.load(sys.stdin)
if not items: print('No blueprints'); sys.exit(0)
for item in items:
    b = item.get('blueprint', item)
    print(f\"{b.get('id', '')}  {b.get('name', '')}  {b.get('repo', '')}@{b.get('branch', '')}  auto:{b.get('autoSync', '')}\")
"
            ;;
        show|get)
            local id; id=$(resolve_blueprint "${1:-}") || return 1
            render_request GET "/blueprints/$id" | python3 -m json.tool
            ;;
        validate)
            local file="${1:-render.yaml}"
            if [[ ! -f "$file" ]]; then
                echo "Error: $file not found" >&2
                return 1
            fi
            local body
            body=$(python3 -c "
import sys, json, yaml
y = yaml.safe_load(open(sys.argv[1]))
print(json.dumps({'spec': y}))
" "$file" 2>/dev/null) || {
                # Fallback if PyYAML not available — send raw text under 'specYaml'
                local raw
                raw=$(cat "$file")
                body=$(python3 -c "import sys, json; print(json.dumps({'specYaml': sys.stdin.read()}))" <<< "$raw")
            }
            render_request_checked POST "/blueprints/validate" "$body" | python3 -m json.tool
            ;;
        update|patch)
            local id; id=$(resolve_blueprint "${1:-}") || return 1
            shift
            local auto="" name=""
            while [[ $# -gt 0 ]]; do
                case "$1" in
                    --auto-sync) auto="$2"; shift 2 ;;
                    --name) name="$2"; shift 2 ;;
                    *) shift ;;
                esac
            done
            local body
            body=$(python3 -c "
import sys, json
out = {}
if sys.argv[1]: out['autoSync'] = sys.argv[1] in ('yes', 'true', '1')
if sys.argv[2]: out['name'] = sys.argv[2]
print(json.dumps(out))
" "$auto" "$name")
            render_request_checked PATCH "/blueprints/$id" "$body" > /dev/null && echo "Updated blueprint"
            ;;
        delete|del|rm)
            local id; id=$(resolve_blueprint "${1:-}") || return 1
            local confirm=0; shift
            while [[ $# -gt 0 ]]; do [[ "$1" == --yes ]] && confirm=1; shift; done
            [[ "$confirm" != "1" ]] && { echo "Refusing without --yes" >&2; return 1; }
            render_request_checked DELETE "/blueprints/$id" > /dev/null && echo "Deleted blueprint"
            ;;
        syncs|history)
            local id; id=$(resolve_blueprint "${1:-}") || return 1
            render_request GET "/blueprints/$id/syncs?limit=20" | python3 -c "
import sys, json
items = json.load(sys.stdin)
if not items: print('No sync history'); sys.exit(0)
for item in items:
    s = item.get('sync', item)
    print(f\"{s.get('createdAt', '')}  {s.get('status', '')}  resources:{len(s.get('resources', []))}\")
"
            ;;
        *)
            cat <<'EOF'
Usage: agent-render blueprint <subcommand>

  list                          List blueprints
  show <bp>                     Blueprint details
  validate [render.yaml]        Validate a render.yaml against the API
  update <bp> [--auto-sync yes|no] [--name X]
  delete <bp> --yes
  syncs <bp>                    Sync history (which resources got created)

Note: blueprints are created automatically when a repo with render.yaml is
linked via the dashboard. The API does not expose a create endpoint; it
provides validate + management of existing blueprints.
EOF
            return 1
            ;;
    esac
}

