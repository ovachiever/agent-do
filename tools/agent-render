cmd_scale() {
    local name_or_id="${1:-}"
    local count="${2:-}"

    if [[ -z "$name_or_id" ]] || [[ -z "$count" ]]; then
        echo "Usage: agent-render scale <service> <num_instances>"
        return 1
    fi

    local sid
    sid=$(resolve_service "$name_or_id") || return 1

    local result
