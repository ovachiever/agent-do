r = json.load(sys.stdin)
print(f\"Created: {r.get('name', '')} ({r.get('id', '')})\")
"
            ;;
        delete|del|rm)
            local id="${1:-}"; local confirm=0; shift || true
            while [[ $# -gt 0 ]]; do [[ "$1" == --yes ]] && confirm=1; shift; done
            [[ -z "$id" ]] && { echo "Usage: agent-render registry delete <id> --yes"; return 1; }
            [[ "$confirm" != "1" ]] && { echo "Refusing without --yes" >&2; return 1; }
            render_request_checked DELETE "/registrycredentials/$id" > /dev/null && echo "Deleted"
            ;;
        *) echo "Usage: agent-render registry {list|show|add|delete} ..."; return 1 ;;
    esac
}

# =====================================================================
# Projects (extended) + Environments
# =====================================================================

cmd_project() {
    local subcmd="${1:-list}"; shift || true
    case "$subcmd" in
        list|ls) cmd_projects ;;
        show|get)
            local id="${1:-}"
            [[ -z "$id" ]] && { echo "Usage: agent-render project show <project-id>"; return 1; }
            render_request GET "/projects/$id" | python3 -m json.tool
            ;;
        create)
            local name="" owner=""
            local -a envs=()
            while [[ $# -gt 0 ]]; do
                case "$1" in
                    --owner) owner="$2"; shift 2 ;;
                    --env) envs+=("$2"); shift 2 ;;
                    *) [[ -z "$name" ]] && name="$1" || true; shift ;;
                esac
            done
            [[ -z "$name" ]] && { echo "Usage: agent-render project create <name> [--env <name>]..."; return 1; }
            [[ -z "$owner" ]] && owner=$(default_owner_id)
            owner=$(resolve_owner "$owner") || return 1
            # Default to one env named "production" if none given
            [[ ${#envs[@]} -eq 0 ]] && envs=("production")
            local body
            body=$(python3 -c "
import sys, json
name = sys.argv[1]; owner = sys.argv[2]
envs = [{'name': n} for n in sys.argv[3:]]
print(json.dumps({'name': name, 'ownerId': owner, 'environments': envs}))
" "$name" "$owner" "${envs[@]}")
            render_request_checked POST "/projects" "$body" | python3 -c "
import sys, json
p = json.load(sys.stdin)
print(f\"Created: {p.get('name', '')} ({p.get('id', '')})\")
"
            ;;
        update|patch)
            local id="${1:-}"; shift
            local new_name=""
            while [[ $# -gt 0 ]]; do
                case "$1" in --name) new_name="$2"; shift 2 ;; *) shift ;; esac
            done
            local body; body=$(python3 -c "
import sys, json
out = {}
if sys.argv[1]: out['name'] = sys.argv[1]
print(json.dumps(out))
" "$new_name")
            render_request_checked PATCH "/projects/$id" "$body" > /dev/null && echo "Updated project"
            ;;
        delete|del|rm)
            local id="${1:-}"; local confirm=0; shift || true
            while [[ $# -gt 0 ]]; do [[ "$1" == --yes ]] && confirm=1; shift; done
            [[ "$confirm" != "1" ]] && { echo "Refusing without --yes" >&2; return 1; }
            render_request_checked DELETE "/projects/$id" > /dev/null && echo "Deleted project"
            ;;
        *) echo "Usage: agent-render project {list|show|create|update|delete} ..."; return 1 ;;
    esac
}

cmd_environment() {
    local subcmd="${1:-list}"; shift || true
    case "$subcmd" in
        list|ls)
            local project=""
            while [[ $# -gt 0 ]]; do
                case "$1" in --project|-p) project="$2"; shift 2 ;; *) shift ;; esac
            done
            if [[ -z "$project" ]]; then
                # Render requires projectId; iterate over projects.
                local projects_json
                projects_json=$(render_request GET "/projects?limit=100")
                local pids
                pids=$(echo "$projects_json" | python3 -c "
import sys, json
items = json.load(sys.stdin)
for it in items:
    p = it.get('project', it)
    print(p.get('id', ''))
" 2>/dev/null)
                if [[ -z "$pids" ]]; then
                    echo "No projects found (environments require a project)"
                    return 0
                fi
                local pid
                for pid in $pids; do
                    render_request GET "/environments?projectId=$pid" | python3 -c "
import sys, json
data = json.load(sys.stdin)
if isinstance(data, dict) and 'message' in data:
    sys.exit(0)
if not data: sys.exit(0)
for item in data:
    e = item.get('environment', item) if isinstance(item, dict) else {}
    print(f\"{e.get('id', '')}  {e.get('name', '')}  project:{e.get('projectId', '')}\")
"
                done
            else
                render_request GET "/environments?projectId=$project" | python3 -c "
import sys, json
data = json.load(sys.stdin)
if isinstance(data, dict) and 'message' in data:
    print(f\"Render: {data['message']}\"); sys.exit(0)
if not data: print('No environments'); sys.exit(0)
for item in data:
    e = item.get('environment', item) if isinstance(item, dict) else {}
    print(f\"{e.get('id', '')}  {e.get('name', '')}  project:{e.get('projectId', '')}\")
"
            fi
            ;;
        show|get)
            local id="${1:-}"; [[ -z "$id" ]] && { echo "Usage: agent-render environment show <env>"; return 1; }
            render_request GET "/environments/$id" | python3 -m json.tool
            ;;
        create)
            local name="" project=""
            while [[ $# -gt 0 ]]; do
                case "$1" in
                    --project|-p) project="$2"; shift 2 ;;
                    --name) name="$2"; shift 2 ;;
                    *) [[ -z "$name" ]] && name="$1" || true; shift ;;
                esac
            done
            [[ -z "$name" || -z "$project" ]] && { echo "Usage: agent-render environment create <name> --project <project-id>"; return 1; }
            local body; body=$(python3 -c "
import json,sys; print(json.dumps({'name': sys.argv[1], 'projectId': sys.argv[2]}))
" "$name" "$project")
            render_request_checked POST "/environments" "$body" | python3 -m json.tool
            ;;
        delete|del|rm)
            local id="${1:-}"; local confirm=0; shift || true
            while [[ $# -gt 0 ]]; do [[ "$1" == --yes ]] && confirm=1; shift; done
            [[ "$confirm" != "1" ]] && { echo "Refusing without --yes" >&2; return 1; }
            render_request_checked DELETE "/environments/$id" > /dev/null && echo "Deleted"
            ;;
        link)
            local env="${1:-}"; shift
            [[ -z "$env" ]] && { echo "Usage: agent-render environment link <env> --resource <id>..."; return 1; }
            local -a resources=()
            while [[ $# -gt 0 ]]; do
                case "$1" in --resource) resources+=("$2"); shift 2 ;; *) shift ;; esac
            done
            local body; body=$(python3 -c "
import json, sys
print(json.dumps({'resourceIds': sys.argv[1:]}))
" "${resources[@]}")
            render_request_checked POST "/environments/$env/resources" "$body" > /dev/null && echo "Linked resources"
            ;;
        unlink)
            local env="${1:-}"; shift
            local -a resources=()
            while [[ $# -gt 0 ]]; do
                case "$1" in --resource) resources+=("$2"); shift 2 ;; *) shift ;; esac
            done
            local body; body=$(python3 -c "
import json, sys
print(json.dumps({'resourceIds': sys.argv[1:]}))
" "${resources[@]}")
            render_request_checked DELETE "/environments/$env/resources" "$body" > /dev/null && echo "Unlinked resources"
            ;;
        *) echo "Usage: agent-render environment {list|show|create|delete|link|unlink} ..."; return 1 ;;
    esac
}

# =====================================================================
# Webhooks
# =====================================================================

cmd_webhook() {
    local subcmd="${1:-list}"; shift || true
    case "$subcmd" in
        list|ls)
            render_request GET "/webhooks?limit=50" | python3 -c "
import sys, json
items = json.load(sys.stdin)
if not items: print('No webhooks'); sys.exit(0)
for item in items:
    w = item.get('webhook', item)
    print(f\"{w.get('id', '')}  {w.get('name', '')}  enabled:{w.get('enabled', False)}  {w.get('url', '')}\")
"
            ;;
        show|get)
            local id="${1:-}"; [[ -z "$id" ]] && { echo "Usage: agent-render webhook show <id>"; return 1; }
            render_request GET "/webhooks/$id" | python3 -m json.tool
            ;;
        create)
            local name="" url="" owner="" enabled="true"
            local -a events=()
            while [[ $# -gt 0 ]]; do
                case "$1" in
                    --name) name="$2"; shift 2 ;;
                    --url) url="$2"; shift 2 ;;
                    --owner) owner="$2"; shift 2 ;;
                    --event) events+=("$2"); shift 2 ;;
                    --disabled) enabled="false"; shift ;;
                    *) shift ;;
                esac
            done
            [[ -z "$name" || -z "$url" ]] && { echo "Usage: agent-render webhook create --name X --url Y [--event T]..."; return 1; }
            [[ -z "$owner" ]] && owner=$(default_owner_id)
            owner=$(resolve_owner "$owner") || return 1
            [[ ${#events[@]} -eq 0 ]] && events=("deploy_ended" "deploy_started")
            local body
            body=$(python3 -c "
import sys, json
print(json.dumps({
    'name': sys.argv[1],
    'url': sys.argv[2],
    'ownerId': sys.argv[3],
    'enabled': sys.argv[4] == 'true',
    'eventFilter': {'eventTypes': sys.argv[5:]},
}))
" "$name" "$url" "$owner" "$enabled" "${events[@]}")
            render_request_checked POST "/webhooks" "$body" | python3 -m json.tool
            ;;
        update)
            local id="${1:-}"; shift
            local enabled=""
            while [[ $# -gt 0 ]]; do
                case "$1" in --enable) enabled="true"; shift ;; --disable) enabled="false"; shift ;; *) shift ;; esac
            done
            local body; body=$(python3 -c "
import sys, json
out = {}
if sys.argv[1]: out['enabled'] = sys.argv[1] == 'true'
print(json.dumps(out))
" "$enabled")
            render_request_checked PATCH "/webhooks/$id" "$body" > /dev/null && echo "Updated webhook"
            ;;
        delete|del|rm)
            local id="${1:-}"; local confirm=0; shift || true
            while [[ $# -gt 0 ]]; do [[ "$1" == --yes ]] && confirm=1; shift; done
            [[ "$confirm" != "1" ]] && { echo "Refusing without --yes" >&2; return 1; }
            render_request_checked DELETE "/webhooks/$id" > /dev/null && echo "Deleted webhook"
            ;;
        events)
            local id="${1:-}"; [[ -z "$id" ]] && { echo "Usage: agent-render webhook events <id>"; return 1; }
            render_request GET "/webhooks/$id/events?limit=20" | python3 -m json.tool
            ;;
        *) echo "Usage: agent-render webhook {list|show|create|update|delete|events} ..."; return 1 ;;
    esac
}

# =====================================================================
# Notification settings
# =====================================================================

cmd_notify() {
    local subcmd="${1:-show}"; shift || true
    case "$subcmd" in
        show)
            local owner="${1:-}"
            [[ -z "$owner" ]] && owner=$(default_owner_id)
            owner=$(resolve_owner "$owner") || return 1
            render_request GET "/notification-settings/owners/$owner" | python3 -m json.tool
            ;;
        update)
            local owner="" body_file=""
            while [[ $# -gt 0 ]]; do
                case "$1" in
                    --owner) owner="$2"; shift 2 ;;
                    --from-file) body_file="$2"; shift 2 ;;
                    *) shift ;;
                esac
            done
            [[ -z "$owner" ]] && owner=$(default_owner_id)
            owner=$(resolve_owner "$owner") || return 1
            local body
            if [[ -n "$body_file" ]]; then
                body=$(cat "$body_file")
            else
                body=$(cat)
            fi
            render_request_checked PATCH "/notification-settings/owners/$owner" "$body" > /dev/null && \
                echo "Updated notification settings"
            ;;
        overrides)
            local owner="${1:-}"
            [[ -z "$owner" ]] && owner=$(default_owner_id)
            owner=$(resolve_owner "$owner") || return 1
            render_request GET "/notification-settings/overrides?ownerId=$owner" | python3 -m json.tool
            ;;
        override)
            local svc="${1:-}"
            [[ -z "$svc" ]] && { echo "Usage: agent-render notify override <svc>"; return 1; }
            local sid; sid=$(resolve_service "$svc") || return 1
            render_request GET "/notification-settings/overrides/services/$sid" | python3 -m json.tool
            ;;
        *) echo "Usage: agent-render notify {show|update|overrides|override} ..."; return 1 ;;
    esac
}

# =====================================================================
# Audit logs
# =====================================================================

cmd_audit() {
    local owner=""
    local limit="20"
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --owner) owner="$2"; shift 2 ;;
            --limit) limit="$2"; shift 2 ;;
            *) shift ;;
        esac
    done
    [[ -z "$owner" ]] && owner=$(default_owner_id)
    owner=$(resolve_owner "$owner") || return 1
    render_request GET "/owners/$owner/audit-logs?limit=$limit" | python3 -c "
import sys, json
data = json.load(sys.stdin)
if isinstance(data, dict) and 'message' in data:
    print(f\"Render: {data['message']}\"); sys.exit(0)
if not data: print('No audit log entries'); sys.exit(0)
for item in data:
    e = item.get('auditLog', item) if isinstance(item, dict) else {}
    actor = e.get('actor', {}) or {}
    resource = e.get('resource', {}) or {}
    print(f\"{e.get('timestamp', '')}  {e.get('action', '')}  by:{actor.get('email', '?')}  on:{resource.get('id', '?')}\")
"
}

# =====================================================================
# Maintenance windows
# =====================================================================

cmd_maintenance() {
    local subcmd="${1:-list}"; shift || true
    case "$subcmd" in
        list|ls)
            render_request GET "/maintenance?limit=20" | python3 -c "
import sys, json
items = json.load(sys.stdin)
if not items: print('No maintenance runs'); sys.exit(0)
for item in items:
    m = item.get('maintenance', item)
    print(f\"{m.get('id', '')}  {m.get('status', '')}  scheduled:{m.get('scheduledFor', '')}\")
"
            ;;
        show|get)
            local id="${1:-}"
            [[ -z "$id" ]] && { echo "Usage: agent-render maintenance show <id>"; return 1; }
            render_request GET "/maintenance/$id" | python3 -m json.tool
            ;;
        reschedule)
            local id="${1:-}" when="${2:-}"
            [[ -z "$id" || -z "$when" ]] && { echo "Usage: agent-render maintenance reschedule <id> <ISO-datetime>"; return 1; }
            local body; body=$(python3 -c "import json,sys; print(json.dumps({'scheduledFor': sys.argv[1]}))" "$when")
            render_request_checked PATCH "/maintenance/$id" "$body" > /dev/null && echo "Rescheduled"
            ;;
        trigger)
            local id="${1:-}"
            [[ -z "$id" ]] && { echo "Usage: agent-render maintenance trigger <id>"; return 1; }
            render_request_checked POST "/maintenance/$id/trigger" > /dev/null && echo "Maintenance triggered"
            ;;
        *) echo "Usage: agent-render maintenance {list|show|reschedule|trigger} ..."; return 1 ;;
    esac
}

# --- Main ---

case "${1:-help}" in
    # --- workspace primitives ---
    owners) cmd_owners ;;
    whoami|me) cmd_whoami ;;
    audit|audit-logs) shift; cmd_audit "$@" ;;

    # --- services ---
    services|ls|list) cmd_services ;;
    show|get) shift; cmd_show "$@" ;;
    create) shift; cmd_create "$@" ;;
    update|patch) shift; cmd_update "$@" ;;
    delete|destroy|rm) shift; cmd_delete "$@" ;;
    cache-purge|purge-cache) shift; cmd_cache_purge "$@" ;;
    events) shift; cmd_events "$@" ;;
    instances) shift; cmd_instances "$@" ;;
    restart) shift; cmd_restart "$@" ;;
    suspend) shift; cmd_suspend "$@" ;;
    resume) shift; cmd_resume "$@" ;;
    scale) shift; cmd_scale "$@" ;;
    autoscaling|autoscale) shift; cmd_autoscaling "$@" ;;

    # --- deploys ---
    deploy)
        shift
        # Support `deploy show <svc> <id>` and `deploy cancel <svc> <id>`
        case "${1:-}" in
            show) shift; cmd_deploy_show "$@" ;;
            cancel) shift; cmd_deploy_cancel "$@" ;;
            *) cmd_deploy "$@" ;;
        esac
        ;;
    deploys) shift; cmd_deploys "$@" ;;
    rollback) shift; cmd_rollback "$@" ;;

    # --- one-off jobs ---
    jobs) shift; cmd_jobs "$@" ;;
    job)
        shift
        case "${1:-}" in
            run) shift; cmd_job_run "$@" ;;
            show|get) shift; cmd_job_show "$@" ;;
            cancel) shift; cmd_job_cancel "$@" ;;
            *) echo "Usage: agent-render job {run|show|cancel} <svc> ..." ;;
        esac
        ;;

    # --- cron ---
    cron)
        shift
        case "${1:-}" in
            run|trigger) shift; cmd_cron_run "$@" ;;
            cancel) shift; cmd_cron_cancel "$@" ;;
            *) echo "Usage: agent-render cron {run|cancel} <cron>" ;;
        esac
        ;;

    # --- env vars / secret files ---
    env) shift; cmd_env "$@" ;;
    env-set) shift; cmd_env_set "$@" ;;
    env-del|env-delete|env-rm) shift; cmd_env_del "$@" ;;
    secret|secrets|secret-file) shift; cmd_secret "$@" ;;

    # --- env groups ---
    env-group|envgroup|eg) shift; cmd_env_group "$@" ;;

    # --- postgres (extended) ---
    db|postgres)
        shift || true
        case "${1:-list}" in
            list|ls|show|get) cmd_db "$@" ;;
            create) shift; cmd_db_create "$@" ;;
            update|patch) shift; cmd_db_update "$@" ;;
            delete|del|rm) shift; cmd_db_delete "$@" ;;
            suspend|resume|restart|failover) action="$1"; shift; cmd_db_lifecycle "$action" "$@" ;;
            connect-info|conn|connection-info) shift; cmd_db_connect_info "$@" ;;
            backup) shift; cmd_db_backup "$@" ;;
            backups) shift; cmd_db_backups "$@" ;;
            recover|recovery) shift; cmd_db_recover "$@" ;;
            creds|credentials) shift; cmd_db_creds "$@" ;;
            *) cmd_db "$@" ;;
        esac
        ;;

    # --- key value ---
    kv|key-value|keyvalue|redis) shift; cmd_kv "$@" ;;

    # --- domains ---
    domains) shift; cmd_domains "$@" ;;
    domain) shift; cmd_domain "$@" ;;

    # --- headers / routes ---
    header|headers) shift; cmd_header "$@" ;;
    route|routes) shift; cmd_route "$@" ;;

    # --- blueprints ---
    blueprint|blueprints|bp) shift; cmd_blueprint "$@" ;;

    # --- disks ---
    disk|disks) shift; cmd_disk "$@" ;;

    # --- dedicated IPs ---
    dedicated-ip|dedicated-ips|ip) shift; cmd_dedicated_ip "$@" ;;

    # --- registry creds ---
    registry|registry-cred|registries) shift; cmd_registry "$@" ;;

    # --- projects / environments ---
    projects) cmd_projects ;;
    project) shift; cmd_project "$@" ;;
    environment|environments|env-project) shift; cmd_environment "$@" ;;

    # --- webhooks ---
    webhook|webhooks) shift; cmd_webhook "$@" ;;

    # --- notifications ---
    notify|notification|notifications) shift; cmd_notify "$@" ;;

    # --- maintenance ---
    maintenance|maint) shift; cmd_maintenance "$@" ;;

    # --- observability ---
    logs) shift; cmd_logs "$@" ;;
    metrics) shift; cmd_metrics "$@" ;;
    snapshot|snap) cmd_snapshot ;;

    help|--help|-h) show_help ;;
    *)
        echo "Unknown command: $1" >&2
        echo "Try: agent-render --help" >&2
        exit 1
        ;;
esac
