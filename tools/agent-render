items = json.load(sys.stdin)
if not items: print('No credentials'); sys.exit(0)
for item in items:
    c = item.get('credential', item)
    print(f\"{c.get('username', '')}  ({c.get('id', '')})\")
"
            ;;
        add|create)
            local user="${1:-}"
            [[ -z "$user" ]] && { echo "Usage: agent-render db creds add <db> <username>"; return 1; }
            local body
            body=$(python3 -c "import json,sys; print(json.dumps({'username': sys.argv[1]}))" "$user")
            render_request_checked POST "/postgres/$dbid/credentials" "$body" | python3 -m json.tool
            ;;
        del|delete|rm)
            local user="${1:-}"
            [[ -z "$user" ]] && { echo "Usage: agent-render db creds del <db> <username>"; return 1; }
            render_request_checked DELETE "/postgres/$dbid/credentials/$user" > /dev/null && \
                echo "Deleted credential: $user"
            ;;
        *) echo "Unknown subcommand: $subcmd"; return 1 ;;
    esac
}

# =====================================================================
# Key Value (Redis-compatible)
# =====================================================================

resolve_kv() {
    local name_or_id="$1"
    if [[ "$name_or_id" == red-* || "$name_or_id" == kv-* ]]; then
        echo "$name_or_id"; return 0
    fi
    local result; result=$(render_request GET "/key-value?limit=100")
    local id
    id=$(echo "$result" | python3 -c "
import sys, json
name = '$name_or_id'
items = json.load(sys.stdin)
for item in items:
    kv = item.get('keyValue', item)
    if kv.get('name', '') == name: print(kv.get('id', '')); break
" 2>/dev/null)
    if [[ -z "$id" ]]; then
        echo "Error: Key Value '$name_or_id' not found" >&2; return 1
    fi
    echo "$id"
}

cmd_kv() {
    local subcmd="${1:-list}"; shift || true
    case "$subcmd" in
        list|ls)
            render_request GET "/key-value?limit=50" | python3 -c "
import sys, json
items = json.load(sys.stdin)
if not items: print('No Key Value instances'); sys.exit(0)
for item in items:
    kv = item.get('keyValue', item)
    print(f\"{kv.get('id', '')}  {kv.get('name', '')}  [{kv.get('plan', '')}]  {kv.get('status', '')}  {kv.get('region', '')}\")
"
            ;;
        show|get)
            local id="${1:-}"; [[ -z "$id" ]] && { echo "Usage: agent-render kv show <kv>"; return 1; }
            local kvid; kvid=$(resolve_kv "$id") || return 1
            render_request GET "/key-value/$kvid" | python3 -m json.tool
            ;;
        create)
            local name="" plan="free" region="oregon" owner="" persist=""
            while [[ $# -gt 0 ]]; do
                case "$1" in
                    --plan) plan="$2"; shift 2 ;;
                    --region) region="$2"; shift 2 ;;
                    --owner) owner="$2"; shift 2 ;;
                    --persist) persist="$2"; shift 2 ;;
                    *) [[ -z "$name" ]] && name="$1" || true; shift ;;
                esac
            done
            [[ -z "$name" ]] && { echo "Usage: agent-render kv create <name> [--plan p] [--region r]"; return 1; }
            if [[ -z "$owner" ]]; then
                owner=$(default_owner_id) || true
                [[ -z "$owner" ]] && { echo "Error: --owner required" >&2; return 1; }
            else
                owner=$(resolve_owner "$owner") || return 1
            fi
            local body
            body=$(python3 -c "
import sys, json
out = {'name': sys.argv[1], 'plan': sys.argv[2], 'region': sys.argv[3], 'ownerId': sys.argv[4]}
if sys.argv[5]: out['persistenceMode'] = sys.argv[5]
print(json.dumps(out))
" "$name" "$plan" "$region" "$owner" "$persist")
            render_request_checked POST "/key-value" "$body" | python3 -c "
import sys, json
kv = json.load(sys.stdin)
print(f\"Created: {kv.get('name', '')} ({kv.get('id', '')})\")
print(f\"Plan: {kv.get('plan', '')}\")
"
            ;;
        update)
            local id="${1:-}"; shift
            local kvid; kvid=$(resolve_kv "$id") || return 1
            local plan="" name=""
            while [[ $# -gt 0 ]]; do
                case "$1" in --plan) plan="$2"; shift 2 ;; --name) name="$2"; shift 2 ;; *) shift ;; esac
            done
            local body
            body=$(python3 -c "
import sys, json
out = {}
if sys.argv[1]: out['plan'] = sys.argv[1]
if sys.argv[2]: out['name'] = sys.argv[2]
print(json.dumps(out))
" "$plan" "$name")
            render_request_checked PATCH "/key-value/$kvid" "$body" > /dev/null && echo "Updated $id"
            ;;
        delete|del|rm)
            local id="${1:-}"; local confirm=0; shift || true
            while [[ $# -gt 0 ]]; do [[ "$1" == --yes ]] && confirm=1; shift; done
            [[ "$confirm" != "1" ]] && { echo "Refusing without --yes" >&2; return 1; }
            local kvid; kvid=$(resolve_kv "$id") || return 1
            render_request_checked DELETE "/key-value/$kvid" > /dev/null && echo "Deleted $id"
            ;;
        connect-info|conn)
            local kvid; kvid=$(resolve_kv "${1:-}") || return 1
            render_request GET "/key-value/$kvid/connection-info" | python3 -m json.tool
            ;;
        suspend|resume)
            local kvid; kvid=$(resolve_kv "${1:-}") || return 1
            render_request_checked POST "/key-value/$kvid/$subcmd" > /dev/null && echo "Key Value $subcmd: ${1}"
            ;;
        *) echo "Usage: agent-render kv {list|show|create|update|delete|connect-info|suspend|resume}"; return 1 ;;
    esac
}

