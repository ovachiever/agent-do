show_create_help() {
    cat <<'EOF'
Usage: agent-render create <type> <name> [options]

Types: web | worker | static | private | cron

Common options:
  --owner <id-or-name>       Required if not derivable (see `agent-render owners`)
  --repo <git-url>           Git repo URL (e.g. https://github.com/me/proj)
  --branch <name>            Default: main
  --root-dir <path>          Sub-directory containing the project
  --runtime <r>              node|python|ruby|go|rust|elixir|docker|image (default: node for web/worker/cron, none for static)
  --build "<cmd>"            Build command
  --start "<cmd>"            Start command (web/worker/private)
  --schedule "<cron>"        Cron schedule (cron type only, e.g. "0 12 * * *")
  --plan <p>                 starter|standard|pro|pro_plus|pro_max|pro_ultra (default: starter)
  --region <r>               oregon|frankfurt|singapore|ohio|virginia (default: oregon)
  --env KEY=VAL              Env var (repeatable)
  --env-from-group <eg-id>   Link env group at creation
  --health-check <path>      Web service health check path
  --instances <n>            Number of instances (web/worker/private; default 1)
  --disk-name <n> --disk-size <gb> --disk-mount <path>   Attach persistent disk
  --no-auto-deploy           Disable auto-deploy on push
  --publish-path <path>      Static site only (default: ./)
  --image <ref>              Docker image (when --runtime image)
  --dry-run                  Print the JSON body that would be POSTed; do not call API
  --json                     Emit full API response

Examples:
  agent-render create web my-api --repo https://github.com/me/api \
    --build "npm install && npm run build" --start "npm start" \
    --env DATABASE_URL='postgres://...' --env NODE_ENV=production
  agent-render create cron daily-task --repo https://github.com/me/jobs \
    --schedule "0 12 * * *" --build "npm install" --start "node daily.js"
  agent-render create static landing --repo https://github.com/me/site \
    --build "npm run build" --publish-path ./dist
EOF
}

cmd_create() {
    if [[ $# -eq 0 ]] || is_help_arg "${1:-}"; then
        show_create_help
        return 0
    fi

    local type_raw="$1"; shift
    local name="${1:-}"
    if [[ -z "$name" || "$name" == --* ]]; then
        echo "Error: service name required" >&2
        show_create_help
        return 1
    fi
    [[ "$name" != --* ]] && shift

    # Normalize type
    local service_type
    case "$type_raw" in
        web|web_service) service_type="web_service" ;;
        worker|background_worker) service_type="background_worker" ;;
        static|static_site) service_type="static_site" ;;
        private|private_service) service_type="private_service" ;;
        cron|cron_job) service_type="cron_job" ;;
        *) echo "Error: unknown type '$type_raw' (use web|worker|static|private|cron)" >&2; return 1 ;;
    esac

    local owner=""
    local repo="" branch="main" root_dir=""
    local runtime=""
    local build="" start="" schedule=""
    local plan="" region="oregon"
    local image_ref=""
    local health=""
    local instances=""
    local disk_name="" disk_size="" disk_mount=""
    local publish_path=""
    local auto_deploy="yes"
    local json_output=0
    local dry_run=0
    local -a env_pairs=()
    local -a env_groups=()

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --owner) owner="$2"; shift 2 ;;
            --repo) repo="$2"; shift 2 ;;
            --branch) branch="$2"; shift 2 ;;
            --root-dir) root_dir="$2"; shift 2 ;;
            --runtime) runtime="$2"; shift 2 ;;
            --build) build="$2"; shift 2 ;;
            --start) start="$2"; shift 2 ;;
            --schedule) schedule="$2"; shift 2 ;;
            --plan) plan="$2"; shift 2 ;;
            --region) region="$2"; shift 2 ;;
            --env) env_pairs+=("$2"); shift 2 ;;
            --env-from-group) env_groups+=("$2"); shift 2 ;;
            --health-check) health="$2"; shift 2 ;;
            --instances) instances="$2"; shift 2 ;;
            --disk-name) disk_name="$2"; shift 2 ;;
            --disk-size) disk_size="$2"; shift 2 ;;
            --disk-mount) disk_mount="$2"; shift 2 ;;
            --publish-path) publish_path="$2"; shift 2 ;;
            --image) image_ref="$2"; shift 2 ;;
            --no-auto-deploy) auto_deploy="no"; shift ;;
            --dry-run) dry_run=1; shift ;;
            --json) json_output=1; shift ;;
            *) echo "Error: unknown option '$1'" >&2; return 1 ;;
        esac
    done

    # Resolve owner
    if [[ -z "$owner" ]]; then
        owner=$(default_owner_id)
        [[ -z "$owner" ]] && { echo "Error: --owner required (no owner derivable)" >&2; return 1; }
    else
        owner=$(resolve_owner "$owner") || return 1
    fi

    # Default runtimes
    if [[ -z "$runtime" ]]; then
        case "$service_type" in
            static_site) runtime="" ;;
            *) runtime="node" ;;
        esac
    fi

    # Default plan
    if [[ -z "$plan" ]]; then
        case "$service_type" in
            static_site) plan="" ;;
            *) plan="starter" ;;
        esac
    fi

    # Build the JSON body in python (cleanest path through nested oneOf shapes)
    # Build env vars JSON
    local body
    local env_json="[]"
    if [[ ${#env_pairs[@]} -gt 0 ]]; then
        env_json=$(python3 -c "
import sys, json
pairs = sys.argv[1:]
out = []
for p in pairs:
    if '=' not in p:
        continue
    k, v = p.split('=', 1)
    out.append({'key': k, 'value': v})
print(json.dumps(out))
" "${env_pairs[@]}")
    fi

    # Build serviceDetails per type
    local sd_json
    sd_json=$(python3 -c "
import sys, json
st = sys.argv[1]
runtime = sys.argv[2]
plan = sys.argv[3]
region = sys.argv[4]
build = sys.argv[5]
start = sys.argv[6]
schedule = sys.argv[7]
health = sys.argv[8]
instances = sys.argv[9]
publish_path = sys.argv[10]
disk_name = sys.argv[11]
disk_size = sys.argv[12]
disk_mount = sys.argv[13]
image_ref = sys.argv[14]

sd = {}
if region: sd['region'] = region
if plan: sd['plan'] = plan
if runtime: sd['runtime'] = runtime
if instances: sd['numInstances'] = int(instances)
if health and st == 'web_service': sd['healthCheckPath'] = health
if publish_path and st == 'static_site': sd['publishPath'] = publish_path

# envSpecificDetails
esd = {}
if image_ref and runtime == 'image':
    # docker-image-based; minimal: registry/image ref handled by separate field
    pass
elif runtime == 'docker':
    if build: esd['dockerCommand'] = build  # not exact mapping
else:
    if build: esd['buildCommand'] = build
    if start and st != 'static_site': esd['startCommand'] = start
if esd and st != 'static_site':
    sd['envSpecificDetails'] = esd
elif st == 'static_site' and build:
    sd['buildCommand'] = build

if st == 'cron_job':
    sd['schedule'] = schedule or ''

if disk_name and disk_size and disk_mount and st != 'static_site' and st != 'cron_job':
    sd['disk'] = {'name': disk_name, 'sizeGB': int(disk_size), 'mountPath': disk_mount}

print(json.dumps(sd))
" "$service_type" "$runtime" "$plan" "$region" "$build" "$start" "$schedule" "$health" "$instances" "$publish_path" "$disk_name" "$disk_size" "$disk_mount" "$image_ref")

    # Compose full body
    body=$(python3 -c "
import sys, json
st = sys.argv[1]
name = sys.argv[2]
owner = sys.argv[3]
auto = sys.argv[4]
repo = sys.argv[5]
branch = sys.argv[6]
root_dir = sys.argv[7]
image_ref = sys.argv[8]
env_vars = json.loads(sys.argv[9])
sd = json.loads(sys.argv[10])
env_group_ids = sys.argv[11].split(',') if sys.argv[11] else []

body = {'type': st, 'name': name, 'ownerId': owner, 'autoDeploy': auto}
if repo: body['repo'] = repo
if repo and branch: body['branch'] = branch
if root_dir: body['rootDir'] = root_dir
if image_ref:
    body['image'] = {'ownerId': owner, 'imagePath': image_ref}
if env_vars: body['envVars'] = env_vars
if sd: body['serviceDetails'] = sd
print(json.dumps(body))
" "$service_type" "$name" "$owner" "$auto_deploy" "$repo" "$branch" "$root_dir" "$image_ref" "$env_json" "$sd_json" "$(IFS=,; echo "${env_groups[*]:-}")")

    if [[ "$dry_run" == "1" ]]; then
        echo "$body" | python3 -m json.tool
        return 0
    fi

    local result
    result=$(render_request_checked POST "/services" "$body") || return 1

    if [[ "$json_output" == "1" ]]; then
        echo "$result"
        return 0
    fi

    echo "$result" | python3 -c "
import sys, json
data = json.load(sys.stdin)
svc = data.get('service', data)
print(f\"Created: {svc.get('name', '')} ({svc.get('id', '')})\")
print(f\"Type:    {svc.get('type', '')}\")
print(f\"URL:     {svc.get('serviceDetails', {}).get('url', '(building)')}\")
deploy = data.get('deployId', '')
if deploy:
    print(f\"Deploy:  {deploy}\")
"

    # Link env groups if requested (separate API calls)
    if [[ ${#env_groups[@]} -gt 0 ]]; then
        local svc_id
        svc_id=$(echo "$result" | python3 -c "
import sys, json
d = json.load(sys.stdin)
print(d.get('service', d).get('id', ''))
" 2>/dev/null)
        for eg in "${env_groups[@]}"; do
            render_request POST "/env-groups/$eg/services/$svc_id" > /dev/null && \
                echo "Linked env group: $eg"
        done
    fi
}

cmd_update() {
    local name_or_id="${1:-}"
    if [[ -z "$name_or_id" || ! "$name_or_id" =~ ^(srv-|crn-) ]] && [[ -z "$name_or_id" ]]; then
        echo "Usage: agent-render update <service> [--name X] [--branch Y] [--root-dir Z] [--auto-deploy yes|no]"
        return 1
    fi
    shift

    local sid
    sid=$(resolve_service "$name_or_id") || return 1

    local new_name="" branch="" root_dir="" auto_deploy=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --name) new_name="$2"; shift 2 ;;
            --branch) branch="$2"; shift 2 ;;
            --root-dir) root_dir="$2"; shift 2 ;;
            --auto-deploy) auto_deploy="$2"; shift 2 ;;
            *) echo "Error: unknown option '$1'" >&2; return 1 ;;
        esac
    done

    local body
    body=$(python3 -c "
import sys, json
out = {}
if sys.argv[1]: out['name'] = sys.argv[1]
if sys.argv[2]: out['branch'] = sys.argv[2]
if sys.argv[3]: out['rootDir'] = sys.argv[3]
if sys.argv[4]: out['autoDeploy'] = sys.argv[4]
print(json.dumps(out))
" "$new_name" "$branch" "$root_dir" "$auto_deploy")

    if [[ "$body" == "{}" ]]; then
        echo "Error: nothing to update" >&2
        return 1
    fi

    render_request_checked PATCH "/services/$sid" "$body" > /dev/null && \
        echo "Updated: $name_or_id ($sid)"
}

cmd_delete() {
    local name_or_id="${1:-}"
    local confirm=0
    shift || true
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --yes|-y) confirm=1; shift ;;
            *) shift ;;
        esac
    done
    if [[ -z "$name_or_id" ]]; then
        echo "Usage: agent-render delete <service> --yes"
        return 1
    fi
    if [[ "$confirm" != "1" ]]; then
        echo "Refusing to delete '$name_or_id' without --yes" >&2
        return 1
    fi
    local sid
    sid=$(resolve_service "$name_or_id") || return 1
    render_request_checked DELETE "/services/$sid" > /dev/null && \
        echo "Deleted: $name_or_id ($sid)"
}

