}

cmd_env() {
    local name_or_id="${1:-}"
    if [[ -z "$name_or_id" ]]; then
        echo "Usage: agent-render env <service>"
        return 1
    fi

    local sid
    sid=$(resolve_service "$name_or_id") || return 1

    # Fetch all env vars (limit=100 covers virtually all services)
    local result
    result=$(render_request GET "/services/$sid/env-vars?limit=100")

    echo "$result" | python3 -c "
import sys, json
items = json.load(sys.stdin)
if not items:
    print('No env vars')
    sys.exit(0)
for item in items:
    ev = item.get('envVar', item)
    key = ev.get('key', '')
    val = ev.get('value', '')
    if val:
        # Mask values longer than 8 chars
        display = val[:4] + '****' if len(val) > 8 else val
    else:
        display = '(generateValue)' if ev.get('generateValue') else '(empty)'
    print(f'{key}={display}')
"
}

cmd_env_set() {
    local name_or_id="${1:-}"
    local key="${2:-}"
    local val="${3:-}"

    if [[ -z "$name_or_id" ]] || [[ -z "$key" ]] || [[ -z "$val" ]]; then
        echo "Usage: agent-render env-set <service> <KEY> <VALUE>"
        return 1
    fi

    local sid
    sid=$(resolve_service "$name_or_id") || return 1

    # JSON-escape the value
    local escaped_val
    escaped_val=$(json_escape "$val")

    # CRITICAL: Use per-key PUT endpoint to upsert a single env var.
    # The collection PUT (PUT /services/:id/env-vars) REPLACES ALL vars — destructive.
    # The per-key PUT (PUT /services/:id/env-vars/:key) upserts safely.
    local body="{\"value\": $escaped_val}"

    render_request PUT "/services/$sid/env-vars/$key" "$body" > /dev/null
    echo "Set $key on $name_or_id ($sid)"
}

cmd_env_del() {
    local name_or_id="${1:-}"
    local key="${2:-}"

    if [[ -z "$name_or_id" ]] || [[ -z "$key" ]]; then
        echo "Usage: agent-render env-del <service> <KEY>"
        return 1
    fi

    local sid
    sid=$(resolve_service "$name_or_id") || return 1

    # Render's env-var delete: PUT with the key removed from the list
    # Actually, use DELETE on the specific key
    render_request DELETE "/services/$sid/env-vars/$key" > /dev/null
    echo "Deleted $key from $name_or_id ($sid)"
}

