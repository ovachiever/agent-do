cmd_instances() {
    local name_or_id="${1:-}"
    if [[ -z "$name_or_id" ]]; then
        echo "Usage: agent-render instances <service>"
        return 1
    fi
    local sid
    sid=$(resolve_service "$name_or_id") || return 1
    local result
    result=$(render_request GET "/services/$sid/instances")
    echo "$result" | python3 -c "
import sys, json
items = json.load(sys.stdin)
if not items: print('No running instances'); sys.exit(0)
for item in items:
    inst = item.get('instance', item)
    print(f\"{inst.get('id', '')}  {inst.get('status', '')}  started:{inst.get('startedAt', '')}\")
"
}

cmd_autoscaling() {
    local subcmd="${1:-help}"
    shift || true
    case "$subcmd" in
        show)
            local sid; sid=$(resolve_service "${1:-}") || return 1
            render_request GET "/services/$sid" | python3 -c "
import sys, json
svc = json.load(sys.stdin)
a = svc.get('serviceDetails', {}).get('autoscaling') or {}
if not a: print('Autoscaling: disabled'); sys.exit(0)
print(f\"Enabled: {a.get('enabled', False)}\")
print(f\"Min/Max: {a.get('min', '?')}/{a.get('max', '?')}\")
print(f\"Criteria: {json.dumps(a.get('criteria', {}), indent=2)}\")
"
            ;;
        enable|set)
            local svc="" min="" max="" cpu="" mem=""
            while [[ $# -gt 0 ]]; do
                case "$1" in
                    --min) min="$2"; shift 2 ;;
                    --max) max="$2"; shift 2 ;;
                    --cpu) cpu="$2"; shift 2 ;;
                    --memory) mem="$2"; shift 2 ;;
                    *) svc="$1"; shift ;;
                esac
            done
            [[ -z "$svc" ]] && { echo "Usage: agent-render autoscaling enable <svc> --min N --max N --cpu PCT --memory PCT" >&2; return 1; }
            local sid; sid=$(resolve_service "$svc") || return 1
            local body
            body=$(python3 -c "
import sys, json
out = {'enabled': True}
if sys.argv[1]: out['min'] = int(sys.argv[1])
if sys.argv[2]: out['max'] = int(sys.argv[2])
crit = {}
if sys.argv[3]: crit['cpu'] = {'enabled': True, 'percentage': int(sys.argv[3])}
if sys.argv[4]: crit['memory'] = {'enabled': True, 'percentage': int(sys.argv[4])}
if crit: out['criteria'] = crit
print(json.dumps(out))
" "$min" "$max" "$cpu" "$mem")
            render_request_checked PUT "/services/$sid/autoscaling" "$body" > /dev/null && \
                echo "Autoscaling enabled: $svc"
            ;;
        disable)
            local sid; sid=$(resolve_service "${1:-}") || return 1
            render_request_checked DELETE "/services/$sid/autoscaling" > /dev/null && \
                echo "Autoscaling disabled"
            ;;
        *)
            echo "Usage: agent-render autoscaling {show|enable|disable} <svc> [opts]"
            return 1
            ;;
    esac
}

