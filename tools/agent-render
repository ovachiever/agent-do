# --- Helpers ---

render_request() {
    local method="$1"
    local endpoint="$2"
    local data="${3:-}"
    local token="${RENDER_API_KEY:-}"

    if [[ -z "$token" ]]; then
        echo "Error: RENDER_API_KEY not set" >&2
        return 1
    fi

    local args=(-s -X "$method" "${RENDER_API}${endpoint}" \
        -H "Authorization: Bearer $token" \
        -H "Accept: application/json" \
        -H "Content-Type: application/json")

    if [[ -n "$data" ]]; then
        args+=(-d "$data")
    fi

    curl "${args[@]}"
}

render_request_checked() {
    local method="$1"
    local endpoint="$2"
    local data="${3:-}"
    local token="${RENDER_API_KEY:-}"

    if [[ -z "$token" ]]; then
        echo "Error: RENDER_API_KEY not set" >&2
        return 1
    fi

    local tmp_body
    tmp_body="$(mktemp)"
    trap 'rm -f "$tmp_body"' RETURN

    local args=(-sS -o "$tmp_body" -w "%{http_code}" -X "$method" "${RENDER_API}${endpoint}" \
        -H "Authorization: Bearer $token" \
        -H "Accept: application/json" \
        -H "Content-Type: application/json")

    if [[ -n "$data" ]]; then
        args+=(-d "$data")
    fi

    local status
    status=$(curl "${args[@]}")
    local body
    body="$(cat "$tmp_body")"

    if [[ "$status" =~ ^2 ]]; then
        printf '%s' "$body"
        return 0
    fi

    echo "Error: Render API ${method} ${endpoint} returned HTTP ${status}" >&2
    if [[ -n "$body" ]]; then
        printf '%s\n' "$body" >&2
    fi
    return 1
}

resolve_service() {
    local name_or_id="$1"

    # Already an ID
    if [[ "$name_or_id" == srv-* ]]; then
        echo "$name_or_id"
        return 0
    fi

    # Resolve by name
    local result
    result=$(render_request GET "/services?name=${name_or_id}&limit=1")

    local service_id
    service_id=$(echo "$result" | python3 -c "
import sys, json
items = json.load(sys.stdin)
if items and len(items) > 0:
    print(items[0].get('service', {}).get('id', ''))
" 2>/dev/null)

    if [[ -z "$service_id" ]]; then
        echo "Error: Service '$name_or_id' not found" >&2
        return 1
    fi

    echo "$service_id"
}

resolve_postgres() {
    local name_or_id="$1"

    # Already an ID
    if [[ "$name_or_id" == dpg-* ]]; then
        echo "$name_or_id"
        return 0
    fi

    # Resolve by name
    local result
    result=$(render_request GET "/postgres?limit=100")

    local db_id
    db_id=$(echo "$result" | python3 -c "
import sys, json
name = '$name_or_id'
items = json.load(sys.stdin)
for item in items:
    db = item.get('postgres', item)
    if db.get('name', '') == name:
        print(db.get('id', ''))
        break
" 2>/dev/null)

    if [[ -z "$db_id" ]]; then
        echo "Error: PostgreSQL instance '$name_or_id' not found" >&2
        return 1
    fi

    echo "$db_id"
}

json_escape() {
    python3 -c "import json,sys; print(json.dumps(sys.argv[1]))" "$1"
}

is_help_arg() {
    local arg="${1:-}"
    [[ "$arg" == "--help" || "$arg" == "-h" || "$arg" == "help" ]]
}

urlencode_pairs() {
    python3 - "$@" <<'PY'
import sys, urllib.parse
pairs = []
for arg in sys.argv[1:]:
    key, value = arg.split("=", 1)
    pairs.append((key, value))
print(urllib.parse.urlencode(pairs))
PY
}

normalize_log_time() {
    python3 - "$1" <<'PY'
import re
import sys
from datetime import datetime, timedelta, timezone

raw = sys.argv[1].strip()
now = datetime.now(timezone.utc)

def emit(dt):
    print(dt.isoformat().replace("+00:00", "Z"))

if re.fullmatch(r"\d+", raw):
    emit(now - timedelta(minutes=int(raw)))
    raise SystemExit(0)

m = re.fullmatch(r"(\d+)([mhd])", raw, re.IGNORECASE)
if m:
    amount = int(m.group(1))
    unit = m.group(2).lower()
    if unit == "m":
        emit(now - timedelta(minutes=amount))
    elif unit == "h":
        emit(now - timedelta(hours=amount))
    else:
        emit(now - timedelta(days=amount))
    raise SystemExit(0)

try:
    dt = datetime.fromisoformat(raw.replace("Z", "+00:00"))
except ValueError:
    print(f"invalid time value: {raw}", file=sys.stderr)
    raise SystemExit(1)

if dt.tzinfo is None:
    dt = dt.replace(tzinfo=timezone.utc)
else:
    dt = dt.astimezone(timezone.utc)
emit(dt)
PY
}

show_logs_help() {
    cat <<'EOF'
Usage: agent-render logs <service> [options]

Options:
  --since <time>      Start of time range. Accepts minutes ago (`60`), duration (`1h`, `24h`, `7d`), or ISO timestamp.
  --until <time>      End of time range. Same formats as --since.
  --limit <n>         Max number of log entries to return (1-100, default: 20).
  --type <value>      Filter log type (for example: app, request, build). Repeatable.
  --level <value>     Filter severity level. Repeatable.
  --text <value>      Filter by log message text. Repeatable.
  --host <value>      Filter request log host. Repeatable.
  --method <value>    Filter request method. Repeatable.
  --status <value>    Filter request status code. Repeatable.
  --path <value>      Filter request path. Repeatable.
  --json              Print raw API response.
  --forward           Return oldest logs first.
  --backward          Return newest logs first (default).
  --help              Show this message.
EOF
}

append_multi_values() {
    local __target="$1"
    local raw="$2"
    local part
    IFS=',' read -r -a parts <<< "$raw"
    for part in "${parts[@]}"; do
        if [[ -n "$part" ]]; then
            eval "$__target+=(\"\$part\")"
        fi
    done
}

# --- Commands ---

cmd_services() {
    local result
    result=$(render_request GET "/services?limit=50")

    echo "$result" | python3 -c "
import sys, json
items = json.load(sys.stdin)
if not items:
    print('No services found')
    sys.exit(0)
for item in items:
    svc = item.get('service', item)
    stype = svc.get('type', svc.get('serviceDetails', {}).get('type', '?'))
    status = svc.get('suspended', 'unknown')
    state = 'suspended' if status == 'suspended' else 'active'
    url = svc.get('serviceDetails', {}).get('url', '') or ''
    name = svc.get('name', '')
    sid = svc.get('id', '')
    print(f'{sid}  {name}  [{stype}]  {state}  {url}')
"
}

