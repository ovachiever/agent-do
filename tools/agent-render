c = json.load(sys.stdin)
print(f\"Internal: {c.get('internalConnectionString', '')}\")
print(f\"External: {c.get('externalConnectionString', '')}\")
print(f\"PSQL:     {c.get('psqlCommand', '')}\")
"
}

cmd_db_backups() {
    local id="${1:-}"
    [[ -z "$id" ]] && { echo "Usage: agent-render db backups <db>"; return 1; }
    local dbid; dbid=$(resolve_postgres "$id") || return 1
    render_request GET "/postgres/$dbid/export" | python3 -c "
import sys, json
items = json.load(sys.stdin)
if not items: print('No exports'); sys.exit(0)
for item in items:
    e = item.get('export', item)
    print(f\"{e.get('id', '')}  {e.get('status', '')}  {e.get('createdAt', '')}\")
"
}

cmd_db_backup() {
    local id="${1:-}"
    [[ -z "$id" ]] && { echo "Usage: agent-render db backup <db>"; return 1; }
    local dbid; dbid=$(resolve_postgres "$id") || return 1
    render_request_checked POST "/postgres/$dbid/export" > /dev/null && \
        echo "Backup export triggered for $id"
}

cmd_db_recover() {
    local id="${1:-}"; shift || true
    [[ -z "$id" ]] && { echo "Usage: agent-render db recover <db> [--target-time ISO]"; return 1; }
    local dbid; dbid=$(resolve_postgres "$id") || return 1
    local target=""
    while [[ $# -gt 0 ]]; do
        case "$1" in --target-time) target="$2"; shift 2 ;; *) shift ;; esac
    done
    if [[ -z "$target" ]]; then
        # Check available recovery window
        render_request GET "/postgres/$dbid/recovery" | python3 -m json.tool
    else
        local body
        body=$(python3 -c "import json,sys; print(json.dumps({'targetTime': sys.argv[1]}))" "$target")
        render_request_checked POST "/postgres/$dbid/recovery" "$body" > /dev/null && \
            echo "Recovery initiated to $target"
    fi
}

cmd_db_creds() {
    local subcmd="${1:-list}"; shift || true
    local id="${1:-}"; shift || true
    [[ -z "$id" ]] && { echo "Usage: agent-render db creds {list|add|del} <db> [user]"; return 1; }
    local dbid; dbid=$(resolve_postgres "$id") || return 1

    case "$subcmd" in
        list|ls)
            render_request GET "/postgres/$dbid/credentials" | python3 -c "
