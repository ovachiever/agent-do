# =====================================================================
# Secret files (per service)
# =====================================================================

cmd_secret() {
    local subcmd="${1:-list}"
    shift || true
    local svc="${1:-}"
    [[ -z "$svc" ]] && { echo "Usage: agent-render secret {list|get|set|del} <svc> ..."; return 1; }
    shift
    local sid; sid=$(resolve_service "$svc") || return 1

    case "$subcmd" in
        list|ls)
            render_request GET "/services/$sid/secret-files?limit=50" | python3 -c "
import sys, json
items = json.load(sys.stdin)
if not items: print('No secret files'); sys.exit(0)
for item in items:
    sf = item.get('secretFile', item)
    print(f\"{sf.get('name', '')}  ({len(sf.get('contents', '')) if sf.get('contents') else '?'} bytes)\")
"
            ;;
        get)
            local name="${1:-}"
            [[ -z "$name" ]] && { echo "Usage: agent-render secret get <svc> <name>"; return 1; }
            render_request GET "/services/$sid/secret-files/$name" | python3 -c "
import sys, json
sf = json.load(sys.stdin)
print(sf.get('contents', ''))
"
            ;;
        set)
            local name="${1:-}"; local file="${2:-}"
            [[ -z "$name" ]] && { echo "Usage: agent-render secret set <svc> <name> <file|->"; return 1; }
            local contents
            if [[ "$file" == "-" || -z "$file" ]]; then
                contents=$(cat)
            else
                contents=$(cat "$file")
            fi
            local body
            body=$(python3 -c "import json,sys; print(json.dumps({'contents': sys.stdin.read()}))" <<< "$contents")
            render_request_checked PUT "/services/$sid/secret-files/$name" "$body" > /dev/null && \
                echo "Set secret file: $name"
            ;;
        del|delete|rm)
            local name="${1:-}"
            [[ -z "$name" ]] && { echo "Usage: agent-render secret del <svc> <name>"; return 1; }
            render_request_checked DELETE "/services/$sid/secret-files/$name" > /dev/null && \
                echo "Deleted secret file: $name"
            ;;
        *)
            echo "Usage: agent-render secret {list|get|set|del} <svc> ..."
            return 1
            ;;
    esac
}

# =====================================================================
# Postgres: full lifecycle (create/update/delete/suspend/resume/restart/
#           failover/recovery/backups/credentials/connection-info)
# =====================================================================

cmd_db_create() {
    local name="" plan="basic_256mb" version="16" region="oregon"
    local db_name="" db_user="" owner="" ha="" disk="" disk_auto=""
    local environment=""
    local json_output=0

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --name) name="$2"; shift 2 ;;
            --plan) plan="$2"; shift 2 ;;
            --version) version="$2"; shift 2 ;;
            --region) region="$2"; shift 2 ;;
            --database) db_name="$2"; shift 2 ;;
            --user) db_user="$2"; shift 2 ;;
            --owner) owner="$2"; shift 2 ;;
            --high-availability|--ha) ha="true"; shift ;;
            --disk-size) disk="$2"; shift 2 ;;
            --disk-autoscale) disk_auto="true"; shift ;;
            --environment) environment="$2"; shift 2 ;;
            --json) json_output=1; shift ;;
            *) [[ -z "$name" ]] && name="$1" || { echo "Error: unexpected '$1'" >&2; return 1; }; shift ;;
        esac
    done

    [[ -z "$name" ]] && { echo "Usage: agent-render db create <name> [--plan <p>] [--version <v>] [--region <r>] ..."; return 1; }
    if [[ -z "$owner" ]]; then
        owner=$(default_owner_id) || true
        [[ -z "$owner" ]] && { echo "Error: --owner required" >&2; return 1; }
    else
        owner=$(resolve_owner "$owner") || return 1
    fi

    local body
    body=$(python3 -c "
import sys, json
out = {
    'name': sys.argv[1],
    'plan': sys.argv[2],
    'version': sys.argv[3],
    'region': sys.argv[4],
    'ownerId': sys.argv[5],
}
if sys.argv[6]: out['databaseName'] = sys.argv[6]
if sys.argv[7]: out['databaseUser'] = sys.argv[7]
if sys.argv[8]: out['enableHighAvailability'] = True
if sys.argv[9]: out['diskSizeGB'] = int(sys.argv[9])
if sys.argv[10]: out['enableDiskAutoscaling'] = True
if sys.argv[11]: out['environmentId'] = sys.argv[11]
print(json.dumps(out))
" "$name" "$plan" "$version" "$region" "$owner" "$db_name" "$db_user" "$ha" "$disk" "$disk_auto" "$environment")

    local result
    result=$(render_request_checked POST "/postgres" "$body") || return 1
    if [[ "$json_output" == "1" ]]; then
        echo "$result"
    else
        echo "$result" | python3 -c "
import sys, json
db = json.load(sys.stdin)
print(f\"Created: {db.get('name', '')} ({db.get('id', '')})\")
print(f\"Plan:    {db.get('plan', '')}  Version: {db.get('version', '')}\")
print(f\"Status:  {db.get('status', '')}\")
"
    fi
}

cmd_db_update() {
    local id="${1:-}"; shift || true
    [[ -z "$id" ]] && { echo "Usage: agent-render db update <db> [--plan <p>] [--disk-size <gb>] [--name <new>]"; return 1; }
    local dbid; dbid=$(resolve_postgres "$id") || return 1
    local plan="" disk="" new_name=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --plan) plan="$2"; shift 2 ;;
            --disk-size) disk="$2"; shift 2 ;;
            --name) new_name="$2"; shift 2 ;;
            *) shift ;;
        esac
    done
    local body
    body=$(python3 -c "
import sys, json
out = {}
if sys.argv[1]: out['plan'] = sys.argv[1]
if sys.argv[2]: out['diskSizeGB'] = int(sys.argv[2])
if sys.argv[3]: out['name'] = sys.argv[3]
print(json.dumps(out))
" "$plan" "$disk" "$new_name")
    [[ "$body" == "{}" ]] && { echo "Error: nothing to update" >&2; return 1; }
    render_request_checked PATCH "/postgres/$dbid" "$body" > /dev/null && echo "Updated $id"
}

cmd_db_delete() {
    local id="${1:-}"; local confirm=0
    shift || true
    while [[ $# -gt 0 ]]; do [[ "$1" == --yes || "$1" == -y ]] && confirm=1; shift; done
    [[ -z "$id" ]] && { echo "Usage: agent-render db delete <db> --yes"; return 1; }
    [[ "$confirm" != "1" ]] && { echo "Refusing to delete '$id' without --yes" >&2; return 1; }
    local dbid; dbid=$(resolve_postgres "$id") || return 1
    render_request_checked DELETE "/postgres/$dbid" > /dev/null && echo "Deleted $id ($dbid)"
}

cmd_db_lifecycle() {
    local action="$1"; local id="${2:-}"
    [[ -z "$id" ]] && { echo "Usage: agent-render db $action <db>"; return 1; }
    local dbid; dbid=$(resolve_postgres "$id") || return 1
    render_request_checked POST "/postgres/$dbid/$action" > /dev/null && echo "Postgres $action: $id ($dbid)"
}

cmd_db_connect_info() {
    local id="${1:-}"
    [[ -z "$id" ]] && { echo "Usage: agent-render db connect-info <db>"; return 1; }
    local dbid; dbid=$(resolve_postgres "$id") || return 1
