class LocalDashboard(BaseHTTPRequestHandler):
    def reply(self, status, payload, content_type="application/json; charset=utf-8"):
        body = payload.encode() if isinstance(payload, str) else json.dumps(payload).encode()
        self.send_response(status); self.send_header("Content-Type", content_type); self.send_header("Content-Length", str(len(body))); self.send_header("Cache-Control", "no-store"); self.end_headers(); self.wfile.write(body)
    def log_message(self, *unused): pass
    def do_GET(self):
        parsed = urllib.parse.urlparse(self.path)
        if parsed.path == "/": return self.reply(200, DYNAMIC_DASHBOARD, "text/html; charset=utf-8")
        if parsed.path.startswith("/api/activity/"):
            activity_id = parsed.path.removeprefix("/api/activity/")
            if not activity_id.isdigit(): return self.reply(400, {"error": "Activity ID must be numeric"})
            try: return self.reply(200, detail_for_activity(activity_id))
            except SystemExit as exc: return self.reply(400, {"error": str(exc)})
        if parsed.path != "/api/stats": return self.reply(404, {"error": "Not found"})
        try:
            days = int(urllib.parse.parse_qs(parsed.query).get("days", [28])[0])
            if not 1 <= days <= 3660: raise ValueError
            data = read_json(CACHE, "activity cache; run Sync now after connecting")
            result = summarize(data["activities"], days, urllib.parse.parse_qs(parsed.query).get("type", [None])[0])
            result["synced_at"] = data.get("synced_at")
            result["units"] = (json.loads(PROFILE.read_text()).get("units") if PROFILE.exists() else None) or "imperial"
            result["activity_types"] = sorted({activity_kind(activity) for activity in data["activities"]})
            return self.reply(200, result)
        except (ValueError, SystemExit) as exc: return self.reply(400, {"error": str(exc)})
    def do_POST(self):
        if self.path == "/api/preferences":
            try:
                size = int(self.headers.get("Content-Length", "0"))
                if size > 1024: raise ValueError("Preference request is too large")
                units = json.loads(self.rfile.read(size) or b"{}").get("units")
                if units not in ("imperial", "metric"): raise ValueError("Units must be imperial or metric")
                profile = read_json(PROFILE, "profile")
                profile["units"] = units; write_json(PROFILE, profile)
                return self.reply(200, {"units": units})
            except (ValueError, json.JSONDecodeError, SystemExit) as exc: return self.reply(400, {"error": str(exc)})
        if self.path == "/api/sync":
            try:
                sync(argparse.Namespace(days=90)); return self.reply(200, {"ok": True})
            except SystemExit as exc: return self.reply(400, {"error": str(exc)})
        return self.reply(404, {"error": "Not found"})

def serve(args):
    if args.host not in ("127.0.0.1", "localhost"): raise SystemExit("The dashboard can only bind to localhost.")
    if not args.no_sync:
        try:
            sync(argparse.Namespace(days=args.days))
        except SystemExit as exc:
            print(f"Startup sync skipped: {exc}", file=sys.stderr)
            print("Serving the last local cache, if available.", file=sys.stderr)
    server = HTTPServer((args.host, args.port), LocalDashboard)
    url = f"http://{args.host}:{server.server_port}"
    print(f"agent-strava dashboard listening at {url}")
    if args.open: webbrowser.open(url)
    try: server.serve_forever()
    except KeyboardInterrupt: print("\nDashboard stopped.")
    finally: server.server_close()

def dashboard(args):
    data = read_json(CACHE, "activity cache; run: agent-do strava sync")
    activities = data["activities"]
    week = datetime.now(timezone.utc) - timedelta(days=7)
    recent = [a for a in activities if datetime.fromisoformat(a["start_date"].replace("Z", "+00:00")) >= week]
    distance = sum(a.get("distance", 0) for a in recent) / 1000
    elevation = sum(a.get("total_elevation_gain", 0) for a in recent)
    rows = "".join(f"<tr><td>{a.get('name','Activity')}</td><td>{a.get('type','')}</td><td>{a.get('distance',0)/1000:.1f} km</td><td>{a.get('moving_time',0)//60} min</td></tr>" for a in activities[:8]) or "<tr><td colspan='4'>No activities in the local cache.</td></tr>"
    html = f"""<!doctype html><meta charset=utf-8><title>agent-strava</title><style>body{{font:16px system-ui;background:#111827;color:#f8fafc;margin:0;padding:48px;max-width:1100px}}h1{{font-size:42px}}.tag{{color:#b8f23d}}.cards{{display:flex;gap:16px;flex-wrap:wrap}}.card,section{{background:#1f2937;border:1px solid #374151;border-radius:14px;padding:22px;margin:18px 0}}.card{{min-width:180px;flex:1}}strong{{font-size:30px;color:#b8f23d}}table{{width:100%;border-collapse:collapse}}td{{padding:12px;border-bottom:1px solid #374151}}small{{color:#94a3b8}}</style><h1>Your training, <span class=tag>locally.</span></h1><small>Last sync: {data['synced_at']}</small><div class=cards><div class=card>This week<br><strong>{distance:.1f} km</strong></div><div class=card>Elevation<br><strong>{elevation:.0f} m</strong></div><div class=card>Activities<br><strong>{len(recent)}</strong></div></div><section><h2>Recent activity</h2><table>{rows}</table></section><small>Private local dashboard generated by agent-do. No data is sent anywhere except Strava during sync.</small>"""
    DASHBOARD.write_text(html); DASHBOARD.chmod(0o600)
    print(DASHBOARD)
    if args.open: webbrowser.open(DASHBOARD.as_uri())

def status(args):
    if not PROFILE.exists():
        if args.json:
            print(json.dumps({"configured": False, "cache_present": False, "next_command": "agent-do strava init"}))
        else:
            print("No local Strava profile. Run: agent-do strava init")
        return
    profile = json.loads(PROFILE.read_text()); result = {k: profile.get(k) for k in ("athlete_id", "athlete_name", "scopes", "connected_at", "last_sync_at", "redirect_uri", "units")}
    result["units"] = result["units"] or "imperial"
    result["configured"] = True; result["cache_present"] = CACHE.exists()
    print(json.dumps(result, indent=2) if args.json else "\n".join(f"{k}: {v}" for k,v in result.items()))

def main():
    parser = argparse.ArgumentParser(description="Private, local-only Strava dashboard")
    sub = parser.add_subparsers(dest="command", required=True)
    p = sub.add_parser("init", help="Initialize a local profile and store the app secret securely"); p.add_argument("--client-id"); p.add_argument("--client-secret-stdin", action="store_true"); p.add_argument("--redirect-uri", default="http://localhost:8787/callback")
    p = sub.add_parser("connect", help="Authorize the local Strava profile"); p.add_argument("--timeout", type=int, default=300)
    p = sub.add_parser("sync", help="Refresh and sync activity data"); p.add_argument("--days", type=int, default=90)
    p = sub.add_parser("dashboard", help="Generate the local HTML dashboard"); p.add_argument("--open", action="store_true")
    p = sub.add_parser("serve", help="Sync once, then serve the responsive local dashboard"); p.add_argument("--host", default="127.0.0.1", choices=("127.0.0.1", "localhost")); p.add_argument("--port", type=int, default=8765); p.add_argument("--days", type=int, default=90); p.add_argument("--no-sync", action="store_true", help="Serve the existing cache without syncing"); p.add_argument("--open", action="store_true")
    p = sub.add_parser("status", help="Show local profile status"); p.add_argument("--json", action="store_true", help="Print structured status")
    args = parser.parse_args()
    if getattr(args, "client_secret_stdin", False): args.client_secret = sys.stdin.read().strip()
    {"init": init, "connect": connect, "sync": sync, "dashboard": dashboard, "serve": serve, "status": status}[args.command](args)
if __name__ == "__main__": main()
