#!/usr/bin/env bash
# agent-obsidian — Obsidian vault integration via the official Obsidian CLI.
#
# This is a thin wrapper around the `obsidian` binary that ships with the
# Obsidian desktop app (Settings → General → Command line interface →
# Register CLI). It does not embed any vault format knowledge of its own:
# it adapts agent-do's structured-API conventions onto obsidian-cli's
# `key=value` parameter grammar, adds a doctor command for one-time CLI
# linking, and gates the powerful introspection surface (`eval`, `dev:*`,
# `plugin:*`) behind the `+live(...)` runtime modifier.
#
# Requires:
#   - Obsidian.app installed locally
#   - Obsidian running (the CLI talks to the live app over IPC)
#
# Reference: https://help.obsidian.md/cli

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

# Optional: json-output.sh helpers for --json plumbing in doctor/snapshot.
# Passthrough commands return the obsidian CLI's native output format.
# shellcheck source=/dev/null
source "$REPO_ROOT/lib/json-output.sh" 2>/dev/null || true

