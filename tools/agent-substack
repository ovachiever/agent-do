def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="agent-substack",
        description="Draft and publish Substack essays through the editor API (auth rides a saved agent-browse session)",
    )
    sub = parser.add_subparsers(dest="command")

    def add_common(p: argparse.ArgumentParser) -> None:
        p.add_argument("--json", action="store_true", help="JSON output")
        p.add_argument("--session", help=f"browse session name (default: {DEFAULT_SESSION})")

    p = sub.add_parser("connect", help="Verify auth against the publication and save config")
    p.add_argument("--publication", help="Publication URL or subdomain (e.g. foo or foo.substack.com)")
    add_common(p)
    p.set_defaults(func=cmd_connect)

    p = sub.add_parser("snapshot", help="Publication info + drafts + recent posts")
    add_common(p)
    p.set_defaults(func=cmd_snapshot)

    p = sub.add_parser("drafts", help="List drafts")
    p.add_argument("--limit", type=int, help="Max drafts to request (provider default when omitted)")
    add_common(p)
    p.set_defaults(func=cmd_drafts)

    p = sub.add_parser("posts", help="List recent published posts")
    p.add_argument("--limit", type=int, help="Max posts to request (provider default when omitted)")
    add_common(p)
    p.set_defaults(func=cmd_posts)

    p = sub.add_parser("get", help="Fetch one draft by id")
    p.add_argument("id")
    add_common(p)
    p.set_defaults(func=cmd_get)

    p = sub.add_parser("convert", help="Convert markdown to ProseMirror JSON (offline, no network)")
    p.add_argument("file")
    p.add_argument("--json", action="store_true", help="JSON output (always JSON; flag kept for symmetry)")
    p.set_defaults(func=cmd_convert)

    def add_draft_fields(p: argparse.ArgumentParser) -> None:
        p.add_argument("--title", help="Draft title (default: leading H1 in the file, else filename)")
        p.add_argument("--subtitle", help="Draft subtitle")
        p.add_argument("--byline-id", type=int, help="Byline user id (default: resolved at connect)")
        p.add_argument("--audience", default="everyone", help="Audience: everyone|only_paid|founding (default everyone)")
        p.add_argument("--type", default="newsletter", help="Post type: newsletter|podcast|thread (default newsletter)")

    p = sub.add_parser("draft", help="Create a DRAFT from a markdown file (never publishes)")
    p.add_argument("file")
    add_draft_fields(p)
    add_common(p)
    p.set_defaults(func=cmd_draft)

    p = sub.add_parser("update", help="Replace a draft's body/title from a markdown file")
    p.add_argument("id")
    p.add_argument("file")
    add_draft_fields(p)
    add_common(p)
    p.set_defaults(func=cmd_update)

    p = sub.add_parser("publish", help="Publish a draft (outward-facing; no subscriber email unless --email)")
    p.add_argument("id")
    p.add_argument("--email", action="store_true", help="Also send the post as email to subscribers")
    add_common(p)
    p.set_defaults(func=cmd_publish)

    p = sub.add_parser("verify", help="Read a draft back and compare against receipt or a markdown file")
    p.add_argument("id")
    p.add_argument("--file", help="Markdown file to compare text against")
    p.add_argument("--title", help="Expected title when comparing --file")
    add_common(p)
    p.set_defaults(func=cmd_verify)

    p = sub.add_parser("receipts", help="Show local draft/publish receipts")
    p.add_argument("--limit", type=int, help="Show only the last N receipts")
    p.add_argument("--json", action="store_true", help="JSON output")
    p.set_defaults(func=cmd_receipts)

    return parser


def main(argv: list[str] | None = None) -> int:
    argv = list(sys.argv[1:]) if argv is None else list(argv)
    if argv[:1] in (["--help"], ["-h"]):
        # First line doubles as the description shown by `agent-do --list`.
        print("agent-substack - Substack drafts and publishing through the editor API")
        print()
        build_parser().print_help()
        return 0
    parser = build_parser()
    args = parser.parse_args(argv)
    if not getattr(args, "command", None):
        parser.print_help()
        return 1
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
