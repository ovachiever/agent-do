def cmd_connect(args: argparse.Namespace) -> int:
    config = load_config(required=False)
    publication = args.publication or config.get("publication")
    if not publication:
        return fail(
            "no publication known: pass --publication <url-or-subdomain>",
            json_mode=args.json,
            error="missing_publication",
        )
    base_url = normalize_publication(publication)
    session = args.session or config.get("session") or DEFAULT_SESSION
    cookie = load_cookie_header(session)
    request_base = API_BASE_OVERRIDE or base_url
    drafts = fetch_drafts(request_base, cookie)
    user_id = resolve_user_id(request_base, cookie)
    config = {
        "publication": publication,
        "base_url": base_url,
        "session": session,
        "user_id": user_id,
        "connected_at": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
    }
    save_config(config)
    result = {
        "ok": True,
        "base_url": base_url,
        "session": session,
        "user_id": user_id,
        "drafts_visible": len(drafts),
        "config": str(CONFIG_PATH),
    }
    if args.json:
        print(json.dumps(result, indent=2))
    else:
        print(f"Connected to {base_url} via browse session '{session}'")
        print(f"  drafts visible: {len(drafts)}")
        print(f"  byline user id: {user_id if user_id is not None else 'unresolved (pass --byline-id when drafting)'}")
        print(f"  config saved: {CONFIG_PATH}")
    return 0


def _client(args: argparse.Namespace) -> tuple[dict[str, Any], str]:
    config = load_config()
    session = getattr(args, "session", None) or config.get("session") or DEFAULT_SESSION
    cookie = load_cookie_header(session)
    return config, cookie


def cmd_snapshot(args: argparse.Namespace) -> int:
    config, cookie = _client(args)
    base_url = effective_base(config)
    drafts = fetch_drafts(base_url, cookie)
    posts = fetch_posts(base_url, cookie)
    snapshot = {
        "ok": True,
        "base_url": base_url,
        "session": config.get("session"),
        "user_id": config.get("user_id"),
        "drafts_total": len(drafts),
        "drafts": [
            {"id": d.get("id"), "title": d.get("draft_title") or d.get("title"), "updated": d.get("draft_updated_at")}
            for d in drafts
        ],
        "recent_posts_total": len(posts),
        "recent_posts": [
            {"id": p.get("id"), "title": p.get("title"), "date": p.get("post_date"), "url": p.get("canonical_url")}
            for p in posts
        ],
    }
    if args.json:
        print(json.dumps(snapshot, indent=2))
    else:
        print(f"Publication: {base_url} (session '{config.get('session')}')")
        print(f"Drafts: {len(drafts)}")
        for d in snapshot["drafts"]:
            print(f"  {d['id']}  {d['title'] or '(untitled)'}")
        print(f"Recent posts: {len(posts)}")
        for p in snapshot["recent_posts"]:
            print(f"  {p['id']}  {p['title']}  {p['url'] or ''}")
    return 0


def cmd_drafts(args: argparse.Namespace) -> int:
    config, cookie = _client(args)
    drafts = fetch_drafts(effective_base(config), cookie, args.limit)
    if args.json:
        print(json.dumps({"ok": True, "total": len(drafts), "drafts": drafts}, indent=2))
    else:
        for d in drafts:
            print(f"{d.get('id')}  {d.get('draft_updated_at') or ''}  {d.get('draft_title') or d.get('title') or '(untitled)'}")
        print(f"{len(drafts)} draft(s)")
    return 0


def cmd_posts(args: argparse.Namespace) -> int:
    config, cookie = _client(args)
    posts = fetch_posts(effective_base(config), cookie, args.limit)
    if args.json:
        print(json.dumps({"ok": True, "total": len(posts), "posts": posts}, indent=2))
    else:
        for p in posts:
            print(f"{p.get('id')}  {p.get('post_date') or ''}  {p.get('title')}  {p.get('canonical_url') or ''}")
        print(f"{len(posts)} post(s)")
    return 0


def cmd_get(args: argparse.Namespace) -> int:
    config, cookie = _client(args)
    draft = request_json("GET", f"{effective_base(config)}/api/v1/drafts/{args.id}", cookie)
    if args.json:
        print(json.dumps({"ok": True, "draft": draft}, indent=2))
    else:
        title = draft.get("draft_title") or draft.get("title") or "(untitled)"
        body_text = doc_plain_text(draft.get("draft_body") or "{}")
        print(f"id: {draft.get('id')}")
        print(f"title: {title}")
        print(f"subtitle: {draft.get('draft_subtitle') or ''}")
        print(f"updated: {draft.get('draft_updated_at') or ''}")
        print(f"words: {len(body_text.split())}")
        print(f"editor: {editor_url(config['base_url'], draft.get('id'))}")
    return 0


def cmd_convert(args: argparse.Namespace) -> int:
    md_path = Path(args.file)
    if not md_path.exists():
        return fail(f"file not found: {md_path}", json_mode=args.json, error="missing_file")
    md_text = md_path.read_text()
    title, body_md = extract_title(md_text)
    doc = markdown_to_doc(body_md)
    print(json.dumps({"title": title, "doc": doc}, indent=2))
    return 0


def _load_markdown(args: argparse.Namespace) -> tuple[str, str | None, Path]:
    md_path = Path(args.file)
    if not md_path.exists():
        raise SystemExit(fail(f"file not found: {md_path}", error="missing_file"))
    md_text = md_path.read_text()
    extracted_title, body_md = extract_title(md_text)
    return body_md, extracted_title, md_path


def cmd_draft(args: argparse.Namespace) -> int:
    config, cookie = _client(args)
    base_url = effective_base(config)
    body_md, extracted_title, md_path = _load_markdown(args)
    title = args.title or extracted_title or md_path.stem
    resolver = make_image_resolver(base_url, cookie, md_path.parent)
    doc = markdown_to_doc(body_md, image_resolver=resolver)
    byline_id = args.byline_id or config.get("user_id")
    payload = build_draft_body(
        doc,
        title=title,
        subtitle=args.subtitle,
        byline_id=byline_id,
        audience=args.audience,
        post_type=args.type,
    )
    draft = request_json("POST", f"{base_url}/api/v1/drafts", cookie, body=payload)
    draft_id = draft.get("id")
    url = editor_url(base_url, draft_id)
    body_sha = hashlib.sha256(payload["draft_body"].encode()).hexdigest()
    append_receipt(
        {
            "action": "draft",
            "draft_id": draft_id,
            "title": title,
            "source_file": str(md_path),
            "body_sha256": body_sha,
            "editor_url": url,
        }
    )
    if args.json:
        print(json.dumps({"ok": True, "draft_id": draft_id, "title": title, "editor_url": url, "body_sha256": body_sha}, indent=2))
    else:
        print(f"Draft created: {draft_id}")
        print(f"  title: {title}")
        print(f"  review: {url}")
        print(f"DRAFT ONLY — review in the Substack UI; publish with `agent-do substack publish {draft_id}`")
    return 0


def cmd_update(args: argparse.Namespace) -> int:
    config, cookie = _client(args)
    base_url = effective_base(config)
    body_md, extracted_title, md_path = _load_markdown(args)
    existing = request_json("GET", f"{base_url}/api/v1/drafts/{args.id}", cookie)
    title = args.title or extracted_title or existing.get("draft_title") or md_path.stem
    resolver = make_image_resolver(base_url, cookie, md_path.parent)
    doc = markdown_to_doc(body_md, image_resolver=resolver)
    byline_id = args.byline_id or config.get("user_id")
    payload = build_draft_body(
        doc,
        title=title,
        subtitle=args.subtitle if args.subtitle is not None else existing.get("draft_subtitle"),
        byline_id=byline_id,
        audience=args.audience,
        post_type=args.type,
    )
    draft = request_json("PUT", f"{base_url}/api/v1/drafts/{args.id}", cookie, body=payload)
    url = editor_url(base_url, args.id)
    body_sha = hashlib.sha256(payload["draft_body"].encode()).hexdigest()
    append_receipt(
        {
            "action": "update",
            "draft_id": args.id,
            "title": title,
            "source_file": str(md_path),
            "body_sha256": body_sha,
            "editor_url": url,
        }
    )
    if args.json:
        print(json.dumps({"ok": True, "draft_id": args.id, "title": title, "editor_url": url, "body_sha256": body_sha}, indent=2))
    else:
        print(f"Draft updated: {args.id}")
        print(f"  title: {title}")
        print(f"  review: {url}")
    return 0


def cmd_publish(args: argparse.Namespace) -> int:
    config, cookie = _client(args)
    base_url = effective_base(config)
    try:
        request_json("GET", f"{base_url}/api/v1/drafts/{args.id}/prepublish", cookie)
    except SystemExit:
        print("Warning: prepublish check did not pass cleanly; attempting publish anyway", file=sys.stderr)
    post = request_json(
        "POST",
        f"{base_url}/api/v1/drafts/{args.id}/publish",
        cookie,
        body={"send": bool(args.email)},
    )
    post_url = post.get("canonical_url") or f"{base_url}/p/{post.get('slug')}" if isinstance(post, dict) else None
    append_receipt(
        {
            "action": "publish",
            "draft_id": args.id,
            "post_url": post_url,
            "email_sent": bool(args.email),
        }
    )
    if args.json:
        print(json.dumps({"ok": True, "draft_id": args.id, "post_url": post_url, "email_sent": bool(args.email)}, indent=2))
    else:
        print(f"Published: {post_url or args.id}")
        print(f"  subscriber email: {'sent' if args.email else 'NOT sent (pass --email to send)'}")
    return 0


def cmd_verify(args: argparse.Namespace) -> int:
    config, cookie = _client(args)
    base_url = effective_base(config)
    draft = request_json("GET", f"{base_url}/api/v1/drafts/{args.id}", cookie)
    remote_title = draft.get("draft_title") or draft.get("title") or ""
    remote_text = doc_plain_text(draft.get("draft_body") or "{}")
    result: dict[str, Any] = {
        "ok": True,
        "draft_id": args.id,
        "remote_title": remote_title,
        "remote_words": len(remote_text.split()),
    }
    if args.file:
        body_md, extracted_title, _ = _load_markdown(args)
        local_doc = markdown_to_doc(body_md)
        local_text = doc_plain_text(local_doc)
        result["local_words"] = len(local_text.split())
        result["text_match"] = local_text == remote_text
        expected_title = args.title or extracted_title
        if expected_title:
            result["title_match"] = expected_title == remote_title
    else:
        receipts = _read_receipts()
        matching = [r for r in receipts if str(r.get("draft_id")) == str(args.id)]
        if matching:
            last = matching[-1]
            remote_sha = hashlib.sha256((draft.get("draft_body") or "").encode()).hexdigest()
            result["receipt_sha256"] = last.get("body_sha256")
            result["remote_sha256"] = remote_sha
            result["body_match"] = last.get("body_sha256") == remote_sha
            result["note"] = (
                "body_match false can mean edits in the Substack UI since the receipt, "
                "or server-side normalization; verify --file for a text-level comparison"
            )
        else:
            result["note"] = f"no local receipt for draft {args.id}; pass --file to compare against a markdown source"
    if args.json:
        print(json.dumps(result, indent=2))
    else:
        for key, value in result.items():
            if key != "ok":
                print(f"{key}: {value}")
    return 0


def _read_receipts() -> list[dict[str, Any]]:
    if not RECEIPTS_PATH.exists():
        return []
    records = []
    for line in RECEIPTS_PATH.read_text().splitlines():
        line = line.strip()
        if line:
            try:
                records.append(json.loads(line))
            except json.JSONDecodeError:
                continue
    return records


def cmd_receipts(args: argparse.Namespace) -> int:
    records = _read_receipts()
    shown = records[-args.limit :] if args.limit else records
    if args.json:
        print(json.dumps({"ok": True, "total": len(records), "shown": len(shown), "receipts": shown}, indent=2))
    else:
        for r in shown:
            print(f"{r.get('ts')}  {r.get('action')}  {r.get('draft_id')}  {r.get('title') or r.get('post_url') or ''}")
        if args.limit and len(records) > len(shown):
            print(f"[showing {len(shown)} of {len(records)}]")
        else:
            print(f"{len(records)} receipt(s)")
    return 0


