      "kind": "text",
      "role": "body",
      "group": "note1",
      "text": "A pool the size of your hand can hold a whole landscape. Start with the things that move slowly.",
      "priority": 0.25,
      "order": 1
    },
    {
      "id": "heading2",
      "kind": "text",
      "role": "heading",
      "group": "note2",
      "text": "Return often.",
      "priority": 0.65,
      "order": 0
    },
    {
      "id": "body2",
      "kind": "text",
      "role": "body",
      "group": "note2",
      "text": "The same stretch of coast becomes a different place with each tide. Keep a record of what changes.",
      "priority": 0.25,
      "order": 1
    },
    {
      "id": "heading3",
      "kind": "text",
      "role": "heading",
      "group": "note3",
      "text": "Leave it living.",
      "priority": 0.65,
      "order": 0
    },
    {
      "id": "body3",
      "kind": "text",
      "role": "body",
      "group": "note3",
      "text": "Observe where you stand, replace the stone you lift, and give every small inhabitant room.",
      "priority": 0.25,
      "order": 1
    }
