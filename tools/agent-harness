    return explicit if explicit is not None else _quantities().READ_PROBE_TIMEOUT_SECONDS


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(add_help=False)
    parser.add_argument("--json", dest="global_json", action="store_true")
    sub = parser.add_subparsers(dest="command")

    inspect_parser = sub.add_parser("inspect", add_help=False)
    inspect_parser.add_argument("--json", action="store_true")

    nudges = sub.add_parser("nudges", add_help=False)
    nudges.add_argument("nudge_command", choices=["effectiveness"])
    nudges.add_argument("--since")
    nudges.add_argument("--json", action="store_true")

    evidence = sub.add_parser("evidence", add_help=False)
    evidence_sub = evidence.add_subparsers(dest="evidence_command")
    evidence_build = evidence_sub.add_parser("build", add_help=False)
    evidence_build.add_argument("target")
    evidence_build.add_argument("--out")
    evidence_build.add_argument("--json", action="store_true")

    manifest = sub.add_parser("manifest", add_help=False)
    manifest_sub = manifest.add_subparsers(dest="manifest_command")
    manifest_new_parser = manifest_sub.add_parser("new", add_help=False)
    manifest_new_parser.add_argument("change_id")
    manifest_new_parser.add_argument("--component-type", default="tool")
    manifest_new_parser.add_argument("--file", action="append")
    manifest_new_parser.add_argument("--evidence", action="append")
    manifest_new_parser.add_argument("--root-cause")
    manifest_new_parser.add_argument("--targeted-fix")
    manifest_new_parser.add_argument("--predicted-fix", action="append")
    manifest_new_parser.add_argument("--risk-regression", action="append")
    manifest_new_parser.add_argument("--verification", action="append")
    manifest_new_parser.add_argument("--rollback-plan")
    manifest_new_parser.add_argument("--safety-scope")
    manifest_new_parser.add_argument("--force", action="store_true")
    manifest_new_parser.add_argument("--json", action="store_true")

    manifest_verify_parser = manifest_sub.add_parser("verify", add_help=False)
    manifest_verify_parser.add_argument("change_id")
    manifest_verify_parser.add_argument("--before", required=True)
    manifest_verify_parser.add_argument("--after", required=True)
    manifest_verify_parser.add_argument("--json", action="store_true")

    contracts = sub.add_parser("contracts", add_help=False)
    contracts.add_argument("contracts_command", choices=["validate", "propose", "surface", "drift", "audit"])
    contracts.add_argument("--strict", action="store_true")
    contracts.add_argument("--tool")
    contracts.add_argument("--out")
    contracts.add_argument("--json", action="store_true")
    contracts.add_argument("--include-network", action="store_true")
    contracts.add_argument("--schema-check", action="store_true")
    contracts.add_argument("--timeout", type=int, default=None)
    contracts.add_argument("--notify", action="store_true")
    contracts.add_argument("--install-schedule", nargs="?", const="weekly", choices=["weekly", "daily"])
    contracts.add_argument("--uninstall-schedule", action="store_true")

    bounds_parser = sub.add_parser("bounds", add_help=False)
    bounds_parser.add_argument("bounds_command", choices=["drift", "audit", "scan"])
    bounds_parser.add_argument("target", nargs="?")
    bounds_parser.add_argument("--tool")
    bounds_parser.add_argument("--out")
    bounds_parser.add_argument("--timeout", type=int, default=None)
    bounds_parser.add_argument("--json", action="store_true")

    quantity = sub.add_parser("quantity", add_help=False)
    quantity_sub = quantity.add_subparsers(dest="quantity_command")
    quantity_lookup_parser = quantity_sub.add_parser("lookup", add_help=False)
    quantity_lookup_parser.add_argument("key")
    quantity_lookup_parser.add_argument("--json", action="store_true")
    quantity_keys_parser = quantity_sub.add_parser("keys", add_help=False)
    quantity_keys_parser.add_argument("--prefix")
    quantity_keys_parser.add_argument("--json", action="store_true")

    census_parser = sub.add_parser("census", add_help=False)
    census_sub = census_parser.add_subparsers(dest="census_command")
    census_lines_parser = census_sub.add_parser("lines", add_help=False)
    census_lines_parser.add_argument("target")
    census_lines_parser.add_argument("--json", action="store_true")
    census_entries_parser = census_sub.add_parser("entries", add_help=False)
    census_entries_parser.add_argument("target")
    census_entries_parser.add_argument("--glob")
    census_entries_parser.add_argument("--recursive", action="store_true")
    census_entries_parser.add_argument("--json", action="store_true")
    census_rows_parser = census_sub.add_parser("rows", add_help=False)
    census_rows_parser.add_argument("--via", required=True)
    census_rows_parser.add_argument("--path")
    census_rows_parser.add_argument("--timeout", type=int, default=None)
    census_rows_parser.add_argument("--json", action="store_true")
    return parser


def main(argv: list[str]) -> int:
    if not argv or argv[0] in {"--help", "-h", "help"}:
        show_help()
        return 0

    parser = build_parser()
    try:
        args = parser.parse_args(argv)
        json_mode = bool(getattr(args, "global_json", False) or getattr(args, "json", False))
        if args.command == "inspect":
            payload = inspect_harness()
            if json_mode:
                print(json.dumps(payload, indent=2))
            else:
                render_inspect_text(payload)
            return 0
        if args.command == "nudges":
            payload = nudge_effectiveness(args.since)
            if json_mode:
                print(json.dumps(payload, indent=2))
            else:
                render_nudge_effectiveness(payload)
            return 0
        if args.command == "evidence" and args.evidence_command == "build":
            payload = build_evidence(args.target, Path(args.out) if args.out else None)
            if json_mode:
                print(json.dumps(payload, indent=2))
            else:
                render_evidence_build(payload)
            return 0
        if args.command == "manifest" and args.manifest_command == "new":
            payload = manifest_new(args)
            if json_mode:
                print(json.dumps(payload, indent=2))
            else:
                render_manifest_result(payload)
            return 0
        if args.command == "manifest" and args.manifest_command == "verify":
            payload = manifest_verify(args)
            if json_mode:
                print(json.dumps(payload, indent=2))
            else:
                render_manifest_result(payload)
            return 0
        if args.command == "contracts" and args.contracts_command == "validate":
            payload = contracts_validate(strict=args.strict)
            if json_mode:
                print(json.dumps(payload, indent=2))
            else:
                render_contracts_validate(payload)
            return 0 if payload["ok"] else 1
        if args.command == "contracts" and args.contracts_command == "surface":
            print(json.dumps(contracts_surface(), indent=2))
            return 0
        if args.command == "contracts" and args.contracts_command == "audit":
            if args.install_schedule or args.uninstall_schedule:
                payload = contracts_audit_schedule(args.install_schedule, args.uninstall_schedule)
                print(json.dumps(payload, indent=2))
                return 0 if payload["ok"] else 1
            args.timeout = read_probe_timeout(args.timeout)
            payload = contracts_audit(args)
            if json_mode:
                print(json.dumps(payload, indent=2))
            else:
                render_contracts_audit(payload)
            return 0 if payload["ok"] else 1
        if args.command == "contracts" and args.contracts_command == "drift":
            payload = contracts_drift(tool=args.tool)
            if json_mode:
                print(json.dumps(payload, indent=2))
            else:
                render_contracts_drift(payload)
            return 0 if payload["ok"] else 1
        if args.command == "bounds":
            if args.bounds_command == "drift":
                payload = bounds_drift(tool=args.tool)
                renderer = render_bounds_drift
            elif args.bounds_command == "audit":
                payload = bounds_audit(tool=args.tool, timeout=args.timeout)
                renderer = render_bounds_audit
            else:
                if not args.target:
                    raise ValueError("bounds scan requires a project path")
                payload = bounds_scan(args.target)
                renderer = render_bounds_scan
            if args.out:
                out_path = Path(args.out).expanduser()
                out_path.parent.mkdir(parents=True, exist_ok=True)
                out_path.write_text(json.dumps(payload, indent=2) + "\n", encoding="utf-8")
                payload["out"] = str(out_path)
            if json_mode:
                print(json.dumps(payload, indent=2))
            else:
                renderer(payload)
                if payload.get("out"):
                    print(f"  Report: {payload['out']}")
            return 0 if payload["ok"] else 1
        if args.command == "quantity" and args.quantity_command == "lookup":
            payload = quantity_lookup(args.key)
            if json_mode:
                print(json.dumps(payload, indent=2))
            else:
                render_quantity_lookup(payload)
            return 0
        if args.command == "quantity" and args.quantity_command == "keys":
            payload = quantity_keys(args.prefix)
            if json_mode:
                print(json.dumps(payload, indent=2))
            else:
                render_quantity_keys(payload)
            return 0
        if args.command == "census" and args.census_command in {"lines", "entries", "rows"}:
            payload = census(args)
            if json_mode:
                print(json.dumps(payload, indent=2))
            else:
                render_census(payload)
            return 0
        if args.command == "contracts" and args.contracts_command == "propose":
            payload = contracts_propose(tool=args.tool)
            if args.out:
                sys.path.insert(0, str(REPO_ROOT / "lib"))
                from contracts import render_markdown  # noqa: WPS433

                out_path = Path(args.out)
                out_path.parent.mkdir(parents=True, exist_ok=True)
                out_path.write_text(
                    render_markdown(payload, payload["generated_at"]), encoding="utf-8"
                )
                payload["out"] = str(out_path)
            if json_mode:
                print(json.dumps(payload, indent=2))
            else:
                render_contracts_propose(payload)
                if args.out:
                    print(f"Inventory written to {payload['out']}")
            return 0
    except Exception as exc:
        # A refusal is not a crash. Census exits 2 — the same code zpc uses when
        # it declines on principle — so a caller can tell "cannot count exactly"
        # apart from "broke", and neither ever carries a total.
        try:
            refusal_type = _quantities().CensusRefusal
        except Exception:  # noqa: BLE001 - a broken import must not mask the real error
            refusal_type = ()
        if refusal_type and isinstance(exc, refusal_type):
            payload = {
                "ok": False,
                "tool": "harness",
                "exact": False,
                "refused": True,
                "reason": exc.reason,
                "detail": exc.detail,
            }
            if "--json" in argv:
                print(json.dumps(payload, indent=2))
            else:
                print(f"Refused: cannot count exactly.\n  reason: {exc.reason}\n  {exc.detail}", file=sys.stderr)
            return 2
        if "--json" in argv:
            print(json.dumps({"ok": False, "tool": "harness", "error": str(exc)}, indent=2))
        else:
            print(f"Error: {exc}", file=sys.stderr)
        return 1

    show_help()
    return 1


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
