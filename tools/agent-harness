def read_probe_timeout(explicit: int | None) -> int:
    """One bounded-read budget for every surface that runs a declared read verb.

    Defined once in lib/quantities.py and resolved here at dispatch rather than
    at parser-build time, so parsing `harness inspect` does not depend on the
    quantity module importing cleanly.
