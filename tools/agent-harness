def quantity_lookup(key: str) -> dict[str, Any]:
    """Resolve one authority key to its value and the record it came from."""
    payload = dict(_quantities().lookup(key))
    payload["ok"] = True
    payload["tool"] = "harness"
    payload["command"] = "quantity lookup"
    payload["generated_at"] = now_iso()
    return payload


def quantity_keys(prefix: str | None = None) -> dict[str, Any]:
    """Enumerate the authority — discovery is what makes reading cheaper than guessing."""
    entries = _quantities().authority_entries()
    if prefix:
        entries = [item for item in entries if item["key"].startswith(prefix)]
    return {
        "ok": True,
        "tool": "harness",
        "command": "quantity keys",
        "generated_at": now_iso(),
        "prefix": prefix,
        "total": len(entries),
        "keys": entries,
    }


def census(args: Any) -> dict[str, Any]:
    """Measure how many exist right now, or refuse to answer at all."""
    module = _quantities()
    if args.census_command == "lines":
        payload = module.census_lines(args.target)
    elif args.census_command == "entries":
        payload = module.census_entries(args.target, glob=args.glob, recursive=args.recursive)
    else:
        payload = module.census_rows(args.via, path=args.path, timeout=read_probe_timeout(args.timeout))
    payload = dict(payload)
    payload["ok"] = True
    payload["tool"] = "harness"
    payload["command"] = f"census {args.census_command}"
    payload["measured_at"] = now_iso()
    return payload


