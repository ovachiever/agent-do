AUDIT_PLIST = Path.home() / "Library" / "LaunchAgents" / "com.agent-do.contracts-audit.plist"
AUDIT_REPORT = agent_do_home() / "audit" / "contracts-audit.md"


def contracts_audit(args: Any) -> dict[str, Any]:
    sys.path.insert(0, str(REPO_ROOT / "lib"))
    import tempfile  # noqa: WPS433
    from functools import partial  # noqa: WPS433
    from contracts_audit import audit_registry, render_report  # noqa: WPS433

    with tempfile.TemporaryDirectory(prefix="contracts-audit-") as scratch:
        # Probes run in a throwaway cwd: a verb that mistakes a flag for an
        # output path (the '--json' PNG incident) litters the scratch, not
        # the caller's directory.
        payload = audit_registry(
            load_bundled_registry(),
            partial(agent_do_cmd, cwd=Path(scratch)),
            include_network=args.include_network,
            schema_check=args.schema_check,
            only_tool=args.tool,
            timeout=args.timeout,
        )
    payload["tool"] = "harness"
    payload["command"] = "contracts audit"
    payload["generated_at"] = now_iso()
    if args.out:
        out_path = Path(args.out).expanduser()
        out_path.parent.mkdir(parents=True, exist_ok=True)
        out_path.write_text(render_report(payload, payload["generated_at"]), encoding="utf-8")
        payload["out"] = str(out_path)
    if args.notify and payload["summary"]["fail"] > 0:
        # Silent when clean — Erik only hears about tools breaking contracts.
        agent_do_cmd(
            "notify", "emit", "contracts_audit",
            "--fact", f"failures={payload['summary']['fail']}",
            "--fact", f"ok={payload['summary']['ok']}",
            timeout=30,
        )
    return payload


def contracts_audit_schedule(install: str | None, uninstall: bool) -> dict[str, Any]:
    sys.path.insert(0, str(REPO_ROOT / "lib"))
    from contracts_audit import build_launchd_plist  # noqa: WPS433

    if uninstall:
        subprocess.run(["launchctl", "unload", str(AUDIT_PLIST)], capture_output=True, check=False)
        existed = AUDIT_PLIST.exists()
        AUDIT_PLIST.unlink(missing_ok=True)
        return {"ok": True, "action": "uninstalled", "existed": existed, "plist": str(AUDIT_PLIST)}
    plist = build_launchd_plist(str(REPO_ROOT / "agent-do"), str(AUDIT_REPORT), install or "weekly")
    AUDIT_PLIST.parent.mkdir(parents=True, exist_ok=True)
    AUDIT_PLIST.write_text(plist, encoding="utf-8")
    subprocess.run(["launchctl", "unload", str(AUDIT_PLIST)], capture_output=True, check=False)
    result = subprocess.run(["launchctl", "load", str(AUDIT_PLIST)], capture_output=True, text=True, check=False)
    return {
        "ok": result.returncode == 0,
        "action": "installed",
        "frequency": install or "weekly",
        "plist": str(AUDIT_PLIST),
        "report": str(AUDIT_REPORT),
        "launchctl": (result.stderr or "loaded").strip(),
    }


