def nudge_events(since: str | None = None) -> list[dict[str, Any]]:
    cutoff = parse_since(since)
    events = read_jsonl(agent_do_home() / "telemetry" / "nudges.jsonl")
    if cutoff is None:
        return events
    filtered = []
    for event in events:
        timestamp = parse_iso(str(event.get("timestamp") or ""))
        if timestamp and timestamp >= cutoff:
            filtered.append(event)
    return filtered


def telemetry_events(since: str | None = None) -> list[dict[str, Any]]:
    cutoff = parse_since(since)
    events = read_jsonl(agent_do_home() / "telemetry" / "events.jsonl")
    if cutoff is None:
        return events
    filtered = []
    for event in events:
        timestamp = parse_iso(str(event.get("timestamp") or ""))
        if timestamp and timestamp >= cutoff:
            filtered.append(event)
    return filtered


def report_relevant_events(events: list[dict[str, Any]]) -> list[dict[str, Any]]:
    relevant = []
    for event in events:
        if (
            event.get("event_type") == "agent_tool_call"
            and event.get("tool") == "harness"
            and (event.get("args_shape") or [])[:2] == ["nudges", "effectiveness"]
        ):
            continue
        relevant.append(event)
    return relevant


def summarize_hook_outcomes(events: list[dict[str, Any]]) -> dict[str, Any]:
    sys.path.insert(0, str(REPO_ROOT / "lib"))
    from telemetry import summarize_hook_outcomes as summarize  # noqa: WPS433

    return summarize(events)


def nudge_effectiveness(since: str | None = None) -> dict[str, Any]:
    legacy_events = nudge_events(since)
    events = report_relevant_events(telemetry_events(since))
    outcome_summary = summarize_hook_outcomes(events)
    by_type = Counter(str(event.get("event_type") or "unknown") for event in legacy_events)
    by_source = Counter(str(event.get("source") or "unknown") for event in legacy_events)
    by_tool: Counter[str] = Counter()
    emitted = 0
    suppressed = 0

    for event in legacy_events:
        event_type = str(event.get("event_type") or "")
        if any(token in event_type for token in ("suppress", "silent", "skip")):
            suppressed += 1
        else:
            emitted += 1
        if event.get("tool"):
            by_tool[str(event["tool"])] += 1
        for tool in event.get("tools", []) or []:
            by_tool[str(tool)] += 1

    return {
        "ok": True,
        "tool": "harness",
        "command": "nudges effectiveness",
        "generated_at": now_iso(),
        "since": since,
        "log": str(agent_do_home() / "telemetry" / "events.jsonl"),
        "legacy_log": str(agent_do_home() / "telemetry" / "nudges.jsonl"),
        "summary": {
            "events": outcome_summary["events"] if events else len(legacy_events),
            "telemetry_events": outcome_summary["events"],
            "legacy_nudge_events": len(legacy_events),
            "emitted": emitted,
            "suppressed": suppressed,
            "decisions": outcome_summary["decisions"],
            "followed": outcome_summary["followed"],
            "ignored": outcome_summary["ignored"],
            "expired": outcome_summary["expired"],
            "pending": outcome_summary["pending"],
            "resolved": outcome_summary["resolved"],
            "follow_through_rate": outcome_summary["follow_through_rate"],
            "by_type": dict(by_type.most_common()),
            "by_outcome_type": outcome_summary["by_type"],
            "by_hook": outcome_summary["by_hook"],
            "by_source": dict(by_source.most_common()),
            "by_tool": outcome_summary["by_tool"] or dict(by_tool.most_common()),
        },
        "compliance": {
            "status": "available" if events else "legacy_only",
            "reason": (
                "Hook decisions are correlated with observed agent-do tool calls/results."
                if events
                else "Only legacy nudge events were found; run current hooks and agent-do commands to collect outcome telemetry."
            ),
        },
        "events": events[-25:] if events else legacy_events[-25:],
    }


