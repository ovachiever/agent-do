def contracts_validate(strict: bool) -> dict[str, Any]:
    """The gate: contract shape, full coverage, and now bound provenance.

    Bounds ride in the same run rather than a second command, because a gate
    nobody remembers to run is a doc line with a shebang. An undeclared bound
    fails exactly where an undeclared contract already fails.
    """
    sys.path.insert(0, str(REPO_ROOT / "lib"))
    from contracts import validate_gate  # noqa: WPS433
    from bounds import validate_bounds  # noqa: WPS433

    registry = load_bundled_registry()
    payload = validate_gate(registry, strict=strict)
    payload["bounds"] = validate_bounds(registry, REPO_ROOT)
    payload["ok"] = payload["ok"] and payload["bounds"]["errors"] == 0
    payload["generated_at"] = now_iso()
    return payload


