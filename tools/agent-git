#!/usr/bin/env bash
# agent-git - Enhanced git operations

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"

show_help() {
    cat << 'EOF'
Local repository operations. For GitHub PRs/reviews use: agent-do gh

Commands:
  status           Show working tree status (compact)
  diff             Show diff of changes
  log [n]          Show recent commits (default: 10)
  commit [msg]     Commit staged changes after a redacted secret scan
    --no-scan      Explicitly bypass the scan (warning + telemetry)
  branch           List branches
  branch <name>    Create and switch to branch
  stash            Stash changes
  stash pop        Pop stashed changes
  pull             Pull with rebase
  push             Push to remote
  sync             Pull and push (sync with remote)
  snapshot          Full repo state as JSON (branch, status, log, remotes, stashes)
  worktree add <branch> [--path <dir>] [--no-seed] [--no-bind]
    Seeds named gitignored files, and binds the new worktree's zpc memory to
    this checkout's store — .zpc/ is gitignored, so an unbound worktree records
    its lessons into a store that dies with it. The binding is a line in
    $AGENT_DO_HOME/zpc/worktree-bindings.tsv keyed by the worktree's absolute
    path: nothing is written into either tree, so no repository can decide
    where your memory is read or written. Honored only while both the store and
    that file are owned by you; `worktree remove` prunes the entry.
    --no-seed  copy no gitignored files
    --no-bind  give the worktree its own throwaway store instead
    The manna board does NOT bind: each checkout carries its own .manna, so
    worktree add warns and tells you to run board commands from here.
  worktree list
  worktree remove <path>
  worktree prune [--dry-run]
    Clear registrations whose directory no longer exists (lists each path;
    `worktree list --json` marks them "prunable"). Locked ones are kept.
  snap list|diff
  snap restore <file> [--in-place]
  conflicts        List unmerged files and conflict-marker counts
  recover          Read-only reflog and unreachable-commit report
  sweep [--apply]  Preview safe local branch cleanup; apply explicitly

Examples:
  agent-git status
  agent-git log 5
  agent-git commit "fix: resolve login issue"
  agent-git branch feature/new-thing
EOF
}

# --- JSON output helpers ---------------------------------------------------
# Detect and strip a --json flag from the argument list. Sets JSON_MODE=1 when
# present. Remaining args are stored in JSON_ARGS for the caller to use. Plain
# text behavior is unchanged when --json is absent.
JSON_MODE=0
JSON_ARGS=()
parse_json_flag() {
    JSON_MODE=0
    JSON_ARGS=()
    local arg
    for arg in "$@"; do
        if [[ "$arg" == "--json" ]]; then
            JSON_MODE=1
        else
            JSON_ARGS+=("$arg")
        fi
    done
}

# Emit a structured JSON error and exit nonzero.
json_fail() {
    local message="$1"
    local code="${2:-1}"
    python3 -c "
import json, sys
print(json.dumps({'ok': False, 'error': sys.argv[1]}))
" "$message"
    exit "$code"
}

# log as JSON: structured commits.
cmd_log_json() {
    local count="${1:-10}"
    if ! git rev-parse --git-dir >/dev/null 2>&1; then
        json_fail "not a git repository"
    fi
    git log --pretty=format:'%H%x1f%h%x1f%an%x1f%aI%x1f%s' -n "$count" 2>/dev/null \
        | python3 -c "
import sys, json
commits = []
for line in sys.stdin.read().split('\n'):
    if not line:
        continue
    parts = line.split('\x1f')
    if len(parts) < 5:
        continue
    commits.append({
        'hash': parts[0],
        'short': parts[1],
        'author': parts[2],
        'date': parts[3],
        'message': parts[4],
    })
print(json.dumps({'ok': True, 'count': len(commits), 'commits': commits}))
"
}

# diff as JSON: per-file stat lines plus raw diff text.
cmd_diff_json() {
    if ! git rev-parse --git-dir >/dev/null 2>&1; then
        json_fail "not a git repository"
    fi
    local scope diff_text numstat
    if git diff --cached --quiet 2>/dev/null; then
        scope="unstaged"
        diff_text=$(git diff 2>/dev/null)
        numstat=$(git diff --numstat 2>/dev/null)
    else
        scope="staged"
        diff_text=$(git diff --cached 2>/dev/null)
        numstat=$(git diff --cached --numstat 2>/dev/null)
    fi
    SCOPE="$scope" DIFF_TEXT="$diff_text" NUMSTAT="$numstat" python3 -c "
import os, json
scope = os.environ.get('SCOPE', '')
diff_text = os.environ.get('DIFF_TEXT', '')
numstat = os.environ.get('NUMSTAT', '')
files = []
for line in numstat.split('\n'):
    if not line.strip():
        continue
    parts = line.split('\t')
    if len(parts) < 3:
        continue
    added = None if parts[0] == '-' else int(parts[0])
    deleted = None if parts[1] == '-' else int(parts[1])
    files.append({'path': parts[2], 'added': added, 'deleted': deleted})
print(json.dumps({'ok': True, 'scope': scope, 'count': len(files), 'files': files, 'diff': diff_text}))
"
}

# branch as JSON: list branches (the read/snapshot form). Creating a branch is
# a write verb and is not exposed through --json.
cmd_branch_json() {
    if ! git rev-parse --git-dir >/dev/null 2>&1; then
        json_fail "not a git repository"
    fi
    local current branch_lines
    current=$(git branch --show-current 2>/dev/null)
    branch_lines=$(git branch -a 2>/dev/null)
    CURRENT="$current" BRANCH_LINES="$branch_lines" python3 -c "
import os, json
current = os.environ.get('CURRENT', '')
branch_lines = os.environ.get('BRANCH_LINES', '')
branches = []
for line in branch_lines.split('\n'):
    line = line.rstrip()
    if not line:
        continue
    is_current = line.startswith('*')
    name = line.lstrip('* ').strip()
    branches.append({'name': name, 'current': is_current, 'remote': name.startswith('remotes/')})
print(json.dumps({'ok': True, 'current': current, 'count': len(branches), 'branches': branches}))
"
}

cmd_status() {
    git status --short --branch
}

cmd_diff() {
    if git diff --cached --quiet 2>/dev/null; then
        # No staged changes, show unstaged
        git diff
    else
        # Show staged changes
        git diff --cached
    fi
}

cmd_log() {
    local count="${1:-10}"
    git log --oneline -n "$count"
}

cmd_commit() {
    local no_scan=0
    local parts=()
    local arg
    for arg in "$@"; do
        if [[ "$arg" == "--no-scan" ]]; then
            no_scan=1
        else
            parts+=("$arg")
        fi
    done
    local msg="${parts[*]}"

    if git diff --cached --quiet 2>/dev/null; then
        local refusal="Nothing is staged. Stage only files you own with: git add <paths>"
        if [[ "$JSON_MODE" == "1" ]]; then
            python3 -c 'import json, sys; print(json.dumps({"blocked": True, "reason": "nothing_staged", "findings": [], "error": sys.argv[1]}))' "$refusal"
        else
            echo "Error: $refusal" >&2
        fi
        return 1
    fi

    if [[ "$no_scan" == "1" ]]; then
        echo "WARNING: staged secret scan bypassed by explicit --no-scan" >&2
        PYTHONPATH="$ROOT_DIR/lib${PYTHONPATH:+:$PYTHONPATH}" python3 - <<'PYEOF' >/dev/null 2>&1 || true
from telemetry import append_event
append_event("git_secret_scan_bypass", "git", command="commit")
PYEOF
    else
        local findings
        findings=$(git diff --cached --no-color --no-ext-diff --unified=0 | python3 -c '
import json
import re
import sys

detectors = [
    ("private-key-block", re.compile(r"-----BEGIN (?:[A-Z0-9 ]+ )?PRIVATE KEY-----")),
    ("provider-key-shape", re.compile(r"(?:sk-[A-Za-z0-9_-]{16,}|AKIA[0-9A-Z]{16}|gh[opusr]_[A-Za-z0-9_]{20,})")),
    ("api-key", re.compile(r"(?i)\\b(?:api[_-]?key|apikey)\\b\\s*[:=]\\s*[\\\"\\\x27]?\\S+")),
    ("token", re.compile(r"(?i)\\b(?:access[_-]?token|auth[_-]?token|token)\\b\\s*[:=]\\s*[\\\"\\\x27]?\\S+")),
    ("password-assignment", re.compile(r"(?i)\\b(?:password|passwd|pwd)\\b\\s*[:=]\\s*[\\\"\\\x27]?\\S+")),
]

path = None
new_line = 0
findings = []
for raw in sys.stdin:
    if raw.startswith("+++ b/"):
        path = raw[6:].rstrip("\\n")
        continue
    if raw.startswith("@@"):
        match = re.search(r"\\+(\\d+)", raw)
        new_line = int(match.group(1)) if match else 0
        continue
    if raw.startswith("+") and not raw.startswith("+++"):
        value = raw[1:].rstrip("\\n")
        for detector, pattern in detectors:
            if pattern.search(value):
                findings.append({"file": path or "?", "line": new_line, "detector": detector})
        new_line += 1
    elif raw.startswith(" "):
        new_line += 1
print(json.dumps(findings, separators=(",", ":")))
')
        local finding_count
        finding_count=$(FINDINGS="$findings" python3 -c 'import json, os; print(len(json.loads(os.environ["FINDINGS"])))')
        if [[ "$finding_count" -gt 0 ]]; then
            if [[ "$JSON_MODE" == "1" ]]; then
                FINDINGS="$findings" python3 -c 'import json, os; print(json.dumps({"blocked": True, "findings": json.loads(os.environ["FINDINGS"])}))'
            else
                echo "Commit blocked: staged secret scan found $finding_count potential secret(s); matched values are redacted." >&2
                FINDINGS="$findings" python3 -c '
import json
import os
for item in json.loads(os.environ["FINDINGS"]):
    print(f"  {item[\"file\"]}:{item[\"line\"]} [{item[\"detector\"]}] value redacted", file=__import__("sys").stderr)
'
            fi
            return 1
        fi
    fi

    if [[ -z "$msg" ]]; then
        # Auto-generate commit message from diff
        echo "Generating commit message..."
        local diff_summary
        diff_summary=$(git diff --cached --stat | tail -1)
        local files_changed
        files_changed=$(git diff --cached --name-only | head -5 | tr '\n' ', ' | sed 's/,$//')
        msg="Update: $files_changed ($diff_summary)"
    fi

    if [[ "$JSON_MODE" == "1" ]]; then
        local output
        if ! output=$(git commit -m "$msg" 2>&1); then
            json_fail "$output"
        fi
        local commit_hash
        commit_hash=$(git rev-parse HEAD)
        COMMIT_HASH="$commit_hash" COMMIT_MESSAGE="$msg" python3 -c 'import json, os; print(json.dumps({"blocked": False, "commit": os.environ["COMMIT_HASH"], "message": os.environ["COMMIT_MESSAGE"], "findings": []}))'
    else
        git commit -m "$msg"
    fi
}

cmd_branch() {
    local name="${1:-}"

    if [[ -z "$name" ]]; then
        git branch -a
    else
        git checkout -b "$name" 2>/dev/null || git checkout "$name"
    fi
}

cmd_stash() {
    local subcmd="${1:-push}"

    case "$subcmd" in
        pop)
            git stash pop
            ;;
        list)
            git stash list
            ;;
        push|"")
            git stash push -m "agent-git stash $(date '+%Y-%m-%d %H:%M:%S')"
            ;;
        *)
            git stash "$@"
            ;;
    esac
}

cmd_pull() {
    git pull --rebase
}

cmd_push() {
    local branch
    branch=$(git branch --show-current)

    # Check if remote tracking branch exists
    if ! git rev-parse --abbrev-ref "$branch@{upstream}" &>/dev/null; then
        echo "Setting upstream to origin/$branch"
        git push -u origin "$branch"
    else
        git push
    fi
}

cmd_sync() {
    echo "Pulling..."
    git pull --rebase
    echo "Pushing..."
    cmd_push
    echo "Synced!"
}

cmd_snapshot() {
    python3 -c "
import subprocess, json

def run(cmd):
    r = subprocess.run(cmd, shell=True, capture_output=True, text=True)
    return r.stdout.strip()

# Branch info
branch = run('git branch --show-current')
all_branches = [b.strip().lstrip('* ') for b in run('git branch').split('\n') if b.strip()]

# Remote info
remotes = []
for line in run('git remote -v').split('\n'):
    if line.strip() and '(fetch)' in line:
        parts = line.split()
        remotes.append({'name': parts[0], 'url': parts[1]})

# Status
status_lines = run('git status --porcelain')
staged = []
unstaged = []
untracked = []
for line in status_lines.split('\n'):
    if not line: continue
    idx, wt = line[0], line[1]
    path = line[3:]
    if idx != ' ' and idx != '?':
        staged.append({'status': idx, 'path': path})
    if wt != ' ' and wt != '?':
        unstaged.append({'status': wt, 'path': path})
    if idx == '?' and wt == '?':
        untracked.append(path)

# Recent log
log = []
for line in run('git log --oneline -10').split('\n'):
    if not line: continue
    parts = line.split(' ', 1)
    log.append({'hash': parts[0], 'message': parts[1] if len(parts) > 1 else ''})

# Stashes
stashes = [s.strip() for s in run('git stash list').split('\n') if s.strip()]

# Ahead/behind
ahead_behind = run('git rev-list --left-right --count HEAD...@{upstream} 2>/dev/null')
ahead = 0
behind = 0
if ahead_behind:
    parts = ahead_behind.split()
    if len(parts) == 2:
        ahead, behind = int(parts[0]), int(parts[1])

# Repo info
repo_root = run('git rev-parse --show-toplevel')
repo_name = repo_root.split('/')[-1] if repo_root else ''

snapshot = {
    'repo': repo_name,
    'branch': branch,
    'branches': all_branches,
    'remotes': remotes,
    'ahead': ahead,
    'behind': behind,
    'staged': {'count': len(staged), 'files': staged},
    'unstaged': {'count': len(unstaged), 'files': unstaged},
    'untracked': {'count': len(untracked), 'files': untracked[:20]},
    'clean': len(staged) == 0 and len(unstaged) == 0 and len(untracked) == 0,
    'log': log,
    'stashes': len(stashes),
}
print(json.dumps(snapshot, indent=2))
"
}

cmd_worktree_list() {
    local porcelain
    porcelain=$(git worktree list --porcelain)
    if [[ "$JSON_MODE" == "1" ]]; then
        WORKTREES="$porcelain" python3 -c '
import json
import os

items = []
current = None
for line in os.environ.get("WORKTREES", "").splitlines():
    if line.startswith("worktree "):
        if current:
            items.append(current)
        current = {"path": line[9:], "head": None, "branch": None, "bare": False, "detached": False,
                   "locked": False, "prunable": None}
    elif current is not None and line.startswith("HEAD "):
        current["head"] = line[5:]
    elif current is not None and line.startswith("branch refs/heads/"):
        current["branch"] = line[len("branch refs/heads/"):]
    elif current is not None and line == "bare":
        current["bare"] = True
    elif current is not None and line == "detached":
        current["detached"] = True
    elif current is not None and (line == "locked" or line.startswith("locked ")):
        current["locked"] = True
    elif current is not None and line.startswith("prunable"):
        current["prunable"] = line[len("prunable"):].strip() or "prunable"
if current:
    items.append(current)
print(json.dumps({"ok": True, "worktrees": items}))
'
    else
        git worktree list
    fi
}

# The uid owning a path: `link` reads the name, `target` (default) reads what
# it resolves to. Identical rule to zpc's own (tools/agent-zpc/lib/common.sh)
# and the session-start hooks', because this writes the pointer those two then
# trust. GNU stat reads -f as --file-system and answers with something that is
# not a uid at all, so the answer has to look like one before it counts.
_git_path_uid() {
    local uid
    if [[ "${2:-target}" == "link" ]]; then
        uid="$(stat -f %u "$1" 2>/dev/null)"
        [[ "$uid" =~ ^[0-9]+$ ]] || uid="$(stat -c %u "$1" 2>/dev/null)"
    else
        uid="$(stat -L -f %u "$1" 2>/dev/null)"
        [[ "$uid" =~ ^[0-9]+$ ]] || uid="$(stat -L -c %u "$1" 2>/dev/null)"
    fi
    [[ "$uid" =~ ^[0-9]+$ ]] || return 1
    printf '%s' "$uid"
}

_git_store_is_ours() {
    local me="${EUID:-$(id -u)}" owner
    owner="$(_git_path_uid "$1" link)" || return 1
    [[ "$owner" == "$me" ]] || return 1
    owner="$(_git_path_uid "$1" target)" || return 1
    [[ "$owner" == "$me" ]]
}

# Where memory bindings live: this user's config, never a repository. The
# location is the security property — see _zpc_binding_for in
# tools/agent-zpc/lib/common.sh for why a pointer inside the tree cannot be
# trusted no matter how it is checked.
_git_bindings_file() {
    printf '%s/zpc/worktree-bindings.tsv' "${AGENT_DO_HOME:-$HOME/.agent-do}"
}

# The store a new worktree should be bound to: the primary checkout's, or —
# when the primary is itself a bound checkout — the store it is bound to, so
# the chain stays one hop deep however many worktrees are nested. Prints
# nothing and fails when there is no store worth binding to.
_git_primary_zpc_store() {
    local root="${1%/}" store="$1/.zpc" bindings worktree target
    if [[ -d "$store" ]] && _git_store_is_ours "$store"; then
        printf '%s' "$store"
        return 0
    fi

    bindings="$(_git_bindings_file)"
    [[ -f "$bindings" ]] || return 1
    _git_store_is_ours "$bindings" || return 1
    while IFS=$'\t' read -r worktree target || [[ -n "$worktree" ]]; do
        [[ -n "$worktree" && "$worktree" != \#* ]] || continue
        [[ "${worktree%/}" == "$root" ]] || continue
        target="${target%$'\r'}"
        target="${target%/}"
        [[ -n "$target" && "$target" == /* && "$target" == */.zpc && -d "$target" ]] || return 1
        _git_store_is_ours "$target" || return 1
        printf '%s' "$target"
        return 0
    done < "$bindings"
    return 1
}

# Bind a fresh worktree's memory to the store that outlives it.
#
# .zpc/ is gitignored, so a linked worktree starts with no store at all, and
# the session-start hook's auto-init then creates an empty one at the worktree
# toplevel. Every lesson that agent records lands there and dies with
# `worktree remove`. The binding is a line in this user's own registry, keyed
# by the worktree's absolute path: nothing is written into either tree, so no
# repository — cloned, forked, or hostile — can move where memory lives. A
# destination that already has its own .zpc is left alone and unbound.
_git_bind_worktree_zpc() {
    local repo_root="$1" destination="$2" store bindings tmp
    [[ -e "$destination/.zpc" ]] && return 1
    store="$(_git_primary_zpc_store "$repo_root")" || return 1

    # Tabs and newlines are the format's only reserved characters, and a path
    # holding one is refused rather than escaped: every reader is a plain line
    # split, and quietly writing a line they would misparse is worse than
    # declining a binding here.
    case "$destination$store" in
        *$'\t'*|*$'\n'*) return 1 ;;
    esac

    bindings="$(_git_bindings_file)"
    mkdir -p "$(dirname "$bindings")" 2>/dev/null || return 1
    chmod 700 "$(dirname "$bindings")" 2>/dev/null || true
    [[ -f "$bindings" ]] || {
        {
            printf '# agent-do: which checkout each worktree keeps its memory in.\n'
            printf '# <absolute worktree>TAB<absolute .zpc store>. Written by\n'
            printf '# `agent-git worktree add`, pruned by `worktree remove`, read by zpc\n'
            printf '# and the session-start hooks. Kept here, outside every repository,\n'
            printf '# so that no repo can decide where your memory is read or written.\n'
        } > "$bindings" || return 1
    }
    chmod 600 "$bindings" 2>/dev/null || true

    _git_unbind_worktree_zpc "$destination"
    printf '%s\t%s\n' "$destination" "$store" >> "$bindings" || return 1
    printf '%s' "$store"
}

# Drop a worktree's binding. Keyed by exact path, so removing a worktree and
# later creating an unrelated one at the same path cannot inherit the old
# binding. Silent and successful when there is nothing to drop.
_git_unbind_worktree_zpc() {
    local target="${1%/}" bindings tmp line worktree
    bindings="$(_git_bindings_file)"
    [[ -f "$bindings" ]] || return 0
    _git_store_is_ours "$bindings" || return 0
    grep -q . "$bindings" 2>/dev/null || return 0

    tmp="$bindings.$$"
    : > "$tmp" || return 0
    chmod 600 "$tmp" 2>/dev/null || true
    while IFS= read -r line || [[ -n "$line" ]]; do
        worktree="${line%%$'\t'*}"
        [[ "${worktree%/}" == "$target" && "$line" != \#* ]] && continue
        printf '%s\n' "$line" >> "$tmp"
    done < "$bindings"
    mv "$tmp" "$bindings" 2>/dev/null || rm -f "$tmp"
    return 0
}

cmd_worktree_add() {
    local branch="${1:-}"
    [[ -n "$branch" ]] || { echo "Usage: agent-git worktree add <branch> [--path <dir>] [--no-seed] [--no-bind]" >&2; return 1; }
    shift
    git check-ref-format --branch "$branch" >/dev/null 2>&1 || { echo "Error: invalid branch name: $branch" >&2; return 1; }

    local destination="" seed=true bind=true
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --path) destination="${2:-}"; shift 2 ;;
            --no-seed) seed=false; shift ;;
            --no-bind) bind=false; shift ;;
            *) echo "Error: unknown worktree add option: $1" >&2; return 1 ;;
        esac
    done

    local repo_root repo_name
    repo_root=$(git rev-parse --show-toplevel)
    repo_name=$(basename "$repo_root")
    if [[ -z "$destination" ]]; then
        local safe_branch="${branch//\//-}"
        destination="$(dirname "$repo_root")/${repo_name}-${safe_branch}"
    fi
    destination=$(python3 -c 'import os, sys; print(os.path.abspath(os.path.expanduser(sys.argv[1])))' "$destination")
    if [[ -e "$destination" ]]; then
        echo "Error: destination already exists; refusing to overwrite: $destination" >&2
        return 1
    fi

    local add_output
    if git show-ref --verify --quiet "refs/heads/$branch"; then
        add_output=$(git worktree add "$destination" "$branch" 2>&1) || { echo "$add_output" >&2; return 1; }
    else
        add_output=$(git worktree add -b "$branch" "$destination" 2>&1) || { echo "$add_output" >&2; return 1; }
    fi

    local seeded=() skipped=() candidates=()
    if [[ "$seed" == "true" ]]; then
        local candidate rel target
        shopt -s nullglob
        for candidate in "$repo_root"/.env "$repo_root"/.env.* "$repo_root"/CLAUDE.local.md; do
            [[ -f "$candidate" ]] && candidates+=("${candidate#"$repo_root"/}")
        done
        shopt -u nullglob
        if [[ -f "$repo_root/.agent-do/worktree-seed" ]]; then
            while IFS= read -r rel || [[ -n "$rel" ]]; do
                rel="${rel%%#*}"
                rel="$(printf '%s' "$rel" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
                [[ -n "$rel" ]] && candidates+=("$rel")
            done < "$repo_root/.agent-do/worktree-seed"
        fi

        declare -A seen=()
        for rel in "${candidates[@]}"; do
            if [[ "$rel" == /* || "$rel" == ".." || "$rel" == ../* || "$rel" == */../* || -n "${seen[$rel]:-}" ]]; then
                continue
            fi
            seen[$rel]=1
            candidate="$repo_root/$rel"
            [[ -f "$candidate" ]] || continue
            git -C "$repo_root" check-ignore -q -- "$rel" || continue
            target="$destination/$rel"
            if [[ -e "$target" || -L "$target" ]]; then
                skipped+=("$rel")
                continue
            fi
            mkdir -p "$(dirname "$target")"
            cp -p "$candidate" "$target"
            seeded+=("$rel")
        done
    fi

    local bound_store=""
    if [[ "$bind" == "true" ]]; then
        bound_store="$(_git_bind_worktree_zpc "$repo_root" "$destination" || true)"
    fi

    # The board does not bind. manna resolves .manna relative to the checkout
    # (tools/agent-manna/src/store.rs) with no path override, so this worktree
    # carries its own copy of the tracked board from the moment it exists, and
    # claims made on either side never reach the other. That cannot be fixed
    # from here, so it is said out loud instead: a fork the operator knows about
    # is a decision, a fork nobody mentioned is a lost afternoon.
    local board_warning=""
    if [[ -d "$repo_root/.manna" ]]; then
        board_warning="WARNING: the manna board does not follow this worktree.
  $destination/.manna is a separate copy of the board at this branch's HEAD.
  Claims, done, and block made from inside the worktree stay there, diverge
  from the primary board, and collide when the branch merges.
  Run board commands against the primary checkout instead:
    (cd $repo_root && agent-do manna claim <id>)"
    fi

    if [[ "$JSON_MODE" == "1" ]]; then
        [[ -n "$board_warning" ]] && printf '%s\n' "$board_warning" >&2
        DESTINATION="$destination" BRANCH="$branch" SEED="$seed" BOUND="$bound_store" WARNING="$board_warning" \
        SEEDED="$(printf '%s\n' "${seeded[@]}")" SKIPPED="$(printf '%s\n' "${skipped[@]}")" \
        python3 -c '
import json
import os
lines = lambda name: [line for line in os.environ.get(name, "").splitlines() if line]
warning = os.environ.get("WARNING", "")
print(json.dumps({
    "ok": True,
    "branch": os.environ["BRANCH"],
    "path": os.environ["DESTINATION"],
    "seed_enabled": os.environ["SEED"] == "true",
    "seeded": lines("SEEDED"),
    "skipped_existing": lines("SKIPPED"),
    "zpc_store": os.environ.get("BOUND") or None,
    "warnings": [warning] if warning else [],
}))
'
    else
        echo "$add_output"
        echo "Worktree: $destination"
        [[ "$seed" == "true" ]] && echo "Seeded: ${seeded[*]:-(none)}"
        [[ ${#skipped[@]} -gt 0 ]] && echo "Skipped existing: ${skipped[*]}"
        [[ -n "$bound_store" ]] && echo "ZPC memory: bound to $bound_store"
        [[ -n "$board_warning" ]] && printf '\n%s\n' "$board_warning"
    fi
    # An explicit success: every line above is a conditional, and under `set -e`
    # the last one to be false would otherwise become this command's exit code.
    return 0
}

cmd_worktree_remove() {
    local target="${1:-}"
    [[ -n "$target" ]] || { echo "Usage: agent-git worktree remove <path>" >&2; return 1; }
    local absolute output
    absolute=$(python3 -c 'import os, sys; print(os.path.abspath(os.path.expanduser(sys.argv[1])))' "$target")
    output=$(git worktree remove "$absolute" 2>&1) || { [[ "$JSON_MODE" == "1" ]] && json_fail "$output" || echo "$output" >&2; return 1; }
    # The tree is gone, so its binding is a dangling key. Harmless while it
    # dangles (resolution only ever asks about directories a session is
    # actually in) but pruned anyway, so a later worktree at the same path
    # starts from nothing rather than inheriting this one's answer.
    _git_unbind_worktree_zpc "$absolute"
    if [[ "$JSON_MODE" == "1" ]]; then
        REMOVED="$absolute" python3 -c 'import json, os; print(json.dumps({"ok": True, "removed": os.environ["REMOVED"]}))'
    else
        echo "Removed worktree: $absolute"
    fi
}

# Registrations whose directory is gone (agents working in /private/tmp,
# mktemp checkouts) cannot be removed with `worktree remove` — there is no
# tree left. `git worktree prune` clears them; this wraps it, reports exactly
# which paths went (from the porcelain `prunable` lines, read first), and
# drops their zpc bindings. Locked worktrees are never pruned (git's rule).
cmd_worktree_prune() {
    local dry_run=0
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --dry-run|-n) dry_run=1; shift ;;
            *) echo "Usage: agent-git worktree prune [--dry-run] [--json]" >&2; return 2 ;;
        esac
    done
    local candidates
    candidates=$(git worktree list --porcelain | python3 -c '
import sys
path = None
for line in sys.stdin.read().splitlines():
    if line.startswith("worktree "):
        path = line[9:]
    elif line.startswith("prunable") and path:
        print(path + "\t" + (line[len("prunable"):].strip() or "prunable"))
') || return 1
    if [[ "$dry_run" == "0" ]]; then
        local output
        output=$(git worktree prune -v 2>&1) || {
            [[ "$JSON_MODE" == "1" ]] && json_fail "$output" || echo "$output" >&2
            return 1
        }
        local path reason
        while IFS=$'\t' read -r path reason; do
            [[ -n "$path" ]] && _git_unbind_worktree_zpc "$path"
        done <<< "$candidates"
    fi
    if [[ "$JSON_MODE" == "1" ]]; then
        CANDIDATES="$candidates" DRY="$dry_run" python3 -c '
import json, os
rows = [l.split("\t", 1) for l in os.environ["CANDIDATES"].splitlines() if l]
print(json.dumps({"ok": True, "dry_run": os.environ["DRY"] == "1",
                  "pruned": [{"path": p, "reason": r} for p, r in rows]}))'
    elif [[ -z "$candidates" ]]; then
        echo "No stale worktree registrations."
    else
        local verb="Pruned"
        [[ "$dry_run" == "1" ]] && verb="Would prune"
        local path reason
        while IFS=$'\t' read -r path reason; do
            echo "$verb: $path ($reason)"
        done <<< "$candidates"
    fi
}

cmd_worktree() {
    local subcommand="${1:-list}"
    shift || true
    case "$subcommand" in
        add) cmd_worktree_add "$@" ;;
        list) cmd_worktree_list ;;
        remove) cmd_worktree_remove "$@" ;;
        prune) cmd_worktree_prune "$@" ;;
        *) echo "Usage: agent-git worktree add|list|remove|prune" >&2; return 1 ;;
    esac
}

current_snap_ref() {
    local branch
    branch=$(git branch --show-current)
    [[ -n "$branch" ]] || return 1
    printf 'refs/auto/%s\n' "$branch"
}

require_snap_ref() {
    local ref
    ref=$(current_snap_ref) || { echo "Error: snapshots require a named current branch" >&2; return 1; }
    if ! git show-ref --verify --quiet "$ref"; then
        if [[ "$JSON_MODE" == "1" ]]; then
            REF="$ref" python3 -c 'import json, os; print(json.dumps({"ok": True, "available": False, "ref": os.environ["REF"], "message": "No auto snapshot exists for the current branch."}))'
        else
            echo "No auto snapshot exists for the current branch (${ref#refs/auto/})."
        fi
        return 2
    fi
    printf '%s\n' "$ref"
}

cmd_snap_list() {
    local rows
    rows=$(git for-each-ref refs/auto --format='%(refname:strip=2)%09%(objectname)%09%(creatordate:iso8601-strict)')
    if [[ "$JSON_MODE" == "1" ]]; then
        ROWS="$rows" python3 -c '
import json
import os
items = []
for line in os.environ.get("ROWS", "").splitlines():
    branch, commit, date = (line.split("\t", 2) + ["", ""])[:3]
    if branch:
        items.append({"branch": branch, "ref": f"refs/auto/{branch}", "commit": commit, "date": date})
print(json.dumps({"ok": True, "snapshots": items}))
'
    else
        if [[ -n "$rows" ]]; then printf '%s\n' "$rows"; else echo "No auto snapshots found."; fi
    fi
}

cmd_snap_diff() {
    local ref
    if ref=$(require_snap_ref); then
        :
    else
        local rc=$?
        if [[ $rc -eq 2 ]]; then
            printf '%s\n' "$ref"
            return 0
        fi
        return "$rc"
    fi
    local diff
    diff=$(git diff "$ref" --)
    if [[ "$JSON_MODE" == "1" ]]; then
        REF="$ref" DIFF="$diff" python3 -c 'import json, os; print(json.dumps({"ok": True, "available": True, "ref": os.environ["REF"], "diff": os.environ["DIFF"]}))'
    else
        printf '%s\n' "$diff"
    fi
}

cmd_snap_restore() {
    local file="${1:-}" in_place=false
    [[ -n "$file" ]] || { echo "Usage: agent-git snap restore <file> [--in-place]" >&2; return 1; }
    shift
    [[ "${1:-}" == "--in-place" ]] && in_place=true
    if [[ "$file" == /* || "$file" == ".." || "$file" == ../* || "$file" == */../* ]]; then
        echo "Error: snapshot restore path must stay inside the repository" >&2
        return 1
    fi
    local ref
    if ref=$(require_snap_ref); then
        :
    else
        local rc=$?
        if [[ $rc -eq 2 ]]; then
            printf '%s\n' "$ref"
            return 0
        fi
        return "$rc"
    fi
    git cat-file -e "$ref:$file" 2>/dev/null || { echo "Error: $file is not present in $ref" >&2; return 1; }
    local root target temporary
    root=$(git rev-parse --show-toplevel)
    target="$root/$file"
    [[ "$in_place" == "false" ]] && target="$target.recovered"
    if [[ "$in_place" == "false" && ( -e "$target" || -L "$target" ) ]]; then
        echo "Error: recovery target already exists; refusing to overwrite: $target" >&2
        return 1
    fi
    mkdir -p "$(dirname "$target")"
    temporary=$(mktemp "${TMPDIR:-/tmp}/agent-git-recover.XXXXXX")
    if ! git show "$ref:$file" > "$temporary"; then
        rm -f "$temporary"
        return 1
    fi
    mv "$temporary" "$target"
    if [[ "$JSON_MODE" == "1" ]]; then
        REF="$ref" TARGET="$target" IN_PLACE="$in_place" python3 -c 'import json, os; print(json.dumps({"ok": True, "ref": os.environ["REF"], "path": os.environ["TARGET"], "in_place": os.environ["IN_PLACE"] == "true"}))'
    else
        echo "Recovered $file to $target"
    fi
}

cmd_snap() {
    local subcommand="${1:-list}"
    shift || true
    case "$subcommand" in
        list) cmd_snap_list ;;
        diff) cmd_snap_diff ;;
        restore) cmd_snap_restore "$@" ;;
        *) echo "Usage: agent-git snap list|diff|restore <file>" >&2; return 1 ;;
    esac
}

cmd_conflicts() {
    JSON_MODE_VALUE="$JSON_MODE" python3 <<'PYEOF'
import json
import os
import subprocess
from pathlib import Path

raw = subprocess.run(
    ["git", "diff", "--name-only", "--diff-filter=U", "-z"],
    check=True,
    capture_output=True,
).stdout
files = []
for value in raw.split(b"\0"):
    if not value:
        continue
    path = os.fsdecode(value)
    try:
        text = Path(path).read_text(encoding="utf-8", errors="replace")
    except OSError:
        text = ""
    files.append({
        "path": path,
        "markers": text.count("<<<<<<<") + text.count("=======") + text.count(">>>>>>>"),
    })
payload = {"ok": True, "count": len(files), "files": files}
if os.environ["JSON_MODE_VALUE"] == "1":
    print(json.dumps(payload))
elif not files:
    print("No conflicted files.")
else:
    for item in files:
        print(f"{item['path']} ({item['markers']} conflict markers)")
PYEOF
}

cmd_recover() {
    # Verify-beat contract: a refusal must carry a clear reason. Guard the
    # no-repository case up front the way the *_json siblings do, so a probe
    # outside any repo yields a structured error instead of an empty report.
    if ! git rev-parse --git-dir >/dev/null 2>&1; then
        if [[ "$JSON_MODE" == "1" ]]; then
            json_fail "not a git repository"
        fi
        echo "Error: not a git repository" >&2
        return 1
    fi
    JSON_MODE_VALUE="$JSON_MODE" python3 <<'PYEOF'
import json
import os
import subprocess
import sys

def run(args):
    return subprocess.run(args, text=True, capture_output=True, check=False)

reflog_raw = run(["git", "reflog", "-20", "--format=%H%x1f%gD%x1f%aI%x1f%gs"])
reflog = []
for line in reflog_raw.stdout.splitlines():
    parts = line.split("\x1f", 3)
    if len(parts) == 4:
        reflog.append({"commit": parts[0], "selector": parts[1], "date": parts[2], "message": parts[3]})

fsck = run(["git", "fsck", "--unreachable", "--no-reflogs", "--no-progress"])
unreachable = []
for line in (fsck.stdout + "\n" + fsck.stderr).splitlines():
    parts = line.split()
    if len(parts) == 3 and parts[:2] == ["unreachable", "commit"]:
        unreachable.append(parts[2])

ok = fsck.returncode in (0, 1)
payload = {"ok": ok, "reflog": reflog, "unreachable_commits": sorted(set(unreachable))}
if not ok:
    # git fsck exits >1 on repository corruption or invocation failure; carry
    # the reason so a nonzero exit is never a silent look-alike of success.
    detail = (fsck.stderr or fsck.stdout or "").strip().splitlines()
    payload["error"] = f"git fsck exited {fsck.returncode}" + (f": {detail[-1]}" if detail else "")
if os.environ["JSON_MODE_VALUE"] == "1":
    print(json.dumps(payload))
else:
    print("Recent reflog:")
    for item in reflog:
        print(f"  {item['selector']} {item['commit'][:12]} {item['message']}")
    print("Unreachable commits:")
    for commit in payload["unreachable_commits"]:
        print(f"  {commit}")
    if not payload["unreachable_commits"]:
        print("  (none)")
    if not ok:
        print(f"Error: {payload['error']}", file=sys.stderr)
raise SystemExit(0 if ok else 1)
PYEOF
}

cmd_sweep() {
    local apply=false
    [[ "${1:-}" == "--apply" ]] && apply=true
    APPLY="$apply" JSON_MODE_VALUE="$JSON_MODE" python3 <<'PYEOF'
import json
import os
import subprocess

def run(args, check=False):
    return subprocess.run(args, text=True, capture_output=True, check=check)

current = run(["git", "branch", "--show-current"], check=True).stdout.strip()
protected = {"main", "master", current}
default = run(["git", "symbolic-ref", "--quiet", "--short", "refs/remotes/origin/HEAD"])
if default.returncode == 0 and default.stdout.strip():
    protected.add(default.stdout.strip().split("/", 1)[-1])

worktree_branches = set()
for line in run(["git", "worktree", "list", "--porcelain"], check=True).stdout.splitlines():
    if line.startswith("branch refs/heads/"):
        worktree_branches.add(line[len("branch refs/heads/"):])

rows = run([
    "git", "for-each-ref", "refs/heads",
    "--format=%(refname:short)%09%(upstream:short)",
], check=True).stdout.splitlines()
candidates = []
excluded = []
for row in rows:
    branch, _, upstream = row.partition("\t")
    if branch in protected:
        excluded.append({"branch": branch, "reason": "protected"})
        continue
    if branch in worktree_branches:
        excluded.append({"branch": branch, "reason": "checked-out-worktree"})
        continue
    if not upstream or run(["git", "rev-parse", "--verify", upstream]).returncode != 0:
        excluded.append({"branch": branch, "reason": "no-upstream"})
        continue
    ahead = run(["git", "rev-list", "--count", f"{upstream}..{branch}"], check=True).stdout.strip()
    if int(ahead or "0") > 0:
        excluded.append({"branch": branch, "reason": "unpushed-commits"})
        continue
    if run(["git", "merge-base", "--is-ancestor", branch, current]).returncode != 0:
        excluded.append({"branch": branch, "reason": "not-merged"})
        continue
    candidates.append(branch)

deleted = []
errors = []
if os.environ["APPLY"] == "true":
    for branch in candidates:
        result = run(["git", "branch", "-d", "--", branch])
        if result.returncode == 0:
            deleted.append(branch)
        else:
            errors.append({"branch": branch, "error": result.stderr.strip() or result.stdout.strip()})

payload = {
    "ok": not errors,
    "dry_run": os.environ["APPLY"] != "true",
    "current": current,
    "candidates": sorted(candidates),
    "excluded": sorted(excluded, key=lambda item: item["branch"]),
    "deleted": deleted,
    "errors": errors,
}
if os.environ["JSON_MODE_VALUE"] == "1":
    print(json.dumps(payload))
else:
    label = "Would delete" if payload["dry_run"] else "Deleted"
    print(f"{label}: {', '.join(payload['candidates'] if payload['dry_run'] else deleted) or '(none)'}")
    if payload["dry_run"]:
        print("Dry run only. Re-run with --apply to delete candidates.")
raise SystemExit(0 if payload["ok"] else 1)
PYEOF
}

# Main
# Strip a --json flag from anywhere in the args. JSON_MODE/JSON_ARGS drive the
# structured output path; plain text behavior is unchanged when --json is absent.
parse_json_flag "$@"
set -- "${JSON_ARGS[@]+"${JSON_ARGS[@]}"}"

case "${1:-help}" in
    status|st)
        if [[ "$JSON_MODE" == "1" ]]; then
            cmd_snapshot
        else
            cmd_status
        fi
        ;;
    diff|d)
        if [[ "$JSON_MODE" == "1" ]]; then
            cmd_diff_json
        else
            cmd_diff
        fi
        ;;
    log|l)
        shift
        if [[ "$JSON_MODE" == "1" ]]; then
            cmd_log_json "$@"
        else
            cmd_log "$@"
        fi
        ;;
    commit|ci)
        shift
        cmd_commit "$@"
        ;;
    branch|br)
        shift
        if [[ "$JSON_MODE" == "1" ]]; then
            if [[ -n "${1:-}" ]]; then
                json_fail "creating a branch is a write verb; --json output is not supported" 1
            fi
            cmd_branch_json
        else
            cmd_branch "$@"
        fi
        ;;
    stash)
        shift
        if [[ "$JSON_MODE" == "1" ]]; then
            json_fail "stash is a write verb; --json output is not supported" 1
        fi
        cmd_stash "$@"
        ;;
    pull)
        if [[ "$JSON_MODE" == "1" ]]; then
            json_fail "pull is a write verb; --json output is not supported" 1
        fi
        cmd_pull
        ;;
    push)
        if [[ "$JSON_MODE" == "1" ]]; then
            json_fail "push is a write verb; --json output is not supported" 1
        fi
        cmd_push
        ;;
    sync)
        if [[ "$JSON_MODE" == "1" ]]; then
            json_fail "sync is a write verb; --json output is not supported" 1
        fi
        cmd_sync
        ;;
    snapshot)
        cmd_snapshot
        ;;
    worktree)
        shift
        cmd_worktree "$@"
        ;;
    snap)
        shift
        cmd_snap "$@"
        ;;
    conflicts)
        cmd_conflicts
        ;;
    recover)
        cmd_recover
        ;;
    sweep)
        shift
        cmd_sweep "$@"
        ;;
    help|--help|-h)
        show_help
        ;;
    *)
        if [[ "$JSON_MODE" == "1" ]]; then
            json_fail "unknown command: ${1:-}" 1
        fi
        echo "Unknown command: $1"
        echo "Try: agent-git help"
        exit 1
        ;;
esac
