def read_body(args: argparse.Namespace, *, required: bool = False) -> str | None:
    if args.body_file:
        if args.body_file == "-":
            return sys.stdin.read()
        try:
            with open(args.body_file, encoding="utf-8", newline="") as source:
                return source.read()
        except (OSError, UnicodeError) as exc:
            raise GhError(f"Cannot read --body-file: {exc}") from exc
    if args.body is not None:
        return args.body
    if required:
        raise GhError("--body or --body-file is required")
    return None


