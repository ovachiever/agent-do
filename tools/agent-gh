    run_gh(gh_args)
    print(f"{'Converted to draft' if draft else 'Marked ready'}: {ref.repo}#{ref.number}")


DECLARATION_START = "<!-- agent-do:declaration:v1 -->"
DECLARATION_END = "<!-- /agent-do:declaration -->"


def read_git(args: list[str]) -> str:
    result = subprocess.run(["git", *args], text=True, capture_output=True, check=False)
    if result.returncode != 0:
        raise GhError(f"git {' '.join(args)} failed: {result.stderr.strip()}")
    return result.stdout.strip()


def pr_declaration(repo: str, base: str, head: str) -> dict[str, Any]:
    """Preserve every contribution's committed stamps without self-reporting.

    The attest lane owns generating/validating these stamps. This consumer
    copies them and refuses missing or ambiguous fields, never infers a model
    from the PR author's current session or an unrelated commit on HEAD.
    """
    if ":" in head:
        raise GhError("--declare requires a local --head branch with committed provenance")
    head_oid = read_git(["rev-parse", "--verify", "--end-of-options", f"refs/heads/{head}^{{commit}}"])
    base_refs = [f"refs/heads/{base}"]
    if (repo_from_git() or "").lower() == repo.lower():
        base_refs.insert(0, f"refs/remotes/origin/{base}")
    base_oid = None
    for ref in base_refs:
        result = subprocess.run(
            ["git", "rev-parse", "--verify", "--end-of-options", f"{ref}^{{commit}}"],
            text=True, capture_output=True, check=False,
        )
        if result.returncode == 0:
            base_oid = result.stdout.strip()
            break
    if base_oid is None:
        raise GhError("--declare requires the base branch locally; fetch it before creating the PR")
    commits = read_git(["log", "--reverse", "--format=%H", f"{base_oid}..{head_oid}"]).splitlines()
    if not commits:
        raise GhError("--declare found no commits between base and head")
    contributions = []
    for commit in commits:
        trailers = read_git(["show", "-s", "--format=%(trailers:only,unfold=true)", commit])
        fields: dict[str, set[str]] = {}
        for line in trailers.splitlines():
            key, separator, value = line.partition(":")
            if separator:
                fields.setdefault(key.lower(), set()).add(value.strip())
        work_items = fields.get("work-item", set()) | fields.get("manna", set())
        fields["work-item"] = work_items
        entry = {"commit": commit}
        for key in ("work-item", "model", "effort", "session"):
            values = fields.get(key, set())
            if len(values) != 1 or not next(iter(values), ""):
                raise GhError(f"--declare requires one {key} trailer on commit {commit}; stamp the commit before publishing")
            entry[key.replace("-", "_")] = next(iter(values))
        contributions.append(entry)
    return {"version": 1, "source": "git-commit-trailers", "base_commit": base_oid,
            "head_commit": head_oid, "contributions": contributions}


def cmd_pr_create(args: argparse.Namespace) -> None:
    repo = resolve_repo(args.repo)
    body = read_body(args, required=True)
    head = args.head or read_git(["symbolic-ref", "--quiet", "--short", "HEAD"])
    declaration = None
    if args.declare:
        if DECLARATION_START in body or DECLARATION_END in body:
            raise GhError("Body already contains an agent-do declaration; remove it before --declare")
        declaration = pr_declaration(repo, args.base, head)
        # JSON escapes are valid JSON and keep trailer text from closing the
        # Markdown fence or declaration marker inside the PR body.
        encoded = json.dumps(declaration, indent=2, ensure_ascii=True)
        encoded = encoded.replace("`", "\\u0060").replace("<", "\\u003c").replace(">", "\\u003e")
        body += ("\n\n" + DECLARATION_START + "\n## Work declaration\n\n```json\n"
                 + encoded + "\n```\n" + DECLARATION_END + "\n")
    payload = {"repo": repo, "title": args.title, "body": body, "base": args.base,
               "head": head, "draft": args.draft, "assignees": args.assignee or [],
               "labels": args.label or [], "reviewers": args.reviewer or [],
               "declaration": declaration}
    if args.dry_run:
        # gh pr create --dry-run can push. Our preview never invokes gh.
        output({"dry_run": True, "pr": payload}, json_mode=args.json)
        return
    if declaration is not None:
        remote = gh_json(["api", f"repos/{repo}/git/ref/heads/{quote(head, safe='/')}"])
        if not isinstance(remote, dict) or (remote.get("object") or {}).get("sha") != declaration["head_commit"]:
            raise GhError("Published head differs from the declaration's local head; synchronize the branch explicitly before creating the PR")
    gh_args = ["pr", "create", "--repo", repo, "--title", args.title,
               "--body-file", "-", "--base", args.base, "--head", head]
    if args.draft:
        gh_args.append("--draft")
    append_repeated_flag(gh_args, "--assignee", args.assignee)
    append_repeated_flag(gh_args, "--label", args.label)
    append_repeated_flag(gh_args, "--reviewer", args.reviewer)
    url = run_gh(gh_args, input_text=body).strip()
    created = re.fullmatch(r"https://github\.com/([^/]+/[^/]+)/pull/[1-9][0-9]*", url)
    if created is None or created.group(1).lower() != repo.lower():
        raise GhError(f"PR creation returned an unexpected receipt: {url}. Inspect GitHub before retrying.")
    if declaration is not None:
        try:
            actual = gh_json(["pr", "view", url, "--repo", repo, "--json", "headRefOid,body"])
            if not isinstance(actual, dict) or actual.get("headRefOid") != declaration["head_commit"] or actual.get("body") != body:
                raise GhError("Created PR head or body differs from its declaration")
        except GhError as exc:
            raise GhError(f"PR creation succeeded ({url}), but declaration read-back failed: {exc}. Inspect that PR before retrying.") from exc
    output({"url": url, "declaration": declaration}, json_mode=args.json)


def add_body_arguments(parser: argparse.ArgumentParser) -> None:
    body = parser.add_mutually_exclusive_group(required=True)
    body.add_argument("--body", help="Body text (passed to gh over stdin)")
    body.add_argument("--body-file", help="Read UTF-8 body text; - reads stdin")


def positive_limit(value: str) -> int:
    try:
        result = int(value)
    except ValueError:
        raise argparse.ArgumentTypeError("limit must be a positive integer") from None
    if result <= 0:
        raise argparse.ArgumentTypeError("limit must be a positive integer")
    return result


def nonempty_title(value: str) -> str:
    if not value.strip():
        raise argparse.ArgumentTypeError("title must not be empty")
    return value


def build_pr_create_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="agent-do gh pr create", description="Create a PR without pushing or launching an editor")
    parser.add_argument("--repo", help="GitHub owner/repo; defaults to origin")
    parser.add_argument("--title", type=nonempty_title, required=True)
    parser.add_argument("--base", required=True, help="Target branch")
    parser.add_argument("--head", help="Source branch; defaults to the current branch")
    add_body_arguments(parser)
    parser.add_argument("--draft", action="store_true")
    parser.add_argument("--assignee", action="append")
    parser.add_argument("--label", action="append")
    parser.add_argument("--reviewer", action="append")
    parser.add_argument("--declare", action="store_true", help="Append every base..head commit's Work-Item (or Manna), Model, Effort, Session trailers")
    parser.add_argument("--dry-run", action="store_true", help="Preview locally; never call GitHub or push")
    parser.add_argument("--json", action="store_true")
    parser.set_defaults(func=cmd_pr_create)
    return parser


