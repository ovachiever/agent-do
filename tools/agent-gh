def cmd_merge(args: argparse.Namespace) -> None:
    ref = parse_pr_ref(args.pr)

    # Merge gate: deterministic preconditions before any merge call.
    gate = merge_gate(ref)
    unresolved_warnings = [
        w for w in gate["warnings"]
        if not (w["gate"] == "risk" and getattr(args, "confirm_risk", False))
    ]
    blocked = bool(gate["blocks"]) or bool(unresolved_warnings)

    if blocked and not args.force:
        if getattr(args, "json", False):
            print_json({**gate, "warnings": unresolved_warnings})
        else:
            print(f"Merge blocked for {ref.repo}#{ref.number}:", file=sys.stderr)
            for block in gate["blocks"]:
                print(f"  BLOCK  [{block['gate']}] {block['reason']}", file=sys.stderr)
            for warning in unresolved_warnings:
                print(f"  WARN   [{warning['gate']}] {warning['reason']}", file=sys.stderr)
            if gate["blocks"]:
                print(
                    "  Fix the cause, or pass --force for a genuine emergency.",
                    file=sys.stderr,
                )
        sys.exit(2)

    if args.force and gate["blocks"]:
        bypassed = ", ".join(block["gate"] for block in gate["blocks"])
        print(
            f"--force: bypassing merge gates [{bypassed}] for {ref.repo}#{ref.number}",
            file=sys.stderr,
        )

    strategy = "--squash"
    if args.merge:
        strategy = "--merge"
    if args.rebase:
        strategy = "--rebase"
    gh_args = ["pr", "merge", *pr_gh_args(ref), strategy]
    if args.auto:
        gh_args.append("--auto")
    if args.delete_branch:
        gh_args.append("--delete-branch")
    if args.match_head_commit:
        gh_args.extend(["--match-head-commit", args.match_head_commit])
    if args.subject:
        gh_args.extend(["--subject", args.subject])
    if args.body:
        gh_args.extend(["--body", args.body])
    run_gh(gh_args)
    print(f"Merged {ref.repo}#{ref.number}")


