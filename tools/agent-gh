def read_body(args: argparse.Namespace, *, required: bool = False) -> str | None:
    if args.body_file:
        if args.body_file == "-":
            return sys.stdin.read()
        return Path(args.body_file).read_text()
    if args.body:
        return args.body
    if required:
        raise GhError("--body or --body-file is required")
    return None


