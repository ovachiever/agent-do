        command = issue_sub.add_parser(name)
        command.add_argument("--repo", help="GitHub owner/repo; defaults to the reference or origin")
        command.add_argument("--json", action="store_true")
        if name == "create":
            command.add_argument("--title", type=nonempty_title, required=True)
