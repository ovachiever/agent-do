        elif not patterns:
            print("Portfolio is empty.")
        else:
            for pattern in patterns:
                print(pattern)
        return
    if not args.pattern:
        raise GhError(f"portfolio {action} requires a pattern (owner/repo or owner/*)")
    pattern = validate_portfolio_pattern(args.pattern)
    patterns = read_portfolio()
    if action == "add":
        if pattern in patterns:
            print(f"Already in portfolio: {pattern}")
            return
        write_portfolio([*patterns, pattern])
        print(f"Added to portfolio: {pattern}")
        return
    if pattern not in patterns:
        raise GhError(f"Not in portfolio: {pattern}")
    write_portfolio([entry for entry in patterns if entry != pattern])
    print(f"Removed from portfolio: {pattern}")


