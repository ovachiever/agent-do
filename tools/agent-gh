def now_iso() -> str:
    return datetime.now(timezone.utc).replace(microsecond=0).isoformat().replace("+00:00", "Z")


def parse_github_time(value: str | None) -> datetime | None:
    if not value:
        return None
    try:
        return datetime.fromisoformat(value.replace("Z", "+00:00"))
    except ValueError:
        return None


def ensure_state_dir() -> None:
    STATE_DIR.mkdir(parents=True, exist_ok=True)


def gh_bin() -> str:
    configured = os.environ.get("AGENT_GH_BIN")
    if configured:
        return configured
    found = shutil.which("gh")
    if not found:
        raise GhError("gh CLI not found. Install GitHub CLI and run `gh auth login`.")
    return found


def run_gh(args: list[str], *, input_text: str | None = None, timeout: float | None = None) -> str:
    cmd = [gh_bin(), *args]
    try:
        result = subprocess.run(
            cmd,
            input=input_text,
            text=True,
            capture_output=True,
            check=False,
            timeout=timeout,
        )
    except subprocess.TimeoutExpired:
        raise GhError(f"gh {' '.join(args)} timed out after {int(timeout or 0)}s") from None
    if result.returncode != 0:
        detail = result.stderr.strip() or result.stdout.strip() or "unknown gh error"
        raise GhError(f"gh {' '.join(args)} failed: {detail}")
    return result.stdout


def gh_json(args: list[str], *, input_text: str | None = None, timeout: float | None = None) -> Any:
    output = run_gh(args, input_text=input_text, timeout=timeout).strip()
    if not output:
        return None
    try:
        return json.loads(output)
    except json.JSONDecodeError as exc:
        raise GhError(f"gh returned invalid JSON for {' '.join(args)}: {exc}") from exc


def repo_from_git() -> str | None:
    result = subprocess.run(
        ["git", "remote", "get-url", "origin"],
        text=True,
        capture_output=True,
        check=False,
    )
    if result.returncode != 0:
        return None
    remote = result.stdout.strip()
    match = re.search(r"github\.com[:/]([^/\s]+/[^/\s]+?)(?:\.git)?$", remote)
    if not match:
        return None
    return match.group(1)


def parse_pr_ref(raw: str | None) -> PrRef:
    value = (raw or "").strip()
    if not value:
        repo = repo_from_git()
        if not repo:
            raise GhError("PR reference required outside a GitHub-backed repo")
        return PrRef(repo=repo, number="", original="")

    url = re.search(r"github\.com/([^/\s]+/[^/\s]+)/pull/(\d+)", value)
    if url:
        return PrRef(repo=url.group(1), number=url.group(2), original=value)

    owner_repo = re.fullmatch(r"([^/\s]+/[^#\s]+)#(\d+)", value)
    if owner_repo:
        return PrRef(repo=owner_repo.group(1), number=owner_repo.group(2), original=value)

    if re.fullmatch(r"\d+", value):
        repo = repo_from_git()
        if not repo:
            raise GhError("Bare PR number requires a GitHub-backed repo")
        return PrRef(repo=repo, number=value, original=value)

    raise GhError(f"Invalid PR reference: {value}")


def pr_gh_args(ref: PrRef) -> list[str]:
    args: list[str] = []
    if ref.number:
        args.append(ref.number)
    if ref.repo:
        args.extend(["--repo", ref.repo])
    return args


def parse_repository(value: str) -> tuple[str, str]:
    """Validate an explicit GitHub owner/repository without guessing a remote."""
    if not REPOSITORY_RE.fullmatch(value or ""):
        raise GhError("Repository must be owner/repo")
    return tuple(value.split("/", 1))  # type: ignore[return-value]


def normalize_commit(payload: dict[str, Any]) -> dict[str, Any]:
    """REST commit response -> small, stable trace receipt."""
    commit = payload.get("commit") or {}
    author = commit.get("author") or {}
    committer = commit.get("committer") or {}
    return {
        "sha": payload.get("sha"),
        "url": payload.get("html_url"),
        "message": commit.get("message"),
        "authored_at": author.get("date"),
        "committed_at": committer.get("date"),
        "author": ((payload.get("author") or {}).get("login")),
        "committer": ((payload.get("committer") or {}).get("login")),
    }


def normalize_associated_pr(payload: dict[str, Any]) -> dict[str, Any]:
    """REST associated-pull response -> deployment-correlation facts."""
    return {
        "number": payload.get("number"),
        "url": payload.get("html_url"),
        "title": payload.get("title"),
        "state": payload.get("state"),
        "merged_at": payload.get("merged_at"),
        "merge_commit_sha": payload.get("merge_commit_sha"),
        "head_sha": ((payload.get("head") or {}).get("sha")),
        "base_ref": ((payload.get("base") or {}).get("ref")),
    }


def closing_issues_for_pr(repo: str, number: int) -> dict[str, Any]:
    """Read GitHub's explicit closing-issue links for one associated PR.

    A PR can have no closing links. That is an available empty result, unlike
    an API error, which callers must surface as degraded evidence.
    """
    owner, name = parse_repository(repo)
    query = """
query {
  repository(owner: %s, name: %s) {
    pullRequest(number: %d) {
      closingIssuesReferences(first: 100) {
        totalCount
        nodes { number title url state closedAt repository { nameWithOwner } }
      }
    }
  }
}
""" % (json.dumps(owner), json.dumps(name), number)
    try:
        payload = run_graphql(query)
        connection = (((payload.get("repository") or {}).get("pullRequest") or {})
                      .get("closingIssuesReferences") or {})
        nodes = connection.get("nodes") or []
        return {
            "status": "available",
            "issues": [{
                "number": issue.get("number"),
                "title": issue.get("title"),
                "url": issue.get("url"),
                "state": issue.get("state"),
                "closed_at": issue.get("closedAt"),
                "repository": ((issue.get("repository") or {}).get("nameWithOwner")),
                "pull_request": number,
            } for issue in nodes if isinstance(issue, dict)],
            "truncated": (connection.get("totalCount") or 0) > len(nodes),
        }
    except GhError:
        return {
            "status": "degraded",
            "issues": [],
            "truncated": False,
            "reason": "GitHub closing-issue references were unavailable for this pull request",
        }


def commit_correlation(repo: str, sha: str) -> dict[str, Any]:
    """Return only GitHub-declared relationships for a commit; never infer."""
    if not COMMIT_SHA_RE.fullmatch(sha or ""):
        raise GhError("Commit SHA must contain 7 to 64 hexadecimal characters")
    parse_repository(repo)
    accept = "Accept: application/vnd.github+json"
    commit = gh_json(["api", "-H", accept, f"repos/{repo}/commits/{sha}"])
    if not isinstance(commit, dict):
        raise GhError("GitHub commit response was not an object")
    associations = gh_json([
        "api", "--paginate", "--slurp", "-H", accept,
        f"repos/{repo}/commits/{sha}/pulls?per_page=100",
    ])
    if not isinstance(associations, list):
        raise GhError("GitHub associated-pull-request response was not a list")
    prs = [normalize_associated_pr(pr) for pr in flatten_pages(associations)]
    issue_results = [closing_issues_for_pr(repo, pr["number"]) for pr in prs if isinstance(pr.get("number"), int)]
    issues = [issue for result in issue_results for issue in result["issues"]]
    degraded = [result for result in issue_results if result["status"] == "degraded"]
    return {
        "success": True,
        "provider": "github",
        "repository": repo,
        "commit": normalize_commit(commit),
        "pull_requests": {"status": "available", "items": prs, "count": len(prs)},
        "issues": {
            "status": "degraded" if degraded else "available",
            "items": issues,
            "count": len(issues),
            "truncated": any(result["truncated"] for result in issue_results),
            **({"reason": "One or more associated pull requests did not expose closing-issue references"} if degraded else {}),
        },
    }
def resolve_repo(repo: str | None) -> str:
    value = repo if repo is not None else repo_from_git()
    if not value or not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9-]*/[A-Za-z0-9._-]+", value):
        raise GhError("A GitHub owner/repo is required; pass --repo outside a GitHub-backed repo")
    if value.split("/")[1] in {".", ".."}:
        raise GhError("Invalid GitHub repository")
    return value


def parse_issue_ref(raw: str, repo: str | None = None) -> IssueRef:
    value = raw.strip()
    match = re.fullmatch(r"https://github\.com/([^/]+/[^/]+)/issues/([1-9][0-9]*)(?:[?#].*)?", value)
    if match is None:
        match = re.fullmatch(r"([^/#\s]+/[^/#\s]+)#([1-9][0-9]*)", value)
    if match:
        target_repo = resolve_repo(match.group(1))
        if repo is not None and resolve_repo(repo).lower() != target_repo.lower():
            raise GhError("Issue reference conflicts with --repo")
        return IssueRef(target_repo, match.group(2))
    if re.fullmatch(r"[1-9][0-9]*", value):
        return IssueRef(resolve_repo(repo), value)
    raise GhError(f"Invalid issue reference: {value}")


def normalize_issue(repo: str, item: dict[str, Any]) -> dict[str, Any]:
    if not isinstance(item, dict) or not isinstance(item.get("number"), int):
        raise GhError("GitHub returned an invalid issue object")
    if "pull_request" in item:
        raise GhError(f"{repo}#{item['number']} is a pull request, not an issue")
    return {
        "ref": f"{repo}#{item['number']}", "repo": repo, "number": item["number"],
        "title": item.get("title"), "body": item.get("body"), "state": item.get("state"),
        "url": item.get("html_url"), "author": (item.get("user") or {}).get("login"),
        "assignees": [user["login"] for user in item.get("assignees") or []],
        "labels": [label["name"] for label in item.get("labels") or []],
        "created_at": item.get("created_at"), "updated_at": item.get("updated_at"),
        "closed_at": item.get("closed_at"),
    }


def issue_detail(ref: IssueRef) -> dict[str, Any]:
    issue = normalize_issue(ref.repo, gh_json(["api", f"repos/{ref.repo}/issues/{ref.number}"]))
    if str(issue["number"]) != ref.number:
        raise GhError("GitHub returned a different issue number")
    return issue


def cmd_issue_list(args: argparse.Namespace) -> None:
    repo = resolve_repo(args.repo)
    query = {"state": args.state}
    for key, value in (("assignee", args.assignee), ("creator", args.author)):
        if value is not None:
            query[key] = current_user(refresh=True)["login"] if value == "@me" else value
    if args.label:
        query["labels"] = ",".join(args.label)
    # REST's issues collection includes PRs. Fetch all pages before filtering
    # and applying the caller's display cap so total always means real issues.
    pages = gh_json(["api", "--paginate", "--slurp", f"repos/{repo}/issues?{urlencode(query)}"])
    if not isinstance(pages, list) or any(
        not isinstance(page, list) or any(not isinstance(item, dict) for item in page)
        for page in pages
    ):
        raise GhError("GitHub returned invalid issue pages")
    issues = [normalize_issue(repo, item) for page in pages for item in page if "pull_request" not in item]
    shown = issues if args.limit is None else issues[:args.limit]
    payload = {"repo": repo, "count": len(shown), "total": len(issues), "issues": shown}
    if args.json:
        print_json(payload)
    else:
        print_table(shown, ["ref", "state", "title"])
        if len(shown) != len(issues):
            print(f"[truncated: {len(shown)} of {len(issues)} shown]")


def cmd_issue_create(args: argparse.Namespace) -> None:
    repo = resolve_repo(args.repo)
    body = read_body(args, required=True)
    gh_args = ["issue", "create", "--repo", repo, "--title", args.title, "--body-file", "-"]
    append_repeated_flag(gh_args, "--assignee", args.assignee)
    append_repeated_flag(gh_args, "--label", args.label)
    url = run_gh(gh_args, input_text=body).strip()
    # Creation already happened if read-back fails. Never retry a write here.
    try:
        ref = parse_issue_ref(url, repo)
        issue = issue_detail(ref)
    except GhError as exc:
        raise GhError(f"Issue creation succeeded ({url}), but read-back failed: {exc}. Do not recreate it.") from exc
    output({"issue": issue}, json_mode=args.json)


def cmd_issue_mutate(args: argparse.Namespace) -> None:
    ref = parse_issue_ref(args.issue, args.repo)
    action = args.issue_command
    body = read_body(args, required=True) if action == "comment" else None
    if action == "comment" and not body.strip():
        raise GhError("An issue comment requires a nonempty body")
    if action == "label" and not (args.add or args.remove):
        raise GhError("issue label requires --add or --remove")
    # Check object kind before using GitHub's shared issue/PR mutation surface.
    issue_detail(ref)
    gh_args = ["issue", "edit" if action in {"assign", "unassign", "label"} else action,
               ref.number, "--repo", ref.repo]
    if action in {"assign", "unassign"}:
        flag = "--add-assignee" if action == "assign" else "--remove-assignee"
        append_repeated_flag(gh_args, flag, args.assignee or ["@me"])
    elif action == "label":
        append_repeated_flag(gh_args, "--add-label", args.add)
        append_repeated_flag(gh_args, "--remove-label", args.remove)
    elif action == "close":
        gh_args.extend(["--reason", args.reason])
    elif action == "comment":
        gh_args.extend(["--body-file", "-"])
    result = run_gh(gh_args, input_text=body).strip()
    try:
        issue = issue_detail(ref)
        if action == "close" and issue["state"] != "closed":
            raise GhError("Issue remains open after close")
    except GhError as exc:
        raise GhError(f"Issue {action} succeeded for {ref.repo}#{ref.number}, but read-back failed: {exc}. Do not repeat the write blindly.") from exc
    output({"action": action, "issue": issue, "result": result}, json_mode=args.json)


def current_user(*, refresh: bool = False) -> dict[str, Any]:
    ensure_state_dir()
    if not refresh and USER_CACHE.exists():
        try:
            return json.loads(USER_CACHE.read_text())
        except json.JSONDecodeError:
            pass
    payload = gh_json(["api", "user"])
    user = {
        "login": payload.get("login", ""),
        "id": payload.get("id"),
        "name": payload.get("name"),
        "url": payload.get("html_url"),
        "synced_at": now_iso(),
    }
    USER_CACHE.write_text(json.dumps(user, indent=2) + "\n")
    return user


def normalize_repo(item: dict[str, Any]) -> dict[str, Any]:
    owner = item.get("owner") or {}
    owner_login = owner.get("login") if isinstance(owner, dict) else None
    full_name = item.get("full_name") or item.get("nameWithOwner")
    if not full_name and owner_login and item.get("name"):
        full_name = f"{owner_login}/{item['name']}"
    return {
        "name": item.get("name"),
        "full_name": full_name,
        "owner": owner_login,
        "visibility": item.get("visibility") or ("private" if item.get("private") else "public"),
        "private": bool(item.get("private") or item.get("isPrivate")),
        "archived": bool(item.get("archived") or item.get("isArchived")),
        "default_branch": item.get("default_branch") or (item.get("defaultBranchRef") or {}).get("name"),
        "url": item.get("html_url") or item.get("url"),
        "pushed_at": item.get("pushed_at") or item.get("pushedAt"),
        "updated_at": item.get("updated_at") or item.get("updatedAt"),
        "permissions": {key: bool(value) for key, value in (item.get("permissions") or {}).items()},
        "open_issues_count": item.get("open_issues_count"),
    }


def flatten_pages(raw: Any) -> list[dict[str, Any]]:
    items: list[dict[str, Any]] = []
    if isinstance(raw, list) and raw and isinstance(raw[0], list):
        for page in raw:
            items.extend(page)
    elif isinstance(raw, list):
        items = raw
    return [item for item in items if isinstance(item, dict)]


def fetch_repos(limit: int | None = None) -> list[dict[str, Any]]:
    args = [
        "api",
        "--paginate",
        "--slurp",
        "/user/repos?affiliation=owner,collaborator,organization_member&sort=updated&per_page=100",
    ]
    repos = [normalize_repo(item) for item in flatten_pages(gh_json(args))]
    repos = [repo for repo in repos if repo.get("full_name")]
    if limit is not None:
        repos = repos[:limit]
    return repos


def write_repos_cache(repos: list[dict[str, Any]]) -> None:
    ensure_state_dir()
    REPOS_CACHE.write_text(
        json.dumps({"synced_at": now_iso(), "count": len(repos), "repos": repos}, indent=2) + "\n"
    )


def read_repos_cache() -> dict[str, Any] | None:
    if not REPOS_CACHE.exists():
        return None
    try:
        return json.loads(REPOS_CACHE.read_text())
    except json.JSONDecodeError:
        return None


def normalize_pr(item: dict[str, Any]) -> dict[str, Any]:
    repo = item.get("repository") or {}
    author = item.get("author") or {}
    labels = item.get("labels") or []
    return {
        "ref": f"{repo.get('nameWithOwner') or repo.get('fullName') or repo.get('full_name')}#{item.get('number')}",
        "repo": repo.get("nameWithOwner") or repo.get("fullName") or repo.get("full_name"),
        "number": item.get("number"),
        "title": item.get("title"),
        "state": item.get("state"),
        "draft": bool(item.get("isDraft")),
        "author": author.get("login") if isinstance(author, dict) else author,
        "updated_at": item.get("updatedAt"),
        "url": item.get("url"),
        "comments": item.get("commentsCount"),
        "labels": [label.get("name") for label in labels if isinstance(label, dict)],
        # Stage fields exist on every row; REST search cannot see them, and
        # an honest absence is null, never a guess (stage contract law).
        "review_decision": None,
        "merge_state": None,
        "checks": None,
        "review_requests": None,
        "next_action": None,
    }


def review_request_label(request: dict[str, Any]) -> str | None:
    reviewer = request.get("requestedReviewer")
    if not isinstance(reviewer, dict):
        reviewer = request
    return reviewer.get("login") or reviewer.get("slug") or reviewer.get("name")


def search_prs(args: argparse.Namespace) -> list[dict[str, Any]]:
    gh_args = ["search", "prs", "--json", PR_SEARCH_FIELDS, "--limit", str(args.limit)]
    has_explicit_scope = bool(
        args.repo
        or args.owner
        or args.author
        or args.review_requested
        or args.review
        or args.checks
        or args.query
    )
    if args.state != "all":
        gh_args.extend(["--state", args.state])
    for repo in args.repo or []:
        gh_args.extend(["--repo", repo])
    for owner in args.owner or []:
        gh_args.extend(["--owner", owner])
    if args.author:
        gh_args.extend(["--author", args.author])
    if args.review_requested:
        gh_args.extend(["--review-requested", "@me" if args.review_requested == "me" else args.review_requested])
    if args.review:
        gh_args.extend(["--review", args.review])
    if args.checks:
        gh_args.extend(["--checks", args.checks])
    if not has_explicit_scope:
        gh_args.extend(["--author", "@me"])
    if args.query:
        gh_args.append(args.query)
    payload = gh_json(gh_args) or []
    return [normalize_pr(item) for item in payload]


def pr_detail(ref: PrRef) -> dict[str, Any]:
    payload = gh_json(["pr", "view", *pr_gh_args(ref), "--json", PR_VIEW_FIELDS])
    return normalize_pr_detail(ref, payload or {})


def normalize_pr_detail(ref: PrRef, payload: dict[str, Any]) -> dict[str, Any]:
    review_requests = payload.get("reviewRequests") or []
    latest_reviews = payload.get("latestReviews") or []
    files = payload.get("files") or []
    status_rollup = payload.get("statusCheckRollup") or []
    return {
        "ref": f"{ref.repo}#{payload.get('number') or ref.number}",
        "repo": ref.repo,
        "number": payload.get("number") or int(ref.number or 0),
        "title": payload.get("title"),
        "state": payload.get("state"),
        "draft": bool(payload.get("isDraft")),
        "author": (payload.get("author") or {}).get("login"),
        "base": payload.get("baseRefName"),
        "head": payload.get("headRefName"),
        "head_sha": payload.get("headRefOid"),
        "mergeable": payload.get("mergeable"),
        "merge_state": payload.get("mergeStateStatus"),
        "review_decision": payload.get("reviewDecision"),
        "changed_files": payload.get("changedFiles"),
        "additions": payload.get("additions"),
        "deletions": payload.get("deletions"),
        "review_requests": [
            label
            for request in review_requests
            if isinstance(request, dict)
            for label in [review_request_label(request)]
            if label
        ],
        "latest_reviews": [
            {
                "author": (review.get("author") or {}).get("login"),
                "state": review.get("state"),
                "submitted_at": review.get("submittedAt"),
            }
            for review in latest_reviews
            if isinstance(review, dict)
        ],
        "files": [
            {
                "path": file.get("path"),
                "additions": file.get("additions"),
                "deletions": file.get("deletions"),
            }
            for file in files
            if isinstance(file, dict)
        ],
        "checks": summarize_checks(status_rollup),
        "updated_at": payload.get("updatedAt"),
        "created_at": payload.get("createdAt"),
        "url": payload.get("url"),
    }


def summarize_checks(checks: list[Any]) -> dict[str, Any]:
    summary = {"total": 0, "passed": 0, "failed": 0, "pending": 0, "items": []}
    for check in checks:
        if not isinstance(check, dict):
            continue
        state = check.get("state") or check.get("status")
        conclusion = check.get("conclusion")
        name = check.get("name") or check.get("workflowName")
        bucket = "pending"
        if conclusion in {"SUCCESS", "success"} or state in {"SUCCESS", "success"}:
            bucket = "passed"
        elif conclusion in {"FAILURE", "failure", "ERROR", "error", "CANCELLED", "cancelled"}:
            bucket = "failed"
        summary["total"] += 1
        summary[bucket] += 1
        summary["items"].append({"name": name, "state": state, "conclusion": conclusion, "bucket": bucket})
    return summary


def pr_checks(ref: PrRef) -> list[dict[str, Any]]:
    # `gh pr checks` exits non-zero when a branch has zero checks — that is a
    # normal state (no CI configured), not an error. Treat it as an empty list.
    try:
        payload = gh_json(["pr", "checks", *pr_gh_args(ref), "--json", "name,state,bucket,link,description,workflow,startedAt,completedAt"])
    except GhError as exc:
        if "no checks reported" in str(exc).lower():
            return []
        raise
    return payload or []


def pr_diff_text(ref: PrRef) -> str:
    return run_gh(["pr", "diff", *pr_gh_args(ref)])


def pr_threads(ref: PrRef, *, all_threads: bool = False) -> list[dict[str, Any]]:
    if not ref.repo or not ref.number:
        raise GhError("threads requires an explicit PR reference")
    owner, repo = ref.repo.split("/", 1)
    query = """
query($owner:String!, $repo:String!, $number:Int!) {
  repository(owner:$owner, name:$repo) {
    pullRequest(number:$number) {
      reviewThreads(first:100) {
        nodes {
          id
          isResolved
          path
          line
          comments(first:20) {
            nodes {
              id
              body
              createdAt
              url
              author { login }
            }
          }
        }
      }
    }
  }
}
"""
    payload = gh_json(
        [
            "api",
            "graphql",
            "-f",
            f"owner={owner}",
            "-f",
            f"repo={repo}",
            "-F",
            f"number={ref.number}",
            "-f",
            f"query={query}",
        ]
    )
    nodes = (
        ((payload or {}).get("data") or {})
        .get("repository", {})
        .get("pullRequest", {})
        .get("reviewThreads", {})
        .get("nodes", [])
    )
    threads = []
    for node in nodes:
        if not isinstance(node, dict):
            continue
        if node.get("isResolved") and not all_threads:
            continue
        comments = [
            {
                "author": (comment.get("author") or {}).get("login"),
                "body": comment.get("body"),
                "created_at": comment.get("createdAt"),
                "url": comment.get("url"),
            }
            for comment in ((node.get("comments") or {}).get("nodes") or [])
            if isinstance(comment, dict)
        ]
        threads.append(
            {
                "id": node.get("id"),
                "resolved": bool(node.get("isResolved")),
                "path": node.get("path"),
                "line": node.get("line"),
                "comments": comments,
            }
        )
    return threads


def build_inbox(limit: int, *, ceremony_only: bool = False) -> dict[str, Any]:
    items: dict[str, dict[str, Any]] = {}

    def add(reason: str, prs: list[dict[str, Any]]) -> None:
        for pr in prs:
            key = pr.get("ref") or pr.get("url")
            if not key:
                continue
            entry = items.setdefault(key, {**pr, "reasons": []})
            if reason not in entry["reasons"]:
                entry["reasons"].append(reason)

    # One GraphQL round trip replaces the 4 ceremony subprocesses and the
    # per-repo/per-PR sweep calls (measured 30s -> ~1s). REST remains the
    # loud fallback; AGENT_GH_INBOX=rest forces it.
    graphql_error: str | None = None
    if os.environ.get("AGENT_GH_INBOX") != "rest":
        try:
            sweep, viewer = build_inbox_graphql(limit, ceremony_only, add)
            # Post-pass after dedupe: derive the two ceremony reasons the
            # GraphQL path no longer searches for (the stage fields carry
            # the same signals authoritatively), then map next_action from
            # the merged row.
            for entry in items.values():
                derive_authored_reasons(entry)
                entry["next_action"] = next_action_for(entry, viewer)
            entries = list(items.values())
            return {"items": entries[:limit], "total": len(entries), "sweep": sweep}
        except GhError as exc:
            graphql_error = str(exc)
            items.clear()

    base = argparse.Namespace(
        limit=limit,
        state="open",
        repo=[],
        owner=[],
        author=None,
        review_requested="me",
        review=None,
        checks=None,
        query=None,
    )
    add("review_requested", search_prs(base))

    mine = argparse.Namespace(**{**vars(base), "review_requested": None, "author": "@me"})
    add("authored_open", search_prs(mine))

    failed = argparse.Namespace(**{**vars(base), "review_requested": None, "author": "@me", "checks": "failure"})
    add("authored_failed_checks", search_prs(failed))

    changes = argparse.Namespace(**{**vars(base), "review_requested": None, "author": "@me", "review": "changes_requested"})
    add("authored_changes_requested", search_prs(changes))

    sweep: dict[str, Any] | None = None
    if not ceremony_only:
        viewer = current_user().get("login") or ""
        sweep = maintainer_sweep(viewer, add)
        sweep["path"] = "rest-fallback" if graphql_error else "rest"
        # The envelope stamp holds on the REST path too: the keys exist on
        # every row, their values are honestly null here.
        sweep["stage_contract"] = 1
        if graphql_error:
            sweep["graphql_error"] = graphql_error

    entries = list(items.values())
    return {"items": entries[:limit], "total": len(entries), "sweep": sweep}


def is_bot_login(login: str | None) -> bool:
    if not login:
        return False
    lower = login.lower()
    return lower.endswith("[bot]") or lower in {"dependabot", "dependabot-preview"}


SWEEP_GH_TIMEOUT = 60


def gh_json_pages(path: str) -> list[dict[str, Any]]:
    return flatten_pages(gh_json(["api", "--paginate", "--slurp", path], timeout=SWEEP_GH_TIMEOUT))


# ── GraphQL inbox ──────────────────────────────────────────────────────────
# The REST inbox is N+4 serial round trips (4 ceremony searches, then pulls
# and reviews per swept repo — measured 30s over 20 active repos). One
# GraphQL document answers all of it in a single trip: the four ceremony
# searches AND the maintainer sweep, the latter as an owner-scoped search
# (viewer.repositories enumeration measured ~4.5s per page server-side, so
# it is avoided entirely; eligibility comes from the repos cache the REST
# sweep already trusts). The REST path below remains the loud fallback, and
# the sweep stats say which path ran.

# GitHub's published per-page ceiling for search connections.
SWEEP_SEARCH_PAGE = 100
# Reviews ride nested on each sweep PR. Truncation is never silent: when
# totalCount exceeds the window and the viewer is not in it, that one PR's
# reviews are fetched over REST rather than misclassified.
SWEEP_REVIEW_WINDOW = 30

GRAPHQL_PR_CORE = """
fragment PrCore on PullRequest {
  number title state isDraft updatedAt url
  author { login }
  repository { nameWithOwner }
  labels(first: 20) { nodes { name } }
  comments { totalCount }
  reviewDecision
  mergeStateStatus
  reviewRequests(first: 1) { totalCount }
  commits(last: 1) { nodes { commit { statusCheckRollup {
    state
    contexts(first: 30) { totalCount nodes {
      __typename
      ... on CheckRun { status conclusion }
      ... on StatusContext { state }
    } }
  } } } }
}
"""

# mergeStateStatus rides the merge-info preview accept header; harmless
# where the field has since gone GA.
GRAPHQL_ACCEPT_HEADER = "Accept: application/vnd.github.merge-info-preview+json"

# Check-rollup context outcomes, bucketed the way `gh pr checks` buckets
# them: neutral and skipped count as passed, stale counts as failed.
CHECK_PASSED = {"SUCCESS", "NEUTRAL", "SKIPPED"}
CHECK_FAILED = {"FAILURE", "ERROR", "TIMED_OUT", "CANCELLED", "ACTION_REQUIRED", "STARTUP_FAILURE", "STALE"}

CEREMONY_SEARCHES = (
    ("review_requested", "is:pr state:open review-requested:@me"),
    ("authored_open", "is:pr state:open author:@me"),
    ("authored_failed_checks", "is:pr state:open author:@me status:failure"),
    ("authored_changes_requested", "is:pr state:open author:@me review:changes-requested"),
)

# The GraphQL path executes only the first two: with stage enrichment on
# every row, authored_failed_checks and authored_changes_requested are
# DERIVED from checks.failed and review_decision — the same signals the
# search qualifiers filter on, read from the authoritative rollup instead.
# Two fewer heavy searches per run; the REST fallback still runs all four.
GRAPHQL_CEREMONY_SEARCHES = CEREMONY_SEARCHES[:2]


def run_graphql(query: str) -> dict[str, Any]:
    payload = gh_json(
        ["api", "graphql", "-H", GRAPHQL_ACCEPT_HEADER, "-f", f"query={query}"],
        timeout=SWEEP_GH_TIMEOUT,
    )
    if not isinstance(payload, dict):
        raise GhError("graphql returned no payload")
    if payload.get("errors"):
        raise GhError(f"graphql error: {payload['errors'][0].get('message', payload['errors'][0])}")
    data = payload.get("data")
    if not isinstance(data, dict):
        raise GhError("graphql returned no data")
    return data


def _graphql_search_alias(name: str, query: str, limit: int) -> str:
    return f"{name}: search(type: ISSUE, first: {limit}, query: {json.dumps(query)}) {{ nodes {{ ...PrCore }} }}"


def _graphql_sweep_alias(query: str, cursor: str | None) -> str:
    after = f", after: {json.dumps(cursor)}" if cursor else ""
    return (
        f"sweep: search(type: ISSUE, first: {SWEEP_SEARCH_PAGE}{after}, query: {json.dumps(query)}) {{ "
        "pageInfo { hasNextPage endCursor } "
        "nodes { ...PrCore ... on PullRequest { headRefOid "
        f"reviews(last: {SWEEP_REVIEW_WINDOW}) {{ totalCount nodes {{ "
        "state submittedAt author { login } commit { oid } } } } } }"
    )


def checks_from_rollup(node: dict[str, Any]) -> dict[str, int] | None:
    """Bucket the check rollup into counted outcomes.

    A PR with no rollup gets None, never zeros — the counts come from the
    rollup or they do not exist (bounds discipline). If the context window
    truncates (totalCount above what arrived), total keeps the true count,
    so a bucket sum below total reads as truncation, not invention.
    """
    commits = ((node.get("commits") or {}).get("nodes")) or []
    rollup = ((commits[0].get("commit") or {}).get("statusCheckRollup")) if commits else None
    if not isinstance(rollup, dict):
        return None
    contexts = rollup.get("contexts") or {}
    counts = {"passed": 0, "failed": 0, "pending": 0, "total": contexts.get("totalCount") or 0}
    for ctx in contexts.get("nodes") or []:
        if not isinstance(ctx, dict):
            continue
        if ctx.get("__typename") == "CheckRun":
            outcome = str(ctx.get("conclusion") or "").upper()
            if not outcome and str(ctx.get("status") or "").upper() != "COMPLETED":
                counts["pending"] += 1
                continue
        else:
            outcome = str(ctx.get("state") or "").upper()
        if outcome in CHECK_PASSED:
            counts["passed"] += 1
        elif outcome in CHECK_FAILED:
            counts["failed"] += 1
        else:
            counts["pending"] += 1
    return counts


def normalize_graphql_pr(node: dict[str, Any]) -> dict[str, Any]:
    """GraphQL PR node -> the exact dict shape the REST paths emit."""
    repo = (node.get("repository") or {}).get("nameWithOwner")
    author = node.get("author") or {}
    labels = ((node.get("labels") or {}).get("nodes")) or []
    return {
        "ref": f"{repo}#{node.get('number')}",
        "repo": repo,
        "number": node.get("number"),
        "title": node.get("title"),
        "state": str(node.get("state") or "").lower(),
        "draft": bool(node.get("isDraft")),
        "author": author.get("login") if isinstance(author, dict) else author,
        "updated_at": node.get("updatedAt"),
        "url": node.get("url"),
        "comments": (node.get("comments") or {}).get("totalCount"),
        "labels": [label.get("name") for label in labels if isinstance(label, dict)],
        "review_decision": node.get("reviewDecision"),
        "merge_state": node.get("mergeStateStatus"),
        "checks": checks_from_rollup(node),
        "review_requests": (node.get("reviewRequests") or {}).get("totalCount"),
        "next_action": None,
    }


def derive_authored_reasons(entry: dict[str, Any]) -> None:
    """Reasons the GraphQL path no longer searches for, derived from stage
    fields carrying the same signals authoritatively (rollup and
    reviewDecision instead of the status:/review: search qualifiers)."""
    reasons = entry.setdefault("reasons", [])
    if "authored_open" not in reasons:
        return
    if ((entry.get("checks") or {}).get("failed") or 0) > 0 and "authored_failed_checks" not in reasons:
        reasons.append("authored_failed_checks")
    if entry.get("review_decision") == "CHANGES_REQUESTED" and "authored_changes_requested" not in reasons:
        reasons.append("authored_changes_requested")


def next_action_for(item: dict[str, Any], viewer: str) -> dict[str, Any] | None:
    """The deterministic next-action verb — engine-owned, first match wins
    (11-GH-STAGE-AWARENESS.md mapping table; consumers never re-derive it).
    `yours` means exactly: the ball is in the viewing user's court.
    `command` is data typed behind a human Enter, never executed here."""
    authored = bool(viewer) and item.get("author") == viewer
    checks = item.get("checks") or {}
    number = item.get("number")
    if item.get("draft"):
        return {"verb": "Draft", "detail": "still being written", "yours": False, "command": None}
    if item.get("merge_state") == "DIRTY":
        return {"verb": "Resolve conflicts", "detail": "branch cannot merge", "yours": authored, "command": None}
    if authored and item.get("review_decision") == "CHANGES_REQUESTED":
        return {"verb": "Address review", "detail": "changes requested", "yours": True,
                "command": f"agent-do gh pr {number}"}
    if authored and (checks.get("failed") or 0) > 0:
        return {"verb": "Fix checks", "detail": f"{checks['failed']} of {checks['total']} failing",
                "yours": True, "command": f"agent-do gh checks {number}"}
    if authored and item.get("review_decision") == "APPROVED" and item.get("merge_state") == "CLEAN":
        return {"verb": "Merge", "detail": "approved, checks green", "yours": True,
                "command": f"agent-do gh merge {number}"}
    if not authored and "review_requested" in (item.get("reasons") or []):
        return {"verb": "Review", "detail": "your review requested", "yours": True,
                "command": f"agent-do gh pr {number}"}
    if authored:
        pending = item.get("review_requests")
        detail = f"{pending} reviewer(s) pending" if pending else "no review yet"
        return {"verb": "Awaiting review", "detail": detail, "yours": False, "command": None}
    return None


def _rest_shaped_reviews(pr_node: dict[str, Any]) -> list[dict[str, Any]]:
    """GraphQL review nodes -> REST review dicts, so classify_review_state
    runs unchanged on both paths (zero classifier drift)."""
    shaped = []
    for review in ((pr_node.get("reviews") or {}).get("nodes")) or []:
        if not isinstance(review, dict):
            continue
        shaped.append({
            "user": {"login": ((review.get("author") or {}).get("login"))},
            "state": review.get("state"),
            "submitted_at": review.get("submittedAt"),
            "commit_id": ((review.get("commit") or {}).get("oid")),
        })
    return shaped


def _classify_sweep_node(
    node: dict[str, Any],
    viewer: str,
    eligible: set[str],
    add: Callable[[str, list[dict[str, Any]]], None],
    stats: dict[str, Any],
) -> None:
    full = ((node.get("repository") or {}).get("nameWithOwner")) or ""
    if full not in eligible:
        # Owner-scoped search sees repos we can only read; the REST sweep
        # never swept those, so neither does this path.
        stats["skipped_no_role"] += 1
        return
    author = ((node.get("author") or {}).get("login"))
    if node.get("number") is None or not author or author == viewer:
        return
    reviews = _rest_shaped_reviews(node)
    review_conn = node.get("reviews") or {}
    if (review_conn.get("totalCount") or 0) > len(reviews) and not any(
        review["user"]["login"] == viewer for review in reviews
    ):
        # The viewer's review may sit outside the window; fetch the full
        # list for this one PR rather than misclassify it as unreviewed.
        try:
            reviews = gh_json_pages(f"repos/{full}/pulls/{node['number']}/reviews?per_page=100")
        except GhError as exc:
            stats["unswept"].append({"repo": full, "reason": f"reviews for #{node['number']}: {exc}"})
            return
    stats["prs_classified"] += 1
    token = classify_review_state(reviews, viewer, node.get("headRefOid"))
    if token is None:
        stats["waiting_on_author"] += 1
        return
    entry = normalize_graphql_pr(node)
    add(f"maintainer_{token}", [entry])
    if is_bot_login(author):
        add("bot_author", [entry])


def build_inbox_graphql(
    limit: int,
    ceremony_only: bool,
    add: Callable[[str, list[dict[str, Any]]], None],
) -> dict[str, Any] | None:
    """Concurrent-document inbox. Returns (sweep stats | None when ceremony_only, viewer login)."""
    eligible: set[str] = set()
    sweep_field = ""
    sweep_query = ""
    if not ceremony_only:
        eligible = {repo["full_name"] for repo in repos_for_sweep()}
        owners = sorted({full.split("/")[0] for full in eligible})
        if owners:
            sweep_query = "is:pr is:open archived:false " + " ".join(f"user:{owner}" for owner in owners)
            sweep_field = _graphql_sweep_alias(sweep_query, None)
    # Aliased search fields execute serially inside one document, so the
    # ceremony and sweep documents go over the wire concurrently. Wider
    # fan-out was measured and rejected: five concurrent documents ran
    # SLOWER than two (GitHub queues concurrent GraphQL per token), so two
    # is the shape until GitHub changes its economics.
    from concurrent.futures import ThreadPoolExecutor

    aliases = " ".join(_graphql_search_alias(name, query, limit) for name, query in GRAPHQL_CEREMONY_SEARCHES)
    ceremony_doc = f"query {{ viewer {{ login }} {aliases} }} {GRAPHQL_PR_CORE}"
    if sweep_field:
        sweep_doc = f"query {{ {sweep_field} }} {GRAPHQL_PR_CORE}"
        with ThreadPoolExecutor(max_workers=2) as pool:
            ceremony_future = pool.submit(run_graphql, ceremony_doc)
            sweep_future = pool.submit(run_graphql, sweep_doc)
            data = ceremony_future.result()
            data["sweep"] = (sweep_future.result() or {}).get("sweep")
    else:
        data = run_graphql(ceremony_doc)
    # A response that parses but lacks the requested aliases is a failure,
    # not an empty inbox — treat it like any other GraphQL error and let the
    # REST fallback carry the run.
    missing = [name for name, _ in GRAPHQL_CEREMONY_SEARCHES if name not in data]
    if not isinstance(data.get("viewer"), dict) or "login" not in (data.get("viewer") or {}):
        missing.append("viewer.login")
    if sweep_field and not isinstance(data.get("sweep"), dict):
        missing.append("sweep")
    if missing:
        raise GhError(f"graphql response missing field(s): {', '.join(missing)}")
    for name, _ in GRAPHQL_CEREMONY_SEARCHES:
        nodes = ((data.get(name) or {}).get("nodes")) or []
        add(name, [normalize_graphql_pr(node) for node in nodes if isinstance(node, dict)])
    viewer = (data.get("viewer") or {}).get("login") or ""
    if ceremony_only:
        return None, viewer
    stats: dict[str, Any] = {
        "repos_swept": len(eligible), "prs_classified": 0, "waiting_on_author": 0,
        "unswept": [], "skipped_no_role": 0, "path": "graphql", "stage_contract": 1,
    }
    if not eligible:
        stats["unswept"].append({"repo": "*", "reason": "no sweep-eligible repos in inventory"})
    connection = data.get("sweep") or {}
    while sweep_field:
        for node in connection.get("nodes") or []:
            if isinstance(node, dict):
                _classify_sweep_node(node, viewer, eligible, add, stats)
        page = connection.get("pageInfo") or {}
        if not page.get("hasNextPage"):
            break
        follow_up = f"query {{ {_graphql_sweep_alias(sweep_query, page.get('endCursor'))} }} {GRAPHQL_PR_CORE}"
        connection = run_graphql(follow_up).get("sweep") or {}
    portfolio_sweep(viewer, add, stats, role_covered=set(eligible))
    return stats, viewer


def sweep_eligible(repo: dict[str, Any]) -> bool:
    if repo.get("archived"):
        return False
    permissions = repo.get("permissions") or {}
    return bool(permissions.get("admin") or permissions.get("maintain") or permissions.get("push"))


def repos_for_sweep() -> list[dict[str, Any]]:
    cache = read_repos_cache()
    repos = (cache or {}).get("repos") or []
    if not repos or any("permissions" not in repo for repo in repos):
        repos = fetch_repos()
        write_repos_cache(repos)
    return [repo for repo in repos if repo.get("full_name") and sweep_eligible(repo)]


def _yaml():
    try:
        import yaml
    except ImportError as exc:  # pragma: no cover - project dependency
        raise GhError("pyyaml is required for portfolio storage") from exc
    return yaml


def validate_portfolio_pattern(pattern: str) -> str:
    value = (pattern or "").strip()
    if not PORTFOLIO_PATTERN_RE.fullmatch(value):
        raise GhError(f"Invalid portfolio pattern: {pattern!r} (use owner/repo or owner/*)")
    return value


def read_portfolio() -> list[str]:
    if not PORTFOLIO_FILE.exists():
        return []
    yaml = _yaml()
    try:
        payload = yaml.safe_load(PORTFOLIO_FILE.read_text()) or {}
    except yaml.YAMLError as exc:
        raise GhError(f"invalid portfolio file {PORTFOLIO_FILE}: {exc}") from exc
    patterns = payload.get("patterns") if isinstance(payload, dict) else None
    return [str(pattern) for pattern in patterns or [] if isinstance(pattern, str)]


def write_portfolio(patterns: list[str]) -> None:
    yaml = _yaml()
    ensure_state_dir()
    payload = {"updated_at": now_iso(), "patterns": sorted(set(patterns))}
    tmp = PORTFOLIO_FILE.parent / (PORTFOLIO_FILE.name + ".tmp")
    tmp.write_text(yaml.safe_dump(payload, default_flow_style=False, sort_keys=True))
    tmp.replace(PORTFOLIO_FILE)


def is_no_access_error(message: str) -> bool:
    lowered = message.lower()
    return any(marker in lowered for marker in ("404", "403", "not found", "forbidden"))


def expand_portfolio_patterns(patterns: list[str], unswept: list[dict[str, Any]]) -> list[tuple[str, int | None]]:
    """Expand portfolio patterns to (full_name, open_issues_count) pairs.

    Exact patterns carry no metadata (None); owner/* expands through the REST
    repo listing for that owner. Unresolvable patterns land in unswept."""
    expanded: list[tuple[str, int | None]] = []
    for pattern in patterns:
        owner, _, tail = pattern.partition("/")
        if tail != "*":
            expanded.append((pattern, None))
            continue
        listing: list[dict[str, Any]] | None = None
        failure = ""
        for path in (f"orgs/{owner}/repos?per_page=100", f"users/{owner}/repos?per_page=100"):
            try:
                listing = gh_json_pages(path)
                break
            except GhError as exc:
                failure = str(exc)
        if listing is None:
            unswept.append({"repo": pattern, "reason": "no access" if is_no_access_error(failure) else failure})
            continue
        for item in listing:
            full = item.get("full_name")
            if full and not item.get("archived"):
                expanded.append((full, item.get("open_issues_count")))
    return expanded


def normalize_rest_pr(repo_full: str, item: dict[str, Any]) -> dict[str, Any]:
    author = item.get("user") or {}
    labels = item.get("labels") or []
    return {
        "ref": f"{repo_full}#{item.get('number')}",
        "repo": repo_full,
        "number": item.get("number"),
        "title": item.get("title"),
        "state": item.get("state"),
        "draft": bool(item.get("draft")),
        "author": author.get("login") if isinstance(author, dict) else author,
        "updated_at": item.get("updated_at"),
        "url": item.get("html_url"),
        "comments": None,
        "labels": [label.get("name") for label in labels if isinstance(label, dict)],
        "review_decision": None,
        "merge_state": None,
        "checks": None,
        "review_requests": None,
        "next_action": None,
    }


def classify_review_state(reviews: list[dict[str, Any]], viewer: str, head_sha: str | None) -> str | None:
    """Classify a third-party PR by the viewer's latest submitted review.

    Returns a bare reason token, or None when the ball is with the author
    (viewer requested changes at the current head)."""
    viewer_reviews = [
        review
        for review in reviews
        if isinstance(review, dict)
        and ((review.get("user") or {}).get("login")) == viewer
        and str(review.get("state") or "").upper() != "PENDING"
    ]
    latest = max(viewer_reviews, key=lambda review: review.get("submitted_at") or "", default=None)
    if latest is None:
        return "unreviewed"
    if head_sha and latest.get("commit_id") != head_sha:
        return "review_stale"
    state = str(latest.get("state") or "").upper()
    if state == "APPROVED":
        return "approved_unmerged"
    if state == "CHANGES_REQUESTED":
        return None
    # COMMENTED or DISMISSED at head: no decision recorded, still on us.
    return "unreviewed"


def classify_maintainer_state(reviews: list[dict[str, Any]], viewer: str, head_sha: str | None) -> str | None:
    token = classify_review_state(reviews, viewer, head_sha)
    return None if token is None else f"maintainer_{token}"


def sweep_repo_pulls(
    full: str,
    viewer: str,
    add: Callable[[str, list[dict[str, Any]]], None],
    bucket: dict[str, Any],
    unswept: list[dict[str, Any]],
    reason_prefix: str,
) -> None:
    """Sweep one repo's open third-party PRs into the inbox under reason_prefix."""
    try:
        pulls = gh_json_pages(f"repos/{full}/pulls?state=open&per_page=100")
    except GhError as exc:
        message = str(exc)
        if reason_prefix == "portfolio_" and is_no_access_error(message):
            message = "no access"
        unswept.append({"repo": full, "reason": message})
        return
    bucket["repos_swept"] += 1
    for pull in pulls:
        author = (pull.get("user") or {}).get("login")
        number = pull.get("number")
        if number is None or not author or author == viewer:
            continue
        try:
            reviews = gh_json_pages(f"repos/{full}/pulls/{number}/reviews?per_page=100")
        except GhError as exc:
            unswept.append({"repo": full, "reason": f"reviews for #{number}: {exc}"})
            continue
        bucket["prs_classified"] += 1
        token = classify_review_state(reviews, viewer, (pull.get("head") or {}).get("sha"))
        if token is None:
            bucket["waiting_on_author"] += 1
            continue
        entry = normalize_rest_pr(full, pull)
        add(reason_prefix + token, [entry])
        if is_bot_login(author):
            add("bot_author", [entry])


def maintainer_sweep(viewer: str, add: Callable[[str, list[dict[str, Any]]], None]) -> dict[str, Any]:
    """Waiting-on-us from role (repos we can push to) plus declared portfolio.

    A repo is either swept or loudly in `unswept` — never silently skipped."""
    stats: dict[str, Any] = {"repos_swept": 0, "prs_classified": 0, "waiting_on_author": 0, "unswept": []}
    role_repos: list[dict[str, Any]] = []
    try:
        role_repos = repos_for_sweep()
    except GhError as exc:
        stats["unswept"].append({"repo": "*", "reason": f"repo inventory unavailable: {exc}"})
    role_covered: set[str] = set()
    for repo in role_repos:
        full = repo["full_name"]
        role_covered.add(full)
        # open_issues_count includes open PRs, so zero proves nothing is open.
        if repo.get("open_issues_count") == 0:
            stats["repos_swept"] += 1
            continue
        sweep_repo_pulls(full, viewer, add, stats, stats["unswept"], "maintainer_")

    portfolio_sweep(viewer, add, stats, role_covered)
    return stats


def portfolio_sweep(
    viewer: str,
    add: Callable[[str, list[dict[str, Any]]], None],
    stats: dict[str, Any],
    role_covered: set[str],
) -> None:
    """Declared-portfolio sweep, shared by the REST and GraphQL inbox paths."""
    portfolio_stats: dict[str, Any] = {"patterns": 0, "repos_swept": 0, "prs_classified": 0, "waiting_on_author": 0}
    stats["portfolio"] = portfolio_stats
    try:
        patterns = read_portfolio()
    except GhError as exc:
        stats["unswept"].append({"repo": "portfolio", "reason": str(exc)})
        patterns = []
    portfolio_stats["patterns"] = len(patterns)
    if patterns:
        seen: set[str] = set()
        for full, open_issues in expand_portfolio_patterns(patterns, stats["unswept"]):
            # Role wins on dedupe: role-covered repos keep maintainer_* reasons.
            if full in role_covered or full in seen:
                continue
            seen.add(full)
            if open_issues == 0:
                portfolio_stats["repos_swept"] += 1
                continue
            sweep_repo_pulls(full, viewer, add, portfolio_stats, stats["unswept"], "portfolio_")


def search_candidates_for_awaiting(args: argparse.Namespace) -> list[dict[str, Any]]:
    items: dict[str, dict[str, Any]] = {}

    def add(prs: list[dict[str, Any]]) -> None:
        for pr in prs:
            key = pr.get("ref") or pr.get("url")
            if key:
                items.setdefault(key, pr)

    base = argparse.Namespace(
        limit=args.limit,
        state="open",
        repo=args.repo or [],
        owner=args.owner or [],
        author=None,
        review_requested=None,
        review=None,
        checks=None,
        query=args.query,
    )

    strict = argparse.Namespace(**{**vars(base), "review_requested": "me"})
    add(search_prs(strict))

    has_broad_scope = bool(args.repo or args.owner or args.author or args.query)
    if has_broad_scope:
        authors = args.author or [None]
        for author in authors:
            broad = argparse.Namespace(**{**vars(base), "author": author})
            add(search_prs(broad))

    return list(items.values())


def awaiting_reasons(detail: dict[str, Any], viewer: str, *, include_reviewed: bool) -> list[str]:
    reasons: list[str] = []
    review_requests = set(detail.get("review_requests") or [])
    if viewer in review_requests:
        reasons.append("review_requested")

    viewer_reviews = [
        review
        for review in detail.get("latest_reviews", [])
        if isinstance(review, dict) and review.get("author") == viewer
    ]
    latest_review = max(
        viewer_reviews,
        key=lambda review: review.get("submitted_at") or "",
        default=None,
    )
    if latest_review is None:
        reasons.append("not_reviewed_by_me")
        return reasons

    review_state = latest_review.get("state")
    submitted_at = parse_github_time(latest_review.get("submitted_at"))
    updated_at = parse_github_time(detail.get("updated_at"))
    if submitted_at and updated_at and updated_at > submitted_at:
        reasons.append("updated_after_my_review")
    elif review_state == "COMMENTED":
        reasons.append("commented_not_decisive")
    elif include_reviewed:
        reasons.append(f"reviewed_by_me:{review_state or 'unknown'}")

    return reasons


def build_awaiting(args: argparse.Namespace) -> dict[str, Any]:
    viewer = current_user().get("login") or ""
    candidates = search_candidates_for_awaiting(args)
    details: list[dict[str, Any]] = []
    seen: set[str] = set()

    for candidate in candidates:
        repo = candidate.get("repo")
        number = candidate.get("number")
        if not repo or not number:
            continue
        ref = f"{repo}#{number}"
        if ref in seen:
            continue
        seen.add(ref)
        detail = pr_detail(PrRef(repo=repo, number=str(number), original=ref))
        if str(detail.get("state") or "").upper() != "OPEN":
            continue
        if detail.get("draft") and not args.include_drafts:
            continue
        if detail.get("author") == viewer:
            continue
        if is_bot_login(detail.get("author")) and not args.include_bots:
            continue
        reasons = awaiting_reasons(detail, viewer, include_reviewed=args.include_reviewed)
        if not reasons:
            continue
        details.append({**detail, "reasons": reasons})

    details.sort(key=lambda item: item.get("updated_at") or "", reverse=True)
    scope_note = None
    if not (args.repo or args.owner or args.author or args.query):
        scope_note = "Unscoped awaiting uses strict review requests only. Add --owner, --repo, --author, or a query for broader not-yet-reviewed PR discovery."
    return {"viewer": viewer, "count": len(details), "items": details[: args.limit], "scope_note": scope_note}


REVIEW_DOCTRINE = """# Pull Request Review Doctrine

A pull request is someone's work — a person's or an agent's — finished and handed to you. Review it the way you'd want yours reviewed: closely, fairly, all the way through. Own the whole arc — review, audit, and merge or send back. Don't hand a half-finished review to the human; they work alongside you, they don't run your steps.

## Read the change, not the pitch

The PR description says what the author meant to do. The diff says what they did. Read the diff. Where the two diverge, the diff wins and the description becomes a question to raise.

## Verify before you bless

- If CI reported, read it. If no CI ran, run the relevant tests yourself — and say exactly which ones and what happened.
- `agent-do gh review <n>` gives you the risk tier. Critical-tier changes — auth, middleware, rate limiting, migrations, secrets, permissions — get traced, not skimmed: follow the control flow, name the failure modes, confirm the tests exercise the thing being fixed.
- Standard-tier changes still get a real read. They just don't need the forensic pass.

## Write like a colleague, not a linter

The author reads every word you leave. Write so it lands as help, not as a verdict.

- Cite specifics: `middleware.ts:80`, not "the middleware." A reviewer who can't point at a line didn't read the file.
- Name what's right. Good work should hear it's good — that's information, not flattery.
- Say the problem and the fix in the same breath. "X breaks under Y; do Z" beats "X looks wrong."
- Plain and short. No ceremony, no restating the PR back at the author, no padding.
- Never estimate time. "Quick fix," "this'd take a while" — cut all of it.
- You're moving the change forward, not guarding a gate. Even a request-for-changes reads as "here's what gets this in" — not "denied."

## The decision

- Passes review, audit, and checks -> approve and squash-merge with a clean message. Resolve any bot threads you've genuinely addressed. Done — don't wait for permission on a routine merge.
- Fixable problems -> request changes with the exact lines and the exact fixes. Don't merge.
- Judgment call — changes authorization semantics, alters a migration's meaning, affects other people's running work, or the scope outgrew the stated intent -> review it, state your recommendation plainly, escalate to the human. That, and only that, goes back to them.

## Merge hygiene

Squash by default. Clean message describing the why. Delete the branch. The merge gate refuses on failing checks, unresolved threads, a dirty merge state, or a missing approval — don't fight it, fix the cause. `--force` exists for genuine emergencies and announces itself loudly when used.
"""


# ---------------------------------------------------------------------------
# Risk classification — maps changed paths to review-scrutiny tiers.
# critical: security / authorization / data-integrity surface
# elevated: build / deploy / dependency surface
# standard: everything else
# ---------------------------------------------------------------------------

RISK_RULES: list[tuple[str, str, str]] = [
    ("critical", r"middleware\.", "auth perimeter"),
    ("critical", r"(^|/)auth($|[./_-])", "authentication"),
    ("critical", r"rate.?limit", "rate limiting"),
    ("critical", r"(^|/)rls($|[/._-])", "row-level security"),
    ("critical", r"migrations?/", "database migration"),
    ("critical", r"\.sql$", "database migration"),
    ("critical", r"secret", "secret material"),
    ("critical", r"credential", "credential handling"),
    ("critical", r"(^|[/._-])token($|[./_-])", "token handling"),
    ("critical", r"session", "session handling"),
    ("critical", r"crypto", "cryptography"),
    ("critical", r"password", "password handling"),
    ("critical", r"(^|/)cors", "CORS policy"),
    ("critical", r"permission", "permission logic"),
    ("elevated", r"\.github/workflows/", "CI workflow"),
    ("elevated", r"(^|/)dockerfile", "container build"),
    ("elevated", r"render\.yaml", "deploy config"),
    ("elevated", r"vercel\.json", "deploy config"),
    ("elevated", r"\.tf$", "infrastructure"),
    ("elevated", r"package\.json$", "dependency manifest"),
    ("elevated", r"-lock\.(json|yaml)$", "dependency lockfile"),
    ("elevated", r"requirements\.txt$", "dependency manifest"),
    ("elevated", r"Cargo\.(toml|lock)$", "dependency manifest"),
    ("elevated", r"(^|/)\.env", "environment config"),
    ("elevated", r"next\.config\.", "framework config"),
]

_RISK_TIER_ORDER = {"standard": 0, "elevated": 1, "critical": 2}


def classify_risk(paths: list[str]) -> dict[str, Any]:
    """Classify changed paths into review-scrutiny tiers. Pure function."""
    counts = {"critical": 0, "elevated": 0, "standard": 0}
    signals: list[dict[str, str]] = []
    overall = "standard"
    for path in paths:
        path_tier = "standard"
        path_reason = ""
        for tier, pattern, reason in RISK_RULES:
            if re.search(pattern, path, re.IGNORECASE):
                if _RISK_TIER_ORDER[tier] > _RISK_TIER_ORDER[path_tier]:
                    path_tier = tier
                    path_reason = reason
        counts[path_tier] += 1
        if path_tier != "standard":
            signals.append({"path": path, "tier": path_tier, "reason": path_reason})
        if _RISK_TIER_ORDER[path_tier] > _RISK_TIER_ORDER[overall]:
            overall = path_tier
    signals.sort(key=lambda s: _RISK_TIER_ORDER[s["tier"]], reverse=True)
    return {"tier": overall, "counts": counts, "signals": signals}


def merge_gate(ref: PrRef) -> dict[str, Any]:
    """Deterministic merge preconditions. Returns blocks (hard) + warnings (risk)."""
    detail = pr_detail(ref)
    checks = pr_checks(ref)
    threads = pr_threads(ref)
    blocks: list[dict[str, str]] = []
    warnings: list[dict[str, str]] = []

    failed = [c for c in checks if str(c.get("bucket") or "").lower() in {"fail", "failed", "failure"}]
    if failed:
        names = ", ".join(str(c.get("name") or "unnamed") for c in failed[:5])
        blocks.append({"gate": "checks", "reason": f"{len(failed)} check(s) failing: {names}"})

    if threads:
        blocks.append({"gate": "threads", "reason": f"{len(threads)} unresolved review thread(s)"})

    merge_state = str(detail.get("merge_state") or "").upper()
    if merge_state and merge_state not in {"CLEAN", "UNKNOWN"}:
        blocks.append({"gate": "mergeable", "reason": f"merge state is {merge_state}, not CLEAN"})

    decision = str(detail.get("review_decision") or "").upper()
    if decision != "APPROVED":
        blocks.append({
            "gate": "approval",
            "reason": f"no approving review recorded (review_decision={decision or 'none'})",
        })

    risk = classify_risk(changed_paths(detail))
    if risk["tier"] == "critical":
        crit = ", ".join(s["path"] for s in risk["signals"] if s["tier"] == "critical")
        warnings.append({
            "gate": "risk",
            "reason": f"critical-tier paths changed ({crit}) — pass --confirm-risk after tracing the control flow",
        })

    return {"allowed": not blocks, "blocks": blocks, "warnings": warnings, "risk": risk}


def add_finding(
    findings: list[dict[str, Any]],
    *,
    severity: str,
    title: str,
    evidence: str,
    fix: str,
    category: str = "review",
) -> None:
    findings.append(
        {
            "severity": severity,
            "category": category,
            "title": title,
            "evidence": evidence,
            "fix": fix,
        }
    )


def changed_file(detail: dict[str, Any], suffix: str) -> dict[str, Any] | None:
    for file in detail.get("files") or []:
        path = str(file.get("path") or "")
        if path.endswith(suffix):
            return file
    return None


def changed_paths(detail: dict[str, Any]) -> list[str]:
    return [str(file.get("path") or "") for file in detail.get("files") or [] if file.get("path")]


def extract_interesting_env_vars(text: str) -> list[str]:
    envs: set[str] = set()
    for value in ENV_VAR_RE.findall(text):
        if value in OPTIONAL_PROVIDER_ENV_NAMES or value in {"SENTRY", "NEXT_PUBLIC", "RENDER", "VERCEL"}:
            continue
        if value.startswith(INTERESTING_ENV_PREFIXES):
            envs.add(value)
    if ("SENTRY_ORG" in envs or "SENTRY_PROJECT" in envs) and "SENTRY_AUTH_TOKEN" not in envs:
        envs.add("SENTRY_AUTH_TOKEN")
    return sorted(envs)


def command_available(cmd: str) -> bool:
    return shutil.which(cmd) is not None


def run_optional(cmd: list[str], *, timeout: int = 30) -> subprocess.CompletedProcess[str] | None:
    try:
        return subprocess.run(cmd, text=True, capture_output=True, check=False, timeout=timeout)
    except (OSError, subprocess.TimeoutExpired):
        return None


def parse_env_keys(output_text: str) -> set[str]:
    keys: set[str] = set()
    for line in output_text.splitlines():
        match = re.search(r"\b([A-Z][A-Z0-9_]{2,})=", line)
        if match:
            keys.add(match.group(1))
    return keys


def repo_slug(repo: str | None) -> str | None:
    if not repo or "/" not in repo:
        return None
    return repo.split("/", 1)[1].lower()


def deployment_target_kind(paths: list[str]) -> str:
    web = any(path.startswith("presentation/") or path == "Dockerfile.web" or path.endswith("Dockerfile.web") for path in paths)
    worker = any(path.startswith("orchestrator/") or path == "Dockerfile.worker" or path.endswith("Dockerfile.worker") for path in paths)
    if web and not worker:
        return "web"
    if worker and not web:
        return "worker"
    return "mixed"


def service_matches_target(service_name: str, target_kind: str) -> bool:
    lower = service_name.lower()
    if target_kind == "web":
        return "worker" not in lower
    if target_kind == "worker":
        return "worker" in lower
    return True


def probe_deployment_env(detail: dict[str, Any], env_vars: list[str], *, target_kind: str = "mixed") -> dict[str, Any]:
    """Best-effort local provider probe. Values are never returned, only key presence."""
    slug = repo_slug(detail.get("repo"))
    result: dict[str, Any] = {
        "enabled": True,
        "env_vars": env_vars,
        "render": {"services": []},
        "vercel": {"projects": []},
        "notes": [],
    }
    if not slug or not env_vars:
        return result

    if command_available("agent-do"):
        render_services = run_optional(["agent-do", "render", "services"])
        if render_services and render_services.returncode == 0:
            for line in render_services.stdout.splitlines():
                parts = line.split()
                if len(parts) < 2:
                    continue
                service_id, service_name = parts[0], parts[1]
                if slug not in service_name.lower() or not service_matches_target(service_name, target_kind):
                    continue
                env_out = run_optional(["agent-do", "render", "env", service_id])
                keys = parse_env_keys(env_out.stdout if env_out and env_out.returncode == 0 else "")
                result["render"]["services"].append(
                    {
                        "id": service_id,
                        "name": service_name,
                        "present": sorted(set(env_vars) & keys),
                        "missing": sorted(set(env_vars) - keys),
                    }
                )
        elif render_services:
            result["notes"].append(f"render probe failed: {(render_services.stderr or render_services.stdout).strip()[:200]}")

        vercel_projects = None if target_kind == "worker" else run_optional(["agent-do", "vercel", "projects"])
        if vercel_projects and vercel_projects.returncode == 0:
            for line in vercel_projects.stdout.splitlines():
                parts = line.split()
                if len(parts) < 2:
                    continue
                project_id, project_name = parts[0], parts[1]
                if slug != project_name.lower():
                    continue
                env_out = run_optional(["agent-do", "vercel", "env", project_name])
                keys = parse_env_keys(env_out.stdout if env_out and env_out.returncode == 0 else "")
                result["vercel"]["projects"].append(
                    {
                        "id": project_id,
                        "name": project_name,
                        "present": sorted(set(env_vars) & keys),
                        "missing": sorted(set(env_vars) - keys),
                    }
                )
        elif vercel_projects:
            result["notes"].append(f"vercel probe failed: {(vercel_projects.stderr or vercel_projects.stdout).strip()[:200]}")
    else:
        result["notes"].append("agent-do not found; provider env probe skipped")
    return result


def audit_pr(ref: PrRef, *, probe_deploys: bool = False) -> dict[str, Any]:
    detail = pr_detail(ref)
    checks = pr_checks(ref)
    threads = pr_threads(ref)
    diff = pr_diff_text(ref)
    paths = changed_paths(detail)
    findings: list[dict[str, Any]] = []

    failed_checks = [check for check in checks if str(check.get("bucket") or "").lower() in {"fail", "failed", "failure"}]
    pending_checks = [check for check in checks if str(check.get("bucket") or "").lower() in {"pending", "queued", "in_progress", "waiting"}]
    if failed_checks:
        add_finding(
            findings,
            severity="high",
            category="checks",
            title="Required checks are failing",
            evidence=", ".join(str(check.get("name") or "unnamed") for check in failed_checks[:5]),
            fix="Fix the failing checks before review approval. If a check is irrelevant, document why and remove or reconfigure it instead of ignoring the failure.",
        )
    if pending_checks:
        add_finding(
            findings,
            severity="medium",
            category="checks",
            title="Required signal is still pending",
            evidence=", ".join(str(check.get("name") or "unnamed") for check in pending_checks[:5]),
            fix="Wait for the pending checks to settle before merge, or rerun/debug stuck checks so review is based on final CI state.",
        )
    if threads:
        add_finding(
            findings,
            severity="medium",
            category="review",
            title="Unresolved review threads exist",
            evidence=f"{len(threads)} unresolved thread(s)",
            fix="Resolve the review threads in code or reply with a concrete reason they are intentionally left open.",
        )
    if detail.get("merge_state") and str(detail.get("merge_state")).upper() not in {"CLEAN", "UNKNOWN"}:
        add_finding(
            findings,
            severity="high",
            category="merge",
            title="PR is not cleanly mergeable",
            evidence=f"merge_state={detail.get('merge_state')} mergeable={detail.get('mergeable')}",
            fix="Rebase or merge the base branch, resolve conflicts, and rerun checks before review approval.",
        )

    lock_files = [file for file in detail.get("files") or [] if str(file.get("path") or "").endswith(("package-lock.json", "pnpm-lock.yaml", "yarn.lock"))]
    package_files = [file for file in detail.get("files") or [] if str(file.get("path") or "").endswith("package.json")]
    for file in lock_files:
        churn = int(file.get("additions") or 0) + int(file.get("deletions") or 0)
        if churn >= 1000:
            add_finding(
                findings,
                severity="medium",
                category="dependencies",
                title="Lockfile blast radius is large",
                evidence=f"{file.get('path')} changed by +{file.get('additions')} -{file.get('deletions')}",
                fix="Regenerate the lockfile with only the intended dependency change. If the broad dependency refresh is intentional, split it into a separate PR with its own validation notes.",
            )
        elif churn >= 250 and package_files:
            add_finding(
                findings,
                severity="low",
                category="dependencies",
                title="Lockfile churn needs review",
                evidence=f"{file.get('path')} changed by +{file.get('additions')} -{file.get('deletions')}",
                fix="Confirm the lockfile changes correspond to the manifest change and do not silently upgrade unrelated runtime packages.",
            )

    if re.search(r"tracesSampleRate\s*:\s*1(?:\.0)?", diff):
        add_finding(
            findings,
            severity="medium",
            category="observability",
            title="Production trace sampling appears too high",
            evidence="Diff contains tracesSampleRate: 1.0",
            fix='Make sampling env-driven or lower the production default, for example `Number(process.env.SENTRY_TRACES_SAMPLE_RATE ?? "0.1")`, and use it consistently across runtime configs.',
        )

    if "SENTRY_ORG" in diff or "SENTRY_PROJECT" in diff:
        if "SENTRY_AUTH_TOKEN" not in diff:
            add_finding(
                findings,
                severity="medium",
                category="observability",
                title="Source-map upload looks partially wired",
                evidence="Diff references SENTRY_ORG/SENTRY_PROJECT without SENTRY_AUTH_TOKEN",
                fix="Either fully wire build-time source-map upload env, including SENTRY_AUTH_TOKEN, or remove/disable source-map upload config until that path is ready.",
            )

    if "captureException" in diff and "process.exit" in diff and "Sentry.flush" not in diff and "Sentry.close" not in diff:
        add_finding(
            findings,
            severity="medium",
            category="observability",
            title="Fatal telemetry may be dropped before process exit",
            evidence="Diff captures exceptions and exits without Sentry.flush()/Sentry.close()",
            fix="Await `Sentry.flush(2000)` or `Sentry.close(2000)` before fatal `process.exit` paths. Do not let telemetry failure block shutdown indefinitely.",
        )

    if re.search(r"tags\s*:\s*\{[^}]*\bjobId\b", diff, re.DOTALL) or re.search(r"tags\s*:\s*\{[^}]*\bjobName\b", diff, re.DOTALL):
        add_finding(
            findings,
            severity="medium",
            category="observability",
            title="High-cardinality values are used as Sentry tags",
            evidence="Diff places jobId/jobName in tags",
            fix="Keep tags low-cardinality. Move jobId/jobName to `extra` or structured context while keeping only stable dimensions, such as worker name, in tags.",
        )

    if "vitest" in diff.lower():
        package_json = changed_file(detail, "package.json")
        if package_json and '"test"' not in diff and "vitest" not in re.sub(r"^\+.*vitest.*$", "", diff, flags=re.MULTILINE).lower():
            add_finding(
                findings,
                severity="medium",
                category="tests",
                title="Added Vitest test may not be runnable",
                evidence="Diff imports/mentions Vitest but does not add an obvious test script or Vitest dependency",
                fix="Add Vitest to devDependencies and a real test script, rewrite the test for the existing runner, or remove the dead test from this PR.",
            )
        elif package_json and '"test"' not in diff:
            add_finding(
                findings,
                severity="medium",
                category="tests",
                title="New test runner wiring is unclear",
                evidence="Diff mentions Vitest but no package.json test script addition was detected",
                fix="Make the test executable through the package's normal test command so CI and reviewers can run it.",
            )

    if any(path.endswith((".env.example", "render.yaml", "vercel.json")) or "Dockerfile" in path for path in paths):
        add_finding(
            findings,
            severity="medium",
            category="deploy",
            title="Deployment or environment contract changed",
            evidence=", ".join(path for path in paths if path.endswith((".env.example", "render.yaml", "vercel.json")) or "Dockerfile" in path)[:300],
            fix="Verify the live deployment provider has the same required env keys and build/runtime semantics as the checked-in config. Keep blueprint state aligned with production or explicitly mark it non-authoritative.",
        )

    env_vars = extract_interesting_env_vars(diff)
    target_kind = deployment_target_kind(paths)
    deploy_probe = probe_deployment_env(detail, env_vars, target_kind=target_kind) if probe_deploys else {"enabled": False, "env_vars": env_vars}
    deploy_probe["target_kind"] = target_kind
    if probe_deploys:
        for service in deploy_probe.get("render", {}).get("services", []):
            missing = service.get("missing") or []
            if missing:
                add_finding(
                    findings,
                    severity="medium",
                    category="deploy",
                    title=f"Render env may be missing keys on {service.get('name')}",
                    evidence=", ".join(missing[:12]),
                    fix="Add the missing keys to the Render service or document why this service should not receive them. Verify build-time NEXT_PUBLIC_* keys separately for Docker builds.",
                )
        for project in deploy_probe.get("vercel", {}).get("projects", []):
            missing = project.get("missing") or []
            if missing:
                add_finding(
                    findings,
                    severity="low",
                    category="deploy",
                    title=f"Vercel env may be missing keys on {project.get('name')}",
                    evidence=", ".join(missing[:12]),
                    fix="If Vercel is still an active target, add the missing keys. If it is intentionally disabled/stale, document that so Vercel previews are not treated as production validation.",
                )

    severity_order = {"high": 0, "medium": 1, "low": 2}
    findings.sort(key=lambda item: (severity_order.get(item.get("severity"), 9), item.get("category") or "", item.get("title") or ""))
    return {
        "pr": detail,
        "checks": {"count": len(checks), "items": checks},
        "unresolved_threads": {"count": len(threads), "items": threads},
        "changed_paths": paths,
        "risk": classify_risk(paths),
        "env_vars_in_diff": env_vars,
        "deployment_probe": deploy_probe,
        "findings": findings,
        "verdict": "request_changes" if any(item.get("severity") in {"high", "medium"} for item in findings) else "no_blockers_found",
    }


def format_audit_reply(audit: dict[str, Any]) -> str:
    pr = audit.get("pr") or {}
    findings = audit.get("findings") or []
    blockers = [finding for finding in findings if finding.get("severity") in {"high", "medium"}]
    notes = [finding for finding in findings if finding.get("severity") not in {"high", "medium"}]
    if blockers:
        lines = [
            "Do not merge as-is.",
            "",
            "Required fixes:",
            "",
        ]
        for finding in blockers:
            lines.append(f"- {finding.get('title')}. {finding.get('evidence')}.")
            lines.append(f"  How to address: {finding.get('fix')}")
        if notes:
            lines.extend(["", "Lower-priority notes:", ""])
            for finding in notes:
                lines.append(f"- {finding.get('title')}. {finding.get('evidence')}.")
                lines.append(f"  How to address: {finding.get('fix')}")
        lines.extend(
            [
                "",
                "Current verified signals:",
                f"- Checks inspected: {(audit.get('checks') or {}).get('count', 0)}",
                f"- Unresolved review threads: {(audit.get('unresolved_threads') or {}).get('count', 0)}",
                f"- Files changed: {pr.get('changed_files')}  +{pr.get('additions')} -{pr.get('deletions')}",
                "",
                "Requesting changes.",
            ]
        )
        return "\n".join(lines)

    lines = ["No blocking issues found from the automated review audit."]
    if notes:
        lines.extend(["", "Lower-priority notes:", ""])
        for finding in notes:
            lines.append(f"- {finding.get('title')}. {finding.get('evidence')}.")
            lines.append(f"  How to address: {finding.get('fix')}")
    lines.extend(
        [
            "",
            "Current verified signals:",
            f"- Checks inspected: {(audit.get('checks') or {}).get('count', 0)}",
            f"- Unresolved review threads: {(audit.get('unresolved_threads') or {}).get('count', 0)}",
            f"- Files changed: {pr.get('changed_files')}  +{pr.get('additions')} -{pr.get('deletions')}",
            "",
            "This is not a substitute for reading the code diff, but there are no automated blockers from the audited signals.",
        ]
    )
    return "\n".join(lines)


def print_json(payload: Any) -> None:
    print(json.dumps(payload, indent=2, sort_keys=True))


def print_table(rows: list[dict[str, Any]], fields: list[str]) -> None:
    if not rows:
        print("No results.")
        return
    widths = {field: len(field.upper()) for field in fields}
    for row in rows:
        for field in fields:
            widths[field] = max(widths[field], len(str(row.get(field, "") or "")))
    print("  ".join(field.upper().ljust(widths[field]) for field in fields))
    for row in rows:
        print("  ".join(str(row.get(field, "") or "").ljust(widths[field]) for field in fields))


def output(payload: Any, *, json_mode: bool, table_fields: list[str] | None = None) -> None:
    if json_mode:
        print_json(payload)
        return
    if isinstance(payload, list) and table_fields:
        print_table(payload, table_fields)
        return
    if isinstance(payload, dict):
        for key, value in payload.items():
            if isinstance(value, (dict, list)):
                print(f"{key}: {json.dumps(value)}")
            else:
                print(f"{key}: {value}")
        return
    print(payload)


