    drops_p = sub.add_parser("drops")
    drops_p.add_argument("--for-me", action="store_true", dest="for_me")
    drops_p.add_argument("--all", action="store_true", dest="include_resolved")
    drops_p.add_argument("--wake", action="store_true", dest="wake")

    worker_p = sub.add_parser("worker")
    worker_p.add_argument("item")

    history_p = sub.add_parser("history")
    history_p.add_argument("peer", nargs="?")
    history_p.add_argument("--limit", type=int, default=20)

    sub.add_parser("help")
    return p


def format_peer(peer: dict[str, Any]) -> str:
    label = peer.get("alias") or peer.get("agent_id")
    current = " current" if peer.get("current") else ""
    focus = peer.get("focus") or {}
    parts = [f"{label} status:{peer.get('status')}({peer.get('age')})"]
    if peer.get("role"):
        mode = peer.get("mode")
        role = str(peer.get("role"))
        parts.append(f"role:{role}[read-only]" if mode == "read-only" else f"role:{role}")
    if peer.get("phase"):
        parts.append(f"phase:{peer.get('phase')}")
    if focus.get("goal"):
        parts.append(f'goal:"{focus.get("goal")}"')
    pulse = peer.get("pulse") or {}
    if pulse.get("status"):
        parts.append(f"pulse:{pulse['status']}({format_age(pulse.get('updated_at'))})")
        attention = (pulse.get("attention") or {}).get("message")
        if pulse["status"] == "needs-user" and attention:
            parts.append(f'attn:"{attention}"')
        if pulse["status"] == "working" and pulse.get("activity"):
            parts.append(f"act:{pulse['activity']}")
        todo = pulse.get("todo") or {}
        if todo.get("total"):
            label = f' "{todo["current"]}"' if todo.get("current") else ""
            parts.append(f"todo:{todo.get('done', 0)}/{todo['total']}{label}")
        if not focus.get("goal") and pulse.get("latest_prompt"):
            parts.append(f'prompt:"{pulse["latest_prompt"]}"')
    if peer.get("stop_note"):
        parts.append(f'note:"{peer.get("stop_note")}"')
    return " ".join(parts) + current


def format_interrupt(item: dict[str, Any]) -> str:
    prefix = "[new] " if item.get("new") else ""
    return f"{prefix}{item.get('kind')}: {item.get('summary')}"


def bell_from_hook() -> int:
    """Only fixed context leaves this boundary. No harness/session startup."""
    try:
        payload = json.load(sys.stdin)
        if not isinstance(payload, dict):
            return 0
        event = payload.get("hook_event_name")
        if event not in {"UserPromptSubmit", "Stop"}:
            return 0
        if event == "Stop" and payload.get("stop_hook_active") is not False:
            # Never chain stop continuations. Retain the bit for the next turn.
            return 0
        session = payload.get("session_id")
        cwd = payload.get("cwd")
        if not isinstance(session, str) or not session or not isinstance(cwd, str) or not cwd:
            return 0
        base = Path(cwd)
        if not base.is_absolute() or not base.is_dir():
            return 0
        paths = resolve_project_paths(base)
        if not (Path(paths["coord_root"]) / "bells.json").is_file():
            return 0
        if not CoordStore(base, identify=False).take_bell(session):
            return 0
        if event == "Stop":
            # Both Claude and Codex document this one-shot continuation protocol.
            result = {"decision": "block", "reason": DOORBELL_NUDGE}
        else:
            result = {"hookSpecificOutput": {"hookEventName": event, "additionalContext": DOORBELL_NUDGE}}
        print(json.dumps(result))
    except Exception:
        pass
    return 0


def main(argv: list[str]) -> int:
    if len(argv) == 1 or argv[1] in {"--help", "-h", "help"}:
        print(HELP)
        return 0

    raw_args = argv[1:]
    force_json = False
    if "--json" in raw_args:
        force_json = True
        raw_args = [arg for arg in raw_args if arg != "--json"]

    if raw_args and raw_args[0] == "bell":
        # Never echo rejected content in argparse diagnostics or persist it.
        if raw_args in (["bell"], ["bell", "--help"], ["bell", "ring", "--help"], ["bell", "check", "--help"]):
            print("bell ring --for <agent> | bell check --from-hook (routing only; no content)")
            return 0
        if raw_args == ["bell", "check", "--from-hook"]:
            return bell_from_hook()
        if len(raw_args) == 4 and raw_args[:3] == ["bell", "ring", "--for"] and not raw_args[3].startswith("-"):
            try:
                queued = CoordStore(Path.cwd(), identify=False).ring(raw_args[3])
            except Exception:
                queued = False
            return print_payload({"success": True, "tool": "coord", "queued": queued}, force_json)
        return error("bell accepts routing only: bell ring --for <agent> | bell check --from-hook; no content", force_json, code=2)

    args = parser().parse_args(raw_args)
    args.json = bool(force_json or getattr(args, "json", False))
    if not args.command:
        print(HELP)
        return 0

    if (
        args.command == "pulse"
        and getattr(args, "pulse_command", None) == "record"
        and args.from_hook
    ):
        # Hook-safe by contract: whatever happens, exit 0 with empty stdout —
        # a telemetry write must never break or chatter into a session's hooks.
        try:
            payload = json.load(sys.stdin)
            if not isinstance(payload, dict):
                return 0
            session = payload.get("session_id")
            if isinstance(session, str) and session:
                # The payload names the session that generated the event, and it
                # outranks any inherited pin: a hook process carrying another
                # session's env must never write telemetry onto that row. Real
                # hooks agree with their own pin; this guards the crossed case.
                os.environ["AGENT_DO_COORD_SESSION"] = session
            cwd_value = payload.get("cwd")
            base = Path.cwd()
            if isinstance(cwd_value, str) and cwd_value:
                candidate = Path(cwd_value)
                if candidate.is_dir():
                    base = candidate
            CoordStore(base).record_pulse(payload)
        except Exception:
            pass
        return 0

    if args.command == "pulse" and getattr(args, "pulse_command", None) == "record":
        if not args.session or not args.status or not args.updated_at:
