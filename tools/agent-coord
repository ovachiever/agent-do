        if not ok:
            extra = {k: v for k, v in payload.items() if k != "error"}
            return error(str(payload.get("error")), args.json, code=2, **extra)
        if args.json:
            return print_payload({"success": True, "tool": "coord", **payload}, True)
        item = payload["item"]
        print(
            f'{item["id"]} {item.get("status")}: claimant {item.get("claimant") or "none"} '
            f'(attempt {item.get("attempt") if item.get("attempt") is not None else "n/a"}, '
            f'work order {short_digest((item.get("work_order") or {}).get("digest"))}, board {item.get("board")})'
        )
        session = payload.get("session")
        if session:
            binding = session["binding"]
            liveness = payload["liveness"] or {}
            print(
                f'session: {session["agent_id"]}'
                + (f' (also {", ".join(session["also"])})' if session.get("also") else "")
                + f' bound {format_age(binding.get("bound_at"))} via {binding.get("how")}'
            )
            print(
                f'liveness: {liveness.get("presence")} (last seen {liveness.get("age")}; process {liveness.get("process", {}).get("verified")})'
            )
            assignment = payload.get("assignment") or {}
            declared = assignment.get("declared_focus")
            print(
                f'assignment: {item["id"]} claimed {format_age(item.get("claimed_at"))} | declared focus: '
                + (f'"{declared.get("goal")}" ({declared.get("age")})' if declared else "none")
                + f' | {assignment.get("note")}'
            )
        else:
            print(f'session: none [{payload.get("recipient_state")}] {payload.get("reason")}')
        obligations = payload.get("obligations") or []
        print(f"obligations: {len(obligations)} open")
        for item_view in obligations:
            stale = (item_view.get("delivery") or {}).get("stale")
            print(
                f'  {item_view["id"]} {item_view.get("kind")} {item_view.get("path")} from {item_view.get("owner")}: '
                f'stage {item_view.get("stage")}' + (f'; STALE {stale.get("reason")}' if stale else "")
            )
        return 0

    if args.command == "history":
        events = store.history(peer=args.peer, limit=args.limit)
        if args.json:
            return print_payload({"success": True, "tool": "coord", "events": events}, True)
        if not events:
            print("No history.")
            return 0
        for event in events:
            label = event.get("agent_alias") or event.get("agent_id")
            print(f'{event.get("created_at")} {event.get("kind")} {label}: {event.get("summary")}')
        return 0

    if args.command == "publish":
        if args.publish_command == "add":
            payload = store.add_publish(args.key, args.status, args.summary, args.ref, file_path=args.file_path)
            return print_payload({"success": True, "tool": "coord", "publish": payload}, args.json)
        if args.publish_command == "clear":
            ok, payload = store.clear_publish(args.key)
            if not ok:
                return error(f"No active publish for {args.key}", args.json, code=2)
            return print_payload({"success": True, "tool": "coord", "cleared": payload}, args.json)
        return error("publish requires add|clear", args.json, code=2)

    print(HELP)
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
