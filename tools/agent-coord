    name.strip().lower()
    for name in os.environ.get("AGENT_DO_COORD_ANCHOR_NAMES", "").split(",")
    if name.strip()
}


def process_table() -> dict[int, tuple[int, str]]:
    completed = subprocess.run(
        ["ps", "-axo", "pid=,ppid=,comm="],
        text=True,
        capture_output=True,
        check=False,
    )
    table: dict[int, tuple[int, str]] = {}
    if completed.returncode != 0:
        return table
    for line in completed.stdout.splitlines():
        parts = line.split(None, 2)
        if len(parts) < 3:
            continue
        try:
            table[int(parts[0])] = (int(parts[1]), parts[2].strip())
        except ValueError:
            continue
    return table


def find_anchor_pid() -> int:
    """The long-lived process this agent session hangs off.

    Agent harnesses spawn a fresh shell per command (its own session leader,
    gone seconds later), so os.getsid(0) is unusable there: it would mint a
    new identity per call and record a pid that immediately dies. Walk the
    ancestry to the nearest process named like an agent runtime instead;
    plain interactive shells fall back to the session leader (the pane shell).
    """
    table = process_table()
    pid = os.getpid()
    for _ in range(25):
        entry = table.get(pid)
        if entry is None:
            break
        ppid, comm = entry
        name = os.path.basename(comm).lstrip("-").lower()
        if pid != os.getpid() and name in ANCHOR_RUNTIME_NAMES:
            return pid
        if ppid <= 1:
            break
        pid = ppid
    try:
        return os.getsid(0)
    except OSError:
        return os.getppid()


def process_anchor() -> dict[str, Any]:
    """Anchor process for identity + liveness: pid + start time + display hints."""
    pid_env = os.environ.get("AGENT_DO_COORD_PID")
    pid: int | None = None
    if pid_env:
        try:
            pid = int(pid_env)
        except ValueError:
            pid = None
    if pid is None:
        pid = find_anchor_pid()
    start = os.environ.get("AGENT_DO_COORD_PID_START") or ps_lstart(pid) or ""
    return {
        "pid": pid,
        "pid_start": start,
        "pane": os.environ.get("TMUX_PANE"),
        "host": socket.gethostname(),
    }


def process_liveness(record: dict[str, Any]) -> bool | None:
    """True = verified alive, False = verified gone/reused, None = unverifiable."""
    pid = record.get("pid")
    if pid is None:
        return None
    host = record.get("host")
    if host and host != socket.gethostname():
        return None
    try:
        pid = int(pid)
    except (TypeError, ValueError):
        return None
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        pass
    except OSError:
        return None
    expected_start = record.get("pid_start")
    if expected_start:
        current_start = ps_lstart(pid)
        if current_start and current_start != expected_start:
            return False
    return True


def detect_runtime(identity_source: str) -> str:
    override = os.environ.get("AGENT_DO_COORD_RUNTIME")
    if override in RUNTIMES:
        return override
    if identity_source.startswith("CODEX"):
        return "codex"
    if identity_source.startswith("CLAUDE") or os.environ.get("CLAUDECODE"):
        return "claude"
    return "other"


def derive_identity(coord_root: Path, anchor: dict[str, Any]) -> dict[str, str | None]:
    explicit = os.environ.get("AGENT_DO_COORD_SESSION")
    if explicit:
        short = compact(explicit)[:12]
        if short:
            return {
                "agent_id": f"session-{short}",
                "source": "AGENT_DO_COORD_SESSION",
                "raw": explicit,
                "session": explicit,
            }

    for prefix, env_key in THREAD_CANDIDATES:
        value = os.environ.get(env_key)
        if not value:
            continue
        short = compact(value)
        if short:
            return {"agent_id": f"{prefix}-{short}", "source": env_key, "raw": value, "session": None}

    # Pane/host fallback: mint a session UUID at first contact, keyed by the
    # anchoring process, so a recycled pane never inherits a dead session's identity.
    scope = anchor.get("pane") or anchor.get("host") or "local"
    anchor_key = f"{scope}|{anchor.get('pid')}|{anchor.get('pid_start')}"
    session = mint_session(coord_root, anchor_key)
    source = "TMUX_PANE+process" if anchor.get("pane") else "host+process"
    return {
        "agent_id": f"session-{session[:12]}",
        "source": source,
        "raw": anchor_key,
        "session": session,
    }


def mint_session(coord_root: Path, anchor_key: str) -> str:
    coord_root.mkdir(parents=True, exist_ok=True)
    sessions_path = coord_root / "sessions.json"
    lock_path = coord_root / ".lock"
    with lock_path.open("a+") as fh:
        fcntl.flock(fh.fileno(), fcntl.LOCK_EX)
        try:
            payload: dict[str, Any] = {"anchors": {}}
            if sessions_path.exists():
                try:
                    loaded = json.loads(sessions_path.read_text())
                    if isinstance(loaded, dict) and isinstance(loaded.get("anchors"), dict):
                        payload = loaded
                except json.JSONDecodeError:
                    pass
            anchors = payload["anchors"]
            entry = anchors.get(anchor_key)
            if isinstance(entry, dict) and isinstance(entry.get("session"), str) and entry["session"]:
                return entry["session"]
            session = uuid.uuid4().hex
            anchors[anchor_key] = {"session": session, "created_at": now_iso()}
            tmp = sessions_path.with_suffix(".json.tmp")
            tmp.write_text(json.dumps(payload, indent=2, sort_keys=True) + "\n")
            tmp.replace(sessions_path)
            return session
        finally:
            fcntl.flock(fh.fileno(), fcntl.LOCK_UN)


def normalize_path(project_root: Path, cwd: Path, value: str) -> str:
    raw = value.strip()
    if not raw:
        return raw
    candidate = Path(raw)
    if candidate.is_absolute():
        try:
            return candidate.resolve(strict=False).relative_to(project_root).as_posix()
        except ValueError:
            return candidate.as_posix()
    try:
        return (cwd / candidate).resolve(strict=False).relative_to(project_root).as_posix()
    except ValueError:
        return Path(os.path.normpath(raw)).as_posix()


def path_overlaps(a: str, b: str) -> bool:
    if not a or not b:
        return False
    if a == b:
        return True
    if a == "." or b == ".":
        return True
    return a.startswith(f"{b}/") or b.startswith(f"{a}/")


def classify_presence(record: dict[str, Any]) -> str:
    if record.get("dead"):
        return "dead"
    if record.get("stopped"):
        return "stopped"
    if process_liveness(record) is False:
        return "dead"
    lease_expires_at = parse_iso(record.get("lease_expires_at"))
    if lease_expires_at and now() <= lease_expires_at:
        return "active"
    last_seen = parse_iso(record.get("last_seen"))
    if last_seen is None:
        return "unknown"
    if (now() - last_seen).total_seconds() <= IDLE_WINDOW_SECONDS:
        return "idle"
    return "stale"


def clip(value: Any, limit: int) -> str | None:
    """Whitespace-normalized truncation with an honest marker, never a bare cut."""
    if not isinstance(value, str):
        return None
    text = " ".join(value.split())
    if not text:
        return None
    if len(text) <= limit:
        return text
    return text[: max(0, limit - 1)].rstrip() + "…"


def reduce_pulse(existing: dict[str, Any] | None, payload: dict[str, Any]) -> dict[str, Any] | None:
    """Fold one harness hook payload into a session's pulse state.

    Returns the updated state, or None for events that carry nothing for the
    pulse — unknown hook names are ignored so newer harnesses stay harmless.
    """
    event = payload.get("hook_event_name")
    if not isinstance(event, str):
        return None
    state = dict(existing or {})

    if event == "UserPromptSubmit":
        state["status"] = "working"
        prompt = clip(payload.get("prompt"), PULSE_PROMPT_CHARS)
        if prompt:
            state["latest_prompt"] = prompt
        state["turns"] = int(state.get("turns", 0) or 0) + 1
        state.pop("attention", None)
        state.pop("activity", None)
    elif event == "PreToolUse":
        state["status"] = "working"
        tool = clip(payload.get("tool_name"), PULSE_DETAIL_CHARS)
        if tool:
            state["activity"] = tool
        state.pop("attention", None)
    elif event == "PostToolUse":
        state["status"] = "working"
        if payload.get("tool_name") == "TodoWrite":
            todos = (payload.get("tool_input") or {}).get("todos")
            if isinstance(todos, list):
                rows = [item for item in todos if isinstance(item, dict)]
                current = next(
                    (item.get("content") for item in rows if item.get("status") == "in_progress"),
                    None,
                ) or next(
                    (item.get("content") for item in rows if item.get("status") == "pending"),
                    None,
                )
                state["todo"] = {
                    "done": sum(1 for item in rows if item.get("status") == "completed"),
                    "total": len(rows),
                    "current": clip(current, PULSE_DETAIL_CHARS),
                }
        state.pop("attention", None)
    elif event == "Notification":
        state["status"] = "needs-user"
        state["attention"] = {"message": clip(payload.get("message"), PULSE_PROMPT_CHARS)}
    elif event == "Stop":
        state["status"] = "finished"
        state.pop("activity", None)
        state.pop("attention", None)
    elif event == "StopFailure":
        state["status"] = "failed"
        state.pop("activity", None)
    elif event == "SessionEnd":
        state["status"] = "ended"
        state.pop("activity", None)
        state.pop("attention", None)
    else:
        return None

    state["updated_at"] = now_iso()
    state["event_count"] = int(state.get("event_count", 0) or 0) + 1
    return state


def pulse_agent_id(session_key: str) -> str:
    """Map a full harness session id or coord session key to its pulse row."""
    raw = session_key.strip()
    if raw.startswith("session-"):
        raw = raw[len("session-") :]
    short = compact(raw)[:12]
    if not short:
        raise ValueError("session must contain at least one letter or number")
    return f"session-{short}"


def normalize_pulse_timestamp(value: str) -> str:
    """Validate an external observation timestamp and normalize it to UTC."""
    parsed = parse_iso(value.strip())
    if parsed is None or parsed.tzinfo is None:
        raise ValueError("updated-at must be an RFC 3339 timestamp with a timezone")
    return parsed.astimezone(timezone.utc).isoformat().replace("+00:00", "Z")


def format_age(value: str | None) -> str:
    seconds = age_seconds(value)
    if seconds is None:
        return "unknown age"
    if seconds < 60:
        return f"{seconds}s ago"
    if seconds < 3600:
        return f"{seconds // 60}m ago"
    if seconds < 86400:
        return f"{seconds // 3600}h ago"
    return f"{seconds // 86400}d ago"


ITEM_TARGET_PREFIX = "item:"

# One manna read gets the same per-call bound the prompt-router gives coord
# itself inside Claude Code's five-second hook budget
# (hooks/claude/agent-do-prompt-router.py, run_bounded timeout=2.0).
MANNA_READ_BUDGET_SECONDS = float(os.environ.get("AGENT_DO_COORD_MANNA_BUDGET_SECONDS", "2"))


def manna_program() -> list[str] | None:
    """The manna CLI: beside this tool, else under the recorded install path, else on PATH."""
    candidates = [Path(__file__).resolve().parent / "agent-manna" / "agent-manna"]
    breadcrumb = Path.home() / ".agent-do" / "install-path"
    if breadcrumb.is_file():
        try:
            candidates.append(Path(breadcrumb.read_text().strip()) / "tools" / "agent-manna" / "agent-manna")
        except OSError:
            pass
    for candidate in candidates:
        if candidate.is_file() and os.access(candidate, os.X_OK):
            return [str(candidate)]
    agent_do = shutil.which("agent-do")
    return [agent_do, "manna"] if agent_do else None


def run_manna(args: list[str], *, cwd: Path, env: dict[str, str] | None = None) -> tuple[int | None, str, str]:
    program = manna_program()
    if program is None:
        return None, "", "manna not found beside agent-coord, under the install path, or on PATH"
    try:
        completed = subprocess.run(
            [*program, *args],
            cwd=str(cwd),
            env=env,
            text=True,
            capture_output=True,
            check=False,
            timeout=MANNA_READ_BUDGET_SECONDS,
        )
    except subprocess.TimeoutExpired:
        return None, "", f"manna {' '.join(args)} did not answer within {MANNA_READ_BUDGET_SECONDS:g}s"
    except OSError as exc:
        return None, "", f"manna {' '.join(args)} could not start: {exc}"
    return completed.returncode, completed.stdout, completed.stderr


def manna_json(args: list[str], *, cwd: Path, env: dict[str, str] | None = None) -> tuple[dict[str, Any] | None, str | None]:
    """A successful manna JSON payload, or the refusal manna printed (never a guess)."""
    code, out, err = run_manna(args, cwd=cwd, env=env)
    if code is None:
        return None, err
    payload: Any = None
    try:
        payload = json.loads(out) if out.strip() else None
    except json.JSONDecodeError:
        payload = None
    if isinstance(payload, dict) and payload.get("success"):
        return payload, None
    message = payload.get("error") if isinstance(payload, dict) else None
    if not isinstance(message, str) or not message:
        text = out.strip() or err.strip()
        # A refusal older binaries print as YAML: keep its error line.
        message = next(
            (line.split(":", 1)[1].strip() for line in text.splitlines() if line.startswith("error:")),
            text,
        ) or f"manna {' '.join(args)} exited {code}"
    return None, message


def manna_identity(env: dict[str, str] | None = None) -> dict[str, Any] | None:
    """This process's Manna session label and ownership proof, from the manna binary itself.

    The proof is the digest Manna derives under its machine-local key from the
    same opaque harness id the board stores as `claim_token_hash` on a claim.
    Coord never derives it; a label is never a proof.
    """
    payload, _ = manna_json(["identity", "--json"], cwd=Path.cwd(), env=env)
    if not payload:
        return None
    session = payload.get("session")
    proof = payload.get("proof")
    if not isinstance(session, str) or not session or not isinstance(proof, str) or not proof:
        return None
    return {
        "session": session,
        "proof": proof,
        "operator": bool(payload.get("operator")),
        "source": "manna identity --json in this process environment",
        "bound_at": now_iso(),
    }


def canonical_board_root(project_root: Path) -> tuple[Path, bool]:
    """The checkout whose `.manna/` is the board. A worktree carries a copy; the board lives with the common git dir."""

    def absolute(text: str | None) -> Path | None:
        if not text:
            return None
        path = Path(text)
        return (path if path.is_absolute() else project_root / path).resolve()

    git_dir = absolute(git_output(project_root, "rev-parse", "--git-dir"))
    common = absolute(git_output(project_root, "rev-parse", "--git-common-dir"))
    if git_dir and common and git_dir != common:
        return common.parent, True
    return project_root, False


# A digest is shown at the hex width a drop id carries (drp-<12 hex>), so the
# two read beside each other; the full value stays on the record.
DIGEST_PREFIX_HEX = len("drp-1a2b3c4d5e6f") - len("drp-")


def short_digest(value: Any) -> str:
    text = str(value or "")
    if text.startswith("sha256:"):
        return text[: len("sha256:") + DIGEST_PREFIX_HEX]
    return text[:DIGEST_PREFIX_HEX] if text else "none"


def approval_text(approval: dict[str, Any] | None) -> str:
    if not approval:
        return ""
    allows = "; ".join(str(item) for item in approval.get("allows", []))
    excludes = "; ".join(str(item) for item in approval.get("excludes", []))
    return (
        f" | approval scope as recorded: allows {allows}; excludes {excludes}; "
        f"authorized by {approval.get('authorized_by')}; work order {short_digest((approval.get('work_order') or {}).get('digest'))}; "
        f"routing confers nothing beyond it"
    )


def stale_recipient_remedy(drop: dict[str, Any], for_item: dict[str, Any]) -> str:
    """What the recipient of a stale assignment drop can do: nothing coord would refuse.

    Once the assignment has moved, `drop ack` and `drop resolve` are both
    refused for the recipient, so the guidance names only the owner's way
    out and the one read that re-checks the assignment.
    """
    noun = "approval" if drop.get("approval") else "drop"
    owner = drop.get("owner_label") or drop.get("owner")
    return (
        f"void for you: its recipient can neither acknowledge nor resolve a stale {noun}; "
        f"only its owner ({owner}) retires it or readdresses it, and you need a fresh {noun} "
        f"before relying on it; re-check: agent-do coord worker {for_item.get('id')}"
    )


def readdress_command(project_root: Path, drop: dict[str, Any], for_item: dict[str, Any]) -> str:
    """The exact `drop add` that re-pins this drop against the current assignment.

    Re-adding the owner's own path re-pins the claim, attempt and work order
    and bumps the revision (journaled as `readdressed`). The path is rendered
    absolute so the command works from any working directory.
    """
    parts = [
        "agent-do", "coord", "drop", "add",
        shlex.quote(str(project_root / str(drop.get("path") or ""))),
        "--for-item", str(for_item.get("id")),
    ]
    approval = drop.get("approval") if isinstance(drop.get("approval"), dict) else None
    if drop.get("kind") == "action" and not approval:
        parts.append("--action")
    if drop.get("note"):
        parts.extend(["--note", shlex.quote(str(drop["note"]))])
    if drop.get("key"):
        parts.extend(["--key", shlex.quote(str(drop["key"]))])
    if approval:
        for text in approval.get("allows", []):
            parts.extend(["--allows", shlex.quote(str(text))])
        for text in approval.get("excludes", []):
            parts.extend(["--excludes", shlex.quote(str(text))])
        parts.extend(["--authorized-by", shlex.quote(str(approval.get("authorized_by") or ""))])
    return " ".join(parts)


class CoordStore:
    def __init__(self, cwd: Path, *, identify: bool = True) -> None:
        paths = resolve_project_paths(cwd)
        self.cwd = cwd.resolve()
        self.project_root = Path(paths["project_root"])
        self.coord_root = Path(paths["coord_root"])
        self.storage = paths["storage"]

        self.coord_root.mkdir(parents=True, exist_ok=True)

        if identify:
            self.anchor = process_anchor()
            ident = derive_identity(self.coord_root, self.anchor)
            self.agent_id = str(ident["agent_id"])
            self.identity_source = str(ident["source"])
            self.identity_raw = ident["raw"]
            self.session = ident.get("session")
            self.runtime = detect_runtime(self.identity_source)
            self.model = os.environ.get("AGENT_DO_COORD_MODEL")
        else:
            # External pulse writers act on an explicit target key. They need
            # storage and the shared lock, but no caller identity or lease.
            self.anchor = {}
            self.agent_id = ""
            self.identity_source = ""
            self.identity_raw = None
            self.session = None
            self.runtime = "other"
            self.model = None

        self.agents_path = self.coord_root / "agents.json"
        self.focus_path = self.coord_root / "focus.json"
        self.claims_path = self.coord_root / "claims.json"
        self.needs_path = self.coord_root / "needs.json"
        self.publishes_path = self.coord_root / "publishes.json"
        self.drops_path = self.coord_root / "drops.json"
        self.pulse_path = self.coord_root / "pulse.json"
        self.bells_path = self.coord_root / "bells.json"
        self.events_path = self.coord_root / "events.jsonl"
        self.lock_path = self.coord_root / ".lock"
        # One board read per item per command; a view never re-reads the board.
        self._board_cache: dict[str, tuple[dict[str, Any] | None, dict[str, Any]]] = {}

    @contextmanager
    def locked(self, *, wait: bool = True):
        self.lock_path.parent.mkdir(parents=True, exist_ok=True)
        with self.lock_path.open("a+") as fh:
            fcntl.flock(fh.fileno(), fcntl.LOCK_EX | (0 if wait else fcntl.LOCK_NB))
            try:
                yield
            finally:
                fcntl.flock(fh.fileno(), fcntl.LOCK_UN)

    def _read_json(self, path: Path, default: Any) -> Any:
        if not path.exists():
            return default
        try:
            return json.loads(path.read_text())
        except json.JSONDecodeError:
            return default

    def _write_json(self, path: Path, payload: Any) -> None:
        path.parent.mkdir(parents=True, exist_ok=True)
        tmp = path.with_suffix(path.suffix + ".tmp")
        tmp.write_text(json.dumps(payload, indent=2, sort_keys=True) + "\n")
        tmp.replace(path)

    def _load_agents(self) -> dict[str, dict[str, Any]]:
        payload = self._read_json(self.agents_path, {"agents": {}})
        agents = payload.get("agents", {})
        return agents if isinstance(agents, dict) else {}

    def _save_agents(self, agents: dict[str, dict[str, Any]]) -> None:
        self._write_json(self.agents_path, {"agents": agents})

    def _load_focus(self) -> dict[str, dict[str, Any]]:
        payload = self._read_json(self.focus_path, {"focus": {}})
        focus = payload.get("focus", {})
        return focus if isinstance(focus, dict) else {}

    def _save_focus(self, focus: dict[str, dict[str, Any]]) -> None:
        self._write_json(self.focus_path, {"focus": focus})

    def _load_claims(self) -> list[dict[str, Any]]:
        payload = self._read_json(self.claims_path, {"claims": []})
        claims = payload.get("claims", [])
        return claims if isinstance(claims, list) else []

    def _save_claims(self, claims: list[dict[str, Any]]) -> None:
        self._write_json(self.claims_path, {"claims": claims})

    def _load_needs(self) -> list[dict[str, Any]]:
        payload = self._read_json(self.needs_path, {"needs": []})
        needs = payload.get("needs", [])
        return needs if isinstance(needs, list) else []

    def _save_needs(self, needs: list[dict[str, Any]]) -> None:
        self._write_json(self.needs_path, {"needs": needs})

    def _load_publishes(self) -> list[dict[str, Any]]:
        payload = self._read_json(self.publishes_path, {"publishes": []})
        publishes = payload.get("publishes", [])
        return publishes if isinstance(publishes, list) else []

    def _save_publishes(self, publishes: list[dict[str, Any]]) -> None:
        self._write_json(self.publishes_path, {"publishes": publishes})

    def _save_drops(self, drops: list[dict[str, Any]]) -> None:
        self._write_json(self.drops_path, {"drops": drops})

    def _load_pulse(self) -> dict[str, dict[str, Any]]:
        payload = self._read_json(self.pulse_path, {"pulse": {}})
        pulse = payload.get("pulse", {})
        return pulse if isinstance(pulse, dict) else {}

    def _save_pulse(self, pulse: dict[str, dict[str, Any]]) -> None:
        self._write_json(self.pulse_path, {"pulse": pulse})

    def _load_bells(self) -> dict[str, bool]:
        payload = self._read_json(self.bells_path, {})
        # Reject content-bearing/corrupt state instead of forwarding any of it.
        if not isinstance(payload, dict) or any(value is not True for value in payload.values()):
            return {}
        return payload

    def _ring_locked(self, agent_id: str | None) -> bool:
        """Best-effort advisory write AFTER the ledger commit, under its lock."""
        if agent_id is None:
            return False
        try:
            agents = self._load_agents()
            target = agents.get(agent_id)
            if not target or classify_presence(target) not in {"active", "idle"}:
                return False
            # No per-peer process probes on a ledger write. Remove only records
            # already pruned by coord; check the addressed session's liveness.
            bells = {key: True for key in self._load_bells() if key in agents}
            bells[agent_id] = True
            self._write_json(self.bells_path, bells)
            return True
        except Exception:
            # Attention may degrade to polling; a ledger write must still succeed.
            return False

    def ring(self, target: str) -> bool:
        try:
            with self.locked(wait=False):
                agent_id, _ = self._resolve_peer(target)
                return self._ring_locked(agent_id)
        except Exception:
            return False

    def take_bell(self, session: str) -> bool:
        """Match the hook's exact session, never an inherited process identity.

        Legacy thread IDs and pinned session IDs can name the same harness
        session. Consume their bits together without creating or reviving peers.
        The shared lock serializes this read/clear with all ledger writers.
        """
        with self.locked(wait=False):
            agents = self._load_agents()
            targets = {
                key for key, record in agents.items()
                if session in (record.get("session"), record.get("identity_raw"))
            }
            bells = self._load_bells()
            pending = targets & bells.keys()
            if not pending:
                return False
            deliver = any(classify_presence(agents[key]) in {"active", "idle"} for key in pending)
            self._write_json(self.bells_path, {key: True for key in bells if key not in targets})
            return deliver

    def _load_events(self) -> list[dict[str, Any]]:
        if not self.events_path.exists():
            return []
        events: list[dict[str, Any]] = []
        for line in self.events_path.read_text().splitlines():
            if not line.strip():
                continue
            try:
                event = json.loads(line)
            except json.JSONDecodeError:
                continue
            if isinstance(event, dict):
                events.append(event)
        events.sort(key=lambda item: int(item.get("seq", 0)))
        return events

    def _append_event(
        self,
        *,
        kind: str,
        paths: list[str] | None = None,
        keys: list[str] | None = None,
        summary: str,
        extra: dict[str, Any] | None = None,
    ) -> dict[str, Any]:
        events = self._load_events()
        seq = (max((int(item.get("seq", 0)) for item in events), default=0) + 1)
        self_record = self.self_record(refresh=False)
        event = {
            "seq": seq,
            "id": f"evt_{seq:06d}",
            "kind": kind,
            "agent_id": self.agent_id,
            "agent_alias": self_record.get("alias"),
            "paths": paths or [],
            "keys": keys or [],
            "summary": summary,
            "created_at": now_iso(),
        }
        if extra:
            # Structured facts ride beside the summary (drop ids, reasons,
            # evidence) so history can filter without parsing prose.
            event.update({key: value for key, value in extra.items() if key not in event})
        with self.events_path.open("a") as fh:
            fh.write(json.dumps(event, sort_keys=True) + "\n")
        return event

    def _resolve_peer(self, token: str | None) -> tuple[str | None, str | None]:
        if token is None:
            return None, None
        agents = self._load_agents()
        if token in agents:
            return token, agents[token].get("alias")
        for agent_id, record in agents.items():
            alias = record.get("alias")
            if isinstance(alias, str) and alias == token:
                return agent_id, alias
        return token, token

    def _tombstone_superseded(self, agents: dict[str, dict[str, Any]]) -> None:
        """A pane now anchored to a new process marks its previous occupants DEAD."""
        pane = self.anchor.get("pane")
        if not pane:
            return
        for agent_id, record in agents.items():
            if agent_id == self.agent_id or record.get("dead"):
                continue
            record_pane = record.get("pane")
            v1_pane = record.get("identity_raw") if record.get("identity_source") == "TMUX_PANE" else None
            if pane not in (record_pane, v1_pane):
                continue
            if process_liveness(record) is not True:
                record["dead"] = True
                record["superseded_by"] = self.agent_id
                record["tombstoned_at"] = now_iso()

    def _prune(
        self,
        agents: dict[str, dict[str, Any]],
    ) -> list[str]:
        pruned: list[str] = []
        for agent_id, record in list(agents.items()):
            if agent_id == self.agent_id:
                continue
            reference = record.get("tombstoned_at") or record.get("stopped_at") or record.get("last_seen")
            age = age_seconds(reference)
            if age is None:
                continue
            if (record.get("dead") or record.get("stopped")) and age > TOMBSTONE_SECONDS:
                agents.pop(agent_id)
                pruned.append(agent_id)
            elif age > TOMBSTONE_SECONDS and process_liveness(record) is False:
                # Unflagged but verifiably gone — same aging as tombstones.
                agents.pop(agent_id)
                pruned.append(agent_id)
            elif age > PRUNE_SECONDS:
                agents.pop(agent_id)
                pruned.append(agent_id)
        return pruned

    def _cascade_prune(self, pruned: list[str]) -> None:
        if not pruned:
            return
        gone = set(pruned)
        focus = self._load_focus()
        remaining_focus = {agent_id: record for agent_id, record in focus.items() if agent_id not in gone}
        if len(remaining_focus) != len(focus):
            self._save_focus(remaining_focus)
        claims = self._load_claims()
        remaining_claims = [item for item in claims if item.get("owner") not in gone]
        if len(remaining_claims) != len(claims):
            self._save_claims(remaining_claims)
        pulse = self._load_pulse()
        remaining_pulse = {agent_id: record for agent_id, record in pulse.items() if agent_id not in gone}
        if len(remaining_pulse) != len(pulse):
            self._save_pulse(remaining_pulse)

    def _bind_manna_identity(self, existing: dict[str, Any] | None) -> dict[str, Any] | None:
        """Ask the manna binary who this process is; keep an earlier binding when it cannot say."""
        binding = manna_identity()
        if binding:
            return binding
        previous = (existing or {}).get("manna")
        return previous if isinstance(previous, dict) and previous.get("proof") else None

    def register_self(self, *, bind: bool = False) -> dict[str, Any]:
        # The manna read happens outside the lock (manna takes its own board
        # lock and the hooks bound every coord call). First contact binds;
        # `touch` and `whoami` refresh.
        existing = self._load_agents().get(self.agent_id)
        binding: dict[str, Any] | None = None
        has_proof = isinstance(existing, dict) and isinstance(existing.get("manna"), dict) and bool(existing["manna"].get("proof"))
        # Until a proof is bound every call retries: a hook process without the
        # session's env fails fast and leaves nothing, so the shell's first
        # coord call (focus, claim, touch) is the one that binds.
        bind_now = bind or not has_proof
        if bind_now:
            binding = self._bind_manna_identity(existing)
        with self.locked():
            agents = self._load_agents()
            current = agents.get(self.agent_id, {})
            current.update(
                {
                    "agent_id": self.agent_id,
                    "last_seen": now_iso(),
                    "lease_expires_at": datetime.fromtimestamp(
                        now().timestamp() + ACTIVE_WINDOW_SECONDS, tz=timezone.utc
                    ).replace(microsecond=0).isoformat().replace("+00:00", "Z"),
                    "project_root": str(self.project_root),
                    "identity_source": self.identity_source,
                    "pid": self.anchor.get("pid"),
                    "pid_start": self.anchor.get("pid_start"),
                    "host": self.anchor.get("host"),
                    "runtime": self.runtime,
                }
            )
            if self.anchor.get("pane"):
                current["pane"] = self.anchor["pane"]
            if self.session:
                current["session"] = self.session
            if self.model:
                current["model"] = self.model
            if self.identity_raw:
                current["identity_raw"] = self.identity_raw
            if bind_now:
                # A binding is written only when manna produced one in this
                # process; a hook process without the session's env keeps the
                # shell's binding rather than erasing it.
                current["manna"] = binding
            for revived_key in ("dead", "superseded_by", "tombstoned_at", "stopped", "stopped_at", "stop_note"):
                current.pop(revived_key, None)
            agents[self.agent_id] = current
            self._tombstone_superseded(agents)
            pruned = self._prune(agents)
            self._save_agents(agents)
            self._cascade_prune(pruned)
            return current

    def self_record(self, refresh: bool = True) -> dict[str, Any]:
        if refresh:
            self.register_self()
        return self._load_agents().get(self.agent_id, {"agent_id": self.agent_id})

    def alias_self(self, alias: str) -> dict[str, Any]:
        current = self.register_self()
        with self.locked():
            agents = self._load_agents()
            current = agents.get(self.agent_id, current)
            current["alias"] = alias
            agents[self.agent_id] = current
            self._save_agents(agents)
            return current

    def aliases(self) -> list[dict[str, Any]]:
        self.register_self()
        aliases: list[dict[str, Any]] = []
        for agent_id, record in sorted(self._load_agents().items()):
            alias = record.get("alias")
            if not isinstance(alias, str) or not alias:
                continue
            aliases.append(
                {
                    "agent_id": agent_id,
                    "alias": alias,
                    "status": classify_presence(record),
                    "current": agent_id == self.agent_id,
                }
            )
        return aliases

    def focus_map(self) -> dict[str, dict[str, Any]]:
        return self._load_focus()

    def focus_for(self, token: str | None = None) -> dict[str, Any] | None:
        agent_id = self.agent_id if token is None else self._resolve_peer(token)[0]
        if not agent_id:
            return None
        return self.focus_map().get(agent_id)

    def set_focus(
        self,
        goal: str,
        paths: list[str],
        phase: str | None = None,
        note: str | None = None,
        blocking_on: list[str] | None = None,
        last_ship: str | None = None,
        branch: str | None = None,
    ) -> dict[str, Any]:
        self.register_self()

        def resolve_text(value: str | None, previous: Any) -> str | None:
            if value is None:
                return previous if isinstance(previous, str) and previous else None
            return value or None

        with self.locked():
            focus = self._load_focus()
            existing = focus.get(self.agent_id, {})
            if paths:
                normalized = sorted(
                    {normalize_path(self.project_root, self.cwd, path) for path in paths if path.strip()}
                )
            else:
                normalized = [str(item) for item in existing.get("paths", [])]
            resolved_phase = phase or existing.get("phase") or "building"
            if blocking_on is None:
                resolved_blocking = [str(item) for item in existing.get("blocking_on", [])]
            else:
                resolved_blocking = [item for item in blocking_on if item.strip()]
            payload = {
                "agent_id": self.agent_id,
                "alias": self.self_record(refresh=False).get("alias"),
                "goal": goal,
                "phase": resolved_phase,
                "paths": normalized,
                "note": resolve_text(note, existing.get("note")),
                "blocking_on": resolved_blocking,
                "last_ship": resolve_text(last_ship, existing.get("last_ship")),
                "branch": normalize_branch(resolve_text(branch, existing.get("branch"))),
                "updated_at": now_iso(),
            }
            focus[self.agent_id] = payload
            self._save_focus(focus)
            self._append_event(
                kind="focus_set",
                paths=normalized,
                summary=f"{payload.get('alias') or self.agent_id} set focus: {goal} [phase:{resolved_phase}]",
            )
        return payload

    def pulse_map(self) -> dict[str, dict[str, Any]]:
        return self._load_pulse()

    def pulse_for(self, token: str | None = None) -> dict[str, Any] | None:
        pulse = self.pulse_map()
        agent_id = self.agent_id if token is None else self._resolve_peer(token)[0]
        if not agent_id:
            return None
        record = pulse.get(agent_id)
        if record is not None or token is None or agent_id != token:
            return record
        try:
            return pulse.get(pulse_agent_id(token))
        except ValueError:
            return None

    def record_pulse(self, payload: dict[str, Any]) -> dict[str, Any] | None:
        """Reduce one hook payload into this agent's pulse row.

        Telemetry, not coordination: no event-journal entry — pulse fires per
        tool call and would drown the journal that peers actually read.
        """
        self.register_self()
        with self.locked():
            pulse = self._load_pulse()
            updated = reduce_pulse(pulse.get(self.agent_id), payload)
            if updated is None:
                return None
            updated["agent_id"] = self.agent_id
            pulse[self.agent_id] = updated
            self._save_pulse(pulse)
            return updated

    def record_explicit_pulse(
        self,
        session_key: str,
        status: str,
        updated_at: str,
        activity: str | None,
        clear_activity: bool,
    ) -> tuple[dict[str, Any], bool]:
        """Merge a supervisor verdict without claiming the target's liveness.

        All writers share the coord lock. Status and updated_at are replaced;
        activity is replaced only when explicitly supplied or cleared. Hook-owned
        fields such as latest_prompt, todo, turns, and event_count survive.
        """
        agent_id = pulse_agent_id(session_key)
        timestamp = normalize_pulse_timestamp(updated_at)
        with self.locked():
            pulse = self._load_pulse()
            existing = pulse.get(agent_id)
            state = dict(existing or {})
            state["agent_id"] = agent_id
            state["status"] = status
            state["updated_at"] = timestamp
            if clear_activity:
                state.pop("activity", None)
            elif activity is not None:
                detail = clip(activity, PULSE_DETAIL_CHARS)
                if detail:
                    state["activity"] = detail
                else:
                    state.pop("activity", None)
            changed = state != existing
            if changed:
                pulse[agent_id] = state
                self._save_pulse(pulse)
            return state, changed

    def branch_mismatch(self, focus: dict[str, Any] | None = None) -> dict[str, Any] | None:
        """A lane declaring a branch this working tree is not on must isolate.

        One working tree holds one branch, so unlike overlapping ownership this
        is not a preference: no split of paths makes this checkout serve both.
        """
        if not ISOLATION_NUDGE:
            return None
        record = focus if focus is not None else (self.focus_for() or {})
        declared = normalize_branch(record.get("branch"))
        if not declared:
            return None
        head = checkout_branch(self.project_root)
        if not head or head == declared:
            return None
        return {"declared": declared, "head": head, "remedy": branch_remedy(declared)}

    def concurrent_builder_nudge(self, focus: dict[str, Any] | None = None) -> dict[str, Any] | None:
        """Warn a building writer when another active writer builds in this checkout."""
        if not ISOLATION_NUDGE:
            return None
        record = focus if focus is not None else (self.focus_for() or {})
        if record.get("phase") != "building":
            return None
        agents = self._load_agents()
        if self._record_mode(agents.get(self.agent_id, {})) != "writer":
            return None

        builders = [
            peer
            for peer in self.peers(include_stale=False)
            if not peer["current"]
            and peer["status"] == "active"
            and peer.get("mode") == "writer"
            and (peer.get("focus") or {}).get("phase") == "building"
        ]
        if not builders:
            return None
        builders.sort(key=lambda peer: str(peer["agent_id"]))
        peer_ids = [str(peer["agent_id"]) for peer in builders]
        peer_labels = [str(peer.get("alias") or peer["agent_id"]) for peer in builders]
        count = len(builders)
        noun = "writer" if count == 1 else "writers"
        verb = "shares" if count == 1 else "share"
        summary = (
            f"{count} other active building {noun} already {verb} this checkout "
            f"({', '.join(peer_labels)}); compile state and build artifacts are shared "
            "even when source paths are disjoint"
        )
        remedy = concurrent_builder_remedy()
        return {
            "count": count,
            "peers": peer_ids,
            "peer_labels": peer_labels,
            "summary": with_remedy(summary, remedy),
            "remedy": remedy,
        }

    def clear_focus(self) -> dict[str, Any] | None:
        self.register_self()
        with self.locked():
            focus = self._load_focus()
            existing = focus.pop(self.agent_id, None)
            self._save_focus(focus)
            if existing:
                self._append_event(
                    kind="focus_clear",
                    paths=existing.get("paths", []),
                    summary=f"{existing.get('alias') or self.agent_id} cleared focus",
                )
            return existing

    def peers(
        self,
        include_stale: bool = False,
        active_only: bool = False,
        writers_only: bool = False,
    ) -> list[dict[str, Any]]:
        self.register_self()
        focus = self.focus_map()
        pulse_map = self.pulse_map()
        peers: list[dict[str, Any]] = []
        for agent_id, record in sorted(self._load_agents().items()):
            status = classify_presence(record)
            if status == "stale" and not include_stale:
                continue
            if active_only and status != "active":
                continue
            mode = record.get("role_mode") or "writer"
            if writers_only and (status not in {"active", "idle"} or mode != "writer"):
                continue
            peer_focus = focus.get(agent_id)
            peer = {
                "agent_id": agent_id,
                "alias": record.get("alias"),
                "status": status,
                "last_seen": record.get("last_seen"),
                "age": format_age(record.get("last_seen")),
                "age_seconds": age_seconds(record.get("last_seen")),
                "lease_expires_at": record.get("lease_expires_at"),
                "current": agent_id == self.agent_id,
                "runtime": record.get("runtime"),
                "model": record.get("model"),
                "pane": record.get("pane"),
                "role": record.get("role"),
                "mode": mode,
                "territory": self._record_territory(record),
                "phase": (peer_focus or {}).get("phase"),
                "focus": peer_focus,
                "pulse": pulse_map.get(agent_id),
            }
            if record.get("stop_note"):
                peer["stop_note"] = record["stop_note"]
            peers.append(peer)
        status_rank = {"active": 0, "idle": 1, "stopped": 2, "dead": 3, "stale": 4}

        def sort_key(item: dict[str, Any]) -> tuple[int, int, int, int, str]:
            presence = str(item.get("status"))
            live = presence in {"active", "idle"}
            # Attention-first among the living; the retired and the dead keep
            # their presence order. Trust latch: only a peer with a pulse row
            # may claim a fine-grained state — no pulse ranks as plain alive.
            pulse_status = str((item.get("pulse") or {}).get("status") or "")
            rank = PULSE_RANK.get(pulse_status, PULSE_RANK_NO_PULSE) if live else PULSE_RANK_NO_PULSE
            return (
                0 if live else 1,
                rank,
                status_rank.get(presence, 9),
                0 if item.get("mode") == "writer" else 1,
                str(item.get("agent_id")),
            )

        peers.sort(key=sort_key)
        return peers

    def stop(self, note: str | None) -> dict[str, Any]:
        with self.locked():
            agents = self._load_agents()
            current = agents.get(self.agent_id, {"agent_id": self.agent_id})
            current["last_seen"] = now_iso()
            current["stopped"] = True
            current["stopped_at"] = now_iso()
            if note:
                current["stop_note"] = note
            agents[self.agent_id] = current
            self._save_agents(agents)
            focus = self._load_focus()
            existing_focus = focus.get(self.agent_id)
            if existing_focus:
                existing_focus["phase"] = "stopped"
                existing_focus["updated_at"] = now_iso()
                self._save_focus(focus)
            label = current.get("alias") or self.agent_id
            summary = f"{label} stopped" + (f": {note}" if note else "")
            self._append_event(kind="stop", summary=summary)
            return current

    def bye(self) -> dict[str, Any]:
        self.register_self()
        with self.locked():
            agents = self._load_agents()
            record = agents.pop(self.agent_id, None)
            self._save_agents(agents)
            focus = self._load_focus()
            focus.pop(self.agent_id, None)
            self._save_focus(focus)
            claims = self._load_claims()
            remaining_claims = [item for item in claims if item.get("owner") != self.agent_id]
            if len(remaining_claims) != len(claims):
                self._save_claims(remaining_claims)
            needs = self._load_needs()
            remaining_needs = [item for item in needs if item.get("owner") != self.agent_id]
            if len(remaining_needs) != len(needs):
                self._save_needs(remaining_needs)
            pulse = self._load_pulse()
            if pulse.pop(self.agent_id, None) is not None:
                self._save_pulse(pulse)
            label = (record or {}).get("alias") or self.agent_id
            self._append_event(kind="bye", summary=f"{label} left the board")
            return record or {"agent_id": self.agent_id}

    def claims(self) -> list[dict[str, Any]]:
        self.register_self()
        claims = self._load_claims()
        agents = self._load_agents()
        for claim in claims:
            owner = claim.get("owner")
            owner_record = agents.get(str(owner), {})
            claim["owner_status"] = classify_presence(owner_record) if owner_record else "unknown"
        claims.sort(key=lambda item: item.get("path", ""))
        return claims

    def claim(self, path: str, reason: str | None, strength: str) -> tuple[bool, dict[str, Any] | None, str | None]:
        self.register_self()
        normalized = normalize_path(self.project_root, self.cwd, path)
        alias = self.self_record(refresh=False).get("alias")
        with self.locked():
            claims = self._load_claims()
            for existing in claims:
                if existing.get("path") != normalized:
                    continue
                if existing.get("owner") == self.agent_id:
                    existing["reason"] = reason
                    existing["strength"] = strength
                    existing["updated_at"] = now_iso()
                    self._save_claims(claims)
                    self._append_event(
                        kind="claim",
                        paths=[normalized],
                        summary=f"{alias or self.agent_id} updated claim on {normalized}",
                    )
                    return True, existing, None
                owner = existing.get("owner_alias") or existing.get("owner")
                return False, existing, f"{normalized} is already claimed by {owner}"

            claim = {
                "path": normalized,
                "owner": self.agent_id,
                "owner_alias": alias,
                "reason": reason,
                "strength": strength,
                "created_at": now_iso(),
                "updated_at": now_iso(),
            }
            claims.append(claim)
            self._save_claims(claims)
            self._append_event(
                kind="claim",
                paths=[normalized],
                summary=f"{alias or self.agent_id} claimed {normalized}",
            )
            return True, claim, None

    def release(self, path: str) -> tuple[bool, dict[str, Any] | None, str | None]:
        self.register_self()
        normalized = normalize_path(self.project_root, self.cwd, path)
        with self.locked():
            claims = self._load_claims()
            for existing in list(claims):
                if existing.get("path") != normalized:
                    continue
                if existing.get("owner") != self.agent_id:
                    owner = existing.get("owner_alias") or existing.get("owner")
                    return False, existing, f"{normalized} is owned by {owner}"
                claims.remove(existing)
                self._save_claims(claims)
                self._append_event(
                    kind="release",
                    paths=[normalized],
                    summary=f"{existing.get('owner_alias') or self.agent_id} released {normalized}",
                )
                return True, existing, None
            return False, None, f"No active claim for {normalized}"

    def needs(self, include_all: bool = False) -> list[dict[str, Any]]:
        self.register_self()
        needs = self._load_needs()
        if not include_all:
            needs = [item for item in needs if item.get("owner") == self.agent_id]
        needs.sort(key=lambda item: (item.get("key", ""), item.get("created_at", "")))
        return needs

    def add_need(self, key: str, why: str, from_token: str | None) -> dict[str, Any]:
        self.register_self()
        alias = self.self_record(refresh=False).get("alias")
        from_agent_id, from_alias = self._resolve_peer(from_token)
        with self.locked():
            needs = self._load_needs()
            existing = next(
                (
                    item
                    for item in needs
                    if item.get("owner") == self.agent_id and item.get("key") == key
                ),
                None,
            )
            if existing:
                existing.update(
                    {
                        "why": why,
                        "from": from_agent_id,
                        "from_alias": from_alias,
                        "updated_at": now_iso(),
                    }
                )
                payload = existing
            else:
                payload = {
                    "key": key,
                    "owner": self.agent_id,
                    "owner_alias": alias,
                    "why": why,
                    "from": from_agent_id,
                    "from_alias": from_alias,
                    "created_at": now_iso(),
                    "updated_at": now_iso(),
                }
                needs.append(payload)
            self._save_needs(needs)
            self._append_event(
                kind="need_add",
                keys=[key],
                summary=f"{alias or self.agent_id} needs {key}",
            )
            self._ring_locked(from_agent_id)
            return payload

    def clear_need(self, key: str) -> tuple[bool, dict[str, Any] | None]:
        self.register_self()
        with self.locked():
            needs = self._load_needs()
            for existing in list(needs):
                if existing.get("owner") == self.agent_id and existing.get("key") == key:
                    needs.remove(existing)
                    self._save_needs(needs)
                    self._append_event(
                        kind="need_clear",
                        keys=[key],
                        summary=f"{existing.get('owner_alias') or self.agent_id} cleared need {key}",
                    )
                    return True, existing
            return False, None

    def publishes(self) -> list[dict[str, Any]]:
        self.register_self()
        publishes = self._load_publishes()
        agents = self._load_agents()
        for publish in publishes:
            owner = str(publish.get("owner"))
            owner_record = agents.get(owner, {})
            publish["owner_status"] = classify_presence(owner_record) if owner_record else "unknown"
        publishes.sort(key=lambda item: (item.get("key", ""), item.get("updated_at", "")), reverse=False)
        return publishes

    def add_publish(
        self,
        key: str,
        status: str,
        summary: str,
        refs: list[str],
        file_path: str | None = None,
    ) -> dict[str, Any]:
        self.register_self()
        alias = self.self_record(refresh=False).get("alias")
        normalized_file = (
            normalize_path(self.project_root, self.cwd, file_path) if file_path else None
        )
        with self.locked():
            publishes = self._load_publishes()
            existing = next(
                (
                    item
                    for item in publishes
                    if item.get("owner") == self.agent_id and item.get("key") == key
                ),
                None,
            )
            if existing:
                existing.update(
                    {
                        "status": status,
                        "summary": summary,
                        "refs": refs,
                        "file": normalized_file or existing.get("file"),
                        "updated_at": now_iso(),
                    }
                )
                payload = existing
            else:
                payload = {
                    "key": key,
                    "owner": self.agent_id,
                    "owner_alias": alias,
                    "status": status,
                    "summary": summary,
                    "refs": refs,
                    "file": normalized_file,
                    "created_at": now_iso(),
                    "updated_at": now_iso(),
                }
                publishes.append(payload)
            self._save_publishes(publishes)
            self._append_event(
                kind="publish_add",
                keys=[key],
                summary=f"{alias or self.agent_id} published {key} ({status})",
            )
            return payload

    def clear_publish(self, key: str) -> tuple[bool, dict[str, Any] | None]:
        self.register_self()
        with self.locked():
            publishes = self._load_publishes()
            for existing in list(publishes):
                if existing.get("owner") == self.agent_id and existing.get("key") == key:
                    publishes.remove(existing)
                    self._save_publishes(publishes)
                    self._append_event(
                        kind="publish_clear",
                        keys=[key],
                        summary=f"{existing.get('owner_alias') or self.agent_id} cleared publish {key}",
                    )
                    return True, existing
            return False, None

    def _live_records(self, agents: dict[str, dict[str, Any]]) -> dict[str, dict[str, Any]]:
        return {
            agent_id: record
            for agent_id, record in agents.items()
            if agent_id != self.agent_id and classify_presence(record) in {"active", "idle"}
        }

    @staticmethod
    def _record_mode(record: dict[str, Any]) -> str:
        return str(record.get("role_mode") or "writer")

    @staticmethod
    def _record_territory(record: dict[str, Any]) -> list[str]:
        territory = record.get("territory")
        if not isinstance(territory, list):
            return []
        return [str(item) for item in territory if str(item)]

    def _territory_overlaps(
        self,
        mine: list[str],
        agents: dict[str, dict[str, Any]],
        mode: str = "writer",
    ) -> list[dict[str, Any]]:
        overlaps: list[dict[str, Any]] = []
        if not mine:
            return overlaps
        for agent_id, record in sorted(self._live_records(agents).items()):
            if self._record_mode(record) != mode:
                continue
            theirs = self._record_territory(record)
            shared = sorted(
                {
                    path
                    for own in mine
                    for other in theirs
                    if path_overlaps(own, other)
                    for path in (own, other)
                }
            )
            if not shared:
                continue
            overlaps.append(
                {
                    "peer": agent_id,
                    "peer_label": record.get("alias") or agent_id,
                    "paths": shared,
                }
            )
        return overlaps

    def set_role(
        self,
        role: str,
        mode: str | None,
        territory_paths: list[str],
    ) -> tuple[dict[str, Any], list[dict[str, Any]]]:
        self.register_self()
        resolved_mode = mode or ROLE_DEFAULT_MODES.get(role, "writer")
        normalized = sorted(
            {
                normalize_path(self.project_root, self.cwd, path)
                for path in territory_paths
                if path.strip()
            }
        )
        with self.locked():
            agents = self._load_agents()
            current = agents.get(self.agent_id, {"agent_id": self.agent_id})
            current["role"] = role
            current["role_mode"] = resolved_mode
            current["territory"] = normalized
            agents[self.agent_id] = current
            self._save_agents(agents)
            label = current.get("alias") or self.agent_id
            self._append_event(
                kind="role_set",
                paths=normalized,
                summary=f"{label} took role {role} ({resolved_mode}) over {', '.join(normalized) or 'no territory'}",
            )
            overlaps = (
                self._territory_overlaps(normalized, agents, mode="writer")
                if resolved_mode == "writer"
                else []
            )
        payload = {
            "agent_id": self.agent_id,
            "alias": current.get("alias"),
            "role": role,
            "mode": resolved_mode,
            "territory": normalized,
        }
        return payload, overlaps

    def territory_map(self) -> dict[str, Any]:
        self.register_self()
        agents = self._load_agents()
        territories: list[dict[str, Any]] = []
        writers: list[tuple[str, str, list[str]]] = []
        for agent_id, record in sorted(agents.items()):
            territory = self._record_territory(record)
            if not territory and not record.get("role"):
                continue
            status = classify_presence(record)
            mode = self._record_mode(record)
            label = record.get("alias") or agent_id
            territories.append(
                {
                    "agent_id": agent_id,
                    "label": label,
                    "role": record.get("role"),
                    "mode": mode,
                    "status": status,
                    "age": format_age(record.get("last_seen")),
                    "territory": territory,
                    "current": agent_id == self.agent_id,
                }
            )
            if mode == "writer" and territory and status in {"active", "idle"}:
                writers.append((agent_id, label, territory))
        overlaps: list[dict[str, Any]] = []
        for index, (agent_a, label_a, paths_a) in enumerate(writers):
            for agent_b, label_b, paths_b in writers[index + 1 :]:
                shared = sorted(
                    {
                        path
                        for own in paths_a
                        for other in paths_b
                        if path_overlaps(own, other)
                        for path in (own, other)
                    }
                )
                if shared:
                    overlaps.append(
                        {
                            "agents": [agent_a, agent_b],
                            "labels": [label_a, label_b],
                            "paths": shared,
                        }
                    )
        return {"territories": territories, "overlaps": overlaps}

    def _identity_group(self, agents: dict[str, dict[str, Any]] | None = None) -> dict[str, dict[str, Any]]:
        """My record and every record anchored to the same harness session.

        A session can carry two coord labels (a hook pinned to the session id
        beside a shell deriving from the thread id); they share `identity_raw`
        or `session`, never a prefix of each other's label.
        """
        agents = agents if agents is not None else self._load_agents()
        mine = agents.get(self.agent_id) or {}
        anchors = {value for value in (self.identity_raw, self.session, mine.get("identity_raw"), mine.get("session")) if value}
        group = {self.agent_id: mine}
        for agent_id, record in agents.items():
            if agent_id == self.agent_id:
                continue
            if anchors & {value for value in (record.get("identity_raw"), record.get("session")) if value}:
                group[agent_id] = record
        return group

    def _my_proofs(self, agents: dict[str, dict[str, Any]] | None = None) -> set[str]:
        proofs: set[str] = set()
        for record in self._identity_group(agents).values():
            manna = record.get("manna")
            if isinstance(manna, dict) and isinstance(manna.get("proof"), str) and manna["proof"]:
                proofs.add(manna["proof"])
        return proofs

    def _drop_targets_me(self, drop: dict[str, Any], agents: dict[str, dict[str, Any]] | None = None) -> bool:
        for_item = drop.get("for_item")
        if isinstance(for_item, dict):
            current = self._resolve_item_recipient(for_item, agents or self._load_agents())
            if current["state"] != "resolved":
                return False
            return bool(set(current["candidates"]) & self._identity_group(agents).keys())
        target = str(drop.get("for") or "any")
        if target == "any":
            return True
        if drop.get("for_agent_id") == self.agent_id or target == self.agent_id:
            return True
        record = self.self_record(refresh=False)
        alias = record.get("alias")
        if isinstance(alias, str) and alias and target == alias:
            return True
        role = record.get("role")
        return isinstance(role, str) and bool(role) and target == role

    # ------------------------------------------------------------------
    # Drops: a pointer handed to a peer, with a lifecycle.
    #
    # A drop is born `open` with a stable id and revision 1. Recipients
    # acknowledge delivery (`ack`), per agent and per revision, which only
    # quiets that reader's routine interrupts; the drop itself stays open.
    # An authorized party resolves the work (`resolve`), which quiets it
    # for everyone and keeps the record, its original timestamps and its
    # audit trail. A re-add by the owner with changed content bumps the
    # revision, so acknowledgments of the old revision no longer suppress
    # it and a resolved drop reopens. Nothing here deletes a drop.
    # ------------------------------------------------------------------

    @staticmethod
    def _drop_identity(record: dict[str, Any]) -> str:
        material = f"{record.get('owner')}|{record.get('path')}|{record.get('created_at')}"
        return "drp-" + hashlib.sha256(material.encode("utf-8")).hexdigest()[:12]

    @classmethod
    def _normalize_drop(cls, record: dict[str, Any]) -> dict[str, Any]:
        """Read a drop written by any coord version as a lifecycle record.

        A legacy drop (no id) is treated as open at revision 1 with no
        acknowledgments: age, a missing owner record, or a missing file are
        observations, never completion. The normalization is read-only; the
        record is rewritten only when a write path touches the ledger.
        """
        drop = dict(record)
        if not drop.get("id"):
            drop["id"] = cls._drop_identity(drop)
            drop["legacy"] = True
        drop.setdefault("revision", 1)
        drop.setdefault("status", "open")
        # `info`: a delivery; reading it is the whole obligation. `action`:
        # an obligation that stays visible after it is read, until resolved.
        drop["kind"] = "action" if drop.get("kind") == "action" else "info"
        drop.setdefault("updated_at", drop.get("created_at"))
        acks = drop.get("acks")
        drop["acks"] = acks if isinstance(acks, dict) else {}
        drop.setdefault("resolved", None)
        history = drop.get("history")
        drop["history"] = history if isinstance(history, list) else []
        # Host-notification receipts, keyed by the demand they answered
        # (drop id, revision and assignment instance); read as empty when absent.
        wake = drop.get("wake")
        drop["wake"] = wake if isinstance(wake, dict) else {}
        return drop

    def _load_drops(self) -> list[dict[str, Any]]:
        payload = self._read_json(self.drops_path, {"drops": []})
        drops = payload.get("drops", [])
        if not isinstance(drops, list):
            return []
        return [self._normalize_drop(item) for item in drops if isinstance(item, dict)]

    def _find_drop(self, drops: list[dict[str, Any]], drop_id: str) -> dict[str, Any] | None:
        for item in drops:
            if item.get("id") == drop_id:
                return item
        return None

    def _drop_acknowledged_by_me(self, drop: dict[str, Any]) -> bool:
        ack = (drop.get("acks") or {}).get(self.agent_id)
        if not isinstance(ack, dict):
            return False
        try:
            return int(ack.get("revision", 0)) >= int(drop.get("revision", 1))
        except (TypeError, ValueError):
            return False

    def _drop_owner_presence(self, drop: dict[str, Any], agents: dict[str, dict[str, Any]]) -> str:
        record = agents.get(str(drop.get("owner")))
        if not record:
            return "unknown"
        return classify_presence(record)

    def _drop_view(self, drop: dict[str, Any], agents: dict[str, dict[str, Any]]) -> dict[str, Any]:
        view = dict(drop)
        view["acknowledged_by_me"] = self._drop_acknowledged_by_me(drop)
        view["addressed_to_me"] = drop.get("owner") != self.agent_id and self._drop_targets_me(drop, agents)
        view["owner_presence"] = self._drop_owner_presence(drop, agents)
        view["reported_age"] = format_age(drop.get("updated_at") or drop.get("created_at"))
        view["delivery"] = self._delivery_view(drop, agents)
        return view

    # ------------------------------------------------------------------
    # Assignment addressing: a drop for "the worker on mn-x".
    #
    # The board row names the claimant and its claim proof; the worker's
    # coord record carries the proof manna derived in the worker's own
    # process (bound at touch). The recipient is the live record whose
    # proof equals the row's, exactly. Nothing here shortens, translates,
    # or prefix-matches a label, and no routing step confers authority.
    # ------------------------------------------------------------------

    def _board_item(self, item_id: str) -> tuple[dict[str, Any] | None, dict[str, Any]]:
        """The canonical board's row for an item (`manna show --json`), or the refusal manna gave."""
        if item_id in self._board_cache:
            return self._board_cache[item_id]
        root, via_worktree = canonical_board_root(self.project_root)
        board: dict[str, Any] = {
            "root": str(root),
            "path": str(root / ".manna"),
            "via_worktree": via_worktree,
            "source": "manna show --json",
            "observed_at": now_iso(),
        }
        row: dict[str, Any] | None = None
        if not (root / ".manna").is_dir():
            board["error"] = f"no Manna board at {root / '.manna'}"
        else:
            payload, message = manna_json(["show", item_id, "--json"], cwd=root)
            issue = payload.get("issue") if payload else None
            if isinstance(issue, dict) and issue.get("id"):
                row = issue
            else:
                board["error"] = message or f"manna show {item_id} returned no issue"
        self._board_cache[item_id] = (row, board)
        return row, board

    def _item_attempt(self, item_id: str, root: Path) -> dict[str, Any]:
        """Read atomic managed metadata without calling assess back into Coord.

        assess observes Coord liveness; invoking it while holding the Coord
        lock would create a lock cycle. This is a recorded generation, not an
        acceptance verdict. Missing means unmanaged; unreadable never does.
        """
        path = root / ".manna" / "managed.json"
        source = str(path)
        try:
            if path.is_symlink():
                raise ValueError("managed metadata is a symlink")
            try:
                data = json.loads(path.read_text())
            except FileNotFoundError:
                return {"attempt": None, "managed": False, "source": source}
            if not isinstance(data, dict) or data.get("version", 1) != 1 or not isinstance(data.get("items", {}), dict):
                raise ValueError("invalid managed metadata")
            record = data.get("items", {}).get(item_id)
            if item_id not in data.get("items", {}):
                return {"attempt": None, "managed": False, "source": source}
            if not isinstance(record, dict) or record.get("id") != item_id or type(record.get("attempt")) is not int or record["attempt"] < 1:
                raise ValueError("invalid managed attempt")
            return {"attempt": record["attempt"], "managed": True, "source": source}
        except (OSError, ValueError) as exc:
            return {"attempt": None, "managed": None, "source": source, "error": str(exc)}

    @staticmethod
    def _pin_item(row: dict[str, Any], board: dict[str, Any], attempt: dict[str, Any] | None) -> dict[str, Any]:
        attempt = attempt or {}
        return {
            "id": row.get("id"),
            "title": row.get("title"),
            "status": row.get("status"),
            "board": board.get("path"),
            "board_root": board.get("root"),
            "via_worktree": board.get("via_worktree"),
            "claimant": row.get("claimed_by"),
            "claim_proof": row.get("claim_token_hash"),
            "claimed_at": row.get("claimed_at"),
            "attempt": attempt.get("attempt"),
            "managed": attempt.get("managed"),
            "work_order": {"prompt": row.get("prompt"), "digest": row.get("handoff_digest")},
            "observed_at": board.get("observed_at"),
            "source": "manna show --json; " + str(attempt.get("source", "attempt unavailable")),
        }

    @staticmethod
    def _record_anchor(agent_id: str, record: dict[str, Any]) -> str:
        return str(record.get("identity_raw") or record.get("session") or agent_id)

    def _resolve_item_recipient(self, pinned: dict[str, Any], agents: dict[str, dict[str, Any]]) -> dict[str, Any]:
        """The exact coord session for a pinned claim: one live record, one proof, or an honest reason."""
        item_id = pinned.get("id")
        claimant = pinned.get("claimant")
        proof = pinned.get("claim_proof")
        if not claimant or not proof:
            return {
                "state": "unassigned",
                "agent_id": None,
                "candidates": [],
                "reason": f"{item_id} is {pinned.get('status')} with no claimant on the board; nobody is assigned",
            }
        bound = [
            (agent_id, record)
            for agent_id, record in agents.items()
            if isinstance(record.get("manna"), dict) and record["manna"].get("proof") == proof
        ]
        live = [(agent_id, record) for agent_id, record in bound if classify_presence(record) in {"active", "idle"}]
        if not live:
            gone = {agent_id: classify_presence(record) for agent_id, record in bound}
            reason = (
                f"no live coord session has bound the claimant's proof (claimant {claimant}); "
                "the worker binds by running `agent-do coord touch` in its own session"
            )
            if gone:
                reason += "; sessions that bound it and are not live: " + ", ".join(f"{k} ({v})" for k, v in sorted(gone.items()))
            return {"state": "pending", "agent_id": None, "candidates": [], "not_live": gone, "reason": reason}
        anchors = {self._record_anchor(agent_id, record) for agent_id, record in live}
        if len(anchors) > 1:
            ids = sorted(agent_id for agent_id, _ in live)
            return {
                "state": "ambiguous",
                "agent_id": None,
                "candidates": ids,
                "reason": (
                    f"{len(ids)} live sessions carry the claimant's proof but anchor to different harness sessions "
                    f"({', '.join(ids)}); refusing to pick one"
                ),
            }
        live.sort(key=lambda item: str(item[1].get("last_seen") or ""), reverse=True)
        agent_id, record = live[0]
        return {
            "state": "resolved",
            "agent_id": agent_id,
            "also": [other for other, _ in live[1:]],
            "candidates": [agent_id, *[other for other, _ in live[1:]]],
            "how": "coord record manna.proof == board claim_token_hash (exact)",
            "manna_session": record["manna"].get("session"),
            "bound_at": record["manna"].get("bound_at"),
            "presence": classify_presence(record),
            "resolved_at": now_iso(),
            "reason": None,
        }

    def _staleness(self, drop: dict[str, Any]) -> dict[str, Any] | None:
        """Has the assignment moved since this drop pinned it? Read from the board, never assumed."""
        for_item = drop.get("for_item")
        if not isinstance(for_item, dict) or not for_item.get("id"):
            return None
        row, board = self._board_item(str(for_item["id"]))
        if row is None:
            return {"reason": "unverified", "detail": board.get("error")}
        if for_item.get("board") != board.get("path"):
            return {"reason": "board changed", "detail": "the canonical board differs from the recorded destination"}
        pinned_proof = for_item.get("claim_proof")
        if row.get("claim_token_hash") != pinned_proof:
            return {
                "reason": "reassigned",
                "detail": (
                    f"claimant now {row.get('claimed_by') or 'nobody'} (recorded for {for_item.get('claimant')}); "
                    "not forwarded to the replacement"
                ),
            }
        if not for_item.get("claimed_at") or row.get("claimed_at") != for_item.get("claimed_at"):
            return {"reason": "claim changed", "detail": "this is a different claim, even if the same worker reclaimed it"}
        attempt = self._item_attempt(str(for_item["id"]), Path(str(board["root"])))
        if attempt.get("error") or for_item.get("managed") is None:
            return {"reason": "unverified", "detail": attempt.get("error") or "recorded managed status is unknown; explicitly readdress"}
        if attempt.get("managed") != for_item.get("managed") or attempt.get("attempt") != for_item.get("attempt"):
            return {"reason": "attempt changed", "detail": "approval belongs to an earlier managed assignment"}
        if row.get("status") == "done":
            return {"reason": "item closed", "detail": f"{for_item['id']} is done"}
        pinned_digest = (for_item.get("work_order") or {}).get("digest")
        if row.get("handoff_digest") != pinned_digest:
            return {
                "reason": "work-order revised",
                "detail": (
                    f"work order {short_digest(pinned_digest)} -> {short_digest(row.get('handoff_digest'))}; "
                    "recorded against the earlier revision and does not extend to this one"
                ),
            }
        return None

    def _exact_recipient_ids(self, drop: dict[str, Any], agents: dict[str, dict[str, Any]]) -> set[str]:
        """The sessions whose acknowledgment counts as the recipient's: the resolved id, its siblings, and proof-bound records."""
        if isinstance(drop.get("for_item"), dict):
            current = self._resolve_item_recipient(drop["for_item"], agents)
            if current["state"] != "resolved" or self._staleness(drop):
                return set()
            return set(current["candidates"])
        ids: set[str] = set()
        target_id = drop.get("for_agent_id")
        if isinstance(target_id, str) and target_id:
            ids.add(target_id)
            anchor_record = agents.get(target_id)
            if anchor_record:
                anchor = self._record_anchor(target_id, anchor_record)
                for agent_id, record in agents.items():
                    if self._record_anchor(agent_id, record) == anchor:
                        ids.add(agent_id)
        return ids

    def _delivery_view(self, drop: dict[str, Any], agents: dict[str, dict[str, Any]]) -> dict[str, Any]:
        """Each stage as a fact: recorded, recipient resolved, bell queued, acknowledged, completed."""
        target = str(drop.get("for") or "any")
        for_item = drop.get("for_item") if isinstance(drop.get("for_item"), dict) else None
        target_id = drop.get("for_agent_id")
        recipient: dict[str, Any]
        if for_item:
            current = self._resolve_item_recipient(for_item, agents)
            recipient = {
                "state": current["state"],
                "agent_id": current.get("agent_id"),
                "at": (drop.get("recipient") or {}).get("resolved_at"),
                "reason": current.get("reason"),
                "candidates": current.get("candidates", []),
            }
        elif target == "any":
            recipient = {"state": "broadcast", "agent_id": None, "how": "everyone"}
        elif target in ROLES:
            recipient = {"state": "broadcast", "agent_id": None, "how": f"role {target}"}
        elif isinstance(target_id, str) and target_id:
            recipient = {"state": "resolved", "agent_id": target_id, "at": drop.get("created_at"), "how": "named directly"}
        else:
            recipient = {
                "state": "unknown",
                "agent_id": None,
                "reason": f"{target} was not a registered coord session when this drop was written",
            }
        if recipient.get("agent_id"):
            record = agents.get(str(recipient["agent_id"]))
            recipient["presence"] = classify_presence(record) if record else "unknown"

        if drop.get("bell_queued_at"):
            bell = {"state": "queued", "at": drop.get("bell_queued_at")}
        elif recipient["state"] == "broadcast":
            bell = {"state": "not queued", "reason": "broadcasts are ledger entries, never bells"}
        elif recipient["state"] != "resolved":
            bell = {"state": "not queued", "reason": "no exact recipient"}
        else:
            bell = {"state": "not queued", "reason": "the recipient was not live when the drop was recorded"}

        acks = drop.get("acks") or {}
        acknowledged: dict[str, Any] | None = None
        if recipient["state"] == "broadcast":
            readers = [
                {"by": reader, "at": ack.get("at"), "revision": ack.get("revision")}
                for reader, ack in sorted(acks.items())
                if isinstance(ack, dict)
            ]
            acknowledged = {"readers": readers} if readers else None
        else:
            counted = self._exact_recipient_ids(drop, agents)
            for reader, ack in sorted(acks.items()):
                if reader in counted and isinstance(ack, dict):
                    try:
                        current_revision = int(ack.get("revision", 0)) >= int(drop.get("revision", 1))
                    except (TypeError, ValueError):
                        current_revision = False
                    if current_revision:
                        acknowledged = {"by": reader, "at": ack.get("at"), "revision": ack.get("revision")}
                        break

        resolved = drop.get("resolved") if isinstance(drop.get("resolved"), dict) else None
        completed = (
            {"by": resolved.get("by"), "at": resolved.get("at"), "reason": resolved.get("reason"), "evidence": resolved.get("evidence")}
            if resolved and drop.get("status") == "resolved"
            else None
        )
        if completed:
            stage = "completed"
        elif for_item and (recipient["state"] != "resolved" or self._staleness(drop)):
            stage = "recorded"
        elif acknowledged:
            stage = "acknowledged"
        elif bell["state"] == "queued":
            stage = "bell queued"
        elif recipient["state"] in {"resolved", "broadcast"}:
            stage = "recipient resolved" if recipient["state"] == "resolved" else "recorded"
        else:
            stage = "recorded"
        return {
            "stage": stage,
            "recorded": {"at": drop.get("created_at")},
            "recipient": recipient,
            "bell": bell,
            "acknowledged": acknowledged,
            "completed": completed,
            "stale": self._staleness(drop),
            "notification": self._wake_notification(drop, agents),
            "note": (
                "a ledger write, a queued bell, or a host's wake request or transport receipt is not acknowledgment; "
                "only the recipient's ack and resolve are"
            ),
        }

    # ------------------------------------------------------------------
    # Wake demands: what a host adapter may act on, and the receipts it leaves.
    #
    # An open action drop with one exact live recipient, unacknowledged at
    # its current revision and not stale, is a demand for that recipient's
    # attention. A host reads the demands, claims one by requesting it under
    # its own coord identity, submits the fixed instruction through the
    # transport it owns, and records the outcome. One live consumer holds a
    # demand at a time (its coord presence is the lease); an unknown outcome
    # blocks any further request until it is resolved; a submitted outcome is
    # a transport fact and never an acknowledgment. Nothing here changes
    # acks, resolution, approval scope, or the assignment.
    # ------------------------------------------------------------------

    def _assignment_key(self, drop: dict[str, Any]) -> str | None:
        """The assignment instance a demand binds to: the pinned claim for an item drop, the named session for a direct one."""
        for_item = drop.get("for_item")
        if isinstance(for_item, dict):
            material = "|".join(
                str(for_item.get(key)) for key in ("board", "claim_proof", "claimed_at", "managed", "attempt")
            ) + "|" + str((for_item.get("work_order") or {}).get("digest"))
            return hashlib.sha256(material.encode("utf-8")).hexdigest()[:DIGEST_PREFIX_HEX]
        target_id = drop.get("for_agent_id")
        return str(target_id) if isinstance(target_id, str) and target_id else None

    def _demand_id(self, drop: dict[str, Any]) -> str | None:
        """Deduplication identity of a demand: drop id, revision and assignment instance. Any of them moving is a new demand."""
        key = self._assignment_key(drop)
        if not key:
            return None
        return f"{drop.get('id')}:r{int(drop.get('revision', 1))}:{key}"

    def _session_facts(
        self,
        agent_id: str | None,
        agents: dict[str, dict[str, Any]],
        pulse_map: dict[str, dict[str, Any]] | None = None,
    ) -> dict[str, Any] | None:
        """What a host needs to find a recipient's session: the coord record's own harness facts, never a guess."""
        if not agent_id:
            return None
        record = agents.get(agent_id)
        if not record:
            return {"agent_id": agent_id, "presence": "unknown"}
        verified = process_liveness(record)
        manna = record.get("manna") if isinstance(record.get("manna"), dict) else None
        pulses = pulse_map if pulse_map is not None else self.pulse_map()
        return {
            "agent_id": agent_id,
            "alias": record.get("alias"),
            "presence": classify_presence(record),
            "last_seen": record.get("last_seen"),
            "lease_expires_at": record.get("lease_expires_at"),
            "harness": {
                "runtime": record.get("runtime"),
                "identity_source": record.get("identity_source"),
                "session": record.get("identity_raw") or record.get("session"),
                "pid": record.get("pid"),
                "pid_start": record.get("pid_start"),
                "host": record.get("host"),
                "pane": record.get("pane"),
                "process": "alive" if verified is True else "gone" if verified is False else "unverifiable",
            },
            "bound": (
                {"manna_session": manna.get("session"), "proof": manna.get("proof"), "bound_at": manna.get("bound_at")}
                if manna
                else None
            ),
            "pulse": pulses.get(agent_id),
            "source": "coord agents.json record; kill -0 and ps lstart on this host",
        }

    def _wake_requests(self, drop: dict[str, Any], demand_id: str | None) -> list[dict[str, Any]]:
        bucket = (drop.get("wake") or {}).get(demand_id) if demand_id else None
        requests = (bucket or {}).get("requests") if isinstance(bucket, dict) else None
        return [item for item in requests if isinstance(item, dict)] if isinstance(requests, list) else []

    def _find_wake_request(self, drop: dict[str, Any], request_id: str) -> tuple[str | None, dict[str, Any] | None]:
        for demand_id, bucket in (drop.get("wake") or {}).items():
            for request in ((bucket or {}).get("requests") or []) if isinstance(bucket, dict) else []:
                if isinstance(request, dict) and request.get("id") == request_id:
                    return str(demand_id), request
        return None, None

    def _consumer_live(self, consumer: str | None, agents: dict[str, dict[str, Any]]) -> tuple[bool, str]:
        """A consumer holds a demand only while its coord presence is active: its presence is the lease."""
        record = agents.get(str(consumer)) if consumer else None
        presence = classify_presence(record) if record else "unknown"
        return presence == "active", presence

    def _wake_notification(
        self,
        drop: dict[str, Any],
        agents: dict[str, dict[str, Any]],
        demand_id: str | None = None,
    ) -> dict[str, Any]:
        """The host-notification state of this drop's current demand, read from its receipts."""
        demand_id = demand_id or self._demand_id(drop)
        requests = self._wake_requests(drop, demand_id)
        attempts = sum(
            1 for item in requests if (item.get("outcome") or {}).get("state") in {"submitted", "unknown", "failed"}
        )
        current = requests[-1] if requests else None
        state = "wanted"
        lapsed: dict[str, Any] | None = None
        view_request: dict[str, Any] | None = None
        if current:
            outcome = current.get("outcome") if isinstance(current.get("outcome"), dict) else None
            live, presence = self._consumer_live(current.get("consumer"), agents)
            view_request = {
                "id": current.get("id"),
                "consumer": current.get("consumer"),
                "consumer_label": current.get("consumer_label"),
                "consumer_presence": presence,
                "requested_at": current.get("requested_at"),
                "age": format_age(current.get("requested_at")),
                "waiting": current.get("waiting"),
                "outcome": outcome,
                "after": current.get("after"),
            }
            if outcome is None:
                if live:
                    state = "pending readiness" if current.get("waiting") else "requested"
                else:
                    lapsed = {
                        "request": current.get("id"),
                        "consumer": current.get("consumer"),
                        "consumer_presence": presence,
                        "detail": "the holder's coord presence is no longer active; the demand is open to another request",
                    }
            elif outcome.get("state") == "submitted":
                state = "submitted"
            elif outcome.get("state") == "unknown":
                state = "unknown"
        return {
            "state": state,
            "demand_id": demand_id,
            "request": view_request,
            "lapsed": lapsed,
            "attempts": attempts,
            "requests": len(requests),
            "note": "transport facts: a request or a submission is never the recipient's acknowledgment",
        }

    def _wake_demand(
        self,
        drop: dict[str, Any],
        agents: dict[str, dict[str, Any]],
        pulse_map: dict[str, dict[str, Any]],
    ) -> dict[str, Any]:
        """One drop as a wake demand: actionable now, or held with the reason. Read fresh from the board and the records."""
        delivery = self._delivery_view(drop, agents)
        recipient = delivery["recipient"]
        for_item = drop.get("for_item") if isinstance(drop.get("for_item"), dict) else None
        addressing = "item" if for_item else "broadcast" if recipient["state"] == "broadcast" else "direct"
        notification = delivery["notification"]
        reason: str | None = None
        if drop.get("status") == "resolved":
            reason = "resolved: " + str((drop.get("resolved") or {}).get("reason") or "settled")
        elif drop.get("kind") != "action":
            reason = "informational: a notice read at the recipient's next boundary, never a wake"
        elif addressing == "broadcast":
            reason = f"broadcast ({recipient.get('how')}): a ledger entry with no exact recipient, never a wake"
        elif delivery.get("stale"):
            stale = delivery["stale"]
            reason = f"stale: {stale.get('reason')}: {stale.get('detail')}"
        elif recipient["state"] != "resolved":
            reason = f"recipient {recipient['state']}: {recipient.get('reason')}"
        elif recipient.get("presence") not in {"active", "idle"}:
            reason = f"recipient {recipient.get('agent_id')} is {recipient.get('presence')}: no live session to wake"
        elif delivery.get("acknowledged"):
            ack = delivery["acknowledged"]
            reason = (
                f"acknowledged by {ack.get('by')} at r{ack.get('revision')} ({format_age(ack.get('at'))}); "
                "unresolved work the recipient already knows about"
            )
        actionable = reason is None
        if actionable:
            next_step = {
                "wanted": f"a host adapter may claim it: agent-do coord drop wake {drop.get('id')}",
                "requested": "the holder submits the fixed instruction when the session is input-ready and records --outcome with evidence",
                "pending readiness": "the holder is waiting for the session to be input-ready; it records --outcome with evidence when it acts",
                "submitted": "await the recipient's own ack (drop ack); a further request names --after <request-id> with evidence",
                "unknown": "establish what happened: record --outcome submitted or failed on the request with evidence; new requests are refused until then",
            }[notification["state"]]
        else:
            next_step = "held: " + str(reason)
        return {
            "demand_id": notification.get("demand_id"),
            "actionable": actionable,
            "reason": reason,
            "wake_wanted": actionable and notification["state"] == "wanted",
            "drop": {
                "id": drop.get("id"),
                "revision": drop.get("revision"),
                "kind": drop.get("kind"),
                "status": drop.get("status"),
                "path": drop.get("path"),
                "note": drop.get("note"),
                "owner": drop.get("owner"),
                "owner_label": drop.get("owner_label"),
                "created_at": drop.get("created_at"),
                "updated_at": drop.get("updated_at"),
                "approval": drop.get("approval"),
            },
            "addressing": addressing,
            "assignment": dict(for_item) if for_item else None,
            "recipient": {**recipient, "session": self._session_facts(recipient.get("agent_id"), agents, pulse_map)},
            "stage": delivery["stage"],
            "acknowledged": delivery.get("acknowledged"),
            "stale": delivery.get("stale"),
            "bell": delivery.get("bell"),
            "notification": notification,
            "next": next_step,
        }

    def wake_list(self) -> dict[str, Any]:
        """Every open action drop as a wake demand: the actionable ones first, the held ones with their reasons."""
        record = self.register_self()
        agents = self._load_agents()
        pulse_map = self.pulse_map()
        demands: list[dict[str, Any]] = []
        held: list[dict[str, Any]] = []
        for drop in self._load_drops():
            if drop.get("status") == "resolved" or drop.get("kind") != "action":
                continue
            entry = self._wake_demand(drop, agents, pulse_map)
            (demands if entry["actionable"] else held).append(entry)
        order = {"wanted": 0, "unknown": 1, "requested": 2, "pending readiness": 3, "submitted": 4}
        demands.sort(key=lambda item: (order.get(str(item["notification"]["state"]), len(order)), str(item["drop"].get("updated_at") or "")))
        held.sort(key=lambda item: str(item["drop"].get("updated_at") or ""), reverse=True)
        return {
            "contract": WAKE_CONTRACT,
            "instruction": WAKE_INSTRUCTION,
            "observed_at": now_iso(),
            "consumer": {"agent_id": self.agent_id, "presence": classify_presence(record)},
            "demands": demands,
            "held": held,
            "counts": {
                "demands": len(demands),
                "wanted": sum(1 for item in demands if item["wake_wanted"]),
                "held": len(held),
            },
            "note": (
                "a demand is actionable unresolved work with one exact live recipient; informational drops, broadcasts, "
                "acknowledged obligations, and stale, pending or ambiguous assignments are held with the reason; "
                "a request or a transport receipt is never the recipient's acknowledgment"
            ),
        }

    def wake_request(
        self,
        drop_id: str,
        revision: int | None,
        after: str | None,
        evidence: str | None,
    ) -> tuple[bool, dict[str, Any]]:
        """Claim the wake demand a drop raises, for this session as the host consumer. Targeting is re-read, never assumed."""
        self.register_self()
        with self.locked():
            drops = self._load_drops()
            drop = self._find_drop(drops, drop_id)
            if drop is None:
                return False, {"error": f"No drop {drop_id}"}
            agents = self._load_agents()
            pulse_map = self.pulse_map()
            demand = self._wake_demand(drop, agents, pulse_map)
            group = set(self._identity_group(agents).keys())
            if (self._exact_recipient_ids(drop, agents) & group) or demand["recipient"].get("agent_id") in group:
                return False, {
                    "error": f"this session is the recipient of {drop_id}; acknowledge it with `agent-do coord drop ack {drop_id}`",
                    "demand": demand,
                }
            if not demand["actionable"]:
                return False, {"error": f"{drop_id} raises no wake demand now: {demand['reason']}", "demand": demand}
            if revision is not None and int(revision) != int(drop.get("revision", 1)):
                return False, {
                    "error": f"{drop_id} is at r{drop.get('revision')}, not r{revision}: re-read the demand before requesting",
                    "demand": demand,
                }
            demand_id = str(demand["demand_id"])
            notification = demand["notification"]
            current = notification.get("request") or {}
            bucket = drop["wake"].setdefault(demand_id, {"requests": []})
            requests = bucket.setdefault("requests", [])
            live_request = requests[-1] if requests else None
            if notification["state"] in {"requested", "pending readiness"}:
                if current.get("consumer") in group:
                    return True, {
                        "request": live_request,
                        "change": "unchanged",
                        "duplicate": True,
                        "supersedes": None,
                        "demand": demand,
                        "instruction": WAKE_INSTRUCTION,
                        "contract": WAKE_CONTRACT,
                    }
                return False, {
                    "error": (
                        f"{drop_id} is held by {current.get('consumer')} since {current.get('requested_at')} "
                        f"({current.get('id')}); one live consumer per demand"
                    ),
                    "held_by": current,
                    "demand": demand,
                }
            if notification["state"] == "unknown":
                return False, {
                    "error": (
                        f"the outcome of {current.get('id')} on {drop_id} is unknown; record `agent-do coord drop wake {drop_id} "
                        f"--request {current.get('id')} --outcome submitted|failed --evidence <what established it>` before another request; "
                        "a reconnect or a timeout is not grounds to submit again"
                    ),
                    "outstanding": current,
                    "demand": demand,
                }
            if notification["state"] == "submitted":
                if after != current.get("id") or not (evidence or "").strip():
                    return False, {
                        "error": (
                            f"{current.get('id')} was submitted {format_age((current.get('outcome') or {}).get('at'))} and the recipient "
                            f"has not acknowledged; await the ack, or pass --after {current.get('id')} --evidence <why another wake is warranted>"
                        ),
                        "submitted": current,
                        "demand": demand,
                    }
            stamp = now_iso()
            change = "requested"
            superseded: dict[str, Any] | None = None
            lapsed = notification.get("lapsed")
            if lapsed and live_request is not None and live_request.get("outcome") is None:
                live_request["lapsed"] = {"at": stamp, "consumer_presence": lapsed.get("consumer_presence"), "superseded_by": None}
                live_request.setdefault("history", []).append(
                    {"event": "lapsed", "at": stamp, "by": self.agent_id, "consumer_presence": lapsed.get("consumer_presence")}
                )
                superseded = {
                    "request": live_request.get("id"),
                    "consumer": live_request.get("consumer"),
                    "consumer_presence": lapsed.get("consumer_presence"),
                }
                change = "superseded"
            request = {
                "id": "wrq-" + uuid.uuid4().hex[:DIGEST_PREFIX_HEX],
                "demand_id": demand_id,
                "drop_id": drop_id,
                "revision": int(drop.get("revision", 1)),
                "consumer": self.agent_id,
                "consumer_label": self.self_record(refresh=False).get("alias") or self.agent_id,
                "requested_at": stamp,
                "recipient": demand["recipient"].get("agent_id"),
                "after": after if notification["state"] == "submitted" else None,
                "evidence": (evidence or "").strip() or None,
                "waiting": None,
                "outcome": None,
                "supersedes": superseded,
                "history": [{"event": "requested", "at": stamp, "by": self.agent_id}],
            }
            if superseded and live_request is not None:
                live_request["lapsed"]["superseded_by"] = request["id"]
            requests.append(request)
            self._save_drops(drops)
            self._append_event(
                kind="wake_request",
                paths=[str(drop.get("path"))],
                summary=(
                    f"{request['consumer_label']} requested a wake for {drop_id} r{request['revision']} "
                    f"({request['id']}) -> {request['recipient']}"
                ),
                extra={
                    "drop_id": drop_id,
                    "request_id": request["id"],
                    "demand_id": demand_id,
                    "consumer": self.agent_id,
                    "recipient": request["recipient"],
                    "change": change,
                },
            )
            refreshed = self._wake_demand(drop, self._load_agents(), pulse_map)
            return True, {
                "request": request,
                "change": change,
                "duplicate": False,
                "supersedes": superseded,
                "demand": refreshed,
                "instruction": WAKE_INSTRUCTION,
                "contract": WAKE_CONTRACT,
            }

    def wake_outcome(
        self,
        drop_id: str,
        request_id: str,
        outcome: str | None,
        evidence: str | None,
        waiting: str | None,
    ) -> tuple[bool, dict[str, Any]]:
        """Record what a host's transport did with a wake request, or why it still waits. Facts, never acknowledgment."""
        self.register_self()
        if bool(outcome) == (waiting is not None):
            return False, {"error": "pass exactly one of --outcome <state> --evidence <text> or --waiting <reason>"}
        if outcome and outcome not in WAKE_OUTCOMES:
            return False, {"error": f"outcome must be one of {', '.join(WAKE_OUTCOMES)}"}
        if outcome and not (evidence or "").strip():
            return False, {
                "error": f"--outcome {outcome} requires --evidence: what established it (for unknown, why it is unknown)"
            }
        if waiting is not None and not waiting.strip():
            return False, {"error": "--waiting requires a reason"}
        with self.locked():
            drops = self._load_drops()
            drop = self._find_drop(drops, drop_id)
            if drop is None:
                return False, {"error": f"No drop {drop_id}"}
            demand_id, request = self._find_wake_request(drop, request_id)
            if request is None or demand_id is None:
                return False, {"error": f"No wake request {request_id} on {drop_id}"}
            agents = self._load_agents()
            group = set(self._identity_group(agents).keys())
            holder_live, holder_presence = self._consumer_live(request.get("consumer"), agents)
            if request.get("consumer") not in group and holder_live:
                return False, {
                    "error": f"{request_id} is held by {request.get('consumer')} (active); the holder records its own outcome",
                    "held_by": request,
                }
            requests = self._wake_requests(drop, demand_id)
            if requests and requests[-1].get("id") != request_id:
                return False, {
                    "error": f"{request_id} was superseded by {requests[-1].get('id')}; its record is frozen, re-read the demand",
                    "superseded_by": requests[-1],
                }
            stamp = now_iso()
            by = self.agent_id
            change = "recorded"
            duplicate = False
            if waiting is not None:
                if request.get("outcome") is not None:
                    return False, {
                        "error": f"{request_id} already has an outcome ({request['outcome'].get('state')}); waiting applies before an outcome"
                    }
                reason = waiting.strip()
                previous = request.get("waiting") or {}
                if previous.get("reason") == reason:
                    change, duplicate = "unchanged", True
                else:
                    request["waiting"] = {"reason": reason, "at": stamp, "by": by}
                    request.setdefault("history", []).append({"event": "waiting", "at": stamp, "by": by, "reason": reason})
            else:
                previous_outcome = request.get("outcome") if isinstance(request.get("outcome"), dict) else None
                if previous_outcome and previous_outcome.get("state") == outcome:
                    change, duplicate = "unchanged", True
                else:
                    recorded: dict[str, Any] = {"state": outcome, "evidence": (evidence or "").strip(), "at": stamp, "by": by}
                    entry: dict[str, Any] = {"event": f"outcome:{outcome}", "at": stamp, "by": by, "evidence": recorded["evidence"]}
                    if previous_outcome:
                        recorded["corrects"] = {key: value for key, value in previous_outcome.items() if key != "corrects"}
                        entry["corrects"] = previous_outcome.get("state")
                        change = "corrected"
                    request["outcome"] = recorded
                    request.setdefault("history", []).append(entry)
            if change != "unchanged":
                self._save_drops(drops)
                label = self.self_record(refresh=False).get("alias") or by
                self._append_event(
                    kind="wake_outcome" if outcome else "wake_waiting",
                    paths=[str(drop.get("path"))],
                    summary=(
                        f"{label} recorded {request_id} on {drop_id}: "
                        + (f"outcome {outcome}" if outcome else f"waiting: {str(waiting).strip()}")
                        + (" (correction)" if change == "corrected" else "")
                    ),
                    extra={
                        "drop_id": drop_id,
                        "request_id": request_id,
                        "demand_id": demand_id,
                        "consumer": request.get("consumer"),
                        "outcome": outcome,
                        "change": change,
                    },
                )
            demand = self._wake_demand(drop, self._load_agents(), self.pulse_map())
            moved = demand.get("demand_id") != demand_id
            return True, {
                "request": request,
                "change": change,
                "duplicate": duplicate,
                "holder_presence": holder_presence,
                "demand": demand,
                "demand_moved": (
                    {
                        "from": demand_id,
                        "to": demand.get("demand_id"),
                        "detail": "the drop's revision or assignment changed after this request; the current demand needs fresh attention",
                    }
                    if moved
                    else None
                ),
                "demand_actionable": demand["actionable"],
                "delivery_stage": demand["stage"],
                "contract": WAKE_CONTRACT,
                "note": "a transport receipt is never the recipient's acknowledgment; the delivery stage moves only on the recipient's ack or resolve",
            }

    def _deliver_pending_item_drops(self) -> list[dict[str, Any]]:
        """Resolve item-addressed drops that were waiting for this session's proof; ring once each."""
        delivered: list[dict[str, Any]] = []
        with self.locked():
            agents = self._load_agents()
            proofs = self._my_proofs(agents)
            if not proofs:
                return delivered
            drops = self._load_drops()
            changed = False
            for drop in drops:
                for_item = drop.get("for_item")
                if not isinstance(for_item, dict) or drop.get("status") == "resolved" or drop.get("for_agent_id"):
                    continue
                if for_item.get("claim_proof") not in proofs or drop.get("owner") == self.agent_id:
                    continue
                if self._staleness(drop):
                    continue
                current = self._resolve_item_recipient(for_item, agents)
                if current["state"] != "resolved" or current["agent_id"] not in self._identity_group(agents):
                    continue
                stamp = now_iso()
                drop["for_agent_id"] = current["agent_id"]
                drop["recipient"] = {
                    "agent_id": current["agent_id"],
                    "also": current.get("also", []),
                    "how": current["how"],
                    "manna_session": current.get("manna_session"),
                    "bound_at": current.get("bound_at"),
                    "resolved_at": stamp,
                    "resolved_by": "recipient touch",
                }
                drop["history"].append({"event": "recipient_resolved", "at": stamp, "by": self.agent_id, "revision": drop.get("revision"), "recipient": current["agent_id"]})
                if self._ring_locked(current["agent_id"]):
                    drop["bell_queued_at"] = stamp
                drop["updated_at"] = stamp
                changed = True
                delivered.append({"id": drop["id"], "item": for_item.get("id"), "recipient": current["agent_id"]})
            if changed:
                self._save_drops(drops)
                for entry in delivered:
                    self._append_event(
                        kind="drop_deliver",
                        paths=[],
                        summary=f"{entry['recipient']} resolved as the recipient of {entry['id']} (worker on {entry['item']})",
                        extra={"drop_id": entry["id"], "recipient": entry["recipient"], "item": entry["item"]},
                    )
        return delivered

    def worker(self, item_id: str) -> tuple[bool, dict[str, Any]]:
        """Who is the worker on an item: exact session, assignment versus declared title, liveness evidence, obligations."""
        self.register_self()
        row, board = self._board_item(item_id)
        if row is None:
            return False, {"error": str(board.get("error")), "board": board}
        attempt = self._item_attempt(item_id, Path(str(board["root"])))
        pinned = self._pin_item(row, board, attempt)
        agents = self._load_agents()
        recipient = self._resolve_item_recipient(pinned, agents)
        focus_map = self.focus_map()
        pulse_map = self.pulse_map()
        session: dict[str, Any] | None = None
        liveness: dict[str, Any] | None = None
        assignment: dict[str, Any] | None = None
        if recipient.get("agent_id"):
            agent_id = str(recipient["agent_id"])
            record = agents.get(agent_id, {})
            manna = record.get("manna") if isinstance(record.get("manna"), dict) else {}
            session = {
                "agent_id": agent_id,
                "alias": record.get("alias"),
                "also": recipient.get("also", []),
                "binding": {
                    "how": recipient.get("how"),
                    "manna_session": manna.get("session"),
                    "proof": manna.get("proof"),
                    "bound_at": manna.get("bound_at"),
                    "source": manna.get("source"),
                },
                "harness": {
                    "runtime": record.get("runtime"),
                    "identity_source": record.get("identity_source"),
                    "pid": record.get("pid"),
                    "host": record.get("host"),
                    "pane": record.get("pane"),
                },
            }
            verified = process_liveness(record)
            liveness = {
                "presence": classify_presence(record),
                "last_seen": record.get("last_seen"),
                "age": format_age(record.get("last_seen")),
                "lease_expires_at": record.get("lease_expires_at"),
                "process": {
                    "pid": record.get("pid"),
                    "verified": "alive" if verified is True else "gone" if verified is False else "unverifiable",
                },
                "pulse": pulse_map.get(agent_id),
                "source": "coord agents.json lease; kill -0 and ps lstart on this host",
                "observed_at": now_iso(),
            }
            focus = focus_map.get(agent_id) or {}
            focus_updated = parse_iso(focus.get("updated_at"))
            claimed = parse_iso(pinned.get("claimed_at"))
            predates = bool(focus_updated and claimed and focus_updated < claimed)
            assignment = {
                "board_assignment": {
                    "item": pinned["id"],
                    "title": pinned.get("title"),
                    "claimed_at": pinned.get("claimed_at"),
                    "attempt": pinned.get("attempt"),
                    "source": "manna board row (recorded claim)",
                },
                "declared_focus": (
                    {
                        "goal": focus.get("goal"),
                        "phase": focus.get("phase"),
                        "updated_at": focus.get("updated_at"),
                        "age": format_age(focus.get("updated_at")),
                        "source": "coord focus (the session's own title, a dated declaration)",
                    }
                    if focus
                    else None
                ),
                "focus_predates_claim": predates,
                "note": (
                    "the declared focus predates the claim: a title set before this assignment was recorded; "
                    "the board row is the current assignment"
                    if predates
                    else "the declared focus was set after the claim" if focus else "no focus declared"
                ),
            }
        obligations: list[dict[str, Any]] = []
        group_ids = {recipient["agent_id"], *recipient.get("also", [])} if recipient.get("agent_id") else set()
        for drop in self._load_drops():
            if drop.get("status") == "resolved":
                continue
            for_item = drop.get("for_item") if isinstance(drop.get("for_item"), dict) else None
            addressed = (for_item and for_item.get("id") == item_id) or (
                group_ids and (drop.get("for_agent_id") in group_ids or drop.get("for") in group_ids)
            )
            if not addressed:
                continue
            view = self._drop_view(drop, agents)
            obligations.append(
                {
                    "id": view["id"],
                    "kind": view.get("kind"),
                    "path": view.get("path"),
                    "note": view.get("note"),
                    "owner": view.get("owner_label") or view.get("owner"),
                    "revision": view.get("revision"),
                    "approval": view.get("approval"),
                    "stage": view["delivery"]["stage"],
                    "delivery": view["delivery"],
                }
            )
        obligations.sort(key=lambda item: (item.get("kind") != "action", item.get("stage") in {"acknowledged", "completed"}, str(item.get("id"))))
        return True, {
            "item": pinned,
            "board": board,
            "recipient_state": recipient["state"],
            "reason": recipient.get("reason"),
            "candidates": recipient.get("candidates", []),
            "not_live": recipient.get("not_live"),
            "session": session,
            "liveness": liveness,
            "assignment": assignment,
            "manna_observation": attempt.get("claimant_observation"),
            "obligations": obligations,
            "authority_note": "a lookup confers nothing; the board row and the drop records are the facts",
        }

    def add_drop(
        self,
        path: str,
        target: str | None,
        note: str | None,
        key: str | None,
        kind: str = "info",
        item: str | None = None,
        approval: dict[str, Any] | None = None,
    ) -> tuple[bool, dict[str, Any]]:
        """Record a pointer for a peer, a role, everyone, or the worker on an item.

        A direct target must be a registered session or alias, a role, or
        `any`; anything else is refused rather than written to nobody. An
        item target pins the board's claimant, claim proof, attempt and
        work-order digest, resolves the exact session by proof, and stays
        visibly pending when none is live. An approval must say what it
        allows, what it excludes, and who authorized it; it is an action.
        """
        self.register_self()
        kind = "action" if kind == "action" else "info"
        normalized = normalize_path(self.project_root, self.cwd, path)
        alias = self.self_record(refresh=False).get("alias")
        agents = self._load_agents()
        for_item: dict[str, Any] | None = None
        recipient: dict[str, Any] | None = None
        resolved: str | None = None
        known_agent = False
        if item:
            if target and target != "any":
                return False, {"error": "--for and --for-item name one destination each; pass one of them"}
            row, board = self._board_item(item)
            if row is None:
                return False, {"error": f"cannot address {item}: {board.get('error')}", "board": board}
            if row.get("status") == "done":
                return False, {
                    "error": f"{row.get('id')} is done; nobody is assigned to it (claimed_by on the row is history, not an assignment)",
                    "item": {"id": row.get("id"), "status": row.get("status"), "claimed_by": row.get("claimed_by")},
                }
            if not row.get("claimed_by") or not row.get("claim_token_hash"):
                return False, {
                    "error": (
                        f"{row.get('id')} is {row.get('status')} with no claimant; address a role or any, "
                        "or wait for a claim"
                    ),
                    "item": {"id": row.get("id"), "status": row.get("status")},
                }
            attempt = self._item_attempt(item, Path(str(board["root"])))
            if attempt.get("error"):
                return False, {"error": "cannot verify assignment attempt", "observation": attempt}
            for_item = self._pin_item(row, board, attempt)
            recipient = self._resolve_item_recipient(for_item, agents)
            if recipient.get("agent_id") in self._identity_group(agents):
                return False, {
                    "error": f"the worker on {for_item['id']} is this session ({recipient['agent_id']}); a drop addresses someone else",
                    "destination": recipient,
                }
            target = f"{ITEM_TARGET_PREFIX}{for_item['id']}"
            resolved = recipient.get("agent_id")
            known_agent = bool(resolved)
            if approval:
                allows = [str(text).strip() for text in approval.get("allows", []) if str(text).strip()]
                excludes = [str(text).strip() for text in approval.get("excludes", []) if str(text).strip()]
                authorized_by = str(approval.get("authorized_by") or "").strip()
                missing = [
                    name
                    for name, present in (("--allows", bool(allows)), ("--excludes", bool(excludes)), ("--authorized-by", bool(authorized_by)))
                    if not present
                ]
                if missing:
                    return False, {
                        "error": (
                            "an approval record names what it allows, what it excludes, and who authorized it; "
                            f"missing {', '.join(missing)}"
                        )
                    }
                approval = {
                    "item": for_item["id"],
                    "work_order": dict(for_item["work_order"]),
                    "attempt": for_item.get("attempt"),
                    "allows": allows,
                    "excludes": excludes,
                    "authorized_by": authorized_by,
                    "recorded_by": self.agent_id,
                    "recorded_at": now_iso(),
                    "note": (
                        "scope as recorded by the coordinator; routing confers no authority beyond it, "
                        "and approval to implement locally is not approval to deploy"
                    ),
                }
                kind = "action"
        else:
            if approval:
                return False, {"error": "an approval is recorded against an item: pass --for-item <mn-id> with --allows/--excludes/--authorized-by"}
            target = target or "any"
            resolved, _ = self._resolve_peer(target)
            known_agent = resolved in agents
            if not known_agent and target != "any" and target not in ROLES:
                live = sorted(
                    (record.get("alias") and f"{agent_id} (alias {record['alias']})") or agent_id
                    for agent_id, record in agents.items()
                    if classify_presence(record) in {"active", "idle"}
                )
                return False, {
                    "error": (
                        f"unknown destination {target!r}: no coord session or alias is registered under that name, "
                        f"and it is not a role ({', '.join(ROLES)}) or any. "
                        f"Live sessions: {', '.join(live) if live else 'none'}. "
                        "Address the assignment instead: drop add <path> --for-item <mn-id>; "
                        "look the worker up with: worker <mn-id>"
                    ),
                    "live_sessions": live,
                }
        with self.locked():
            drops = self._load_drops()
            stamp = now_iso()
            existing = next(
                (item for item in drops if item.get("owner") == self.agent_id and item.get("path") == normalized),
                None,
            )
            pin_changed = False
            if existing is None:
                payload = {
                    "id": "drp-" + uuid.uuid4().hex[:12],
                    "revision": 1,
                    "status": "open",
                    "kind": kind,
                    "path": normalized,
                    "owner": self.agent_id,
                    "owner_label": alias or self.agent_id,
                    "for": target,
                    "for_agent_id": resolved if known_agent else None,
                    "note": note,
                    "key": key,
                    "created_at": stamp,
                    "updated_at": stamp,
                    "acks": {},
                    "resolved": None,
                    "history": [{"event": "added", "at": stamp, "by": self.agent_id, "revision": 1}],
                }
                drops.append(payload)
                change = "added"
            else:
                payload = existing
                previous_item = existing.get("for_item") if isinstance(existing.get("for_item"), dict) else None
                if for_item and previous_item:
                    pin_changed = (
                        previous_item.get("claim_proof") != for_item.get("claim_proof")
                        or previous_item.get("claimed_at") != for_item.get("claimed_at")
                        or previous_item.get("board") != for_item.get("board")
                        or previous_item.get("managed") != for_item.get("managed")
                        or (previous_item.get("work_order") or {}).get("digest") != for_item["work_order"].get("digest")
                        or previous_item.get("attempt") != for_item.get("attempt")
                    )
                content_changed = (
                    existing.get("note") != note
                    or existing.get("key") != key
                    or existing.get("for") != target
                    or existing.get("kind") != kind
                    or bool(for_item) != bool(previous_item)
                    or pin_changed
                    or (existing.get("approval") or None) != (approval or None)
                )
                reopened = existing.get("status") == "resolved"
                if content_changed or reopened:
                    # A meaningful update: a new revision, so earlier
                    # acknowledgments stop suppressing it and a resolved drop
                    # resurfaces. created_at stays the original report time.
                    payload["revision"] = int(payload.get("revision", 1)) + 1
                    payload["status"] = "open"
                    if reopened:
                        payload["history"].append(
                            {
                                "event": "reopened",
                                "at": stamp,
                                "by": self.agent_id,
                                "revision": payload["revision"],
                                "superseded_resolution": payload.get("resolved"),
                            }
                        )
                        payload["resolved"] = None
                    else:
                        payload["history"].append(
                            {"event": "updated", "at": stamp, "by": self.agent_id, "revision": payload["revision"]}
                        )
                    if pin_changed and previous_item:
                        # Re-addressing is the owner's explicit act and is
                        # journaled; it is never done for them.
                        payload["history"].append(
                            {
                                "event": "readdressed",
                                "at": stamp,
                                "by": self.agent_id,
                                "revision": payload["revision"],
                                "from": {
                                    "claimant": previous_item.get("claimant"),
                                    "attempt": previous_item.get("attempt"),
                                    "work_order": (previous_item.get("work_order") or {}).get("digest"),
                                },
                                "to": {
                                    "claimant": for_item.get("claimant") if for_item else None,
                                    "attempt": for_item.get("attempt") if for_item else None,
                                    "work_order": for_item["work_order"].get("digest") if for_item else None,
                                },
                            }
                        )
                    payload["updated_at"] = stamp
                    change = "reopened" if reopened else "updated"
                else:
                    change = "unchanged"
                payload["owner_label"] = alias or self.agent_id
                payload["for"] = target
                if change != "unchanged" or not for_item:
                    payload["for_agent_id"] = resolved if known_agent else None
                payload["note"] = note
                payload["key"] = key
                payload["kind"] = kind
                payload.pop("legacy", None)
            if for_item:
                payload["for_item"] = for_item
                if change != "unchanged":
                    payload["recipient"] = (
                        {
                            "agent_id": recipient["agent_id"],
                            "also": recipient.get("also", []),
                            "how": recipient.get("how"),
                            "manna_session": recipient.get("manna_session"),
                            "bound_at": recipient.get("bound_at"),
                            "resolved_at": stamp,
                            "resolved_by": "drop add",
                        }
                        if recipient and recipient.get("agent_id")
                        else None
                    )
                    payload.pop("bell_queued_at", None)
                if approval:
                    payload["approval"] = approval
                elif "approval" in payload and change != "unchanged":
                    payload.pop("approval", None)
            else:
                payload.pop("for_item", None)
                payload.pop("recipient", None)
                payload.pop("approval", None)
            if change != "unchanged":
                # Roles and 'any' remain ordinary ledger entries, not broadcasts.
                # The bell is a bit on the exact recipient; its timestamp is a stage, not an acknowledgment.
                if self._ring_locked(resolved if known_agent else None):
                    payload["bell_queued_at"] = stamp
            self._save_drops(drops)
            if change != "unchanged":
                self._append_event(
                    kind="drop_add",
                    paths=[normalized],
                    keys=[key] if key else [],
                    summary=f"{alias or self.agent_id} dropped {normalized} for {target} ({payload['id']} r{payload['revision']})",
                    extra={
                        "drop_id": payload["id"],
                        "revision": payload["revision"],
                        "change": change,
                        "item": for_item.get("id") if for_item else None,
                        "recipient": payload.get("for_agent_id"),
                    },
                )
            view = self._drop_view(payload, self._load_agents())
            view["change"] = change
            if for_item:
                view["destination"] = {
                    "item": for_item["id"],
                    "board": for_item.get("board"),
                    "via_worktree": for_item.get("via_worktree"),
                    "claimant": for_item.get("claimant"),
                    "claim_proof": for_item.get("claim_proof"),
                    "attempt": for_item.get("attempt"),
                    "work_order": for_item.get("work_order"),
                    "session": payload.get("for_agent_id"),
                    "state": recipient["state"] if recipient else "pending",
                    "reason": recipient.get("reason") if recipient else None,
                    "candidates": recipient.get("candidates", []) if recipient else [],
                    "provenance": [
                        f"board row: {for_item.get('source')} at {for_item.get('observed_at')}",
                        "session: " + (recipient.get("how") or "no exact session; see reason") if recipient else "",
                    ],
                }
            return True, view

    def ack_drop(self, drop_id: str) -> tuple[bool, dict[str, Any]]:
        """Acknowledge delivery of a drop addressed to me, at its current revision.

        Acknowledgment is per reader: a broadcast (`any` or a role) acked by
        one agent stays visible to every other recipient. It is not
        completion; the drop remains open until someone resolves it.
        """
        self.register_self()
        with self.locked():
            drops = self._load_drops()
            drop = self._find_drop(drops, drop_id)
            if drop is None:
                return False, {"error": f"No drop {drop_id}"}
            if drop.get("owner") == self.agent_id:
                return False, {"error": f"{drop_id} is your own drop; owners resolve, recipients acknowledge"}
            if isinstance(drop.get("for_item"), dict) and self._staleness(drop):
                return False, {"error": "assignment changed or unverified; approval must be explicitly readdressed"}
            if not self._drop_targets_me(drop):
                return False, {"error": f"{drop_id} is addressed to {drop.get('for')}, not to this agent"}
            stamp = now_iso()
            drop["acks"][self.agent_id] = {"revision": int(drop.get("revision", 1)), "at": stamp}
            drop["history"].append(
                {"event": "acknowledged", "at": stamp, "by": self.agent_id, "revision": drop["revision"]}
            )
            self._save_drops(drops)
            label = self.self_record(refresh=False).get("alias") or self.agent_id
            self._append_event(
                kind="drop_ack",
                paths=[str(drop.get("path"))],
                summary=f"{label} acknowledged {drop_id} r{drop['revision']} ({drop.get('path')})",
                extra={"drop_id": drop_id, "revision": drop["revision"]},
            )
            return True, self._drop_view(drop, self._load_agents())

    def _may_resolve_drop(self, drop: dict[str, Any], for_everyone: bool) -> str | None:
        """Return a refusal reason, or None when this agent may resolve the drop."""
        if drop.get("owner") == self.agent_id:
            return None
        if isinstance(drop.get("for_item"), dict):
            if self._staleness(drop) or not self._drop_targets_me(drop):
                return "assignment is stale, unverified, or has no unique recipient; only its owner may retire this drop"
            return None
        target = str(drop.get("for") or "any")
        record = self.self_record(refresh=False)
        if drop.get("for_agent_id") == self.agent_id or target == self.agent_id or target == record.get("alias"):
            return None
        if target == "any":
            if for_everyone:
                return None
            return (
                f"{drop['id']} is addressed to everyone; resolving it hides it for every reader. "
                "Acknowledge it for yourself with `drop ack`, or pass --for-everyone with the reason"
            )
        if target == record.get("role"):
            if for_everyone:
                return None
            return (
                f"{drop['id']} is addressed to the role {target}; resolving it hides it for every {target}. "
                "Acknowledge it for yourself with `drop ack`, or pass --for-everyone with the reason"
            )
        return f"{drop['id']} is addressed to {target}; only its owner or its recipient may resolve it"

    def resolve_drop(
        self,
        drop_id: str,
        reason: str,
        evidence: str | None,
        for_everyone: bool = False,
    ) -> tuple[bool, dict[str, Any]]:
        """Resolve a drop: it leaves routine interrupts for every reader and stays in history."""
        self.register_self()
        if not reason or not reason.strip():
            return False, {"error": "resolve requires --reason: an audit line names why the drop is settled"}
        with self.locked():
            drops = self._load_drops()
            drop = self._find_drop(drops, drop_id)
            if drop is None:
                return False, {"error": f"No drop {drop_id}"}
            refusal = self._may_resolve_drop(drop, for_everyone)
            if refusal:
                return False, {"error": refusal}
            if drop.get("status") == "resolved":
                return False, {"error": f"{drop_id} is already resolved", "drop": drop}
            stamp = now_iso()
            label = self.self_record(refresh=False).get("alias") or self.agent_id
            drop["status"] = "resolved"
            drop["resolved"] = {
                "by": self.agent_id,
                "by_label": label,
                "at": stamp,
                "reason": reason.strip(),
                "evidence": evidence,
                "revision": int(drop.get("revision", 1)),
                "for_everyone": bool(for_everyone and drop.get("owner") != self.agent_id),
            }
            drop["history"].append(
                {
                    "event": "resolved",
                    "at": stamp,
                    "by": self.agent_id,
                    "revision": drop["revision"],
                    "reason": reason.strip(),
                    "evidence": evidence,
                }
            )
            self._save_drops(drops)
            self._append_event(
                kind="drop_resolve",
                paths=[str(drop.get("path"))],
                summary=f"{label} resolved {drop_id} ({drop.get('path')}): {reason.strip()}",
                extra={"drop_id": drop_id, "revision": drop["revision"], "reason": reason.strip(), "evidence": evidence},
            )
            return True, self._drop_view(drop, self._load_agents())

    def drop_history(self, drop_id: str) -> tuple[bool, dict[str, Any]]:
        self.register_self()
        drops = self._load_drops()
        drop = self._find_drop(drops, drop_id)
        if drop is None:
            return False, {"error": f"No drop {drop_id}"}
        events = [event for event in self._load_events() if event.get("drop_id") == drop_id]
        events.sort(key=lambda item: int(item.get("seq", 0)))
        return True, {"drop": self._drop_view(drop, self._load_agents()), "events": events}

    def drops(self, for_me: bool = False, include_resolved: bool = False) -> list[dict[str, Any]]:
        self.register_self()
        agents = self._load_agents()
        drops = self._load_drops()
        if for_me:
            drops = [item for item in drops if item.get("owner") != self.agent_id and self._drop_targets_me(item, agents)]
        if not include_resolved:
            drops = [item for item in drops if item.get("status") != "resolved"]
        drops.sort(key=lambda item: item.get("updated_at") or item.get("created_at", ""), reverse=True)
        return [self._drop_view(item, agents) for item in drops]

    def history(self, peer: str | None = None, limit: int = 20) -> list[dict[str, Any]]:
        self.register_self()
        events = self._load_events()
        if peer:
            agent_id, _ = self._resolve_peer(peer)
            events = [item for item in events if item.get("agent_id") == agent_id]
        events.sort(key=lambda item: int(item.get("seq", 0)), reverse=True)
        return events[: max(1, limit)]

    def guard_check(self, paths: list[str], staged: bool) -> dict[str, Any]:
        self.register_self()
        raw_paths = list(paths)
        if staged:
            staged_output = git_output(self.cwd, "diff", "--cached", "--name-only") or ""
            raw_paths.extend(line for line in staged_output.splitlines() if line.strip())
        normalized = sorted(
            {normalize_path(self.project_root, self.cwd, path) for path in raw_paths if path.strip()}
        )
        agents = self._load_agents()
        live = self._live_records(agents)
        warnings: list[dict[str, Any]] = []
        claims = self._load_claims()
        for path in normalized:
            for claim in claims:
                owner = str(claim.get("owner"))
                if owner == self.agent_id or owner not in live:
                    continue
                owned = str(claim.get("path", ""))
                if not path_overlaps(path, owned):
                    continue
                warnings.append(
                    {
                        "path": path,
                        "kind": "claim",
                        "owner": owner,
                        "owner_label": claim.get("owner_alias") or live[owner].get("alias") or owner,
                        "owned_path": owned,
                        "reason": claim.get("reason"),
                    }
                )
            for agent_id, record in sorted(live.items()):
                for owned in self._record_territory(record):
                    if not path_overlaps(path, owned):
                        continue
                    warnings.append(
                        {
                            "path": path,
                            "kind": "territory",
                            "owner": agent_id,
                            "owner_label": record.get("alias") or agent_id,
                            "owned_path": owned,
                            "role": record.get("role"),
                            "mode": self._record_mode(record),
                        }
                    )
        if warnings:
            label = self.self_record(refresh=False).get("alias") or self.agent_id
            with self.locked():
                self._append_event(
                    kind="guard_warn",
                    paths=sorted({item["path"] for item in warnings}),
                    summary=f"{label} touched paths owned by live peers: "
                    + ", ".join(sorted({item["owner_label"] for item in warnings})),
                )
        return {"paths": normalized, "warnings": warnings, "clean": not warnings}

    def guard_install(self) -> dict[str, Any]:
        hooks_text = git_output(self.cwd, "rev-parse", "--git-path", "hooks")
        if not hooks_text:
            return {"installed": False, "error": "not inside a git repository"}
        hooks_dir = Path(hooks_text)
        if not hooks_dir.is_absolute():
            hooks_dir = (self.cwd / hooks_dir).resolve()
        hooks_dir.mkdir(parents=True, exist_ok=True)
        hook_path = hooks_dir / "pre-commit"

        dispatcher = Path(__file__).resolve().parents[1] / "agent-do"
        command = f"{shlex.quote(str(dispatcher))} coord guard check --staged" if dispatcher.exists() else "agent-do coord guard check --staged"
        marker = "# >>> agent-do coord guard >>>"
        block = (
            f"{marker}\n"
            "# Advisory only: warns when staged paths intersect a live peer's claim or territory.\n"
            f"{command} || true\n"
            "# <<< agent-do coord guard <<<\n"
        )

        already = False
        if hook_path.exists():
            content = hook_path.read_text()
            if marker in content:
                already = True
            else:
                if content and not content.endswith("\n"):
                    content += "\n"
                content += "\n" + block
                hook_path.write_text(content)
        else:
            hook_path.write_text("#!/bin/sh\n\n" + block)
        hook_path.chmod(0o755)
        return {"installed": True, "already_installed": already, "hook": str(hook_path)}

    def _current_paths(self) -> list[str]:
        focus = self.focus_for() or {}
        focus_paths = list(focus.get("paths", []))
        claim_paths = [item["path"] for item in self.claims() if item.get("owner") == self.agent_id]
        return sorted({*focus_paths, *claim_paths})

    def _current_need_keys(self) -> set[str]:
        return {str(item.get("key")) for item in self.needs() if item.get("key")}

    def _last_interrupt_seq(self) -> int:
        record = self.self_record(refresh=False)
        value = record.get("last_interrupt_seq", 0)
        try:
            return int(value)
        except (TypeError, ValueError):
            return 0

    def _mark_interrupt_seq(self, seq: int) -> None:
        current = self.register_self()
        with self.locked():
            agents = self._load_agents()
            current = agents.get(self.agent_id, current)
            current["last_interrupt_seq"] = seq
            agents[self.agent_id] = current
            self._save_agents(agents)

    def _matching_publish(self, need: dict[str, Any], publishes: list[dict[str, Any]]) -> dict[str, Any] | None:
        key = need.get("key")
        from_target = need.get("from")
        from_alias = need.get("from_alias")
        candidates = [item for item in publishes if item.get("key") == key]
        if from_target:
            candidates = [
                item
                for item in candidates
                if item.get("owner") == from_target or item.get("owner_alias") == from_alias or item.get("owner_alias") == from_target
            ]
        if not candidates:
            return None
        candidates.sort(key=lambda item: item.get("updated_at", ""), reverse=True)
        return candidates[0]

    def interrupts(self, mark_seen: bool = False, limit: int = 20) -> dict[str, Any]:
        self.register_self()
        last_seen_seq = self._last_interrupt_seq()
        focus = self.focus_for() or {}
        my_paths = self._current_paths()
        my_needs = self.needs()
        my_need_keys = {str(item.get("key")) for item in my_needs if item.get("key")}
        agents = self._load_agents()
        publishes = self.publishes()
        active_peers = [
            peer for peer in self.peers(include_stale=False)
            if not peer["current"] and peer["status"] == "active"
        ]

        interrupts: list[dict[str, Any]] = []

        # Current contentions.
        claims = self.claims()
        my_claim_paths = {item["path"] for item in claims if item.get("owner") == self.agent_id}
        for peer in active_peers:
            peer_focus = peer.get("focus") or {}
            peer_focus_paths = [str(item) for item in peer_focus.get("paths", [])]
            peer_claim_paths = [
                item["path"]
                for item in claims
                if item.get("owner") == peer["agent_id"]
            ]
            overlaps = sorted(
                {
                    mine
                    for mine in [*my_paths, *my_claim_paths]
                    for theirs in [*peer_focus_paths, *peer_claim_paths]
                    if path_overlaps(mine, theirs)
                }
            )
            if not overlaps:
                continue
            peer_label = peer.get("alias") or peer["agent_id"]
            remedy = overlap_remedy(overlaps) if ISOLATION_NUDGE else []
            interrupts.append(
                {
                    "kind": "contention",
                    "severity": "warning",
                    "peer": peer["agent_id"],
                    "peer_label": peer_label,
                    "paths": overlaps,
                    "keys": [],
                    "summary": with_remedy(
                        f"{peer_label} is active in overlapping paths: {', '.join(overlaps)}",
                        remedy,
                    ),
                    "remedy": remedy,
                    "new": False,
                    "event_id": None,
                }
            )

        # Territory contention: two live writers with overlapping write-domains, fired for both.
        my_record = agents.get(self.agent_id, {})
        my_mode = self._record_mode(my_record)
        my_territory = self._record_territory(my_record)
        if my_mode == "writer" and my_territory:
            for overlap in self._territory_overlaps(my_territory, agents, mode="writer"):
                remedy = overlap_remedy(overlap["paths"]) if ISOLATION_NUDGE else []
                interrupts.append(
                    {
                        "kind": "contention",
                        "severity": "warning",
                        "peer": overlap["peer"],
                        "peer_label": overlap["peer_label"],
                        "paths": overlap["paths"],
                        "keys": [],
                        "summary": with_remedy(
                            f"Exclusive-writer overlap with {overlap['peer_label']}: "
                            f"{', '.join(overlap['paths'])}",
                            remedy,
                        ),
                        "remedy": remedy,
                        "new": False,
                        "event_id": None,
                    }
                )

        # Source ownership can be perfectly disjoint while concurrent builds
        # still consume another lane's dirty compile state and shared artifacts.
        building_nudge = self.concurrent_builder_nudge(focus)
        if building_nudge:
            interrupts.append(
                {
                    "kind": "contention",
                    "reason": "concurrent_builders",
                    "severity": "warning",
                    "peer": None,
                    "peer_label": None,
                    "peers": building_nudge["peers"],
                    "peer_labels": building_nudge["peer_labels"],
                    "paths": [],
                    "keys": [],
                    "summary": building_nudge["summary"],
                    "remedy": building_nudge["remedy"],
                    "new": False,
                    "event_id": None,
                }
            )

        # Declared branch that this working tree is not on: isolation is mandatory.
        mismatch = self.branch_mismatch(focus)
        if mismatch:
            interrupts.append(
                {
                    "kind": "contention",
                    "severity": "warning",
                    "peer": None,
                    "peer_label": None,
                    "paths": [],
                    "keys": [],
                    "summary": with_remedy(
                        f"Declared branch {mismatch['declared']} is not this checkout's branch "
                        f"({mismatch['head']}): one working tree holds one branch",
                        mismatch["remedy"],
                    ),
                    "remedy": mismatch["remedy"],
                    "new": False,
                    "event_id": None,
                }
            )

        # Courtesy notice: an auditor is reading paths this writer owns.
        if my_mode == "writer":
            my_write_paths = sorted({*my_territory, *my_paths})
            for agent_id, record in sorted(self._live_records(agents).items()):
                if self._record_mode(record) != "read-only":
                    continue
                reader_paths = self._record_territory(record)
                reader_focus = self.focus_map().get(agent_id) or {}
                reader_paths = sorted({*reader_paths, *[str(item) for item in reader_focus.get("paths", [])]})
                shared = sorted(
                    {
                        mine
                        for mine in my_write_paths
                        for theirs in reader_paths
                        if path_overlaps(mine, theirs)
                    }
                )
                if not shared:
                    continue
                label = record.get("alias") or agent_id
                interrupts.append(
                    {
                        "kind": "notice",
                        "severity": "info",
                        "peer": agent_id,
                        "peer_label": label,
                        "paths": shared,
                        "keys": [],
                        "summary": f"Auditor {label} active on your paths: {', '.join(shared)}",
                        "new": False,
                        "event_id": None,
                    }
                )

        # Current dependencies.
        for need in my_needs:
            match = self._matching_publish(need, publishes)
            if match:
                owner_label = match.get("owner_alias") or match.get("owner")
                seq = 0
                latest_event = next(
                    (
                        event
                        for event in reversed(self._load_events())
                        if event.get("kind") == "publish_add"
                        and need.get("key") in event.get("keys", [])
                        and event.get("agent_id") == match.get("owner")
                    ),
                    None,
                )
                if latest_event:
                    seq = int(latest_event.get("seq", 0))
                interrupts.append(
                    {
                        "kind": "dependency",
                        "severity": "info",
                        "peer": match.get("owner"),
                        "peer_label": owner_label,
                        "paths": [],
                        "keys": [need["key"]],
                        "summary": f"Dependency satisfied: {need['key']} is available from {owner_label}",
                        "new": seq > last_seen_seq,
                        "event_id": latest_event.get("id") if latest_event else None,
                    }
                )
                continue

            from_target = need.get("from")
            if not from_target:
                continue
            owner_record = agents.get(str(from_target), {})
            owner_label = owner_record.get("alias") or need.get("from_alias") or from_target
            owner_status = classify_presence(owner_record) if owner_record else "unknown"
            interrupts.append(
                {
                    "kind": "dependency",
                    "severity": "warning" if owner_status == "active" else "info",
                    "peer": from_target,
                    "peer_label": owner_label,
                    "paths": [],
                    "keys": [need["key"]],
                    "summary": (
                        f"Dependency still blocked on {owner_label}: {need['key']}"
                        if owner_status == "active"
                        else f"Dependency waiting with no active owner: {need['key']}"
                    ),
                    "new": False,
                    "event_id": None,
                }
            )

        # An addressed need must be readable by its recipient, not just its owner.
        for need in self._load_needs():
            if need.get("owner") == self.agent_id or need.get("from") != self.agent_id:
                continue
            latest_event = next(
                (
                    event for event in reversed(self._load_events())
                    if event.get("kind") == "need_add"
                    and need.get("key") in event.get("keys", [])
                    and event.get("agent_id") == need.get("owner")
                ),
                None,
            )
            seq = int(latest_event.get("seq", 0)) if latest_event else 0
            label = need.get("owner_alias") or need.get("owner")
            interrupts.append({
                "kind": "dependency",
                "severity": "info",
                "peer": need.get("owner"),
                "peer_label": label,
                "paths": [],
                "keys": [need["key"]],
                "summary": f"Dependency requested by {label}: {need['key']}: {need['why']}",
                "new": seq > last_seen_seq,
                "event_id": latest_event.get("id") if latest_event else None,
            })

        # Drops addressed to me (or matching a need key). A resolved drop has
        # left routine interrupts for everyone. An `info` drop is a delivery:
        # once I acknowledge its current revision it has left mine. An
        # `action` drop is an obligation: acknowledging it says "read", not
        # "finished", so it stays listed (no longer new) until it is
        # resolved, and the router keeps reminding at work boundaries.
        # Everything stays readable through `drops --all` and `drop history`.
        all_drops = self._load_drops()
        for drop in all_drops:
            if drop.get("owner") == self.agent_id:
                continue
            if drop.get("status") == "resolved":
                continue
            key = drop.get("key")
            key_match = not isinstance(drop.get("for_item"), dict) and bool(key) and str(key) in my_need_keys
            if not (self._drop_targets_me(drop, agents) or key_match):
                continue
            acknowledged = self._drop_acknowledged_by_me(drop)
            is_action = drop.get("kind") == "action"
            if acknowledged and not is_action:
                continue
            # A drop that answers one of my declared needs is a dependency
            # satisfied, whatever its kind; a plain delivery is a notice.
            dependency_kind = is_action or key_match
            drop_path = str(drop.get("path", ""))
            drop_id = str(drop.get("id"))
            latest_event = next(
                (
                    event
                    for event in reversed(self._load_events())
                    if event.get("kind") == "drop_add"
                    and (
                        event.get("drop_id") == drop_id
                        or (event.get("drop_id") is None and drop_path in event.get("paths", []))
                    )
                    and event.get("agent_id") == drop.get("owner")
                ),
                None,
            )
            seq = int(latest_event.get("seq", 0)) if latest_event else 0
            note = f" — {drop.get('note')}" if drop.get("note") else ""
            reported_at = drop.get("updated_at") or drop.get("created_at")
            # The note describes the state of things when it was written. It
            # is labelled as a dated report, never as a verified present fact.
            if is_action:
                state = "acknowledged, unresolved" if acknowledged else "unresolved"
                remedy = (
                    f"resolve when done: agent-do coord drop resolve {drop_id} --reason <text>"
                    if acknowledged
                    else f"ack when read: agent-do coord drop ack {drop_id}; resolve when done"
                )
                label = "Action"
            else:
                state = "informational"
                remedy = f"ack when read: agent-do coord drop ack {drop_id}"
                label = "Drop"
            for_item = drop.get("for_item") if isinstance(drop.get("for_item"), dict) else None
            stale = self._staleness(drop) if for_item else None
            if for_item:
                label = "Approval" if drop.get("approval") else label
                label = f"{label} for the worker on {for_item.get('id')}"
                note += approval_text(drop.get("approval"))
            if stale:
                # The assignment moved since this drop pinned it. Coord refuses
                # the recipient both ack and resolve, so for them it is void: a
                # notice that never blocks the router and names no command
                # coord would refuse. Only the owner retires or readdresses it.
                state = f"STALE: {stale.get('reason')}: {stale.get('detail')}"
                remedy = stale_recipient_remedy(drop, for_item)
                dependency_kind = False
            interrupts.append(
                {
                    # An obligation is a dependency (the router reminds at work
                    # boundaries); a delivery is a notice (shown, never blocking).
                    "kind": "dependency" if dependency_kind else "notice",
                    "severity": "warning" if is_action and not acknowledged and not stale else "info",
                    "peer": drop.get("owner"),
                    "peer_label": drop.get("owner_label") or drop.get("owner"),
                    "paths": [drop_path],
                    "keys": [str(key)] if key else [],
                    "drop_id": drop_id,
                    "drop_kind": "action" if is_action else "info",
                    "revision": drop.get("revision"),
                    "reported_at": reported_at,
                    "acknowledged": acknowledged,
                    "item": for_item.get("id") if for_item else None,
                    "stale": stale,
                    "summary": (
                        f"{label} {drop_id} from {drop.get('owner_label') or drop.get('owner')}: {drop_path}{note} "
                        f"[{state}; reported {format_age(reported_at)}, not re-verified; {remedy}]"
                    ),
                    "new": seq > last_seen_seq and not acknowledged,
                    "event_id": latest_event.get("id") if latest_event else None,
                }
            )

        # My own obligations that nobody has acknowledged stay in front of me:
        # an unacknowledged action drop or approval is undelivered work, not a
        # finished handoff, whatever the ledger write or the bell said.
        for drop in all_drops:
            if drop.get("owner") != self.agent_id or drop.get("status") == "resolved" or drop.get("kind") != "action":
                continue
            delivery = self._delivery_view(drop, agents)
            if delivery["stage"] in {"acknowledged", "completed"}:
                continue
            recipient = delivery["recipient"]
            if recipient["state"] == "broadcast":
                continue
            drop_id = str(drop.get("id"))
            for_item = drop.get("for_item") if isinstance(drop.get("for_item"), dict) else None
            where = (
                f"the worker on {for_item.get('id')}" if for_item else str(drop.get("for"))
            ) + (f" ({recipient['agent_id']}, {recipient.get('presence')})" if recipient.get("agent_id") else "")
            if recipient["state"] == "resolved":
                detail = f"stage {delivery['stage']}; not acknowledged since {format_age(drop.get('updated_at') or drop.get('created_at'))}"
            else:
                detail = f"{recipient['state']}: {recipient.get('reason')}"
            stale = delivery.get("stale")
            notification = delivery.get("notification") or {}
            if notification.get("state") and notification["state"] != "wanted":
                request = notification.get("request") or {}
                detail += f"; wake {notification['state']}" + (
                    f" ({request.get('consumer')}, {request.get('age')}; a transport fact, not an ack)" if request else ""
                )
            noun = "approval" if drop.get("approval") else "action"
            if for_item and stale:
                # Nobody can acknowledge a stale assignment drop. The owner's
                # two ways out are retiring it or re-pinning it explicitly;
                # both commands run as the owner, so both are named exactly.
                summary = (
                    f"Stale {noun} {drop_id} for {where}: {stale.get('reason')}: {stale.get('detail')}; "
                    f"its recipient can neither acknowledge nor resolve it "
                    f"[retire: agent-do coord drop resolve {drop_id} --reason <text>; "
                    f"or readdress: {readdress_command(self.project_root, drop, for_item)}; "
                    f"re-check: agent-do coord worker {for_item.get('id')}]"
                )
            elif for_item:
                summary = (
                    f"Awaiting acknowledgment: {noun} {drop_id} for {where}: {detail} "
                    f"[re-check: agent-do coord worker {for_item.get('id')}]"
                )
            else:
                summary = f"Awaiting acknowledgment: action {drop_id} for {where}: {detail}"
            interrupts.append(
                {
                    "kind": "notice",
                    "severity": "info",
                    "peer": recipient.get("agent_id"),
                    "peer_label": recipient.get("agent_id"),
                    "paths": [str(drop.get("path", ""))],
                    "keys": [],
                    "drop_id": drop_id,
                    "drop_kind": "action",
                    "awaiting": True,
                    "item": for_item.get("id") if for_item else None,
                    "stale": stale,
                    "delivery": delivery,
                    "summary": summary,
                    "new": False,
                    "event_id": None,
                }
            )

        # Relevant novelty since last seen.
        seen_by_novelty: set[int] = set()
        for event in self._load_events():
            seq = int(event.get("seq", 0))
            if seq <= last_seen_seq:
                continue
            if event.get("agent_id") == self.agent_id:
                continue
            event_paths = [str(item) for item in event.get("paths", [])]
            event_keys = {str(item) for item in event.get("keys", [])}
            relevant = False
            if event_paths and any(path_overlaps(mine, theirs) for mine in my_paths for theirs in event_paths):
                relevant = True
            if event_keys and event_keys & my_need_keys:
                relevant = True
            if not relevant:
                continue
            if event.get("kind") in {"focus_set", "claim"}:
                continue
            seen_by_novelty.add(seq)
            interrupts.append(
                {
                    "kind": "novelty",
                    "severity": "info",
                    "peer": event.get("agent_id"),
                    "peer_label": event.get("agent_alias") or event.get("agent_id"),
                    "paths": event_paths,
                    "keys": sorted(event_keys),
                    "summary": event.get("summary"),
                    "new": True,
                    "event_id": event.get("id"),
                }
            )

        interrupts.sort(
            key=lambda item: (
                {"contention": 0, "notice": 1, "dependency": 2, "novelty": 3}.get(str(item.get("kind")), 9),
                0 if item.get("new") else 1,
                item.get("summary", ""),
            )
        )
        interrupts = interrupts[:limit]

        max_seq = max((int(item.get("seq", 0)) for item in self._load_events()), default=last_seen_seq)
        if mark_seen and max_seq > last_seen_seq:
            self._mark_interrupt_seq(max_seq)

        counts = {"contention": 0, "notice": 0, "dependency": 0, "novelty": 0}
        for item in interrupts:
            kind = str(item.get("kind"))
            counts[kind] = counts.get(kind, 0) + 1

        return {
            "interrupts": interrupts,
            "counts": counts,
            "last_interrupt_seq": last_seen_seq,
            "current_event_seq": max_seq,
            "focus": focus or None,
        }

    def touch(self) -> dict[str, Any]:
        agent = self.register_self(bind=True)
        delivered = self._deliver_pending_item_drops()
        current_focus = self.focus_for()
        peers = self.peers(include_stale=True)
        others = [peer for peer in peers if not peer["current"]]
        active_peers = [peer for peer in others if peer["status"] == "active"]
        peer_counts = {"active": 0, "idle": 0, "stopped": 0, "dead": 0, "stale": 0}
        for peer in others:
            status = str(peer["status"])
            peer_counts[status] = peer_counts.get(status, 0) + 1
        return {
            "agent": {
                **agent,
                "status": classify_presence(agent),
            },
            "focus": current_focus,
            "manna": agent.get("manna"),
            "delivered": delivered,
            "active_peers": active_peers,
            "peer_counts": peer_counts,
            "active_window_seconds": ACTIVE_WINDOW_SECONDS,
            "idle_window_seconds": IDLE_WINDOW_SECONDS,
        }

    def status(self) -> dict[str, Any]:
        record = self.self_record()
        my_claims = [item for item in self.claims() if item.get("owner") == self.agent_id]
        my_needs = self.needs()
        my_publishes = [item for item in self.publishes() if item.get("owner") == self.agent_id]
        interrupt_state = self.interrupts(mark_seen=False, limit=20)
        return {
            "agent": {
                "agent_id": self.agent_id,
                "alias": record.get("alias"),
                "status": classify_presence(record),
                "last_seen": record.get("last_seen"),
                "lease_expires_at": record.get("lease_expires_at"),
            },
            "focus": self.focus_for(),
            "claims": my_claims,
            "needs": my_needs,
            "publishes": my_publishes,
            "interrupts": interrupt_state,
            "active_peers": [peer for peer in self.peers(include_stale=False) if not peer["current"] and peer["status"] == "active"],
        }


