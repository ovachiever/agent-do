def format_peer(peer: dict[str, Any]) -> str:
    label = peer.get("alias") or peer.get("agent_id")
    current = " current" if peer.get("current") else ""
    focus = peer.get("focus") or {}
    parts = [f"{label} status:{peer.get('status')}({peer.get('age')})"]
    if peer.get("role"):
        mode = peer.get("mode")
        role = str(peer.get("role"))
        parts.append(f"role:{role}[read-only]" if mode == "read-only" else f"role:{role}")
    if peer.get("phase"):
        parts.append(f"phase:{peer.get('phase')}")
    if focus.get("goal"):
        parts.append(f'goal:"{focus.get("goal")}"')
    pulse = peer.get("pulse") or {}
    if pulse.get("status"):
        parts.append(f"pulse:{pulse['status']}({format_age(pulse.get('updated_at'))})")
        attention = (pulse.get("attention") or {}).get("message")
        if pulse["status"] == "needs-user" and attention:
            parts.append(f'attn:"{attention}"')
        if pulse["status"] == "working" and pulse.get("activity"):
            parts.append(f"act:{pulse['activity']}")
        todo = pulse.get("todo") or {}
        if todo.get("total"):
            label = f' "{todo["current"]}"' if todo.get("current") else ""
            parts.append(f"todo:{todo.get('done', 0)}/{todo['total']}{label}")
        if not focus.get("goal") and pulse.get("latest_prompt"):
            parts.append(f'prompt:"{pulse["latest_prompt"]}"')
    if peer.get("stop_note"):
        parts.append(f'note:"{peer.get("stop_note")}"')
    return " ".join(parts) + current


def format_interrupt(item: dict[str, Any]) -> str:
    prefix = "[new] " if item.get("new") else ""
    return f"{prefix}{item.get('kind')}: {item.get('summary')}"


def main(argv: list[str]) -> int:
    if len(argv) == 1 or argv[1] in {"--help", "-h", "help"}:
        print(HELP)
        return 0

    raw_args = argv[1:]
    force_json = False
    if "--json" in raw_args:
        force_json = True
        raw_args = [arg for arg in raw_args if arg != "--json"]

    args = parser().parse_args(raw_args)
    args.json = bool(force_json or getattr(args, "json", False))
    if not args.command:
        print(HELP)
        return 0

    if (
        args.command == "pulse"
        and getattr(args, "pulse_command", None) == "record"
        and args.from_hook
    ):
        # Hook-safe by contract: whatever happens, exit 0 with empty stdout —
        # a telemetry write must never break or chatter into a session's hooks.
        try:
            payload = json.load(sys.stdin)
            if not isinstance(payload, dict):
                return 0
            session = payload.get("session_id")
            if isinstance(session, str) and session:
                # The payload names the session that generated the event, and it
                # outranks any inherited pin: a hook process carrying another
                # session's env must never write telemetry onto that row. Real
                # hooks agree with their own pin; this guards the crossed case.
                os.environ["AGENT_DO_COORD_SESSION"] = session
            cwd_value = payload.get("cwd")
            base = Path.cwd()
            if isinstance(cwd_value, str) and cwd_value:
                candidate = Path(cwd_value)
                if candidate.is_dir():
                    base = candidate
            CoordStore(base).record_pulse(payload)
        except Exception:
            pass
        return 0

    if args.command == "pulse" and getattr(args, "pulse_command", None) == "record":
        if not args.session or not args.status or not args.updated_at:
            return error(
                "explicit pulse record requires --session, --status, and --updated-at",
                args.json,
                code=2,
            )
        try:
            store = CoordStore(Path.cwd(), identify=False)
            payload, changed = store.record_explicit_pulse(
                args.session,
                args.status,
                args.updated_at,
                args.activity,
                args.clear_activity,
            )
        except ValueError as exc:
            return error(str(exc), args.json, code=2)
        return print_payload(
            {"success": True, "tool": "coord", "changed": changed, "pulse": payload},
            args.json,
        )

    store = CoordStore(Path.cwd())

    if args.command == "touch":
        payload = store.touch()
        payload.update(
            {
                "success": True,
                "tool": "coord",
                "agent_id": store.agent_id,
                "project_root": str(store.project_root),
                "coord_root": str(store.coord_root),
                "storage": store.storage,
            }
        )
        return print_payload(payload, args.json)

    if args.command == "whoami":
        record = store.self_record()
        payload = {
            "success": True,
            "tool": "coord",
            "agent_id": store.agent_id,
            "alias": record.get("alias"),
            "identity_source": store.identity_source,
            "session": store.session,
            "pid": record.get("pid"),
            "pid_start": record.get("pid_start"),
            "pane": record.get("pane"),
            "host": record.get("host"),
            "runtime": record.get("runtime"),
            "model": record.get("model"),
            "project_root": str(store.project_root),
            "coord_root": str(store.coord_root),
            "storage": store.storage,
            "last_seen": record.get("last_seen"),
            "lease_expires_at": record.get("lease_expires_at"),
            "status": classify_presence(record),
            "active_window_seconds": ACTIVE_WINDOW_SECONDS,
            "idle_window_seconds": IDLE_WINDOW_SECONDS,
        }
        return print_payload(payload, args.json)

    if args.command == "alias":
        record = store.alias_self(args.name)
        return print_payload({"success": True, "tool": "coord", "agent": record}, args.json)

    if args.command == "aliases":
        aliases = store.aliases()
        if args.json:
            return print_payload({"success": True, "tool": "coord", "aliases": aliases}, True)
        if not aliases:
            print("No aliases.")
            return 0
        for item in aliases:
            current = " (current)" if item["current"] else ""
            print(f'{item["alias"]} -> {item["agent_id"]} status:{item["status"]}{current}')
        return 0

    if args.command == "stop":
        record = store.stop(args.note)
        return print_payload({"success": True, "tool": "coord", "agent": record}, args.json)

    if args.command == "bye":
        record = store.bye()
        return print_payload({"success": True, "tool": "coord", "removed": record}, args.json)

    if args.command == "peers":
        peers = store.peers(
            include_stale=args.all,
            active_only=args.active_only,
            writers_only=args.writers_only,
        )
        if args.json:
            return print_payload({"success": True, "tool": "coord", "peers": peers}, True)
        if not peers:
            print("No peers.")
            return 0
        for peer in peers:
            print(format_peer(peer))
        return 0

    if args.command == "status":
        payload = store.status()
        if args.json:
            return print_payload({"success": True, "tool": "coord", **payload}, True)
        agent = payload["agent"]
        print(f'Agent: {agent["alias"] or agent["agent_id"]} status:{agent["status"]}')
        if payload["focus"]:
            print(f'Focus: {payload["focus"]["goal"]} [{", ".join(payload["focus"]["paths"])}]')
        print(
            "State:"
            f" claims={len(payload['claims'])}"
            f" needs={len(payload['needs'])}"
            f" publishes={len(payload['publishes'])}"
            f" active_peers={len(payload['active_peers'])}"
        )
        print(
            "Interrupts:"
            f" contention={payload['interrupts']['counts']['contention']}"
            f" notice={payload['interrupts']['counts'].get('notice', 0)}"
            f" dependency={payload['interrupts']['counts']['dependency']}"
            f" novelty={payload['interrupts']['counts']['novelty']}"
        )
        return 0

    if args.command == "interrupts":
        payload = store.interrupts(mark_seen=args.mark_seen, limit=args.limit)
        if args.json:
            return print_payload({"success": True, "tool": "coord", **payload}, True)
        if not payload["interrupts"]:
            print("No interrupts.")
            return 0
        for item in payload["interrupts"]:
            print(format_interrupt(item))
        return 0

    if args.command == "focus":
        if args.focus_command == "set":
            payload = store.set_focus(
                args.goal,
                args.paths,
                phase=args.phase,
                note=args.note,
                blocking_on=args.blocking_on,
                last_ship=args.last_ship,
                branch=args.branch,
            )
            return print_payload(
                {
                    "success": True,
                    "tool": "coord",
                    "focus": payload,
                    "branch_mismatch": store.branch_mismatch(payload),
                    "isolation_nudge": store.concurrent_builder_nudge(payload),
                },
                args.json,
            )
        if args.focus_command == "show":
            payload = store.focus_for(args.peer)
            if payload is None:
                return error("Focus not found", args.json, code=2)
            return print_payload({"success": True, "tool": "coord", "focus": payload}, args.json)
        if args.focus_command == "clear":
            payload = store.clear_focus()
            return print_payload({"success": True, "tool": "coord", "cleared": payload}, args.json)
        return error("focus requires set|show|clear", args.json, code=2)

    if args.command == "role":
        if args.role_command == "set":
            payload, overlaps = store.set_role(args.role, args.mode, args.territory)
            return print_payload(
                {"success": True, "tool": "coord", "role": payload, "overlaps": overlaps},
                args.json,
            )
        return error("role requires set", args.json, code=2)

    if args.command == "territory":
        if args.territory_command == "show":
            payload = store.territory_map()
            if args.json:
                return print_payload({"success": True, "tool": "coord", **payload}, True)
            if not payload["territories"]:
                print("No territories declared.")
                return 0
            for entry in payload["territories"]:
                current = " (current)" if entry["current"] else ""
                paths = ", ".join(entry["territory"]) or "-"
                print(
                    f'{entry["label"]} ({entry["role"] or "no-role"}, {entry["mode"]}, '
                    f'{entry["status"]} {entry["age"]}){current}: {paths}'
                )
            for overlap in payload["overlaps"]:
                labels = " & ".join(overlap["labels"])
                print(f'!! OVERLAP: {", ".join(overlap["paths"])} — {labels}')
            return 0
        return error("territory requires show", args.json, code=2)

    if args.command == "guard":
        if args.guard_command == "check":
            payload = store.guard_check(args.paths, args.staged)
            if args.json:
                print_payload({"success": True, "tool": "coord", **payload}, True)
            elif payload["clean"]:
                print("guard: clean — no live claims or territories intersect.")
            else:
                for item in payload["warnings"]:
                    owned = item.get("owned_path")
                    print(
                        f'guard WARN: {item["path"]} intersects {item["owner_label"]} '
                        f'({item["kind"]}: {owned})'
                    )
            return 0
        if args.guard_command == "install":
            payload = store.guard_install()
            if not payload.get("installed"):
                return error(str(payload.get("error") or "guard install failed"), args.json)
            return print_payload({"success": True, "tool": "coord", **payload}, args.json)
        return error("guard requires check|install", args.json, code=2)

    if args.command == "pulse":
        if args.pulse_command == "show":
            payload = store.pulse_for(args.peer)
            if payload is None:
                return error("Pulse not found", args.json, code=2)
            return print_payload({"success": True, "tool": "coord", "pulse": payload}, args.json)
        print(HELP)
        return 0

    if args.command == "claims":
        claims = store.claims()
        return print_payload({"success": True, "tool": "coord", "claims": claims}, args.json)

    if args.command == "claim":
        ok, claim, message = store.claim(args.path, args.reason, args.strength)
        if not ok:
            return error(message or "Unable to claim path", args.json)
        return print_payload({"success": True, "tool": "coord", "claim": claim}, args.json)

    if args.command == "release":
        ok, payload, message = store.release(args.path)
        if not ok:
            return error(message or "Unable to release path", args.json)
        return print_payload({"success": True, "tool": "coord", "released": payload}, args.json)

    if args.command == "need":
        if args.need_command == "add":
            payload = store.add_need(args.key, args.why, args.from_target)
            return print_payload({"success": True, "tool": "coord", "need": payload}, args.json)
        if args.need_command == "list":
            payload = store.needs(include_all=args.all)
            return print_payload({"success": True, "tool": "coord", "needs": payload}, args.json)
        if args.need_command == "clear":
            ok, payload = store.clear_need(args.key)
            if not ok:
                return error(f"No active need for {args.key}", args.json, code=2)
            return print_payload({"success": True, "tool": "coord", "cleared": payload}, args.json)
        return error("need requires add|list|clear", args.json, code=2)

    if args.command == "publishes":
        payload = store.publishes()
        return print_payload({"success": True, "tool": "coord", "publishes": payload}, args.json)

    if args.command == "drop":
        if args.drop_command == "add":
            payload = store.add_drop(args.path, args.target, args.note, args.key)
            return print_payload({"success": True, "tool": "coord", "drop": payload}, args.json)
        return error("drop requires add", args.json, code=2)

    if args.command == "drops":
        payload = store.drops(for_me=args.for_me)
        if args.json:
            return print_payload({"success": True, "tool": "coord", "drops": payload}, True)
        if not payload:
            print("No drops.")
            return 0
        for item in payload:
            target = item.get("for") or "any"
            note = f' — {item.get("note")}' if item.get("note") else ""
            print(f'{item.get("path")} (from {item.get("owner_label")}, for {target}){note}')
        return 0

    if args.command == "history":
        events = store.history(peer=args.peer, limit=args.limit)
        if args.json:
            return print_payload({"success": True, "tool": "coord", "events": events}, True)
        if not events:
            print("No history.")
            return 0
        for event in events:
            label = event.get("agent_alias") or event.get("agent_id")
            print(f'{event.get("created_at")} {event.get("kind")} {label}: {event.get("summary")}')
        return 0

    if args.command == "publish":
        if args.publish_command == "add":
            payload = store.add_publish(args.key, args.status, args.summary, args.ref, file_path=args.file_path)
            return print_payload({"success": True, "tool": "coord", "publish": payload}, args.json)
        if args.publish_command == "clear":
            ok, payload = store.clear_publish(args.key)
            if not ok:
                return error(f"No active publish for {args.key}", args.json, code=2)
            return print_payload({"success": True, "tool": "coord", "cleared": payload}, args.json)
        return error("publish requires add|clear", args.json, code=2)

    print(HELP)
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
