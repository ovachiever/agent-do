def overlap_remedy(paths: list[str]) -> list[str]:
    """Ownership comes first because isolation does not permit two writers on one path."""
    joined = ", ".join(paths) or "the contended paths"
    return [
        f"split ownership so each contended path has one owner: {joined} "
        "(required before any isolation; one path still has one writer)",
        f"if both lanes are building, or the work otherwise cannot share a tree, "
        f"isolate it: {WORKTREE_COMMAND} ({WORKTREE_CAVEAT})",
    ]


def branch_remedy(branch: str) -> list[str]:
    """A branch mismatch is not a preference: one working tree holds one branch."""
    return [
        f"isolation is mandatory here: agent-do git worktree add {branch} ({WORKTREE_CAVEAT})",
        "or drop the branch declaration and work on this checkout's branch",
    ]


def concurrent_builder_remedy() -> list[str]:
    """A build consumes checkout-wide state even when source ownership is clean."""
    return [
        f"move this build lane to an isolated worktree before compiling: {WORKTREE_COMMAND} "
        f"(compile state and build artifacts are checkout-wide; {WORKTREE_CAVEAT})",
    ]


def with_remedy(summary: str, remedy: list[str]) -> str:
    if not remedy:
        return summary
    steps = "; ".join(f"{index}) {step}" for index, step in enumerate(remedy, start=1))
    return f"{summary} — remedy: {steps}"


def now() -> datetime:
    return datetime.now(timezone.utc)


def now_iso() -> str:
    return now().replace(microsecond=0).isoformat().replace("+00:00", "Z")


def parse_iso(value: str | None) -> datetime | None:
    if not value or not isinstance(value, str):
        return None
    try:
        return datetime.fromisoformat(value.replace("Z", "+00:00"))
    except ValueError:
        return None


def age_seconds(value: str | None) -> int | None:
    parsed = parse_iso(value)
    if parsed is None:
        return None
    return max(0, int((now() - parsed).total_seconds()))


def compact(value: str) -> str:
    return re.sub(r"[^a-zA-Z0-9]+", "", value).lower()[:16]


def sanitize(value: str) -> str:
    value = re.sub(r"[^a-zA-Z0-9._-]+", "-", value).strip("-_.").lower()
    return value[:24]


def print_payload(payload: Any, as_json: bool) -> int:
    if as_json:
        print(json.dumps(payload, indent=2, sort_keys=False))
    else:
        if isinstance(payload, str):
            print(payload)
        else:
            print(json.dumps(payload, indent=2, sort_keys=False))
    return 0


def error(message: str, as_json: bool, code: int = 1, **extra: Any) -> int:
    payload = {"success": False, "error": message, "code": code}
    payload.update(extra)
    if as_json:
        print(json.dumps(payload, indent=2, sort_keys=False))
    else:
        print(f"Error: {message}", file=sys.stderr)
    return code


def git_output(cwd: Path, *args: str) -> str | None:
    completed = subprocess.run(
        ["git", *args],
        cwd=cwd,
        text=True,
        capture_output=True,
        check=False,
    )
    if completed.returncode != 0:
        return None
    return completed.stdout.strip()


def normalize_branch(value: str | None) -> str | None:
    if not isinstance(value, str):
        return None
    raw = value.strip()
    if raw.startswith("refs/heads/"):
        raw = raw[len("refs/heads/"):]
    return raw or None


def checkout_branch(cwd: Path) -> str | None:
    """The branch this working tree is on; None when detached or outside a repo."""
    return normalize_branch(git_output(cwd, "symbolic-ref", "--quiet", "--short", "HEAD"))


def resolve_project_paths(cwd: Path) -> dict[str, str]:
    git_dir_text = git_output(cwd, "rev-parse", "--git-dir")
    if git_dir_text:
        git_dir = Path(git_dir_text)
        if not git_dir.is_absolute():
            git_dir = (cwd / git_dir).resolve()
        project_root_text = git_output(cwd, "rev-parse", "--show-toplevel")
        project_root = Path(project_root_text).resolve() if project_root_text else cwd.resolve()
        coord_root = git_dir / "agent-do" / "coord"
        return {
            "project_root": str(project_root),
            "coord_root": str(coord_root),
            "storage": "git-local",
        }

    project_root = cwd.resolve()
    project_hash = hashlib.sha1(str(project_root).encode("utf-8")).hexdigest()[:16]
    home = Path(os.environ.get("AGENT_DO_HOME", str(Path.home() / ".agent-do")))
    coord_root = home / "projects" / project_hash / "coord"
    return {
        "project_root": str(project_root),
        "coord_root": str(coord_root),
        "storage": "global-fallback",
    }


def ps_lstart(pid: int) -> str | None:
    completed = subprocess.run(
        ["ps", "-p", str(pid), "-o", "lstart="],
        text=True,
        capture_output=True,
        check=False,
    )
    if completed.returncode != 0:
        return None
    value = completed.stdout.strip()
    return value or None


ANCHOR_RUNTIME_NAMES = {"claude", "codex"} | {
    name.strip().lower()
    for name in os.environ.get("AGENT_DO_COORD_ANCHOR_NAMES", "").split(",")
    if name.strip()
}


def process_table() -> dict[int, tuple[int, str]]:
    completed = subprocess.run(
        ["ps", "-axo", "pid=,ppid=,comm="],
        text=True,
        capture_output=True,
        check=False,
    )
    table: dict[int, tuple[int, str]] = {}
    if completed.returncode != 0:
        return table
    for line in completed.stdout.splitlines():
        parts = line.split(None, 2)
        if len(parts) < 3:
            continue
        try:
            table[int(parts[0])] = (int(parts[1]), parts[2].strip())
        except ValueError:
            continue
    return table


def find_anchor_pid() -> int:
    """The long-lived process this agent session hangs off.

    Agent harnesses spawn a fresh shell per command (its own session leader,
    gone seconds later), so os.getsid(0) is unusable there: it would mint a
    new identity per call and record a pid that immediately dies. Walk the
    ancestry to the nearest process named like an agent runtime instead;
    plain interactive shells fall back to the session leader (the pane shell).
    """
    table = process_table()
    pid = os.getpid()
    for _ in range(25):
        entry = table.get(pid)
        if entry is None:
            break
        ppid, comm = entry
        name = os.path.basename(comm).lstrip("-").lower()
        if pid != os.getpid() and name in ANCHOR_RUNTIME_NAMES:
            return pid
        if ppid <= 1:
            break
        pid = ppid
    try:
        return os.getsid(0)
    except OSError:
        return os.getppid()


def process_anchor() -> dict[str, Any]:
    """Anchor process for identity + liveness: pid + start time + display hints."""
    pid_env = os.environ.get("AGENT_DO_COORD_PID")
    pid: int | None = None
    if pid_env:
        try:
            pid = int(pid_env)
        except ValueError:
            pid = None
    if pid is None:
        pid = find_anchor_pid()
    start = os.environ.get("AGENT_DO_COORD_PID_START") or ps_lstart(pid) or ""
    return {
        "pid": pid,
        "pid_start": start,
        "pane": os.environ.get("TMUX_PANE"),
        "host": socket.gethostname(),
    }


def process_liveness(record: dict[str, Any]) -> bool | None:
    """True = verified alive, False = verified gone/reused, None = unverifiable."""
    pid = record.get("pid")
    if pid is None:
        return None
    host = record.get("host")
    if host and host != socket.gethostname():
        return None
    try:
        pid = int(pid)
    except (TypeError, ValueError):
        return None
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        pass
    except OSError:
        return None
    expected_start = record.get("pid_start")
    if expected_start:
        current_start = ps_lstart(pid)
        if current_start and current_start != expected_start:
            return False
    return True


def detect_runtime(identity_source: str) -> str:
    override = os.environ.get("AGENT_DO_COORD_RUNTIME")
    if override in RUNTIMES:
        return override
    if identity_source.startswith("CODEX"):
        return "codex"
    if identity_source.startswith("CLAUDE") or os.environ.get("CLAUDECODE"):
        return "claude"
    return "other"


def derive_identity(coord_root: Path, anchor: dict[str, Any]) -> dict[str, str | None]:
    explicit = os.environ.get("AGENT_DO_COORD_SESSION")
    if explicit:
        short = compact(explicit)[:12]
        if short:
            return {
                "agent_id": f"session-{short}",
                "source": "AGENT_DO_COORD_SESSION",
                "raw": explicit,
                "session": explicit,
            }

    for prefix, env_key in THREAD_CANDIDATES:
        value = os.environ.get(env_key)
        if not value:
            continue
        short = compact(value)
        if short:
            return {"agent_id": f"{prefix}-{short}", "source": env_key, "raw": value, "session": None}

    # Pane/host fallback: mint a session UUID at first contact, keyed by the
    # anchoring process, so a recycled pane never inherits a dead session's identity.
    scope = anchor.get("pane") or anchor.get("host") or "local"
    anchor_key = f"{scope}|{anchor.get('pid')}|{anchor.get('pid_start')}"
    session = mint_session(coord_root, anchor_key)
    source = "TMUX_PANE+process" if anchor.get("pane") else "host+process"
    return {
        "agent_id": f"session-{session[:12]}",
        "source": source,
        "raw": anchor_key,
        "session": session,
    }


def mint_session(coord_root: Path, anchor_key: str) -> str:
    coord_root.mkdir(parents=True, exist_ok=True)
    sessions_path = coord_root / "sessions.json"
    lock_path = coord_root / ".lock"
    with lock_path.open("a+") as fh:
        fcntl.flock(fh.fileno(), fcntl.LOCK_EX)
        try:
            payload: dict[str, Any] = {"anchors": {}}
            if sessions_path.exists():
                try:
                    loaded = json.loads(sessions_path.read_text())
                    if isinstance(loaded, dict) and isinstance(loaded.get("anchors"), dict):
                        payload = loaded
                except json.JSONDecodeError:
                    pass
            anchors = payload["anchors"]
            entry = anchors.get(anchor_key)
            if isinstance(entry, dict) and isinstance(entry.get("session"), str) and entry["session"]:
                return entry["session"]
            session = uuid.uuid4().hex
            anchors[anchor_key] = {"session": session, "created_at": now_iso()}
            tmp = sessions_path.with_suffix(".json.tmp")
            tmp.write_text(json.dumps(payload, indent=2, sort_keys=True) + "\n")
            tmp.replace(sessions_path)
            return session
        finally:
            fcntl.flock(fh.fileno(), fcntl.LOCK_UN)


def normalize_path(project_root: Path, cwd: Path, value: str) -> str:
    raw = value.strip()
    if not raw:
        return raw
    candidate = Path(raw)
    if candidate.is_absolute():
        try:
            return candidate.resolve(strict=False).relative_to(project_root).as_posix()
        except ValueError:
            return candidate.as_posix()
    try:
        return (cwd / candidate).resolve(strict=False).relative_to(project_root).as_posix()
    except ValueError:
        return Path(os.path.normpath(raw)).as_posix()


def path_overlaps(a: str, b: str) -> bool:
    if not a or not b:
        return False
    if a == b:
        return True
    if a == "." or b == ".":
        return True
    return a.startswith(f"{b}/") or b.startswith(f"{a}/")


def classify_presence(record: dict[str, Any]) -> str:
    if record.get("dead"):
        return "dead"
    if record.get("stopped"):
        return "stopped"
    if process_liveness(record) is False:
        return "dead"
    lease_expires_at = parse_iso(record.get("lease_expires_at"))
    if lease_expires_at and now() <= lease_expires_at:
        return "active"
    last_seen = parse_iso(record.get("last_seen"))
    if last_seen is None:
        return "unknown"
    if (now() - last_seen).total_seconds() <= IDLE_WINDOW_SECONDS:
        return "idle"
    return "stale"


def clip(value: Any, limit: int) -> str | None:
    """Whitespace-normalized truncation with an honest marker, never a bare cut."""
    if not isinstance(value, str):
        return None
    text = " ".join(value.split())
    if not text:
        return None
    if len(text) <= limit:
        return text
    return text[: max(0, limit - 1)].rstrip() + "…"


def reduce_pulse(existing: dict[str, Any] | None, payload: dict[str, Any]) -> dict[str, Any] | None:
    """Fold one harness hook payload into a session's pulse state.

    Returns the updated state, or None for events that carry nothing for the
    pulse — unknown hook names are ignored so newer harnesses stay harmless.
    """
    event = payload.get("hook_event_name")
    if not isinstance(event, str):
        return None
    state = dict(existing or {})

    if event == "UserPromptSubmit":
        state["status"] = "working"
        prompt = clip(payload.get("prompt"), PULSE_PROMPT_CHARS)
        if prompt:
            state["latest_prompt"] = prompt
        state["turns"] = int(state.get("turns", 0) or 0) + 1
        state.pop("attention", None)
        state.pop("activity", None)
    elif event == "PreToolUse":
        state["status"] = "working"
        tool = clip(payload.get("tool_name"), PULSE_DETAIL_CHARS)
        if tool:
            state["activity"] = tool
        state.pop("attention", None)
    elif event == "PostToolUse":
        state["status"] = "working"
        if payload.get("tool_name") == "TodoWrite":
            todos = (payload.get("tool_input") or {}).get("todos")
            if isinstance(todos, list):
                rows = [item for item in todos if isinstance(item, dict)]
                current = next(
                    (item.get("content") for item in rows if item.get("status") == "in_progress"),
                    None,
                ) or next(
                    (item.get("content") for item in rows if item.get("status") == "pending"),
                    None,
                )
                state["todo"] = {
                    "done": sum(1 for item in rows if item.get("status") == "completed"),
                    "total": len(rows),
                    "current": clip(current, PULSE_DETAIL_CHARS),
                }
        state.pop("attention", None)
    elif event == "Notification":
        state["status"] = "needs-user"
        state["attention"] = {"message": clip(payload.get("message"), PULSE_PROMPT_CHARS)}
    elif event == "Stop":
        state["status"] = "finished"
        state.pop("activity", None)
        state.pop("attention", None)
    elif event == "StopFailure":
        state["status"] = "failed"
        state.pop("activity", None)
    elif event == "SessionEnd":
        state["status"] = "ended"
        state.pop("activity", None)
        state.pop("attention", None)
    else:
        return None

    state["updated_at"] = now_iso()
    state["event_count"] = int(state.get("event_count", 0) or 0) + 1
    return state


def pulse_agent_id(session_key: str) -> str:
    """Map a full harness session id or coord session key to its pulse row."""
    raw = session_key.strip()
    if raw.startswith("session-"):
        raw = raw[len("session-") :]
    short = compact(raw)[:12]
    if not short:
        raise ValueError("session must contain at least one letter or number")
    return f"session-{short}"


def normalize_pulse_timestamp(value: str) -> str:
    """Validate an external observation timestamp and normalize it to UTC."""
    parsed = parse_iso(value.strip())
    if parsed is None or parsed.tzinfo is None:
        raise ValueError("updated-at must be an RFC 3339 timestamp with a timezone")
    return parsed.astimezone(timezone.utc).isoformat().replace("+00:00", "Z")


def format_age(value: str | None) -> str:
    seconds = age_seconds(value)
    if seconds is None:
        return "unknown age"
    if seconds < 60:
        return f"{seconds}s ago"
    if seconds < 3600:
        return f"{seconds // 60}m ago"
    if seconds < 86400:
        return f"{seconds // 3600}h ago"
    return f"{seconds // 86400}d ago"


class CoordStore:
    def __init__(self, cwd: Path, *, identify: bool = True) -> None:
        paths = resolve_project_paths(cwd)
        self.cwd = cwd.resolve()
        self.project_root = Path(paths["project_root"])
        self.coord_root = Path(paths["coord_root"])
        self.storage = paths["storage"]

        self.coord_root.mkdir(parents=True, exist_ok=True)

        if identify:
            self.anchor = process_anchor()
            ident = derive_identity(self.coord_root, self.anchor)
            self.agent_id = str(ident["agent_id"])
            self.identity_source = str(ident["source"])
            self.identity_raw = ident["raw"]
            self.session = ident.get("session")
            self.runtime = detect_runtime(self.identity_source)
            self.model = os.environ.get("AGENT_DO_COORD_MODEL")
        else:
            # External pulse writers act on an explicit target key. They need
            # storage and the shared lock, but no caller identity or lease.
            self.anchor = {}
            self.agent_id = ""
            self.identity_source = ""
            self.identity_raw = None
            self.session = None
            self.runtime = "other"
            self.model = None

        self.agents_path = self.coord_root / "agents.json"
        self.focus_path = self.coord_root / "focus.json"
        self.claims_path = self.coord_root / "claims.json"
        self.needs_path = self.coord_root / "needs.json"
        self.publishes_path = self.coord_root / "publishes.json"
        self.drops_path = self.coord_root / "drops.json"
        self.pulse_path = self.coord_root / "pulse.json"
        self.events_path = self.coord_root / "events.jsonl"
        self.lock_path = self.coord_root / ".lock"

    @contextmanager
    def locked(self):
        self.lock_path.parent.mkdir(parents=True, exist_ok=True)
        with self.lock_path.open("a+") as fh:
            fcntl.flock(fh.fileno(), fcntl.LOCK_EX)
            try:
                yield
            finally:
                fcntl.flock(fh.fileno(), fcntl.LOCK_UN)

    def _read_json(self, path: Path, default: Any) -> Any:
        if not path.exists():
            return default
        try:
            return json.loads(path.read_text())
        except json.JSONDecodeError:
            return default

    def _write_json(self, path: Path, payload: Any) -> None:
        path.parent.mkdir(parents=True, exist_ok=True)
        tmp = path.with_suffix(path.suffix + ".tmp")
        tmp.write_text(json.dumps(payload, indent=2, sort_keys=True) + "\n")
        tmp.replace(path)

    def _load_agents(self) -> dict[str, dict[str, Any]]:
        payload = self._read_json(self.agents_path, {"agents": {}})
        agents = payload.get("agents", {})
        return agents if isinstance(agents, dict) else {}

    def _save_agents(self, agents: dict[str, dict[str, Any]]) -> None:
        self._write_json(self.agents_path, {"agents": agents})

    def _load_focus(self) -> dict[str, dict[str, Any]]:
        payload = self._read_json(self.focus_path, {"focus": {}})
        focus = payload.get("focus", {})
        return focus if isinstance(focus, dict) else {}

    def _save_focus(self, focus: dict[str, dict[str, Any]]) -> None:
        self._write_json(self.focus_path, {"focus": focus})

    def _load_claims(self) -> list[dict[str, Any]]:
        payload = self._read_json(self.claims_path, {"claims": []})
        claims = payload.get("claims", [])
        return claims if isinstance(claims, list) else []

    def _save_claims(self, claims: list[dict[str, Any]]) -> None:
        self._write_json(self.claims_path, {"claims": claims})

    def _load_needs(self) -> list[dict[str, Any]]:
        payload = self._read_json(self.needs_path, {"needs": []})
        needs = payload.get("needs", [])
        return needs if isinstance(needs, list) else []

    def _save_needs(self, needs: list[dict[str, Any]]) -> None:
        self._write_json(self.needs_path, {"needs": needs})

    def _load_publishes(self) -> list[dict[str, Any]]:
        payload = self._read_json(self.publishes_path, {"publishes": []})
        publishes = payload.get("publishes", [])
        return publishes if isinstance(publishes, list) else []

    def _save_publishes(self, publishes: list[dict[str, Any]]) -> None:
        self._write_json(self.publishes_path, {"publishes": publishes})

    def _load_drops(self) -> list[dict[str, Any]]:
        payload = self._read_json(self.drops_path, {"drops": []})
        drops = payload.get("drops", [])
        return drops if isinstance(drops, list) else []

    def _save_drops(self, drops: list[dict[str, Any]]) -> None:
        self._write_json(self.drops_path, {"drops": drops})

    def _load_pulse(self) -> dict[str, dict[str, Any]]:
        payload = self._read_json(self.pulse_path, {"pulse": {}})
        pulse = payload.get("pulse", {})
        return pulse if isinstance(pulse, dict) else {}

    def _save_pulse(self, pulse: dict[str, dict[str, Any]]) -> None:
        self._write_json(self.pulse_path, {"pulse": pulse})

    def _load_events(self) -> list[dict[str, Any]]:
        if not self.events_path.exists():
            return []
        events: list[dict[str, Any]] = []
        for line in self.events_path.read_text().splitlines():
            if not line.strip():
                continue
            try:
                event = json.loads(line)
            except json.JSONDecodeError:
                continue
            if isinstance(event, dict):
                events.append(event)
        events.sort(key=lambda item: int(item.get("seq", 0)))
        return events

    def _append_event(
        self,
        *,
        kind: str,
        paths: list[str] | None = None,
        keys: list[str] | None = None,
        summary: str,
    ) -> dict[str, Any]:
        events = self._load_events()
        seq = (max((int(item.get("seq", 0)) for item in events), default=0) + 1)
        self_record = self.self_record(refresh=False)
        event = {
            "seq": seq,
            "id": f"evt_{seq:06d}",
            "kind": kind,
            "agent_id": self.agent_id,
            "agent_alias": self_record.get("alias"),
            "paths": paths or [],
            "keys": keys or [],
            "summary": summary,
            "created_at": now_iso(),
        }
        with self.events_path.open("a") as fh:
            fh.write(json.dumps(event, sort_keys=True) + "\n")
        return event

    def _resolve_peer(self, token: str | None) -> tuple[str | None, str | None]:
        if token is None:
            return None, None
        agents = self._load_agents()
        if token in agents:
            return token, agents[token].get("alias")
        for agent_id, record in agents.items():
            alias = record.get("alias")
            if isinstance(alias, str) and alias == token:
                return agent_id, alias
        return token, token

    def _tombstone_superseded(self, agents: dict[str, dict[str, Any]]) -> None:
        """A pane now anchored to a new process marks its previous occupants DEAD."""
        pane = self.anchor.get("pane")
        if not pane:
            return
        for agent_id, record in agents.items():
            if agent_id == self.agent_id or record.get("dead"):
                continue
            record_pane = record.get("pane")
            v1_pane = record.get("identity_raw") if record.get("identity_source") == "TMUX_PANE" else None
            if pane not in (record_pane, v1_pane):
                continue
            if process_liveness(record) is not True:
                record["dead"] = True
                record["superseded_by"] = self.agent_id
                record["tombstoned_at"] = now_iso()

    def _prune(
        self,
        agents: dict[str, dict[str, Any]],
    ) -> list[str]:
        pruned: list[str] = []
        for agent_id, record in list(agents.items()):
            if agent_id == self.agent_id:
                continue
            reference = record.get("tombstoned_at") or record.get("stopped_at") or record.get("last_seen")
            age = age_seconds(reference)
            if age is None:
                continue
            if (record.get("dead") or record.get("stopped")) and age > TOMBSTONE_SECONDS:
                agents.pop(agent_id)
                pruned.append(agent_id)
            elif age > TOMBSTONE_SECONDS and process_liveness(record) is False:
                # Unflagged but verifiably gone — same aging as tombstones.
                agents.pop(agent_id)
                pruned.append(agent_id)
            elif age > PRUNE_SECONDS:
                agents.pop(agent_id)
                pruned.append(agent_id)
        return pruned

    def _cascade_prune(self, pruned: list[str]) -> None:
        if not pruned:
            return
        gone = set(pruned)
        focus = self._load_focus()
        remaining_focus = {agent_id: record for agent_id, record in focus.items() if agent_id not in gone}
        if len(remaining_focus) != len(focus):
            self._save_focus(remaining_focus)
        claims = self._load_claims()
        remaining_claims = [item for item in claims if item.get("owner") not in gone]
        if len(remaining_claims) != len(claims):
            self._save_claims(remaining_claims)
        pulse = self._load_pulse()
        remaining_pulse = {agent_id: record for agent_id, record in pulse.items() if agent_id not in gone}
        if len(remaining_pulse) != len(pulse):
            self._save_pulse(remaining_pulse)

    def register_self(self) -> dict[str, Any]:
        with self.locked():
            agents = self._load_agents()
            current = agents.get(self.agent_id, {})
            current.update(
                {
                    "agent_id": self.agent_id,
                    "last_seen": now_iso(),
                    "lease_expires_at": datetime.fromtimestamp(
                        now().timestamp() + ACTIVE_WINDOW_SECONDS, tz=timezone.utc
                    ).replace(microsecond=0).isoformat().replace("+00:00", "Z"),
                    "project_root": str(self.project_root),
                    "identity_source": self.identity_source,
                    "pid": self.anchor.get("pid"),
                    "pid_start": self.anchor.get("pid_start"),
                    "host": self.anchor.get("host"),
                    "runtime": self.runtime,
                }
            )
            if self.anchor.get("pane"):
                current["pane"] = self.anchor["pane"]
            if self.session:
                current["session"] = self.session
            if self.model:
                current["model"] = self.model
            if self.identity_raw:
                current["identity_raw"] = self.identity_raw
            for revived_key in ("dead", "superseded_by", "tombstoned_at", "stopped", "stopped_at", "stop_note"):
                current.pop(revived_key, None)
            agents[self.agent_id] = current
            self._tombstone_superseded(agents)
            pruned = self._prune(agents)
            self._save_agents(agents)
            self._cascade_prune(pruned)
            return current

    def self_record(self, refresh: bool = True) -> dict[str, Any]:
        if refresh:
            self.register_self()
        return self._load_agents().get(self.agent_id, {"agent_id": self.agent_id})

    def alias_self(self, alias: str) -> dict[str, Any]:
        current = self.register_self()
        with self.locked():
            agents = self._load_agents()
            current = agents.get(self.agent_id, current)
            current["alias"] = alias
            agents[self.agent_id] = current
            self._save_agents(agents)
            return current

    def aliases(self) -> list[dict[str, Any]]:
        self.register_self()
        aliases: list[dict[str, Any]] = []
        for agent_id, record in sorted(self._load_agents().items()):
            alias = record.get("alias")
            if not isinstance(alias, str) or not alias:
                continue
            aliases.append(
                {
                    "agent_id": agent_id,
                    "alias": alias,
                    "status": classify_presence(record),
                    "current": agent_id == self.agent_id,
                }
            )
        return aliases

    def focus_map(self) -> dict[str, dict[str, Any]]:
        return self._load_focus()

    def focus_for(self, token: str | None = None) -> dict[str, Any] | None:
        agent_id = self.agent_id if token is None else self._resolve_peer(token)[0]
        if not agent_id:
            return None
        return self.focus_map().get(agent_id)

    def set_focus(
        self,
        goal: str,
        paths: list[str],
        phase: str | None = None,
        note: str | None = None,
        blocking_on: list[str] | None = None,
        last_ship: str | None = None,
        branch: str | None = None,
    ) -> dict[str, Any]:
        self.register_self()

        def resolve_text(value: str | None, previous: Any) -> str | None:
            if value is None:
                return previous if isinstance(previous, str) and previous else None
            return value or None

        with self.locked():
            focus = self._load_focus()
            existing = focus.get(self.agent_id, {})
            if paths:
                normalized = sorted(
                    {normalize_path(self.project_root, self.cwd, path) for path in paths if path.strip()}
                )
            else:
                normalized = [str(item) for item in existing.get("paths", [])]
            resolved_phase = phase or existing.get("phase") or "building"
            if blocking_on is None:
                resolved_blocking = [str(item) for item in existing.get("blocking_on", [])]
            else:
                resolved_blocking = [item for item in blocking_on if item.strip()]
            payload = {
                "agent_id": self.agent_id,
                "alias": self.self_record(refresh=False).get("alias"),
                "goal": goal,
                "phase": resolved_phase,
                "paths": normalized,
                "note": resolve_text(note, existing.get("note")),
                "blocking_on": resolved_blocking,
                "last_ship": resolve_text(last_ship, existing.get("last_ship")),
                "branch": normalize_branch(resolve_text(branch, existing.get("branch"))),
                "updated_at": now_iso(),
            }
            focus[self.agent_id] = payload
            self._save_focus(focus)
            self._append_event(
                kind="focus_set",
                paths=normalized,
                summary=f"{payload.get('alias') or self.agent_id} set focus: {goal} [phase:{resolved_phase}]",
            )
        return payload

    def pulse_map(self) -> dict[str, dict[str, Any]]:
        return self._load_pulse()

    def pulse_for(self, token: str | None = None) -> dict[str, Any] | None:
        pulse = self.pulse_map()
        agent_id = self.agent_id if token is None else self._resolve_peer(token)[0]
        if not agent_id:
            return None
        record = pulse.get(agent_id)
        if record is not None or token is None or agent_id != token:
            return record
        try:
            return pulse.get(pulse_agent_id(token))
        except ValueError:
            return None

    def record_pulse(self, payload: dict[str, Any]) -> dict[str, Any] | None:
        """Reduce one hook payload into this agent's pulse row.

        Telemetry, not coordination: no event-journal entry — pulse fires per
        tool call and would drown the journal that peers actually read.
        """
        self.register_self()
        with self.locked():
            pulse = self._load_pulse()
            updated = reduce_pulse(pulse.get(self.agent_id), payload)
            if updated is None:
                return None
            updated["agent_id"] = self.agent_id
            pulse[self.agent_id] = updated
            self._save_pulse(pulse)
            return updated

    def record_explicit_pulse(
        self,
        session_key: str,
        status: str,
        updated_at: str,
        activity: str | None,
        clear_activity: bool,
    ) -> tuple[dict[str, Any], bool]:
        """Merge a supervisor verdict without claiming the target's liveness.

        All writers share the coord lock. Status and updated_at are replaced;
        activity is replaced only when explicitly supplied or cleared. Hook-owned
        fields such as latest_prompt, todo, turns, and event_count survive.
        """
        agent_id = pulse_agent_id(session_key)
        timestamp = normalize_pulse_timestamp(updated_at)
        with self.locked():
            pulse = self._load_pulse()
            existing = pulse.get(agent_id)
            state = dict(existing or {})
            state["agent_id"] = agent_id
            state["status"] = status
            state["updated_at"] = timestamp
            if clear_activity:
                state.pop("activity", None)
            elif activity is not None:
                detail = clip(activity, PULSE_DETAIL_CHARS)
                if detail:
                    state["activity"] = detail
                else:
                    state.pop("activity", None)
            changed = state != existing
            if changed:
                pulse[agent_id] = state
                self._save_pulse(pulse)
            return state, changed

    def branch_mismatch(self, focus: dict[str, Any] | None = None) -> dict[str, Any] | None:
        """A lane declaring a branch this working tree is not on must isolate.

        One working tree holds one branch, so unlike overlapping ownership this
        is not a preference: no split of paths makes this checkout serve both.
        """
        if not ISOLATION_NUDGE:
            return None
        record = focus if focus is not None else (self.focus_for() or {})
        declared = normalize_branch(record.get("branch"))
        if not declared:
            return None
        head = checkout_branch(self.project_root)
        if not head or head == declared:
            return None
        return {"declared": declared, "head": head, "remedy": branch_remedy(declared)}

    def concurrent_builder_nudge(self, focus: dict[str, Any] | None = None) -> dict[str, Any] | None:
        """Warn a building writer when another active writer builds in this checkout."""
        if not ISOLATION_NUDGE:
            return None
        record = focus if focus is not None else (self.focus_for() or {})
        if record.get("phase") != "building":
            return None
        agents = self._load_agents()
        if self._record_mode(agents.get(self.agent_id, {})) != "writer":
            return None

        builders = [
            peer
            for peer in self.peers(include_stale=False)
            if not peer["current"]
            and peer["status"] == "active"
            and peer.get("mode") == "writer"
            and (peer.get("focus") or {}).get("phase") == "building"
        ]
        if not builders:
            return None
        builders.sort(key=lambda peer: str(peer["agent_id"]))
        peer_ids = [str(peer["agent_id"]) for peer in builders]
        peer_labels = [str(peer.get("alias") or peer["agent_id"]) for peer in builders]
        count = len(builders)
        noun = "writer" if count == 1 else "writers"
        verb = "shares" if count == 1 else "share"
        summary = (
            f"{count} other active building {noun} already {verb} this checkout "
            f"({', '.join(peer_labels)}); compile state and build artifacts are shared "
            "even when source paths are disjoint"
        )
        remedy = concurrent_builder_remedy()
        return {
            "count": count,
            "peers": peer_ids,
            "peer_labels": peer_labels,
            "summary": with_remedy(summary, remedy),
            "remedy": remedy,
        }

    def clear_focus(self) -> dict[str, Any] | None:
        self.register_self()
        with self.locked():
            focus = self._load_focus()
            existing = focus.pop(self.agent_id, None)
            self._save_focus(focus)
            if existing:
                self._append_event(
                    kind="focus_clear",
                    paths=existing.get("paths", []),
                    summary=f"{existing.get('alias') or self.agent_id} cleared focus",
                )
            return existing

    def peers(
        self,
        include_stale: bool = False,
        active_only: bool = False,
        writers_only: bool = False,
    ) -> list[dict[str, Any]]:
        self.register_self()
        focus = self.focus_map()
        pulse_map = self.pulse_map()
        peers: list[dict[str, Any]] = []
        for agent_id, record in sorted(self._load_agents().items()):
            status = classify_presence(record)
            if status == "stale" and not include_stale:
                continue
            if active_only and status != "active":
                continue
            mode = record.get("role_mode") or "writer"
            if writers_only and (status not in {"active", "idle"} or mode != "writer"):
                continue
            peer_focus = focus.get(agent_id)
            peer = {
                "agent_id": agent_id,
                "alias": record.get("alias"),
                "status": status,
                "last_seen": record.get("last_seen"),
                "age": format_age(record.get("last_seen")),
                "age_seconds": age_seconds(record.get("last_seen")),
                "lease_expires_at": record.get("lease_expires_at"),
                "current": agent_id == self.agent_id,
                "runtime": record.get("runtime"),
                "model": record.get("model"),
                "pane": record.get("pane"),
                "role": record.get("role"),
                "mode": mode,
                "territory": self._record_territory(record),
                "phase": (peer_focus or {}).get("phase"),
                "focus": peer_focus,
                "pulse": pulse_map.get(agent_id),
            }
            if record.get("stop_note"):
                peer["stop_note"] = record["stop_note"]
            peers.append(peer)
        status_rank = {"active": 0, "idle": 1, "stopped": 2, "dead": 3, "stale": 4}

        def sort_key(item: dict[str, Any]) -> tuple[int, int, int, int, str]:
            presence = str(item.get("status"))
            live = presence in {"active", "idle"}
            # Attention-first among the living; the retired and the dead keep
            # their presence order. Trust latch: only a peer with a pulse row
            # may claim a fine-grained state — no pulse ranks as plain alive.
            pulse_status = str((item.get("pulse") or {}).get("status") or "")
            rank = PULSE_RANK.get(pulse_status, PULSE_RANK_NO_PULSE) if live else PULSE_RANK_NO_PULSE
            return (
                0 if live else 1,
                rank,
                status_rank.get(presence, 9),
                0 if item.get("mode") == "writer" else 1,
                str(item.get("agent_id")),
            )

        peers.sort(key=sort_key)
        return peers

    def stop(self, note: str | None) -> dict[str, Any]:
        with self.locked():
            agents = self._load_agents()
            current = agents.get(self.agent_id, {"agent_id": self.agent_id})
            current["last_seen"] = now_iso()
            current["stopped"] = True
            current["stopped_at"] = now_iso()
            if note:
                current["stop_note"] = note
            agents[self.agent_id] = current
            self._save_agents(agents)
            focus = self._load_focus()
            existing_focus = focus.get(self.agent_id)
            if existing_focus:
                existing_focus["phase"] = "stopped"
                existing_focus["updated_at"] = now_iso()
                self._save_focus(focus)
            label = current.get("alias") or self.agent_id
            summary = f"{label} stopped" + (f": {note}" if note else "")
            self._append_event(kind="stop", summary=summary)
            return current

    def bye(self) -> dict[str, Any]:
        self.register_self()
        with self.locked():
            agents = self._load_agents()
            record = agents.pop(self.agent_id, None)
            self._save_agents(agents)
            focus = self._load_focus()
            focus.pop(self.agent_id, None)
            self._save_focus(focus)
            claims = self._load_claims()
            remaining_claims = [item for item in claims if item.get("owner") != self.agent_id]
            if len(remaining_claims) != len(claims):
                self._save_claims(remaining_claims)
            needs = self._load_needs()
            remaining_needs = [item for item in needs if item.get("owner") != self.agent_id]
            if len(remaining_needs) != len(needs):
                self._save_needs(remaining_needs)
            pulse = self._load_pulse()
            if pulse.pop(self.agent_id, None) is not None:
                self._save_pulse(pulse)
            label = (record or {}).get("alias") or self.agent_id
            self._append_event(kind="bye", summary=f"{label} left the board")
            return record or {"agent_id": self.agent_id}

    def claims(self) -> list[dict[str, Any]]:
        self.register_self()
        claims = self._load_claims()
        agents = self._load_agents()
        for claim in claims:
            owner = claim.get("owner")
            owner_record = agents.get(str(owner), {})
            claim["owner_status"] = classify_presence(owner_record) if owner_record else "unknown"
        claims.sort(key=lambda item: item.get("path", ""))
        return claims

    def claim(self, path: str, reason: str | None, strength: str) -> tuple[bool, dict[str, Any] | None, str | None]:
        self.register_self()
        normalized = normalize_path(self.project_root, self.cwd, path)
        alias = self.self_record(refresh=False).get("alias")
        with self.locked():
            claims = self._load_claims()
            for existing in claims:
                if existing.get("path") != normalized:
                    continue
                if existing.get("owner") == self.agent_id:
                    existing["reason"] = reason
                    existing["strength"] = strength
                    existing["updated_at"] = now_iso()
                    self._save_claims(claims)
                    self._append_event(
                        kind="claim",
                        paths=[normalized],
                        summary=f"{alias or self.agent_id} updated claim on {normalized}",
                    )
                    return True, existing, None
                owner = existing.get("owner_alias") or existing.get("owner")
                return False, existing, f"{normalized} is already claimed by {owner}"

            claim = {
                "path": normalized,
                "owner": self.agent_id,
                "owner_alias": alias,
                "reason": reason,
                "strength": strength,
                "created_at": now_iso(),
                "updated_at": now_iso(),
            }
            claims.append(claim)
            self._save_claims(claims)
            self._append_event(
                kind="claim",
                paths=[normalized],
                summary=f"{alias or self.agent_id} claimed {normalized}",
            )
            return True, claim, None

    def release(self, path: str) -> tuple[bool, dict[str, Any] | None, str | None]:
        self.register_self()
        normalized = normalize_path(self.project_root, self.cwd, path)
        with self.locked():
            claims = self._load_claims()
            for existing in list(claims):
                if existing.get("path") != normalized:
                    continue
                if existing.get("owner") != self.agent_id:
                    owner = existing.get("owner_alias") or existing.get("owner")
                    return False, existing, f"{normalized} is owned by {owner}"
                claims.remove(existing)
                self._save_claims(claims)
                self._append_event(
                    kind="release",
                    paths=[normalized],
                    summary=f"{existing.get('owner_alias') or self.agent_id} released {normalized}",
                )
                return True, existing, None
            return False, None, f"No active claim for {normalized}"

    def needs(self, include_all: bool = False) -> list[dict[str, Any]]:
        self.register_self()
        needs = self._load_needs()
        if not include_all:
            needs = [item for item in needs if item.get("owner") == self.agent_id]
        needs.sort(key=lambda item: (item.get("key", ""), item.get("created_at", "")))
        return needs

    def add_need(self, key: str, why: str, from_token: str | None) -> dict[str, Any]:
        self.register_self()
        alias = self.self_record(refresh=False).get("alias")
        from_agent_id, from_alias = self._resolve_peer(from_token)
        with self.locked():
            needs = self._load_needs()
            existing = next(
                (
                    item
                    for item in needs
                    if item.get("owner") == self.agent_id and item.get("key") == key
                ),
                None,
            )
            if existing:
                existing.update(
                    {
                        "why": why,
                        "from": from_agent_id,
                        "from_alias": from_alias,
                        "updated_at": now_iso(),
                    }
                )
                payload = existing
            else:
                payload = {
                    "key": key,
                    "owner": self.agent_id,
                    "owner_alias": alias,
                    "why": why,
                    "from": from_agent_id,
                    "from_alias": from_alias,
                    "created_at": now_iso(),
                    "updated_at": now_iso(),
                }
                needs.append(payload)
            self._save_needs(needs)
            self._append_event(
                kind="need_add",
                keys=[key],
                summary=f"{alias or self.agent_id} needs {key}",
            )
            return payload

    def clear_need(self, key: str) -> tuple[bool, dict[str, Any] | None]:
        self.register_self()
        with self.locked():
            needs = self._load_needs()
            for existing in list(needs):
                if existing.get("owner") == self.agent_id and existing.get("key") == key:
                    needs.remove(existing)
                    self._save_needs(needs)
                    self._append_event(
                        kind="need_clear",
                        keys=[key],
                        summary=f"{existing.get('owner_alias') or self.agent_id} cleared need {key}",
                    )
                    return True, existing
            return False, None

    def publishes(self) -> list[dict[str, Any]]:
        self.register_self()
        publishes = self._load_publishes()
        agents = self._load_agents()
        for publish in publishes:
            owner = str(publish.get("owner"))
            owner_record = agents.get(owner, {})
            publish["owner_status"] = classify_presence(owner_record) if owner_record else "unknown"
        publishes.sort(key=lambda item: (item.get("key", ""), item.get("updated_at", "")), reverse=False)
        return publishes

    def add_publish(
        self,
        key: str,
        status: str,
        summary: str,
        refs: list[str],
        file_path: str | None = None,
    ) -> dict[str, Any]:
        self.register_self()
        alias = self.self_record(refresh=False).get("alias")
        normalized_file = (
            normalize_path(self.project_root, self.cwd, file_path) if file_path else None
        )
        with self.locked():
            publishes = self._load_publishes()
            existing = next(
                (
                    item
                    for item in publishes
                    if item.get("owner") == self.agent_id and item.get("key") == key
                ),
                None,
            )
            if existing:
                existing.update(
                    {
                        "status": status,
                        "summary": summary,
                        "refs": refs,
                        "file": normalized_file or existing.get("file"),
                        "updated_at": now_iso(),
                    }
                )
                payload = existing
            else:
                payload = {
                    "key": key,
                    "owner": self.agent_id,
                    "owner_alias": alias,
                    "status": status,
                    "summary": summary,
                    "refs": refs,
                    "file": normalized_file,
                    "created_at": now_iso(),
                    "updated_at": now_iso(),
                }
                publishes.append(payload)
            self._save_publishes(publishes)
            self._append_event(
                kind="publish_add",
                keys=[key],
                summary=f"{alias or self.agent_id} published {key} ({status})",
            )
            return payload

    def clear_publish(self, key: str) -> tuple[bool, dict[str, Any] | None]:
        self.register_self()
        with self.locked():
            publishes = self._load_publishes()
            for existing in list(publishes):
                if existing.get("owner") == self.agent_id and existing.get("key") == key:
                    publishes.remove(existing)
                    self._save_publishes(publishes)
                    self._append_event(
                        kind="publish_clear",
                        keys=[key],
                        summary=f"{existing.get('owner_alias') or self.agent_id} cleared publish {key}",
                    )
                    return True, existing
            return False, None

    def _live_records(self, agents: dict[str, dict[str, Any]]) -> dict[str, dict[str, Any]]:
        return {
            agent_id: record
            for agent_id, record in agents.items()
            if agent_id != self.agent_id and classify_presence(record) in {"active", "idle"}
        }

    @staticmethod
    def _record_mode(record: dict[str, Any]) -> str:
        return str(record.get("role_mode") or "writer")

    @staticmethod
    def _record_territory(record: dict[str, Any]) -> list[str]:
        territory = record.get("territory")
        if not isinstance(territory, list):
            return []
        return [str(item) for item in territory if str(item)]

    def _territory_overlaps(
        self,
        mine: list[str],
        agents: dict[str, dict[str, Any]],
        mode: str = "writer",
    ) -> list[dict[str, Any]]:
        overlaps: list[dict[str, Any]] = []
        if not mine:
            return overlaps
        for agent_id, record in sorted(self._live_records(agents).items()):
            if self._record_mode(record) != mode:
                continue
            theirs = self._record_territory(record)
            shared = sorted(
                {
                    path
                    for own in mine
                    for other in theirs
                    if path_overlaps(own, other)
                    for path in (own, other)
                }
            )
            if not shared:
                continue
            overlaps.append(
                {
                    "peer": agent_id,
                    "peer_label": record.get("alias") or agent_id,
                    "paths": shared,
                }
            )
        return overlaps

    def set_role(
        self,
        role: str,
        mode: str | None,
        territory_paths: list[str],
    ) -> tuple[dict[str, Any], list[dict[str, Any]]]:
        self.register_self()
        resolved_mode = mode or ROLE_DEFAULT_MODES.get(role, "writer")
        normalized = sorted(
            {
                normalize_path(self.project_root, self.cwd, path)
                for path in territory_paths
                if path.strip()
            }
        )
        with self.locked():
            agents = self._load_agents()
            current = agents.get(self.agent_id, {"agent_id": self.agent_id})
            current["role"] = role
            current["role_mode"] = resolved_mode
            current["territory"] = normalized
            agents[self.agent_id] = current
            self._save_agents(agents)
            label = current.get("alias") or self.agent_id
            self._append_event(
                kind="role_set",
                paths=normalized,
                summary=f"{label} took role {role} ({resolved_mode}) over {', '.join(normalized) or 'no territory'}",
            )
            overlaps = (
                self._territory_overlaps(normalized, agents, mode="writer")
                if resolved_mode == "writer"
                else []
            )
        payload = {
            "agent_id": self.agent_id,
            "alias": current.get("alias"),
            "role": role,
            "mode": resolved_mode,
            "territory": normalized,
        }
        return payload, overlaps

    def territory_map(self) -> dict[str, Any]:
        self.register_self()
        agents = self._load_agents()
        territories: list[dict[str, Any]] = []
        writers: list[tuple[str, str, list[str]]] = []
        for agent_id, record in sorted(agents.items()):
            territory = self._record_territory(record)
            if not territory and not record.get("role"):
                continue
            status = classify_presence(record)
            mode = self._record_mode(record)
            label = record.get("alias") or agent_id
            territories.append(
                {
                    "agent_id": agent_id,
                    "label": label,
                    "role": record.get("role"),
                    "mode": mode,
                    "status": status,
                    "age": format_age(record.get("last_seen")),
                    "territory": territory,
                    "current": agent_id == self.agent_id,
                }
            )
            if mode == "writer" and territory and status in {"active", "idle"}:
                writers.append((agent_id, label, territory))
        overlaps: list[dict[str, Any]] = []
        for index, (agent_a, label_a, paths_a) in enumerate(writers):
            for agent_b, label_b, paths_b in writers[index + 1 :]:
                shared = sorted(
                    {
                        path
                        for own in paths_a
                        for other in paths_b
                        if path_overlaps(own, other)
                        for path in (own, other)
                    }
                )
                if shared:
                    overlaps.append(
                        {
                            "agents": [agent_a, agent_b],
                            "labels": [label_a, label_b],
                            "paths": shared,
                        }
                    )
        return {"territories": territories, "overlaps": overlaps}

    def _drop_targets_me(self, drop: dict[str, Any]) -> bool:
        target = str(drop.get("for") or "any")
        if target == "any":
            return True
        if drop.get("for_agent_id") == self.agent_id or target == self.agent_id:
            return True
        record = self.self_record(refresh=False)
        alias = record.get("alias")
        if isinstance(alias, str) and alias and target == alias:
            return True
        role = record.get("role")
        return isinstance(role, str) and bool(role) and target == role

    def add_drop(self, path: str, target: str, note: str | None, key: str | None) -> dict[str, Any]:
        self.register_self()
        normalized = normalize_path(self.project_root, self.cwd, path)
        alias = self.self_record(refresh=False).get("alias")
        resolved, _ = self._resolve_peer(target)
        known_agent = resolved in self._load_agents()
        with self.locked():
            drops = self._load_drops()
            payload = {
                "path": normalized,
                "owner": self.agent_id,
                "owner_label": alias or self.agent_id,
                "for": target,
                "for_agent_id": resolved if known_agent else None,
                "note": note,
                "key": key,
                "created_at": now_iso(),
            }
            drops = [item for item in drops if not (item.get("owner") == self.agent_id and item.get("path") == normalized)]
            drops.append(payload)
            self._save_drops(drops)
            self._append_event(
                kind="drop_add",
                paths=[normalized],
                keys=[key] if key else [],
                summary=f"{alias or self.agent_id} dropped {normalized} for {target}",
            )
            return payload

    def drops(self, for_me: bool = False) -> list[dict[str, Any]]:
        self.register_self()
        drops = self._load_drops()
        if for_me:
            drops = [item for item in drops if item.get("owner") != self.agent_id and self._drop_targets_me(item)]
        drops.sort(key=lambda item: item.get("created_at", ""), reverse=True)
        return drops

    def history(self, peer: str | None = None, limit: int = 20) -> list[dict[str, Any]]:
        self.register_self()
        events = self._load_events()
        if peer:
            agent_id, _ = self._resolve_peer(peer)
            events = [item for item in events if item.get("agent_id") == agent_id]
        events.sort(key=lambda item: int(item.get("seq", 0)), reverse=True)
        return events[: max(1, limit)]

    def guard_check(self, paths: list[str], staged: bool) -> dict[str, Any]:
        self.register_self()
        raw_paths = list(paths)
        if staged:
            staged_output = git_output(self.cwd, "diff", "--cached", "--name-only") or ""
            raw_paths.extend(line for line in staged_output.splitlines() if line.strip())
        normalized = sorted(
            {normalize_path(self.project_root, self.cwd, path) for path in raw_paths if path.strip()}
        )
        agents = self._load_agents()
        live = self._live_records(agents)
        warnings: list[dict[str, Any]] = []
        claims = self._load_claims()
        for path in normalized:
            for claim in claims:
                owner = str(claim.get("owner"))
                if owner == self.agent_id or owner not in live:
                    continue
                owned = str(claim.get("path", ""))
                if not path_overlaps(path, owned):
                    continue
                warnings.append(
                    {
                        "path": path,
                        "kind": "claim",
                        "owner": owner,
                        "owner_label": claim.get("owner_alias") or live[owner].get("alias") or owner,
                        "owned_path": owned,
                        "reason": claim.get("reason"),
                    }
                )
            for agent_id, record in sorted(live.items()):
                for owned in self._record_territory(record):
                    if not path_overlaps(path, owned):
                        continue
                    warnings.append(
                        {
                            "path": path,
                            "kind": "territory",
                            "owner": agent_id,
                            "owner_label": record.get("alias") or agent_id,
                            "owned_path": owned,
                            "role": record.get("role"),
                            "mode": self._record_mode(record),
                        }
                    )
        if warnings:
            label = self.self_record(refresh=False).get("alias") or self.agent_id
            with self.locked():
                self._append_event(
                    kind="guard_warn",
                    paths=sorted({item["path"] for item in warnings}),
                    summary=f"{label} touched paths owned by live peers: "
                    + ", ".join(sorted({item["owner_label"] for item in warnings})),
                )
        return {"paths": normalized, "warnings": warnings, "clean": not warnings}

    def guard_install(self) -> dict[str, Any]:
        hooks_text = git_output(self.cwd, "rev-parse", "--git-path", "hooks")
        if not hooks_text:
            return {"installed": False, "error": "not inside a git repository"}
        hooks_dir = Path(hooks_text)
        if not hooks_dir.is_absolute():
            hooks_dir = (self.cwd / hooks_dir).resolve()
        hooks_dir.mkdir(parents=True, exist_ok=True)
        hook_path = hooks_dir / "pre-commit"

        dispatcher = Path(__file__).resolve().parents[1] / "agent-do"
        command = f"{shlex.quote(str(dispatcher))} coord guard check --staged" if dispatcher.exists() else "agent-do coord guard check --staged"
        marker = "# >>> agent-do coord guard >>>"
        block = (
            f"{marker}\n"
            "# Advisory only: warns when staged paths intersect a live peer's claim or territory.\n"
            f"{command} || true\n"
            "# <<< agent-do coord guard <<<\n"
        )

        already = False
        if hook_path.exists():
            content = hook_path.read_text()
            if marker in content:
                already = True
            else:
                if content and not content.endswith("\n"):
                    content += "\n"
                content += "\n" + block
                hook_path.write_text(content)
        else:
            hook_path.write_text("#!/bin/sh\n\n" + block)
        hook_path.chmod(0o755)
        return {"installed": True, "already_installed": already, "hook": str(hook_path)}

    def _current_paths(self) -> list[str]:
        focus = self.focus_for() or {}
        focus_paths = list(focus.get("paths", []))
        claim_paths = [item["path"] for item in self.claims() if item.get("owner") == self.agent_id]
        return sorted({*focus_paths, *claim_paths})

    def _current_need_keys(self) -> set[str]:
        return {str(item.get("key")) for item in self.needs() if item.get("key")}

    def _last_interrupt_seq(self) -> int:
        record = self.self_record(refresh=False)
        value = record.get("last_interrupt_seq", 0)
        try:
            return int(value)
        except (TypeError, ValueError):
            return 0

    def _mark_interrupt_seq(self, seq: int) -> None:
        current = self.register_self()
        with self.locked():
            agents = self._load_agents()
            current = agents.get(self.agent_id, current)
            current["last_interrupt_seq"] = seq
            agents[self.agent_id] = current
            self._save_agents(agents)

    def _matching_publish(self, need: dict[str, Any], publishes: list[dict[str, Any]]) -> dict[str, Any] | None:
        key = need.get("key")
        from_target = need.get("from")
        from_alias = need.get("from_alias")
        candidates = [item for item in publishes if item.get("key") == key]
        if from_target:
            candidates = [
                item
                for item in candidates
                if item.get("owner") == from_target or item.get("owner_alias") == from_alias or item.get("owner_alias") == from_target
            ]
        if not candidates:
            return None
        candidates.sort(key=lambda item: item.get("updated_at", ""), reverse=True)
        return candidates[0]

    def interrupts(self, mark_seen: bool = False, limit: int = 20) -> dict[str, Any]:
        self.register_self()
        last_seen_seq = self._last_interrupt_seq()
        focus = self.focus_for() or {}
        my_paths = self._current_paths()
        my_needs = self.needs()
        my_need_keys = {str(item.get("key")) for item in my_needs if item.get("key")}
        agents = self._load_agents()
        publishes = self.publishes()
        active_peers = [
            peer for peer in self.peers(include_stale=False)
            if not peer["current"] and peer["status"] == "active"
        ]

        interrupts: list[dict[str, Any]] = []

        # Current contentions.
        claims = self.claims()
        my_claim_paths = {item["path"] for item in claims if item.get("owner") == self.agent_id}
        for peer in active_peers:
            peer_focus = peer.get("focus") or {}
            peer_focus_paths = [str(item) for item in peer_focus.get("paths", [])]
            peer_claim_paths = [
                item["path"]
                for item in claims
                if item.get("owner") == peer["agent_id"]
            ]
            overlaps = sorted(
                {
                    mine
                    for mine in [*my_paths, *my_claim_paths]
                    for theirs in [*peer_focus_paths, *peer_claim_paths]
                    if path_overlaps(mine, theirs)
                }
            )
            if not overlaps:
                continue
            peer_label = peer.get("alias") or peer["agent_id"]
            remedy = overlap_remedy(overlaps) if ISOLATION_NUDGE else []
            interrupts.append(
                {
                    "kind": "contention",
                    "severity": "warning",
                    "peer": peer["agent_id"],
                    "peer_label": peer_label,
                    "paths": overlaps,
                    "keys": [],
                    "summary": with_remedy(
                        f"{peer_label} is active in overlapping paths: {', '.join(overlaps)}",
                        remedy,
                    ),
                    "remedy": remedy,
                    "new": False,
                    "event_id": None,
                }
            )

        # Territory contention: two live writers with overlapping write-domains, fired for both.
        my_record = agents.get(self.agent_id, {})
        my_mode = self._record_mode(my_record)
        my_territory = self._record_territory(my_record)
        if my_mode == "writer" and my_territory:
            for overlap in self._territory_overlaps(my_territory, agents, mode="writer"):
                remedy = overlap_remedy(overlap["paths"]) if ISOLATION_NUDGE else []
                interrupts.append(
                    {
                        "kind": "contention",
                        "severity": "warning",
                        "peer": overlap["peer"],
                        "peer_label": overlap["peer_label"],
                        "paths": overlap["paths"],
                        "keys": [],
                        "summary": with_remedy(
                            f"Exclusive-writer overlap with {overlap['peer_label']}: "
                            f"{', '.join(overlap['paths'])}",
                            remedy,
                        ),
                        "remedy": remedy,
                        "new": False,
                        "event_id": None,
                    }
                )

        # Source ownership can be perfectly disjoint while concurrent builds
        # still consume another lane's dirty compile state and shared artifacts.
        building_nudge = self.concurrent_builder_nudge(focus)
        if building_nudge:
            interrupts.append(
                {
                    "kind": "contention",
                    "reason": "concurrent_builders",
                    "severity": "warning",
                    "peer": None,
                    "peer_label": None,
                    "peers": building_nudge["peers"],
                    "peer_labels": building_nudge["peer_labels"],
                    "paths": [],
                    "keys": [],
                    "summary": building_nudge["summary"],
                    "remedy": building_nudge["remedy"],
                    "new": False,
                    "event_id": None,
                }
            )

        # Declared branch that this working tree is not on: isolation is mandatory.
        mismatch = self.branch_mismatch(focus)
        if mismatch:
            interrupts.append(
                {
                    "kind": "contention",
                    "severity": "warning",
                    "peer": None,
                    "peer_label": None,
                    "paths": [],
                    "keys": [],
                    "summary": with_remedy(
                        f"Declared branch {mismatch['declared']} is not this checkout's branch "
                        f"({mismatch['head']}): one working tree holds one branch",
                        mismatch["remedy"],
                    ),
                    "remedy": mismatch["remedy"],
                    "new": False,
                    "event_id": None,
                }
            )

        # Courtesy notice: an auditor is reading paths this writer owns.
        if my_mode == "writer":
            my_write_paths = sorted({*my_territory, *my_paths})
            for agent_id, record in sorted(self._live_records(agents).items()):
                if self._record_mode(record) != "read-only":
                    continue
                reader_paths = self._record_territory(record)
                reader_focus = self.focus_map().get(agent_id) or {}
                reader_paths = sorted({*reader_paths, *[str(item) for item in reader_focus.get("paths", [])]})
                shared = sorted(
                    {
                        mine
                        for mine in my_write_paths
                        for theirs in reader_paths
                        if path_overlaps(mine, theirs)
                    }
                )
                if not shared:
                    continue
                label = record.get("alias") or agent_id
                interrupts.append(
                    {
                        "kind": "notice",
                        "severity": "info",
                        "peer": agent_id,
                        "peer_label": label,
                        "paths": shared,
                        "keys": [],
                        "summary": f"Auditor {label} active on your paths: {', '.join(shared)}",
                        "new": False,
                        "event_id": None,
                    }
                )

        # Current dependencies.
        for need in my_needs:
            match = self._matching_publish(need, publishes)
            if match:
                owner_label = match.get("owner_alias") or match.get("owner")
                seq = 0
                latest_event = next(
                    (
                        event
                        for event in reversed(self._load_events())
                        if event.get("kind") == "publish_add"
                        and need.get("key") in event.get("keys", [])
                        and event.get("agent_id") == match.get("owner")
                    ),
                    None,
                )
                if latest_event:
                    seq = int(latest_event.get("seq", 0))
                interrupts.append(
                    {
                        "kind": "dependency",
                        "severity": "info",
                        "peer": match.get("owner"),
                        "peer_label": owner_label,
                        "paths": [],
                        "keys": [need["key"]],
                        "summary": f"Dependency satisfied: {need['key']} is available from {owner_label}",
                        "new": seq > last_seen_seq,
                        "event_id": latest_event.get("id") if latest_event else None,
                    }
                )
                continue

            from_target = need.get("from")
            if not from_target:
                continue
            owner_record = agents.get(str(from_target), {})
            owner_label = owner_record.get("alias") or need.get("from_alias") or from_target
            owner_status = classify_presence(owner_record) if owner_record else "unknown"
            interrupts.append(
                {
                    "kind": "dependency",
                    "severity": "warning" if owner_status == "active" else "info",
                    "peer": from_target,
                    "peer_label": owner_label,
                    "paths": [],
                    "keys": [need["key"]],
                    "summary": (
                        f"Dependency still blocked on {owner_label}: {need['key']}"
                        if owner_status == "active"
                        else f"Dependency waiting with no active owner: {need['key']}"
                    ),
                    "new": False,
                    "event_id": None,
                }
            )

        # Drops addressed to me (or matching a need key) are dependencies made visible.
        for drop in self._load_drops():
            if drop.get("owner") == self.agent_id:
                continue
            key = drop.get("key")
            key_match = bool(key) and str(key) in my_need_keys
            if not (self._drop_targets_me(drop) or key_match):
                continue
            drop_path = str(drop.get("path", ""))
            latest_event = next(
                (
                    event
                    for event in reversed(self._load_events())
                    if event.get("kind") == "drop_add"
                    and drop_path in event.get("paths", [])
                    and event.get("agent_id") == drop.get("owner")
                ),
                None,
            )
            seq = int(latest_event.get("seq", 0)) if latest_event else 0
            note = f" — {drop.get('note')}" if drop.get("note") else ""
            interrupts.append(
                {
                    "kind": "dependency",
                    "severity": "info",
                    "peer": drop.get("owner"),
                    "peer_label": drop.get("owner_label") or drop.get("owner"),
                    "paths": [drop_path],
                    "keys": [str(key)] if key else [],
                    "summary": f"Drop available from {drop.get('owner_label') or drop.get('owner')}: {drop_path}{note}",
                    "new": seq > last_seen_seq,
                    "event_id": latest_event.get("id") if latest_event else None,
                }
            )

        # Relevant novelty since last seen.
        seen_by_novelty: set[int] = set()
        for event in self._load_events():
            seq = int(event.get("seq", 0))
            if seq <= last_seen_seq:
                continue
            if event.get("agent_id") == self.agent_id:
                continue
            event_paths = [str(item) for item in event.get("paths", [])]
            event_keys = {str(item) for item in event.get("keys", [])}
            relevant = False
            if event_paths and any(path_overlaps(mine, theirs) for mine in my_paths for theirs in event_paths):
                relevant = True
            if event_keys and event_keys & my_need_keys:
                relevant = True
            if not relevant:
                continue
            if event.get("kind") in {"focus_set", "claim"}:
                continue
            seen_by_novelty.add(seq)
            interrupts.append(
                {
                    "kind": "novelty",
                    "severity": "info",
                    "peer": event.get("agent_id"),
                    "peer_label": event.get("agent_alias") or event.get("agent_id"),
                    "paths": event_paths,
                    "keys": sorted(event_keys),
                    "summary": event.get("summary"),
                    "new": True,
                    "event_id": event.get("id"),
                }
            )

        interrupts.sort(
            key=lambda item: (
                {"contention": 0, "notice": 1, "dependency": 2, "novelty": 3}.get(str(item.get("kind")), 9),
                0 if item.get("new") else 1,
                item.get("summary", ""),
            )
        )
        interrupts = interrupts[:limit]

        max_seq = max((int(item.get("seq", 0)) for item in self._load_events()), default=last_seen_seq)
        if mark_seen and max_seq > last_seen_seq:
            self._mark_interrupt_seq(max_seq)

        counts = {"contention": 0, "notice": 0, "dependency": 0, "novelty": 0}
        for item in interrupts:
            kind = str(item.get("kind"))
            counts[kind] = counts.get(kind, 0) + 1

        return {
            "interrupts": interrupts,
            "counts": counts,
            "last_interrupt_seq": last_seen_seq,
            "current_event_seq": max_seq,
            "focus": focus or None,
        }

    def touch(self) -> dict[str, Any]:
        agent = self.register_self()
        current_focus = self.focus_for()
        peers = self.peers(include_stale=True)
        others = [peer for peer in peers if not peer["current"]]
        active_peers = [peer for peer in others if peer["status"] == "active"]
        peer_counts = {"active": 0, "idle": 0, "stopped": 0, "dead": 0, "stale": 0}
        for peer in others:
            status = str(peer["status"])
            peer_counts[status] = peer_counts.get(status, 0) + 1
        return {
            "agent": {
                **agent,
                "status": classify_presence(agent),
            },
            "focus": current_focus,
            "active_peers": active_peers,
            "peer_counts": peer_counts,
            "active_window_seconds": ACTIVE_WINDOW_SECONDS,
            "idle_window_seconds": IDLE_WINDOW_SECONDS,
        }

    def status(self) -> dict[str, Any]:
        record = self.self_record()
        my_claims = [item for item in self.claims() if item.get("owner") == self.agent_id]
        my_needs = self.needs()
        my_publishes = [item for item in self.publishes() if item.get("owner") == self.agent_id]
        interrupt_state = self.interrupts(mark_seen=False, limit=20)
        return {
            "agent": {
                "agent_id": self.agent_id,
                "alias": record.get("alias"),
                "status": classify_presence(record),
                "last_seen": record.get("last_seen"),
                "lease_expires_at": record.get("lease_expires_at"),
            },
            "focus": self.focus_for(),
            "claims": my_claims,
            "needs": my_needs,
            "publishes": my_publishes,
            "interrupts": interrupt_state,
            "active_peers": [peer for peer in self.peers(include_stale=False) if not peer["current"] and peer["status"] == "active"],
        }


