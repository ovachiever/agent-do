resolve_heartbeat() {
    local name_or_id="$1"

    if [[ "$name_or_id" =~ ^[0-9]+$ ]]; then
        echo "$name_or_id"
        return 0
    fi

    # The heartbeats API has no name filter: page through the list and require
    # exactly one heartbeat with this exact name.
    local token
    token=$(bs_token) || return 1
    local heartbeat_id
    heartbeat_id=$(BS_TOKEN="$token" python3 - "${BETTERSTACK_API_V2}/heartbeats" "$name_or_id" <<'PY'
import json, os, sys, urllib.request
url, wanted = sys.argv[1], sys.argv[2]
matches = []
while url:
    req = urllib.request.Request(url, headers={
        "Authorization": "Bearer " + os.environ["BS_TOKEN"],
        "Accept": "application/json",
    })
    with urllib.request.urlopen(req, timeout=60) as resp:
        page = json.load(resp)
    for item in page.get("data", []):
        if item.get("attributes", {}).get("name") == wanted:
            matches.append(str(item.get("id", "")))
    url = (page.get("pagination") or {}).get("next")
if len(matches) == 1:
    print(matches[0])
elif len(matches) > 1:
    print("Error: more than one heartbeat is named '%s' (ids %s); use the id" % (wanted, ", ".join(matches)), file=sys.stderr)
PY
) || return 1

    if [[ -z "$heartbeat_id" ]]; then
        echo "Error: Heartbeat '$name_or_id' not found (or ambiguous)" >&2
        return 1
    fi
    echo "$heartbeat_id"
}

# Pause or resume one monitor, or one heartbeat with --heartbeat.
_set_paused() {
    local paused="$1"; shift
    local verb="pause"; [[ "$paused" == "false" ]] && verb="resume"
    _pop_json_flag "$@"

    local kind="monitor"
    local -a rest=()
    local arg
    for arg in "${_JSON_ARGS[@]+"${_JSON_ARGS[@]}"}"; do
        if [[ "$arg" == "--heartbeat" ]]; then kind="heartbeat"; else rest+=("$arg"); fi
    done
    local name_or_id="${rest[0]:-}"
    if [[ -z "$name_or_id" || ${#rest[@]} -gt 1 ]]; then
        echo "Usage: agent-betterstack $verb <monitor> | $verb --heartbeat <heartbeat>" >&2
        return 1
    fi

    local id result
    if [[ "$kind" == "heartbeat" ]]; then
        id=$(resolve_heartbeat "$name_or_id") || return 1
        result=$(bs_patch "${BETTERSTACK_API_V2}/heartbeats/${id}" "{\"paused\":${paused}}") || return 1
    else
        id=$(resolve_monitor "$name_or_id") || return 1
        result=$(bs_patch "${BETTERSTACK_API_V2}/monitors/${id}" "{\"paused\":${paused}}") || return 1
    fi

    # A heartbeat's attributes carry its ping URL, which is a credential
    # (anyone holding it can report the job healthy): never print it.
    printf '%s' "$result" | KIND="$kind" JSON_MODE="$_json_mode" WANT="$paused" python3 -c '
import json, os, sys
kind, want = os.environ["KIND"], os.environ["WANT"] == "true"
try:
    d = json.load(sys.stdin)
except ValueError:
    print("Error: Better Stack returned a non-JSON reply", file=sys.stderr)
    sys.exit(1)
data = d.get("data")
if not isinstance(data, dict):
    print("Error: " + json.dumps(d.get("errors", d))[:300], file=sys.stderr)
    sys.exit(1)
a = data.setdefault("attributes", {})
if kind == "heartbeat" and a.get("url"):
    a["url"] = "<redacted>"
paused_at = a.get("paused_at")
# Read back: when the reply carries paused_at, it must match what was asked.
if "paused_at" in a and want != bool(paused_at):
    print("Error: %s %s did not change state (paused_at=%r)" % (kind, data.get("id"), paused_at), file=sys.stderr)
    sys.exit(1)
if os.environ["JSON_MODE"] == "true":
    print(json.dumps(d, indent=4))
else:
    name = a.get("pronounceable_name") or a.get("name") or ""
    state = "paused since %s" % paused_at if paused_at else "resumed"
    print("%s \"%s\" (id: %s): %s" % (kind.capitalize(), name, data.get("id", ""), state))
'
}

cmd_pause() { _set_paused true "$@"; }

cmd_resume() { _set_paused false "$@"; }

cmd_ack() {
    _pop_json_flag "$@"
    local incident_id="${_JSON_ARGS[0]:?Usage: agent-betterstack ack <incident_id>}"

    local result
    result=$(bs_post "${BETTERSTACK_API_V3}/incidents/${incident_id}/acknowledge") || return 1
    if $_json_mode; then _emit_json "$result"; return; fi
    echo "$result" | python3 -c "
import sys, json
d = json.load(sys.stdin)
a = d.get('data', {}).get('attributes', {})
print(f'Incident {d.get(\"data\", {}).get(\"id\", \"\")}: acknowledged at {a.get(\"acknowledged_at\", \"\")}')
"
}

cmd_resolve() {
    _pop_json_flag "$@"
    local incident_id="${_JSON_ARGS[0]:?Usage: agent-betterstack resolve <incident_id>}"

    local result
    result=$(bs_post "${BETTERSTACK_API_V3}/incidents/${incident_id}/resolve") || return 1
    if $_json_mode; then _emit_json "$result"; return; fi
    echo "$result" | python3 -c "
import sys, json
d = json.load(sys.stdin)
a = d.get('data', {}).get('attributes', {})
print(f'Incident {d.get(\"data\", {}).get(\"id\", \"\")}: resolved at {a.get(\"resolved_at\", \"\")}')
"
}

cmd_snapshot() {
    _pop_json_flag "$@"
    local token="${BETTERSTACK_API_TOKEN:-}"
    if [[ -z "$token" ]]; then
        echo '{"error": "BETTERSTACK_API_TOKEN not set"}'
        return 1
    fi

    BETTERSTACK_API_TOKEN="$token" python3 -c "
import json, sys, os
from urllib.request import Request, urlopen
from urllib.error import HTTPError

API_V2 = 'https://uptime.betterstack.com/api/v2'
API_V3 = 'https://uptime.betterstack.com/api/v3'
TOKEN = os.environ.get('BETTERSTACK_API_TOKEN', '')

def api_get(url):
    req = Request(url, headers={
        'Authorization': 'Bearer ' + TOKEN,
        'Accept': 'application/json',
    })
    try:
        with urlopen(req, timeout=30) as resp:
            return json.loads(resp.read())
    except HTTPError as e:
        if e.code == 401:
            return {'error': 'unauthorized'}
        return {'error': str(e)}
    except Exception as e:
        return {'error': str(e)}

def fetch_all(url):
    \"\"\"Paginate through all pages of a Better Stack API endpoint.\"\"\"
    all_items = []
    while url:
        d = api_get(url)
        if isinstance(d, dict) and 'error' in d:
            return d
        items = d.get('data', [])
        all_items.extend(items)
        url = d.get('pagination', {}).get('next')
    return all_items

token_valid = True

# Monitors
raw_monitors = fetch_all(API_V2 + '/monitors')
if isinstance(raw_monitors, dict) and 'error' in raw_monitors:
    token_valid = False
    monitors = []
else:
    monitors = []
    by_status = {}
    for item in raw_monitors:
        a = item.get('attributes', {})
        st = a.get('status', '?')
        by_status[st] = by_status.get(st, 0) + 1
        monitors.append({
            'id': item.get('id', ''),
            'name': a.get('pronounceable_name', ''),
            'url': a.get('url', ''),
            'status': st,
            'monitor_type': a.get('monitor_type', ''),
            'check_frequency': a.get('check_frequency'),
            'last_checked_at': a.get('last_checked_at', ''),
            'paused_at': a.get('paused_at'),
            'regions': a.get('regions', []),
        })

# Incidents (v3) — recent and active
raw_incidents = fetch_all(API_V3 + '/incidents')
incidents = []
active_incidents = 0
if isinstance(raw_incidents, list):
    for item in raw_incidents:
        a = item.get('attributes', {})
        resolved = a.get('resolved_at')
        if not resolved:
            active_incidents += 1
        monitor_rel = item.get('relationships', {}).get('monitor', {}).get('data', {})
        incidents.append({
            'id': item.get('id', ''),
            'name': a.get('name', ''),
            'cause': a.get('cause', ''),
            'status': a.get('status', ''),
            'started_at': a.get('started_at', ''),
            'resolved_at': resolved,
            'acknowledged_at': a.get('acknowledged_at'),
            'monitor_id': monitor_rel.get('id') if monitor_rel else None,
        })

# Heartbeats
raw_heartbeats = fetch_all(API_V2 + '/heartbeats')
heartbeats = []
if isinstance(raw_heartbeats, list):
    for item in raw_heartbeats:
        a = item.get('attributes', {})
        heartbeats.append({
            'id': item.get('id', ''),
            'name': a.get('name', ''),
            'status': a.get('status', ''),
            'period': a.get('period'),
            'grace': a.get('grace'),
            'last_pinged_at': a.get('last_pinged_at'),
            'created_at': a.get('created_at', ''),
        })

# Status pages
raw_pages = fetch_all(API_V2 + '/status-pages')
status_pages = []
if isinstance(raw_pages, list):
    for item in raw_pages:
        a = item.get('attributes', {})
        status_pages.append({
            'id': item.get('id', ''),
            'company_name': a.get('company_name', ''),
            'subdomain': a.get('subdomain', ''),
            'custom_domain': a.get('custom_domain'),
            'aggregate_state': a.get('aggregate_state', ''),
        })

# On-call schedules
raw_oncall = fetch_all(API_V2 + '/on-calls')
on_call = []
if isinstance(raw_oncall, list):
    for item in raw_oncall:
        a = item.get('attributes', {})
        on_call_users = item.get('relationships', {}).get('on_call_users', {}).get('data', [])
        emails = []
        for user in on_call_users:
            meta = user.get('meta', {})
            emails.append(meta.get('email') or user.get('id', ''))
        on_call.append({
            'id': item.get('id', ''),
            'name': a.get('name', ''),
            'default_calendar': a.get('default_calendar', False),
            'team_name': a.get('team_name'),
            'on_call_users': emails,
        })

snapshot = {
    'monitors': {
        'count': len(monitors),
        'by_status': by_status if token_valid else {},
        'items': monitors,
    },
    'incidents': {
        'count': len(incidents),
        'active': active_incidents,
        'items': incidents,
    },
    'heartbeats': {
        'count': len(heartbeats),
        'items': heartbeats,
    },
    'status_pages': {
        'count': len(status_pages),
        'items': status_pages,
    },
    'on_call': {
        'count': len(on_call),
        'items': on_call,
    },
    'token_valid': token_valid,
}

print(json.dumps(snapshot, indent=2))
"
}

# --- Main ---

case "${1:-help}" in
    monitors|ls|list)
        shift || true
        cmd_monitors "$@"
        ;;
    show|get)
