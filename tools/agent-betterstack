#!/usr/bin/env bash
# agent-betterstack - Better Stack Uptime monitoring and incident management

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=/dev/null
source "${SCRIPT_DIR}/../lib/json-output.sh" 2>/dev/null || true

_json_mode=false
_JSON_ARGS=()

_pop_json_flag() {
    _json_mode=false
    _JSON_ARGS=()
    for arg in "$@"; do
        if [[ "$arg" == "--json" ]]; then
            _json_mode=true
        else
            _JSON_ARGS+=("$arg")
        fi
    done
}

_emit_json() {
    printf '%s' "$1" | python3 -m json.tool 2>/dev/null || printf '%s\n' "$1"
}

BETTERSTACK_API_V2="https://uptime.betterstack.com/api/v2"
BETTERSTACK_API_V3="https://uptime.betterstack.com/api/v3"

show_help() {
    cat << 'EOF'
agent-betterstack - Better Stack Uptime monitoring and incident management

MONITORS
  monitors / ls                 List all monitors with status
  show <monitor>                Detailed monitor info (by name or ID)
  availability <monitor>        Availability summary for a monitor
  response-times <monitor>      Response time data for a monitor
  pause <monitor>               Pause a monitor
  resume <monitor>              Resume a monitor

INCIDENTS
  incidents [--active]          List incidents (--active = unresolved only)
  incident <id>                 Detailed incident info
  ack <id>                      Acknowledge an incident
  resolve <id>                  Resolve an incident

HEARTBEATS
  heartbeats                    List all heartbeats with status
  pause --heartbeat <hb>        Pause a heartbeat (by exact name or ID)
  resume --heartbeat <hb>       Resume a heartbeat

STATUS PAGES
  status-pages                  List all status pages

ON-CALL
  on-call                       List on-call schedules

ACCOUNT
  snapshot                      Full account state as JSON

All commands accept --json for structured output.

Monitors can be referenced by pronounceable name or numeric ID.

Environment:
  BETTERSTACK_API_TOKEN         API token (Bearer auth)

Examples:
  agent-betterstack monitors
  agent-betterstack show vms-web
