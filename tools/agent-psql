#!/usr/bin/env bash
# agent-psql - PostgreSQL CLI wrapper for AI agents
# Wraps the native psql/pg_dump/pg_restore binaries.
# Complementary to agent-db (which uses Python drivers for multi-database support).
#
# Designed for Render Postgres and Supabase — paste a connection string, get structured access.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PSQL_CONFIG_DIR="${AGENT_DO_HOME:-$HOME/.agent-do}/psql"
SESSION_FILE="${PSQL_CONFIG_DIR}/session.json"
PROFILES_FILE="${PSQL_CONFIG_DIR}/profiles.json"

# Source shared helpers
source "${SCRIPT_DIR}/../lib/json-output.sh" 2>/dev/null || true
source "${SCRIPT_DIR}/../lib/snapshot.sh" 2>/dev/null || true

show_help() {
    cat << 'EOF'
agent-psql - PostgreSQL CLI wrapper for AI agents

Wraps the native psql binary for PostgreSQL-specific operations.
Paste a Render or Supabase connection string and go.

CONNECTION
  connect <conn_string>      Connect via connection string
  connect --profile <name>   Connect via saved profile
  disconnect                 End session
  status                     Show connection status

PROFILES
  profiles                   List saved profiles
  profile add <name> <str>   Save a connection profile (password stored in keychain)
  profile remove <name>      Remove a profile

SCHEMA EXPLORATION
  snapshot                   Full schema overview (tables, views, sizes, extensions)
  snapshot --compact         Table names only
  tables [pattern]           List tables (optional LIKE pattern)
  views                      List views
  describe <table>           Columns, types, constraints, indexes, FKs
  schemas                    List schemas
  extensions                 List installed extensions
  sizes                      Table and index sizes
  relations [table]          FK relationship map

DATA
  query "<sql>"              Execute SQL, return JSON
  query "<sql>" --limit N    Add/override LIMIT (default: 200 for SELECT)
  sample <table> [n]         Sample n rows (default: 5)
  count <table>              Row count
  exec <file.sql>            Execute a SQL file

ADMINISTRATION
  connections                Active database connections
  locks                      Current lock contention
  stats [table]              Table statistics (seq/idx scans, live/dead tuples)
  indexes <table>            Index details and usage stats
  version                    PostgreSQL server version

BACKUP
  dump <outfile> [opts]      pg_dump wrapper
    --table <t>              Dump specific table
    --schema-only            Schema only, no data
    --format <fmt>           Output format: plain (default), custom, directory
  restore <file> [opts]      pg_restore wrapper
    --clean                  Drop objects before restoring
    --schema-only            Schema only

ENVIRONMENT
  PGHOST, PGPORT, PGDATABASE, PGUSER, PGPASSWORD   Standard libpq vars
  Connection strings: postgresql://user:pass@host:port/dbname?sslmode=require

EXIT CODES
  0  Success
  1  Connection failed
  2  psql binary not found
  3  Object not found
  4  Query error
  5  Permission denied
  6  File not found
  7  Backup/restore error
  8  Unknown error

EXAMPLES
  # Connect with a Render connection string
  agent-psql connect "postgresql://user:pass@host.render.com:5432/mydb?sslmode=require"

  # Save it for later
  agent-psql profile add mydb "postgresql://user:pass@host.render.com:5432/mydb"

  # Explore
  agent-psql snapshot
  agent-psql describe users
  agent-psql sample orders 10

  # Query
  agent-psql query "SELECT * FROM users WHERE active = true"

  # Admin
  agent-psql connections
  agent-psql sizes

  # Backup
  agent-psql dump backup.sql --schema-only
EOF
}

# --- Helpers ---

ensure_psql() {
    if ! command -v psql &>/dev/null; then
        echo '{"ok": false, "error": "psql binary not found. Install PostgreSQL client: brew install postgresql"}'
        exit 2
    fi
}

ensure_config_dir() {
    mkdir -p "$PSQL_CONFIG_DIR"
}

# Validate a table reference to prevent SQL injection.
# Allows: schema.table or just table. Each component must be a valid SQL identifier
# (letters, digits, underscores; must start with letter or underscore).
# At most one dot (schema.table); rejects everything else.
validate_table_name() {
    local name="$1"
    if [[ -z "$name" ]]; then
        echo '{"ok": false, "error": "Table name required"}'
        return 1
    fi
    # Allow schema.table (one dot max); validate each component
    local part
    local dot_count="${name//[^.]/}"
    if [[ ${#dot_count} -gt 1 ]]; then
        echo "{\"ok\": false, \"error\": \"Invalid table reference (too many dots): $name\"}"
        return 1
    fi
    IFS='.' read -ra parts <<< "$name"
    for part in "${parts[@]}"; do
        if [[ ! "$part" =~ ^[a-zA-Z_][a-zA-Z0-9_]*$ ]]; then
            echo "{\"ok\": false, \"error\": \"Invalid identifier: $part\"}"
            return 1
        fi
    done
    return 0
}

# Parse a table reference into schema and table components.
# Sets _TBL_SCHEMA and _TBL_NAME. Call after validate_table_name.
# "users" -> schema=public, table=users
# "myschema.users" -> schema=myschema, table=users
parse_table_ref() {
    local ref="$1"
    if [[ "$ref" == *.* ]]; then
        _TBL_SCHEMA="${ref%%.*}"
        _TBL_NAME="${ref#*.}"
    else
        _TBL_SCHEMA="public"
        _TBL_NAME="$ref"
    fi
}

# Mask password in a connection string for safe display
mask_connection_string() {
    python3 -c "
import sys
from urllib.parse import urlparse, urlunparse
try:
    u = urlparse(sys.argv[1])
    if u.password:
        masked = u._replace(netloc=f'{u.username}:****@{u.hostname}' + (f':{u.port}' if u.port else ''))
        print(urlunparse(masked))
    else:
        print(sys.argv[1])
except:
    print('****')
" "$1"
}

# Parse a connection string into PG* env vars.
# Sets: _PG_HOST, _PG_PORT, _PG_DATABASE, _PG_USER, _PG_PASSWORD, _PG_SSLMODE
parse_connection_string() {
    eval "$(python3 -c "
import sys, shlex
from urllib.parse import urlparse, parse_qs
try:
    u = urlparse(sys.argv[1])
    host = u.hostname or 'localhost'
    port = str(u.port or 5432)
    db = (u.path or '').lstrip('/')
    user = u.username or ''
    pw = u.password or ''
    qs = parse_qs(u.query)
    ssl = qs.get('sslmode', ['prefer'])[0]
    print(f'_PG_HOST={shlex.quote(host)}')
    print(f'_PG_PORT={shlex.quote(port)}')
    print(f'_PG_DATABASE={shlex.quote(db)}')
    print(f'_PG_USER={shlex.quote(user)}')
    print(f'_PG_PASSWORD={shlex.quote(pw)}')
    print(f'_PG_SSLMODE={shlex.quote(ssl)}')
except Exception as e:
    print(f'echo \"Error parsing connection string: {e}\" >&2; return 1', file=sys.stderr)
    sys.exit(1)
" "$1")"
}

# Load active session. Returns 0 if session exists, 1 otherwise.
# Sets _PG_* vars from the session file.
load_session() {
    if [[ ! -f "$SESSION_FILE" ]]; then
        return 1
    fi
    eval "$(python3 -c "
import json, sys, shlex
try:
    with open(sys.argv[1]) as f:
        s = json.load(f)
    print(f'_PG_HOST={shlex.quote(s.get(\"host\", \"\"))}')
    print(f'_PG_PORT={shlex.quote(s.get(\"port\", \"5432\"))}')
    print(f'_PG_DATABASE={shlex.quote(s.get(\"database\", \"\"))}')
    print(f'_PG_USER={shlex.quote(s.get(\"user\", \"\"))}')
    print(f'_PG_SSLMODE={shlex.quote(s.get(\"sslmode\", \"prefer\"))}')
except:
    sys.exit(1)
" "$SESSION_FILE" 2>/dev/null)" || return 1
    # Password comes from keychain or env
    _PG_PASSWORD="${PGPASSWORD:-}"
    if [[ -z "$_PG_PASSWORD" ]]; then
        _PG_PASSWORD=$(_get_session_password 2>/dev/null || true)
    fi
    return 0
}

# Save session state (never stores password in the file)
save_session() {
    ensure_config_dir
    python3 -c "
import json, sys
from datetime import datetime
session = {
    'host': sys.argv[1],
    'port': sys.argv[2],
    'database': sys.argv[3],
    'user': sys.argv[4],
    'sslmode': sys.argv[5],
    'connected_at': datetime.utcnow().isoformat() + 'Z'
}
with open(sys.argv[6], 'w') as f:
    json.dump(session, f, indent=2)
" "$_PG_HOST" "$_PG_PORT" "$_PG_DATABASE" "$_PG_USER" "$_PG_SSLMODE" "$SESSION_FILE"
}

# Store password in macOS keychain
_store_password() {
    local profile_name="$1"
    local password="$2"
    if [[ "$(uname)" == "Darwin" ]]; then
        security delete-generic-password -a "$profile_name" -s "agent-psql" 2>/dev/null || true
        security add-generic-password -a "$profile_name" -s "agent-psql" -w "$password" 2>/dev/null
    fi
}

# Get password from keychain
_get_password() {
    local profile_name="$1"
    if [[ "$(uname)" == "Darwin" ]]; then
        security find-generic-password -a "$profile_name" -s "agent-psql" -w 2>/dev/null || true
    fi
}

# Build a composite session key to avoid collisions across hosts/users/databases
_session_key() {
    echo "session-${_PG_HOST:-localhost}-${_PG_PORT:-5432}-${_PG_USER:-$(whoami)}-${_PG_DATABASE:-default}"
}

# Get session password
_get_session_password() {
    _get_password "$(_session_key)"
}

# Store session password
_store_session_password() {
    _store_password "$(_session_key)" "$1"
}

# Ensure we have an active connection. Exits with error if not.
require_connection() {
    ensure_psql
    if ! load_session; then
        echo '{"ok": false, "error": "Not connected. Use: agent-psql connect <connection_string>"}'
        exit 1
    fi
}

# Execute psql with tuples-only unaligned output (no CSV, tab-separated)
run_psql_raw() {
    local sql="$1"
    PGPASSWORD="$_PG_PASSWORD" psql \
        -X -t -A -F $'\t' \
        -v ON_ERROR_STOP=1 \
        -h "$_PG_HOST" \
        -p "$_PG_PORT" \
        -U "$_PG_USER" \
        -d "$_PG_DATABASE" \
        -c "$sql" 2>&1
}

# Execute psql with full output (headers + footers, for human or query results)
run_psql_full() {
    local sql="$1"
    PGPASSWORD="$_PG_PASSWORD" psql \
        -X -A --csv \
        -v ON_ERROR_STOP=1 \
        -h "$_PG_HOST" \
        -p "$_PG_PORT" \
        -U "$_PG_USER" \
        -d "$_PG_DATABASE" \
        -c "$sql" 2>&1
}

# --- Connection Commands ---

cmd_connect() {
    ensure_psql
    local conn_string=""
    local profile_name=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --profile|-p) profile_name="$2"; shift 2 ;;
            --help|-h) show_help; return 0 ;;
            *) conn_string="$1"; shift ;;
        esac
    done

    # From profile
    if [[ -n "$profile_name" ]]; then
        local profiles
        profiles=$(_load_profiles)
        local conn
        conn=$(echo "$profiles" | python3 -c "
import json, sys
profiles = json.load(sys.stdin)
name = sys.argv[1]
if name not in profiles:
    print('', end='')
    sys.exit(1)
print(profiles[name].get('connection_string', ''))
" "$profile_name" 2>/dev/null) || true

        if [[ -z "$conn" ]]; then
            echo "{\"ok\": false, \"error\": \"Profile '$profile_name' not found\"}"
            exit 1
        fi
        conn_string="$conn"
        # Get password from keychain
        local stored_pw
        stored_pw=$(_get_password "$profile_name" 2>/dev/null || true)
        if [[ -n "$stored_pw" ]]; then
            # Inject password into connection string if it has a placeholder
            conn_string=$(python3 -c "
import sys
from urllib.parse import urlparse, urlunparse
u = urlparse(sys.argv[1])
pw = sys.argv[2]
if not u.password or u.password == '****':
    netloc = f'{u.username}:{pw}@{u.hostname}' + (f':{u.port}' if u.port else '')
    print(urlunparse(u._replace(netloc=netloc)))
else:
    print(sys.argv[1])
" "$conn_string" "$stored_pw")
        fi
    fi

    if [[ -z "$conn_string" ]]; then
        # Try PG* env vars
        if [[ -n "${PGHOST:-}" ]] && [[ -n "${PGDATABASE:-}" ]]; then
            _PG_HOST="${PGHOST}"
            _PG_PORT="${PGPORT:-5432}"
            _PG_DATABASE="${PGDATABASE}"
            _PG_USER="${PGUSER:-$(whoami)}"
            _PG_PASSWORD="${PGPASSWORD:-}"
            _PG_SSLMODE="${PGSSLMODE:-prefer}"
        else
            echo '{"ok": false, "error": "No connection string, profile, or PGHOST/PGDATABASE env vars provided"}'
            exit 1
        fi
    else
        parse_connection_string "$conn_string"
    fi

    # Test the connection
    local version
    version=$(run_psql_raw "SELECT version()" 2>&1) || {
        python3 -c "
import json, sys
print(json.dumps({'ok': False, 'error': 'Connection failed: ' + sys.argv[1]}))
" "$(echo "$version" | head -1)"
        exit 1
    }

    # Store session
    save_session

    # Store password in keychain for session reconnect
    if [[ -n "$_PG_PASSWORD" ]]; then
        _store_session_password "$_PG_PASSWORD"
    fi

    local masked
    masked=$(mask_connection_string "postgresql://${_PG_USER}:${_PG_PASSWORD}@${_PG_HOST}:${_PG_PORT}/${_PG_DATABASE}")

    # Snapshot the connection event
    if type snapshot_begin &>/dev/null; then
        snapshot_begin "psql-connect"
        snapshot_field "host" "$_PG_HOST"
        snapshot_field "port" "$_PG_PORT"
        snapshot_field "database" "$_PG_DATABASE"
        snapshot_field "user" "$_PG_USER"
        snapshot_field "sslmode" "$_PG_SSLMODE"
        snapshot_field "masked_uri" "$masked"
        snapshot_end
    fi

    python3 -c "
import json, sys
print(json.dumps({
    'ok': True,
    'message': 'Connected',
    'host': sys.argv[1],
    'port': sys.argv[2],
    'database': sys.argv[3],
    'user': sys.argv[4],
    'sslmode': sys.argv[5],
    'server_version': sys.argv[6].strip(),
    'masked_uri': sys.argv[7]
}, indent=2))
" "$_PG_HOST" "$_PG_PORT" "$_PG_DATABASE" "$_PG_USER" "$_PG_SSLMODE" "$version" "$masked"
}

cmd_disconnect() {
    if [[ -f "$SESSION_FILE" ]]; then
        rm -f "$SESSION_FILE"
    fi
    echo '{"ok": true, "message": "Disconnected"}'
}

cmd_status() {
    if load_session; then
        python3 -c "
import json, sys
print(json.dumps({
    'ok': True,
    'connected': True,
    'host': sys.argv[1],
    'port': sys.argv[2],
    'database': sys.argv[3],
    'user': sys.argv[4],
    'sslmode': sys.argv[5]
}, indent=2))
" "$_PG_HOST" "$_PG_PORT" "$_PG_DATABASE" "$_PG_USER" "$_PG_SSLMODE"
    else
        echo '{"ok": true, "connected": false, "message": "Not connected. Use: agent-psql connect <connection_string>"}'
    fi
}

# --- Profile Commands ---

_load_profiles() {
    if [[ -f "$PROFILES_FILE" ]]; then
        cat "$PROFILES_FILE"
    else
        echo '{}'
    fi
}

cmd_profiles() {
    ensure_config_dir
    local profiles
    profiles=$(_load_profiles)

    echo "$profiles" | python3 -c "
import json, sys
from urllib.parse import urlparse
profiles = json.load(sys.stdin)
if not profiles:
    print(json.dumps({'ok': True, 'profiles': [], 'count': 0}, indent=2))
    sys.exit(0)
items = []
for name, data in profiles.items():
    cs = data.get('connection_string', '')
    try:
        u = urlparse(cs)
        items.append({
            'name': name,
            'host': u.hostname or '',
            'port': u.port or 5432,
            'database': (u.path or '').lstrip('/'),
            'user': u.username or ''
        })
    except:
        items.append({'name': name, 'host': '?', 'database': '?'})
print(json.dumps({'ok': True, 'profiles': items, 'count': len(items)}, indent=2))
"
}

cmd_profile_add() {
    local name="${1:-}"
    local conn_string="${2:-}"

    if [[ -z "$name" ]] || [[ -z "$conn_string" ]]; then
        echo '{"ok": false, "error": "Usage: agent-psql profile add <name> <connection_string>"}'
        return 1
    fi

    ensure_config_dir

    # Extract and store password separately
    local password
    password=$(python3 -c "
from urllib.parse import urlparse
import sys
u = urlparse(sys.argv[1])
print(u.password or '')
" "$conn_string")

    # Store password-stripped connection string
    local stripped
    stripped=$(python3 -c "
from urllib.parse import urlparse, urlunparse
import sys
u = urlparse(sys.argv[1])
if u.password:
    netloc = f'{u.username}:****@{u.hostname}' + (f':{u.port}' if u.port else '')
    print(urlunparse(u._replace(netloc=netloc)))
else:
    print(sys.argv[1])
" "$conn_string")

    # Update profiles file
    local profiles
    profiles=$(_load_profiles)
    echo "$profiles" | python3 -c "
import json, sys
profiles = json.load(sys.stdin)
profiles[sys.argv[1]] = {'connection_string': sys.argv[2]}
with open(sys.argv[3], 'w') as f:
    json.dump(profiles, f, indent=2)
" "$name" "$stripped" "$PROFILES_FILE"

    # Store password in keychain
    if [[ -n "$password" ]]; then
        _store_password "$name" "$password"
        echo "{\"ok\": true, \"message\": \"Profile '$name' saved. Password stored in keychain.\"}"
    else
        echo "{\"ok\": true, \"message\": \"Profile '$name' saved. No password found in connection string.\"}"
    fi
}

cmd_profile_remove() {
    local name="${1:-}"
    if [[ -z "$name" ]]; then
        echo '{"ok": false, "error": "Usage: agent-psql profile remove <name>"}'
        return 1
    fi

    local profiles
    profiles=$(_load_profiles)
    echo "$profiles" | python3 -c "
import json, sys
profiles = json.load(sys.stdin)
name = sys.argv[1]
if name not in profiles:
    print(json.dumps({'ok': False, 'error': f\"Profile '{name}' not found\"}))
    sys.exit(1)
del profiles[name]
with open(sys.argv[2], 'w') as f:
    json.dump(profiles, f, indent=2)
print(json.dumps({'ok': True, 'message': f\"Profile '{name}' removed\"}))
" "$name" "$PROFILES_FILE"

    # Remove from keychain
    if [[ "$(uname)" == "Darwin" ]]; then
        security delete-generic-password -a "$name" -s "agent-psql" 2>/dev/null || true
    fi
}

# --- Schema Exploration Commands ---

cmd_snapshot() {
    require_connection
    local compact=false

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --compact) compact=true; shift ;;
            *) shift ;;
        esac
    done

    if [[ "$compact" == "true" ]]; then
        local result
        result=$(run_psql_raw "SELECT tablename FROM pg_tables WHERE schemaname = 'public' ORDER BY tablename") || {
            python3 -c "import json,sys; print(json.dumps({'ok':False,'error':'Query failed: '+sys.argv[1]}))" "$(echo "$result" | head -1)"
            exit 4
        }
        python3 -c "
import json, sys
lines = [l.strip() for l in sys.stdin.read().strip().split('\n') if l.strip()]
print(json.dumps({
    'ok': True,
    'database': sys.argv[1],
    'table_count': len(lines),
    'tables': lines
}, indent=2))
" "$_PG_DATABASE" <<< "$result"
        return
    fi

    # Full snapshot: tables with row counts and sizes, views, extensions
    local result
    result=$(run_psql_full "
SELECT json_build_object(
    'tables', COALESCE((
        SELECT json_agg(json_build_object(
            'name', t.tablename,
            'schema', t.schemaname,
            'rows', COALESCE(s.n_live_tup, 0),
            'size', pg_size_pretty(pg_total_relation_size(quote_ident(t.tablename))),
            'size_bytes', pg_total_relation_size(quote_ident(t.tablename))
        ) ORDER BY t.tablename)
        FROM pg_tables t
        LEFT JOIN pg_stat_user_tables s ON s.relname = t.tablename
        WHERE t.schemaname = 'public'
    ), '[]'::json),
    'views', COALESCE((
        SELECT json_agg(json_build_object(
            'name', viewname,
            'schema', schemaname
        ) ORDER BY viewname)
        FROM pg_views
        WHERE schemaname = 'public'
    ), '[]'::json),
    'extensions', COALESCE((
        SELECT json_agg(json_build_object(
            'name', extname,
            'version', extversion
        ) ORDER BY extname)
        FROM pg_extension
        WHERE extname != 'plpgsql'
    ), '[]'::json),
    'database', current_database(),
    'server_version', version(),
    'db_size', pg_size_pretty(pg_database_size(current_database())),
    'db_size_bytes', pg_database_size(current_database())
)
") || {
        python3 -c "import json,sys; print(json.dumps({'ok':False,'error':'Snapshot failed: '+sys.argv[1]}))" "$(echo "$result" | head -1)"
        exit 4
    }

    # The CSV header is the first line; the JSON is the second
    python3 -c "
import json, sys
raw = sys.stdin.read().strip()
# Skip CSV header line if present
lines = raw.split('\n')
for line in lines:
    line = line.strip()
    if line.startswith('{'):
        data = json.loads(line)
        data['ok'] = True
        table_count = len(data.get('tables', []))
        view_count = len(data.get('views', []))
        data['table_count'] = table_count
        data['view_count'] = view_count
        print(json.dumps(data, indent=2))
        sys.exit(0)
print(json.dumps({'ok': False, 'error': 'Unexpected output format'}))
" <<< "$result"
}

cmd_tables() {
    require_connection
    local pattern="${1:-}"

    local sql="
        SELECT json_agg(json_build_object(
            'name', t.tablename,
            'rows', COALESCE(s.n_live_tup, 0),
            'size', pg_size_pretty(pg_total_relation_size(quote_ident(t.tablename)))
        ) ORDER BY t.tablename)
        FROM pg_tables t
        LEFT JOIN pg_stat_user_tables s ON s.relname = t.tablename
        WHERE t.schemaname = 'public'
    "
    if [[ -n "$pattern" ]]; then
        # Validate LIKE pattern: allow table name chars plus % and _ wildcards
        if [[ ! "$pattern" =~ ^[a-zA-Z0-9_%.-]+$ ]]; then
            echo "{\"ok\": false, \"error\": \"Invalid table pattern: $pattern\"}"
            return 1
        fi
        sql+=" AND t.tablename LIKE '${pattern}'"
    fi

    local result
    result=$(run_psql_raw "$sql") || {
        echo "{\"ok\": false, \"error\": \"Query failed\"}"
        exit 4
    }

    python3 -c "
import json, sys
raw = sys.stdin.read().strip()
if not raw or raw == '':
    print(json.dumps({'ok': True, 'tables': [], 'count': 0}, indent=2))
    sys.exit(0)
try:
    tables = json.loads(raw) or []
    print(json.dumps({'ok': True, 'tables': tables, 'count': len(tables)}, indent=2))
except:
    print(json.dumps({'ok': True, 'tables': [], 'count': 0}, indent=2))
" <<< "$result"
}

cmd_views() {
    require_connection

    local result
    result=$(run_psql_raw "
        SELECT COALESCE(json_agg(json_build_object(
            'name', viewname,
            'schema', schemaname,
            'definition', LEFT(definition, 200)
        ) ORDER BY viewname), '[]')
        FROM pg_views WHERE schemaname = 'public'
    ") || {
        echo "{\"ok\": false, \"error\": \"Query failed\"}"
        exit 4
    }

    python3 -c "
import json, sys
raw = sys.stdin.read().strip()
views = json.loads(raw) if raw else []
print(json.dumps({'ok': True, 'views': views, 'count': len(views)}, indent=2))
" <<< "$result"
}

cmd_describe() {
    require_connection
    local table="${1:-}"
    if [[ -z "$table" ]]; then
        echo '{"ok": false, "error": "Usage: agent-psql describe <table>"}'
        return 1
    fi
    validate_table_name "$table" || return 1
    parse_table_ref "$table"

    local result
    result=$(run_psql_raw "
        SELECT json_build_object(
            'table', '$table',
            'schema', '$_TBL_SCHEMA',
            'columns', (
                SELECT json_agg(json_build_object(
                    'name', c.column_name,
                    'type', c.data_type ||
                        CASE WHEN c.character_maximum_length IS NOT NULL
                             THEN '(' || c.character_maximum_length || ')'
                             ELSE '' END,
                    'nullable', c.is_nullable = 'YES',
                    'default', c.column_default
                ) ORDER BY c.ordinal_position)
                FROM information_schema.columns c
                WHERE c.table_name = '$_TBL_NAME' AND c.table_schema = '$_TBL_SCHEMA'
            ),
            'primary_key', COALESCE((
                SELECT json_agg(a.attname ORDER BY a.attnum)
                FROM pg_index i
                JOIN pg_attribute a ON a.attrelid = i.indrelid AND a.attnum = ANY(i.indkey)
                WHERE i.indrelid = '\"$_TBL_SCHEMA\".\"$_TBL_NAME\"'::regclass AND i.indisprimary
            ), '[]'::json),
            'foreign_keys', COALESCE((
                SELECT json_agg(json_build_object(
                    'column', kcu.column_name,
                    'references', ccu.table_schema || '.' || ccu.table_name || '.' || ccu.column_name,
                    'constraint', tc.constraint_name
                ))
                FROM information_schema.table_constraints tc
                JOIN information_schema.key_column_usage kcu
                    ON tc.constraint_name = kcu.constraint_name
                JOIN information_schema.constraint_column_usage ccu
                    ON ccu.constraint_name = tc.constraint_name
                WHERE tc.constraint_type = 'FOREIGN KEY'
                  AND tc.table_name = '$_TBL_NAME' AND tc.table_schema = '$_TBL_SCHEMA'
            ), '[]'::json),
            'indexes', COALESCE((
                SELECT json_agg(json_build_object(
                    'name', indexname,
                    'definition', indexdef,
                    'size', pg_size_pretty(pg_relation_size(quote_ident(indexname)))
                ))
                FROM pg_indexes
                WHERE tablename = '$_TBL_NAME' AND schemaname = '$_TBL_SCHEMA'
            ), '[]'::json),
            'row_count', (SELECT n_live_tup FROM pg_stat_user_tables
                          WHERE relname = '$_TBL_NAME' AND schemaname = '$_TBL_SCHEMA'),
            'size', pg_size_pretty(pg_total_relation_size(
                quote_ident('$_TBL_SCHEMA') || '.' || quote_ident('$_TBL_NAME'))),
            'size_bytes', pg_total_relation_size(
                quote_ident('$_TBL_SCHEMA') || '.' || quote_ident('$_TBL_NAME'))
        )
    ") || {
        echo "{\"ok\": false, \"error\": \"Table '$table' not found or query failed\", \"exit_code\": 3}"
        exit 3
    }

    python3 -c "
import json, sys
raw = sys.stdin.read().strip()
if not raw:
    print(json.dumps({'ok': False, 'error': 'No output', 'exit_code': 3}))
    sys.exit(0)
try:
    data = json.loads(raw)
    data['ok'] = True
    print(json.dumps(data, indent=2))
except Exception as e:
    print(json.dumps({'ok': False, 'error': f'Parse error: {e}'}))
" <<< "$result"
}

