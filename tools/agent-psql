cmd_exec() {
    require_connection
    local file="${1:-}"
    if [[ -z "$file" ]]; then
        echo '{"ok": false, "error": "Usage: agent-psql exec <file.sql>"}'
        return 1
    fi
    if [[ ! -f "$file" ]]; then
        echo "{\"ok\": false, \"error\": \"File not found: $file\", \"exit_code\": 6}"
        exit 6
    fi

    # Snapshot the file execution
    if type snapshot_begin &>/dev/null; then
        snapshot_begin "psql-exec"
        snapshot_field "database" "$_PG_DATABASE"
        snapshot_field "file" "$file"
        snapshot_end
    fi

    local start_ms
    start_ms=$(python3 -c "import time; print(int(time.time()*1000))")

    local result
    result=$(PGPASSWORD="$_PG_PASSWORD" psql \
        -X -v ON_ERROR_STOP=1 \
        -h "$_PG_HOST" -p "$_PG_PORT" -U "$_PG_USER" -d "$_PG_DATABASE" \
        -f "$file" 2>&1)
    local exit_code=$?

    local end_ms
    end_ms=$(python3 -c "import time; print(int(time.time()*1000))")
    local elapsed=$((end_ms - start_ms))

    python3 -c "
import json, sys
ok = int(sys.argv[1]) == 0
output = sys.stdin.read().strip()
data = {
    'ok': ok,
    'file': sys.argv[2],
    'execution_time_ms': int(sys.argv[3]),
    'output': output[:2000] if output else ''
}
if not ok:
    data['error'] = output[:500]
    data['exit_code'] = 4
print(json.dumps(data, indent=2))
" "$exit_code" "$file" "$elapsed" <<< "$result"
}

