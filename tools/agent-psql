# --- Backup Commands ---

cmd_dump() {
    require_connection
    local outfile=""
    local table=""
    local schema_only=false
    local format="plain"

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --table|-t) table="$2"; shift 2 ;;
            --schema-only) schema_only=true; shift ;;
            --format|-F) format="$2"; shift 2 ;;
            *) outfile="$1"; shift ;;
        esac
    done

    if [[ -z "$outfile" ]]; then
        echo '{"ok": false, "error": "Usage: agent-psql dump <outfile> [--table T] [--schema-only] [--format plain|custom|directory]"}'
        return 1
    fi

    if ! command -v pg_dump &>/dev/null; then
        echo '{"ok": false, "error": "pg_dump binary not found", "exit_code": 2}'
        exit 2
    fi

    local -a dump_args=(-h "$_PG_HOST" -p "$_PG_PORT" -U "$_PG_USER" -d "$_PG_DATABASE")

    case "$format" in
        plain|p)   dump_args+=(-F p) ;;
        custom|c)  dump_args+=(-F c) ;;
        directory|d) dump_args+=(-F d) ;;
        *) echo "{\"ok\": false, \"error\": \"Unknown format: $format\"}"; return 1 ;;
    esac

    if [[ -n "$table" ]]; then
        validate_table_name "$table" || return 1
        dump_args+=(-t "$table")
    fi
    if [[ "$schema_only" == "true" ]]; then
        dump_args+=(--schema-only)
    fi

    dump_args+=(-f "$outfile")

    local result
    result=$(PGPASSWORD="$_PG_PASSWORD" pg_dump "${dump_args[@]}" 2>&1)
    local exit_code=$?

    if [[ $exit_code -eq 0 ]]; then
        local size="?"
        if [[ -f "$outfile" ]]; then
            size=$(du -sh "$outfile" 2>/dev/null | cut -f1)
        elif [[ -d "$outfile" ]]; then
            size=$(du -sh "$outfile" 2>/dev/null | cut -f1)
        fi
        python3 -c "
import json, sys
print(json.dumps({
    'ok': True,
    'message': 'Dump completed',
    'file': sys.argv[1],
    'format': sys.argv[2],
    'size': sys.argv[3],
    'table': sys.argv[4] or None,
    'schema_only': sys.argv[5] == 'true'
}, indent=2))
" "$outfile" "$format" "$size" "$table" "$schema_only"
    else
        python3 -c "
import json, sys
print(json.dumps({
    'ok': False,
    'error': sys.stdin.read().strip()[:500],
    'exit_code': 7
}, indent=2))
" <<< "$result"
        exit 7
    fi
}

cmd_restore() {
    require_connection
    local infile=""
    local clean=false
    local schema_only=false

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --clean) clean=true; shift ;;
            --schema-only) schema_only=true; shift ;;
            *) infile="$1"; shift ;;
        esac
    done

    if [[ -z "$infile" ]]; then
        echo '{"ok": false, "error": "Usage: agent-psql restore <file> [--clean] [--schema-only]"}'
        return 1
    fi
    if [[ ! -e "$infile" ]]; then
        echo "{\"ok\": false, \"error\": \"File not found: $infile\", \"exit_code\": 6}"
        exit 6
    fi

    # Detect format: .sql → psql, otherwise → pg_restore
    if [[ "$infile" == *.sql ]]; then
        # Warn if restore-specific flags are set — they don't apply to plain SQL
        if [[ "$clean" == "true" ]] || [[ "$schema_only" == "true" ]]; then
            echo '{"ok": false, "error": "Flags --clean and --schema-only are not supported for .sql files (use pg_restore custom/directory format instead)"}'
            return 1
        fi
        cmd_exec "$infile"
        return $?
    fi

    if ! command -v pg_restore &>/dev/null; then
        echo '{"ok": false, "error": "pg_restore binary not found", "exit_code": 2}'
        exit 2
    fi

    local -a restore_args=(-h "$_PG_HOST" -p "$_PG_PORT" -U "$_PG_USER" -d "$_PG_DATABASE")
    if [[ "$clean" == "true" ]]; then restore_args+=(--clean); fi
    if [[ "$schema_only" == "true" ]]; then restore_args+=(--schema-only); fi
    restore_args+=("$infile")

    local result
    result=$(PGPASSWORD="$_PG_PASSWORD" pg_restore "${restore_args[@]}" 2>&1)
    local exit_code=$?

    python3 -c "
import json, sys
ok = int(sys.argv[1]) == 0
output = sys.stdin.read().strip()
data = {'ok': ok, 'file': sys.argv[2]}
if ok:
    data['message'] = 'Restore completed'
else:
    data['error'] = output[:500]
    data['exit_code'] = 7
print(json.dumps(data, indent=2))
" "$exit_code" "$infile" <<< "$result"
}

# --- Main Dispatcher ---

case "${1:-help}" in
    help|--help|-h)
        show_help
        ;;
    connect)
        shift
        cmd_connect "$@"
        ;;
    disconnect)
        cmd_disconnect
        ;;
    status)
        cmd_status
        ;;
    profiles)
        cmd_profiles
        ;;
    profile)
        shift
        action="${1:-}"
        shift || true
        case "$action" in
            add)    cmd_profile_add "$@" ;;
            remove) cmd_profile_remove "$@" ;;
            *)      echo '{"ok": false, "error": "Usage: agent-psql profile [add|remove] <name> ..."}' ;;
        esac
        ;;
    snapshot)
        shift
        cmd_snapshot "$@"
        ;;
    tables)
        shift
        cmd_tables "$@"
        ;;
    views)
        cmd_views
        ;;
    describe|desc)
        shift
        cmd_describe "$@"
        ;;
    schemas)
        cmd_schemas
        ;;
    extensions)
        cmd_extensions
        ;;
    sizes)
        cmd_sizes
        ;;
    relations|rels)
        shift
        cmd_relations "$@"
        ;;
    query|q)
        shift
        cmd_query "$@"
        ;;
    sample)
        shift
        cmd_sample "$@"
        ;;
    count)
        shift
        cmd_count "$@"
        ;;
    exec)
        shift
        cmd_exec "$@"
        ;;
    connections|conns)
        cmd_connections
        ;;
    locks)
        cmd_locks
        ;;
    stats)
        shift
        cmd_stats "$@"
        ;;
    indexes|idx)
        shift
        cmd_indexes "$@"
        ;;
    version)
        cmd_version
        ;;
    dump)
        shift
        cmd_dump "$@"
        ;;
    restore)
        shift
        cmd_restore "$@"
        ;;
    *)
        echo "{\"ok\": false, \"error\": \"Unknown command: $1. Run 'agent-psql help' for usage.\"}"
        exit 1
        ;;
esac
