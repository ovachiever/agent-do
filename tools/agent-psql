cmd_relations() {
    require_connection
    local table="${1:-}"

    local where_clause=""
    if [[ -n "$table" ]]; then
        validate_table_name "$table" || return 1
        parse_table_ref "$table"
        where_clause="AND ((tc.table_name = '$_TBL_NAME' AND tc.table_schema = '$_TBL_SCHEMA') OR (ccu.table_name = '$_TBL_NAME' AND ccu.table_schema = '$_TBL_SCHEMA'))"
    fi

    local result
    result=$(run_psql_raw "
        SELECT COALESCE(json_agg(json_build_object(
            'constraint', tc.constraint_name,
            'from_table', tc.table_name,
            'from_column', kcu.column_name,
            'to_table', ccu.table_name,
            'to_column', ccu.column_name
        )), '[]')
        FROM information_schema.table_constraints tc
        JOIN information_schema.key_column_usage kcu
            ON tc.constraint_name = kcu.constraint_name
        JOIN information_schema.constraint_column_usage ccu
            ON ccu.constraint_name = tc.constraint_name
        WHERE tc.constraint_type = 'FOREIGN KEY' $where_clause
    ") || { echo '{"ok": false, "error": "Query failed"}'; exit 4; }

    python3 -c "
import json, sys
raw = sys.stdin.read().strip()
rels = json.loads(raw) if raw else []
print(json.dumps({'ok': True, 'relations': rels, 'count': len(rels)}, indent=2))
" <<< "$result"
}

# --- Data Commands ---

cmd_query() {
    require_connection
    local sql=""
    local limit=""
    local explain=false

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --limit|-l) limit="$2"; shift 2 ;;
            --explain) explain=true; shift ;;
            *) sql="$1"; shift ;;
        esac
    done

    if [[ -z "$sql" ]]; then
        echo '{"ok": false, "error": "Usage: agent-psql query \"<sql>\" [--limit N]"}'
        return 1
    fi

    # Snapshot the query
    if type snapshot_begin &>/dev/null; then
        snapshot_begin "psql-query"
        snapshot_field "database" "$_PG_DATABASE"
        snapshot_field "sql" "$sql"
        snapshot_end
    fi

    # Add EXPLAIN ANALYZE if requested
    if [[ "$explain" == "true" ]]; then
        sql="EXPLAIN ANALYZE $sql"
    fi

    # Add default LIMIT for SELECT statements without one
    if [[ -z "$limit" ]]; then
        # Only add default limit for SELECT, not for EXPLAIN or DML
        if echo "$sql" | grep -qi '^[[:space:]]*SELECT' && ! echo "$sql" | grep -qi 'LIMIT' && [[ "$explain" == "false" ]]; then
            limit="200"
        fi
    fi

    # Validate limit is numeric
    if [[ -n "$limit" ]] && [[ ! "$limit" =~ ^[0-9]+$ ]]; then
        echo '{"ok": false, "error": "Limit must be a positive integer"}'
        return 1
    fi
    if [[ -n "$limit" ]] && ! echo "$sql" | grep -qi 'LIMIT'; then
        sql="$sql LIMIT $limit"
    fi

    local start_ms
    start_ms=$(python3 -c "import time; print(int(time.time()*1000))")

    local result
    result=$(run_psql_full "$sql" 2>&1)
    local exit_code=$?

    local end_ms
    end_ms=$(python3 -c "import time; print(int(time.time()*1000))")
    local elapsed=$((end_ms - start_ms))

    if [[ $exit_code -ne 0 ]]; then
        python3 -c "
import json, sys
print(json.dumps({
    'ok': False,
    'error': sys.argv[1].strip(),
    'exit_code': 4
}, indent=2))
" "$result"
        return 1
    fi

    # Parse CSV output into JSON
    python3 -c "
import csv, json, sys, io
from datetime import datetime, date
raw = sys.stdin.read().strip()
elapsed = int(sys.argv[1])
if not raw:
    print(json.dumps({'ok': True, 'columns': [], 'rows': [], 'row_count': 0, 'execution_time_ms': elapsed}, indent=2))
    sys.exit(0)
reader = csv.reader(io.StringIO(raw))
rows_out = []
columns = []
for i, row in enumerate(reader):
    if i == 0:
        columns = row
    else:
        rows_out.append(row)
print(json.dumps({
    'ok': True,
    'columns': columns,
    'rows': rows_out,
    'row_count': len(rows_out),
    'execution_time_ms': elapsed
}, indent=2))
" "$elapsed" <<< "$result"
}

cmd_sample() {
    require_connection
    local table="${1:-}"
    local n="${2:-5}"
    local random=false

    if [[ -z "$table" ]]; then
        echo '{"ok": false, "error": "Usage: agent-psql sample <table> [n]"}'
        return 1
    fi
    validate_table_name "$table" || return 1
    parse_table_ref "$table"

    # Validate n is numeric and within bounds
    if [[ ! "$n" =~ ^[0-9]+$ ]] || [[ "$n" -lt 1 ]] || [[ "$n" -gt 1000 ]]; then
        echo '{"ok": false, "error": "Sample count must be a number between 1 and 1000"}'
        return 1
    fi

    # Shift off table and n, check for --random
    shift
    shift 2>/dev/null || true
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --random) random=true; shift ;;
            *) shift ;;
        esac
    done

    local order_clause=""
    if [[ "$random" == "true" ]]; then
        order_clause="ORDER BY RANDOM()"
    fi

    local qualified="\"$_TBL_SCHEMA\".\"$_TBL_NAME\""

    # Get total count
    local total
    total=$(run_psql_raw "SELECT COUNT(*) FROM $qualified" 2>/dev/null) || total="?"

    local result
    result=$(run_psql_full "SELECT * FROM $qualified $order_clause LIMIT $n") || {
        echo "{\"ok\": false, \"error\": \"Table '$table' not found\", \"exit_code\": 3}"
        exit 3
    }

    python3 -c "
import csv, json, sys, io
raw = sys.stdin.read().strip()
table = sys.argv[1]
total = sys.argv[2]
if not raw:
    print(json.dumps({'ok': True, 'table': table, 'columns': [], 'rows': [], 'sampled': 0, 'total_rows': total}, indent=2))
    sys.exit(0)
reader = csv.reader(io.StringIO(raw))
columns = []
rows = []
for i, row in enumerate(reader):
    if i == 0:
        columns = row
    else:
        rows.append(row)
try:
    total = int(total.strip())
except:
    total = '?'
print(json.dumps({
    'ok': True,
    'table': table,
    'columns': columns,
    'rows': rows,
    'sampled': len(rows),
    'total_rows': total
}, indent=2))
" "$table" "$total" <<< "$result"
}

