def token_from_env(*, as_user: bool = False, as_bot: bool = False) -> Token:
    candidates: list[tuple[str, str, str]]
    if as_user:
        candidates = [("SLACK_USER_TOKEN", "user"), ("SLACK_TOKEN", "auto")]
    elif as_bot:
        candidates = [("SLACK_BOT_TOKEN", "bot"), ("SLACK_TOKEN", "auto")]
    else:
        candidates = [
            ("SLACK_USER_TOKEN", "user"),
            ("SLACK_TOKEN", "auto"),
            ("SLACK_BOT_TOKEN", "bot"),
        ]

    for key, identity in candidates:
        value = os.environ.get(key, "").strip()
        if not value:
            continue
        if identity == "auto":
            identity = "user" if value.startswith("xoxp-") else "bot"
        if as_user and identity != "user":
            continue
        if as_bot and identity == "user":
            continue
        return Token(value=value, source=key, identity=identity)

    if as_user:
        raise SlackError("SLACK_USER_TOKEN is required for --as-user")
    if as_bot:
        raise SlackError("SLACK_BOT_TOKEN or SLACK_TOKEN is required for --as-bot")
    raise SlackError("SLACK_USER_TOKEN, SLACK_TOKEN, or SLACK_BOT_TOKEN is required")


def is_email(value: str) -> bool:
    return "@" in value and "." in value.rsplit("@", 1)[-1]


def normalize_person(person: str) -> str:
    return person[1:] if person.startswith("@") else person


def user_display(user: dict[str, Any]) -> str:
    profile = user.get("profile") or {}
    candidates = [
        profile.get("display_name"),
        profile.get("real_name"),
        user.get("real_name"),
        user.get("name"),
        user.get("id"),
    ]
    return next((str(item) for item in candidates if item), "unknown")


def resolve_user(client: SlackClient, query: str) -> dict[str, Any]:
    query = normalize_person(query.strip())
    if USER_ID_RE.match(query):
        return {"id": query, "resolved_from": "id"}

    if is_email(query):
        try:
            payload = client.get("users.lookupByEmail", {"email": query})
            user = payload.get("user") or {}
            if user.get("id"):
                user["resolved_from"] = "email"
                return user
        except SlackError as exc:
            if exc.payload.get("error") not in {"missing_scope", "users_not_found"}:
                raise

    wanted = query.casefold()
    matches: list[dict[str, Any]] = []
    cursor = ""
    while True:
        payload = client.get("users.list", {"limit": 200, "cursor": cursor})
        for user in payload.get("members", []):
            if user.get("deleted") or user.get("is_bot"):
                continue
            profile = user.get("profile") or {}
            fields = [
                user.get("id"),
                user.get("name"),
                user.get("real_name"),
                profile.get("real_name"),
                profile.get("display_name"),
                profile.get("real_name_normalized"),
                profile.get("display_name_normalized"),
                profile.get("email"),
            ]
            normalized = [str(field).casefold() for field in fields if field]
            if wanted in normalized:
                item = dict(user)
                item["resolved_from"] = "users.list"
                return item
            if any(wanted in value for value in normalized):
                matches.append(user)

        metadata = payload.get("response_metadata") or {}
        cursor = str(metadata.get("next_cursor") or "")
        if not cursor:
            break

    if len(matches) == 1:
        item = dict(matches[0])
        item["resolved_from"] = "users.list-partial"
        return item
    if matches:
        choices = ", ".join(f"{user_display(user)} ({user.get('id')})" for user in matches[:8])
        raise SlackError(f"ambiguous user '{query}': {choices}")
    raise SlackError(f"user not found: {query}")


def open_dm(client: SlackClient, user_id: str) -> str:
    payload = client.post("conversations.open", {"users": user_id, "return_im": True})
    channel = payload.get("channel") or {}
    channel_id = channel.get("id")
    if not channel_id:
        raise SlackError("conversations.open did not return a channel ID", payload=payload)
    return str(channel_id)


def target_to_channel(client: SlackClient, target: str, *, force_dm: bool = False) -> tuple[str, str]:
    target = target.strip()
    if not target:
        raise SlackError("target is required")

    if CONVERSATION_ID_RE.match(target):
        return target, "conversation"

    if USER_ID_RE.match(target):
        return open_dm(client, target), "dm"

    if force_dm or target.startswith("@") or is_email(target) or " " in target:
        user = resolve_user(client, target)
        return open_dm(client, str(user["id"])), "dm"

    if target.startswith("#"):
        return target, "channel"

    # Preserve legacy behavior: a bare send target means a channel name.
    return f"#{target}", "channel"


def join_message(parts: list[str]) -> str:
    message = " ".join(parts).strip()
    if not message:
        raise SlackError("message is required")
    return message


def cmd_send(args: argparse.Namespace, *, force_dm: bool = False) -> None:
    token = token_from_env(as_user=args.as_user, as_bot=args.as_bot)
    client = SlackClient(token)
    message = join_message(args.message)
    channel, target_type = target_to_channel(client, args.target, force_dm=force_dm)
    payload = client.post("chat.postMessage", {"channel": channel, "text": message})
    result = {
        "ok": True,
        "channel": payload.get("channel", channel),
        "ts": payload.get("ts"),
        "target_type": target_type,
        "identity": token.identity,
        "token_source": token.source,
    }
    if args.json:
        print(json.dumps(result, indent=2))
    else:
        print(f"Sent to {result['channel']} as {token.identity}")


def cmd_resolve_user(args: argparse.Namespace) -> None:
    token = token_from_env(as_user=args.as_user, as_bot=args.as_bot)
    client = SlackClient(token)
    user = resolve_user(client, args.query)
    profile = user.get("profile") or {}
    result = {
        "ok": True,
        "id": user.get("id"),
        "name": user.get("name"),
        "real_name": user.get("real_name") or profile.get("real_name"),
        "display_name": profile.get("display_name"),
        "email": profile.get("email"),
        "resolved_from": user.get("resolved_from"),
        "identity": token.identity,
        "token_source": token.source,
    }
    if args.json:
        print(json.dumps(result, indent=2))
    else:
        print(f"{result['id']}  {user_display(user)}")


def cmd_webhook(args: argparse.Namespace) -> None:
    webhook = os.environ.get("SLACK_WEBHOOK_URL", "").strip()
    if not webhook:
        raise SlackError("SLACK_WEBHOOK_URL is required")
    message = join_message(args.message)
    data = json.dumps({"text": message}).encode("utf-8")
    request = urllib.request.Request(
        webhook,
        data=data,
        method="POST",
        headers={"Content-Type": "application/json; charset=utf-8"},
    )
    try:
        with urllib.request.urlopen(request, timeout=float(os.environ.get("SLACK_API_TIMEOUT", "20"))) as response:
            body = response.read().decode("utf-8")
    except urllib.error.HTTPError as exc:
        body = exc.read().decode("utf-8", errors="replace")
        raise SlackError(f"webhook HTTP {exc.code}: {body}") from exc
    if body.strip() != "ok":
        raise SlackError(f"webhook failed: {body}")
    print("Sent!")


def cmd_upload(args: argparse.Namespace) -> None:
    if not os.path.isfile(args.file):
        raise SlackError(f"file not found: {args.file}")
    token = token_from_env(as_user=args.as_user, as_bot=args.as_bot)
    client = SlackClient(token)
    channel, target_type = target_to_channel(client, args.target)
    payload = client.post_multipart("files.upload", {"channels": channel}, "file", args.file)
    result = {
        "ok": True,
        "channel": channel,
        "target_type": target_type,
        "file": payload.get("file", {}).get("id"),
        "identity": token.identity,
        "token_source": token.source,
    }
    if args.json:
        print(json.dumps(result, indent=2))
    else:
        print(f"Uploaded to {channel} as {token.identity}")


def cmd_channels(args: argparse.Namespace) -> None:
    token = token_from_env(as_user=args.as_user, as_bot=args.as_bot)
    client = SlackClient(token)
    cursor = ""
    channels: list[dict[str, Any]] = []
    while True:
        payload = client.get(
            "conversations.list",
            {"types": "public_channel,private_channel", "limit": 200, "exclude_archived": "true", "cursor": cursor},
        )
        channels.extend(payload.get("channels", []))
        cursor = str((payload.get("response_metadata") or {}).get("next_cursor") or "")
        if not cursor:
            break
    if args.json:
        print(json.dumps({"ok": True, "channels": channels}, indent=2))
    else:
        for channel in sorted(channels, key=lambda item: item.get("name", "")):
            prefix = "#" if not channel.get("is_private") else "private:"
            print(f"{prefix}{channel['name']}  ({channel.get('num_members', 0)} members)")


def cmd_snapshot(args: argparse.Namespace) -> None:
    token = token_from_env(as_user=args.as_user, as_bot=args.as_bot)
    client = SlackClient(token)
    channels_payload = client.get(
        "conversations.list",
        {"types": "public_channel,private_channel", "limit": 50, "exclude_archived": "true"},
    )
    auth_payload = client.get("auth.test")
    channels = []
    unread_total = 0
    for channel in channels_payload.get("channels", []):
        info = {
            "name": channel.get("name"),
            "id": channel.get("id"),
            "private": channel.get("is_private", False),
            "members": channel.get("num_members", 0),
            "topic": (channel.get("topic") or {}).get("value", ""),
        }
        if channel.get("is_member"):
            try:
                channel_info = client.get("conversations.info", {"channel": channel["id"]})
                count = (channel_info.get("channel") or {}).get("unread_count_display", 0)
                info["unread"] = count
                unread_total += int(count or 0)
            except SlackError:
                info["unread"] = 0
        channels.append(info)
    print(
        json.dumps(
            {
                "team": auth_payload.get("team", "unknown"),
                "user": auth_payload.get("user", "unknown"),
                "identity": token.identity,
                "token_source": token.source,
                "channels": {"count": len(channels), "items": sorted(channels, key=lambda c: c.get("unread", 0), reverse=True)},
                "total_unread": unread_total,
                "token_valid": True,
            },
            indent=2,
        )
    )


def add_identity_flags(parser: argparse.ArgumentParser) -> None:
    group = parser.add_mutually_exclusive_group()
    group.add_argument("--as-user", action="store_true", help="Use SLACK_USER_TOKEN and send as the authenticated user")
    group.add_argument("--as-bot", action="store_true", help="Use SLACK_BOT_TOKEN or SLACK_TOKEN and send as the app/bot")
    parser.add_argument("--json", action="store_true", help="Output JSON")


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="agent-slack", add_help=False)
    subparsers = parser.add_subparsers(dest="command")

    send_parser = subparsers.add_parser("send", help="Send message")
    add_identity_flags(send_parser)
    send_parser.add_argument("target")
    send_parser.add_argument("message", nargs=argparse.REMAINDER)
    send_parser.set_defaults(handler=lambda args: cmd_send(args, force_dm=False))

    dm_parser = subparsers.add_parser("dm", help="Send direct message")
    add_identity_flags(dm_parser)
    dm_parser.add_argument("target")
    dm_parser.add_argument("message", nargs=argparse.REMAINDER)
    dm_parser.set_defaults(handler=lambda args: cmd_send(args, force_dm=True))

    resolve_parser = subparsers.add_parser("resolve-user", help="Resolve Slack user")
    add_identity_flags(resolve_parser)
    resolve_parser.add_argument("query")
    resolve_parser.set_defaults(handler=cmd_resolve_user)

    webhook_parser = subparsers.add_parser("webhook", help="Send via webhook")
    webhook_parser.add_argument("message", nargs=argparse.REMAINDER)
    webhook_parser.set_defaults(handler=cmd_webhook)

    upload_parser = subparsers.add_parser("upload", help="Upload file")
    add_identity_flags(upload_parser)
    upload_parser.add_argument("target")
    upload_parser.add_argument("file")
    upload_parser.set_defaults(handler=cmd_upload)

    channels_parser = subparsers.add_parser("channels", help="List channels")
    add_identity_flags(channels_parser)
    channels_parser.set_defaults(handler=cmd_channels)

    snapshot_parser = subparsers.add_parser("snapshot", help="Workspace snapshot")
    add_identity_flags(snapshot_parser)
    snapshot_parser.set_defaults(handler=cmd_snapshot)

    return parser


def normalize_argv(argv: list[str]) -> list[str]:
    if not argv or argv[0] in {"help", "--help", "-h"}:
        show_help()
        raise SystemExit(0)
    aliases = {
        "message": "send",
        "msg": "send",
        "im": "dm",
        "direct": "dm",
        "hook": "webhook",
        "file": "upload",
        "ch": "channels",
        "snap": "snapshot",
    }
    if argv[0] in aliases:
        argv = [aliases[argv[0]], *argv[1:]]
    if argv[0].startswith(("#", "@")):
        argv = ["send", *argv]
    return argv


def main(argv: list[str]) -> int:
    try:
        parser = build_parser()
        args = parser.parse_args(normalize_argv(argv))
        if not hasattr(args, "handler"):
            raise SlackError(f"unknown command: {argv[0] if argv else ''}")
        args.handler(args)
        return 0
    except SlackError as exc:
        print(f"Error: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
