#!/usr/bin/env bash
# bin/health — Health check for agent-do tools
# Usage: agent-do --health [tool...]
# Checks if tools have their dependencies installed and are ready to use.

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
# shellcheck source=lib/bash-runtime.sh
source "$ROOT_DIR/lib/bash-runtime.sh"
agent_do_ensure_supported_bash "$ROOT_DIR/bin/health" "$@" || exit $?

set -euo pipefail

TOOLS_DIR="$ROOT_DIR/tools"
CREDS_TOOL="$TOOLS_DIR/agent-creds"

probe() {
    # probe <seconds> <cmd...> — bounded liveness check. External daemons
    # (docker, kubectl) can block forever on a dead socket; macOS ships no
    # timeout(1), so bound the probe via python3. Exit 124 on timeout.
    local secs="$1"
    shift
    python3 - "$secs" "$@" <<'PY' >/dev/null 2>&1
import subprocess
import sys

try:
    result = subprocess.run(sys.argv[2:], capture_output=True, timeout=float(sys.argv[1]))
    sys.exit(result.returncode)
except subprocess.TimeoutExpired:
    sys.exit(124)
except FileNotFoundError:
    sys.exit(127)
PY
}

resolve_tool_path() {
    local name="$1"

    if [[ -d "$TOOLS_DIR/agent-$name" && -x "$TOOLS_DIR/agent-$name/agent-$name" ]]; then
        echo "$TOOLS_DIR/agent-$name/agent-$name"
        return 0
    fi

    if [[ -f "$TOOLS_DIR/agent-$name" && -x "$TOOLS_DIR/agent-$name" ]]; then
        echo "$TOOLS_DIR/agent-$name"
        return 0
    fi

    return 1
}

credential_check() {
    local name="$1"
    if [[ ! -x "$CREDS_TOOL" ]]; then
        printf 'MISS|credential checker unavailable\n'
        return 0
    fi

    local payload=""
    local check_status=0
    if payload=$("$CREDS_TOOL" check --tool "$name" --json 2>&1); then
        check_status=0
    else
        check_status=$?
    fi

    local parsed=""
    if ! parsed=$(python3 - "$payload" "$check_status" <<'PY'
import json
import sys

raw = sys.argv[1]
exit_code = int(sys.argv[2])
try:
    payload = json.loads(raw)
except (json.JSONDecodeError, TypeError):
    detail = "no output" if not raw.strip() else "non-JSON output"
    print(f"MISS|credential probe failed (exit {exit_code}; {detail})")
    raise SystemExit(0)

if exit_code not in (0, 1):
    print(f"MISS|credential probe failed (unexpected exit {exit_code})")
    raise SystemExit(0)
if not isinstance(payload, dict):
    print("MISS|credential probe returned an invalid payload")
    raise SystemExit(0)

items = payload.get("items") or []
if not items:
    print("SKIP|")
    raise SystemExit(0)

if payload.get("ok"):
    sources = sorted({item.get("source") for item in items if item.get("present") and item.get("source")})
    note = "credentials configured"
    if sources:
        note = f"credentials from {', '.join(sources)}"
    print(f"OK|{note}")
    raise SystemExit(0)

parts = []
missing_required = payload.get("missing_required") or []
missing_one_of = payload.get("missing_one_of") or []
if missing_required:
    parts.append("missing " + ", ".join(missing_required))
for group in missing_one_of:
    parts.append("need one of: " + " | ".join(group))

print("CONF|" + "; ".join(parts))
PY
    ); then
        printf 'MISS|credential response parser failed\n'
        return 0
    fi

    printf '%s\n' "$parsed"
}

merge_credential_status() {
    local current_status="$1"
    local current_note="$2"
    local credential_result="$3"

    [[ -n "$credential_result" ]] || {
        printf '%s|%s\n' "$current_status" "$current_note"
        return 0
    }

    local credential_status="${credential_result%%|*}"
    local credential_note="${credential_result#*|}"

    if [[ "$credential_status" == "SKIP" ]]; then
        printf '%s|%s\n' "$current_status" "$current_note"
        return 0
    fi

    if [[ "$credential_status" == "MISS" ]]; then
        local merged_note="$credential_note"
        if [[ -n "$current_note" && "$current_note" != "$credential_note" ]]; then
            merged_note="$current_note; $credential_note"
        fi
        printf 'MISS|%s\n' "$merged_note"
        return 0
    fi

    if [[ "$current_status" == "WARN" || "$current_status" == "MISS" ]]; then
        printf '%s|%s\n' "$current_status" "$current_note"
        return 0
    fi

    if [[ "$credential_status" == "CONF" ]]; then
        local merged_note="$credential_note"
        if [[ -n "$current_note" && "$current_note" != "$credential_note" ]]; then
            merged_note="$current_note; $credential_note"
        elif [[ -n "$current_note" ]]; then
            merged_note="$current_note"
        fi
        printf 'CONF|%s\n' "$merged_note"
        return 0
    fi

    if [[ -z "$current_note" && -n "$credential_note" ]]; then
        printf '%s|%s\n' "$current_status" "$credential_note"
    else
        printf '%s|%s\n' "$current_status" "$current_note"
    fi
}

check_tool() {
    local name="$1"
    local tool_path=""

    # Find tool
    if ! tool_path="$(resolve_tool_path "$name")"; then
        echo "  ✗  MISS  $name  (not found)"
        return 1
    fi

    # Check if --help works
    if "$tool_path" --help &>/dev/null; then
        # Tool-specific dependency checks
        local status="OK"
        local note=""

        case "$name" in
            browse|unbrowse)
                if ! command -v node &>/dev/null; then
                    status="WARN"; note="node not found"
                elif [[ -d "$TOOLS_DIR/agent-$name/node_modules" ]]; then
                    status="OK"; note="node_modules present"
                else
                    status="WARN"; note="run: cd tools/agent-$name && npm install"
                fi
                ;;
            api)
                if "$tool_path" list --json 2>/dev/null | python3 -c '
import json
import sys

payload = json.load(sys.stdin)
templates = payload.get("templates") or []
assert any(item.get("name") == "anthropic" for item in templates)
' 2>/dev/null; then
                    status="OK"; note="anthropic template ready"
                else
                    status="WARN"; note="canonical templates not ready"
                fi
                ;;
            manna)
                local manna_bin="$TOOLS_DIR/agent-manna/target/release/manna-core"
                if [[ -x "$manna_bin" ]]; then
                    status="OK"; note="binary built"
                else
                    status="WARN"; note="run: cd tools/agent-manna && cargo build --release"
                fi
                ;;
            models)
                local models_payload models_summary
                models_payload=$("$tool_path" doctor --json 2>/dev/null || true)
                models_summary=$(python3 - "$models_payload" <<'PY' 2>/dev/null || true
import json
import sys

payload = json.loads(sys.argv[1])
providers = payload.get("providers") or {}
ready = sorted(name for name, item in providers.items() if item.get("status") == "ok")
warnings = payload.get("warnings") or []
if not payload.get("ok", False):
    print("WARN|provider verification failed")
elif warnings:
    suffix = f"; ready: {', '.join(ready)}" if ready else ""
    print(f"WARN|optional provider skipped{suffix}")
else:
    print(f"OK|verified {', '.join(ready)}")
PY
)
                if [[ -n "$models_summary" ]]; then
                    status="${models_summary%%|*}"
                    note="${models_summary#*|}"
                else
                    status="WARN"; note="model doctor returned no readable result"
                fi
                ;;
            ios)
                if command -v xcrun &>/dev/null; then
                    status="OK"
                else
                    status="WARN"; note="Xcode CLI tools not found"
                fi
                ;;
            docker)
                if command -v docker &>/dev/null; then
                    if probe 10 docker info; then
                        status="OK"; note="Docker running"
                    else
                        status="WARN"; note="Docker installed but not responding"
                    fi
                else
                    status="WARN"; note="docker not found"
                fi
                ;;
            k8s)
                if command -v kubectl &>/dev/null; then
                    if probe 10 kubectl cluster-info; then
                        status="OK"; note="cluster reachable"
                    else
                        status="WARN"; note="kubectl found but no cluster"
                    fi
                else
                    status="WARN"; note="kubectl not found"
                fi
                ;;
            okta)
                if [[ -z "${OKTA_DOMAIN:-}" ]]; then
                    status="CONF"; note="OKTA_DOMAIN not set"
                fi
                ;;
            obsidian)
                # Local index mode is the primary agent surface. The
                # obsidian-cli path is still useful for live/app operations,
                # but a readable vault path is enough for read/search/save,
                # indexing, semantic retrieval, and JSON automation.
                local obsidian_vault="${AGENT_OBSIDIAN_VAULT_PATH:-${AGENT_OBSIDIAN_VAULT:-}}"
                if [[ -n "$obsidian_vault" && -d "$obsidian_vault" && -d "$obsidian_vault/.obsidian" ]]; then
                    status="OK"; note="local vault index mode"
                elif [[ -n "$obsidian_vault" ]]; then
                    status="WARN"; note="AGENT_OBSIDIAN_VAULT_PATH is not a readable Obsidian vault"
                elif [[ -n "${OBSIDIAN_BIN:-}" && -x "${OBSIDIAN_BIN}" ]]; then
                    status="OK"; note="OBSIDIAN_BIN=$OBSIDIAN_BIN"
                elif command -v obsidian &>/dev/null; then
                    status="OK"
                elif [[ -x "/usr/local/bin/obsidian" ]]; then
                    status="OK"; note="/usr/local/bin/obsidian"
                elif [[ -x "/opt/homebrew/bin/obsidian" ]]; then
                    status="OK"; note="/opt/homebrew/bin/obsidian"
                elif [[ -x "$HOME/.local/bin/obsidian" ]]; then
                    status="OK"; note="$HOME/.local/bin/obsidian"
                elif [[ -x "/Applications/Obsidian.app/Contents/MacOS/obsidian-cli" || \
                        -x "$HOME/Applications/Obsidian.app/Contents/MacOS/obsidian-cli" ]]; then
                    status="WARN"; note="Obsidian.app present — run: agent-do obsidian doctor --fix"
                else
                    status="WARN"; note="obsidian CLI not found — install Obsidian then run doctor --fix"
                fi
                ;;
            tui)
                command -v tmux &>/dev/null && { status="OK"; } || { status="WARN"; note="tmux not found"; }
                ;;
            jupyter)
                command -v jupyter &>/dev/null && { status="OK"; } || { status="WARN"; note="jupyter not found"; }
                ;;
            latex)
                command -v pdflatex &>/dev/null && { status="OK"; } || { status="WARN"; note="pdflatex not found"; }
                ;;
            handbrake)
                if command -v HandBrakeCLI &>/dev/null \
                    || [[ -x "${AGENT_HANDBRAKE_BIN:-}" ]] \
                    || { [[ -n "${AGENT_HANDBRAKE_BIN:-}" ]] && command -v "$AGENT_HANDBRAKE_BIN" &>/dev/null; } \
                    || [[ -x "/Applications/HandBrakeCLI" ]]; then
                    status="OK"
                else
                    status="WARN"; note="HandBrakeCLI not found — brew install handbrake or set AGENT_HANDBRAKE_BIN"
                fi
                ;;
            makemkv)
                if command -v makemkvcon &>/dev/null \
                    || [[ -x "${AGENT_MAKEMKV_BIN:-}" ]] \
                    || { [[ -n "${AGENT_MAKEMKV_BIN:-}" ]] && command -v "$AGENT_MAKEMKV_BIN" &>/dev/null; } \
                    || [[ -x "/Applications/MakeMKV.app/Contents/MacOS/makemkvcon" ]]; then
                    status="OK"
                else
                    status="WARN"; note="makemkvcon not found — install MakeMKV or set AGENT_MAKEMKV_BIN"
                fi
                ;;
            *)
                status="OK"
                ;;
        esac

        local credential_result merged
        if ! credential_result="$(credential_check "$name")"; then
            credential_result="MISS|credential checker failed internally"
        fi
        merged="$(merge_credential_status "$status" "$note" "$credential_result")"
        status="${merged%%|*}"
        note="${merged#*|}"

        local icon="✓"
        [[ "$status" == "WARN" ]] && icon="⚠"
        [[ "$status" == "CONF" ]] && icon="○"
        [[ "$status" == "MISS" ]] && icon="✗"

        if [[ -n "$note" ]]; then
            echo "  $icon  $status  $name  ($note)"
        else
            echo "  $icon  OK    $name"
        fi
    else
        echo "  ✗  ERR   $name  (--help failed)"
        return 1
    fi
}

main() {
    echo "agent-do health check"
    echo "===================="
    echo "Runtime: GNU Bash $BASH_VERSION (${AGENT_DO_BASH:-$BASH})"
    echo ""

    local tools=("$@")

    if [[ ${#tools[@]} -eq 0 ]]; then
        # Check all tools
        for tool_path in "$TOOLS_DIR"/agent-*; do
            local name
            if [[ -d "$tool_path" ]]; then
                name=$(basename "$tool_path" | sed 's/^agent-//')
            else
                name=$(basename "$tool_path" | sed 's/^agent-//')
            fi
            tools+=("$name")
        done
    fi

    local ok=0 warn=0 conf=0 miss=0

    for name in $(echo "${tools[@]}" | tr ' ' '\n' | sort -u); do
        result="$(check_tool "$name" 2>/dev/null || true)"
        [[ -n "$result" ]] || result="  ✗  MISS  $name"
        echo "$result"
        status="$(awk '{print $2}' <<<"$result")"
        case "$status" in
            OK) ok=$((ok + 1)) ;;
            WARN) warn=$((warn + 1)) ;;
            CONF) conf=$((conf + 1)) ;;
            MISS|ERR) miss=$((miss + 1)) ;;
            *) miss=$((miss + 1)) ;;
        esac
    done

    echo ""
    echo "Summary: $ok ready, $warn warnings, $conf need config, $miss missing"
    echo ""
    echo "Legend: ✓ OK = ready  ⚠ WARN = missing dependency  ○ CONF = needs config or credentials  ✗ MISS = broken prerequisite or tool"

    (( miss == 0 ))
}

main "$@"
