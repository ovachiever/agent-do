#!/usr/bin/env bash
# bin/bootstrap - Idempotent bootstrap for stateful agent-do tools

set -euo pipefail

AGENT_DO_HOME="${AGENT_DO_HOME:-$HOME/.agent-do}"
_source="${BASH_SOURCE[0]}"
if [ -L "$_source" ]; then
    _target="$(readlink "$_source")"
    case "$_target" in
        /*) _source="$_target" ;;
        *)  _source="$(dirname "$_source")/$_target" ;;
    esac
fi
BIN_DIR="$(cd "$(dirname "$_source")" && pwd)"
REPO_DIR="$(cd "$BIN_DIR/.." && pwd)"
AGENT_DO="$REPO_DIR/agent-do"

json=false
recommend=false
force=false
yes=false
never=false
allow=false
cwd="$PWD"
OPTOUT_MARKER=".agent-do-no-bootstrap"

show_help() {
    cat <<'EOF'
agent-do bootstrap - initialize stateful agent-do tools for the current project

Usage:
  agent-do bootstrap [--recommend] [--json] [--cwd PATH] [--yes] [--force]

What it bootstraps:
  - context: shared docs store in ~/.agent-do/context
  - zpc: project-local .zpc/ when project files indicate ZPC usage
  - workflow: project-local .manna/ plus tracked .handoff/ in every project

Options:
  --recommend   Detect pending bootstrap work without making changes
  --json        Output structured JSON
  --cwd PATH    Detect the target project from PATH instead of the current dir
  --yes         Non-interactive mode for callers that already have user approval
  --force       Re-run init commands even if the target already exists
  --never       Mark this root opted out: write .agent-do-no-bootstrap so
                recommend reports nothing pending and hooks stop asking
  --allow       Remove the opt-out marker written by --never
  --help, -h    Show this help

Examples:
  agent-do bootstrap
  agent-do bootstrap --recommend
  agent-do bootstrap --recommend --json --cwd /path/to/project
EOF
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        --recommend)
            recommend=true
            shift
            ;;
        --json)
            json=true
            shift
            ;;
        --cwd)
            cwd="$2"
            shift 2
            ;;
        --yes)
            yes=true
            shift
            ;;
        --force)
            force=true
            shift
            ;;
        --never)
            never=true
            shift
            ;;
        --allow)
            allow=true
            shift
            ;;
        --help|-h)
            show_help
            exit 0
            ;;
        *)
            echo "Unknown option: $1" >&2
            echo "Try: agent-do bootstrap --help" >&2
            exit 1
            ;;
    esac
done

find_project_root() {
    local dir="$1"

    while [[ "$dir" != "/" && -n "$dir" ]]; do
        if [[ -e "$dir/.git" ]] \
            || [[ -f "$dir/CLAUDE.md" ]] \
            || [[ -f "$dir/AGENTS.md" ]] \
            || [[ -f "$dir/package.json" ]] \
            || [[ -f "$dir/pyproject.toml" ]] \
            || [[ -f "$dir/Cargo.toml" ]] \
            || [[ -f "$dir/go.mod" ]] \
            || [[ -f "$dir/requirements.txt" ]] \
            || [[ -f "$dir/pnpm-workspace.yaml" ]] \
            || [[ -f "$dir/turbo.json" ]]; then
            echo "$dir"
            return 0
        fi
        dir="$(dirname "$dir")"
    done

    echo "$1"
}

doc_contains() {
    local needle="$1"
    shift
    [[ $# -eq 0 ]] && return 1
    if command -v rg >/dev/null 2>&1; then
        rg -q -F "$needle" "$@" 2>/dev/null
    else
        grep -qF "$needle" "$@" 2>/dev/null
    fi
}

join_by() {
    local sep="$1"
    shift || true
    local out=""
    local item
    for item in "$@"; do
        if [[ -z "$out" ]]; then
            out="$item"
        else
            out="${out}${sep}${item}"
        fi
    done
    printf '%s' "$out"
}

cwd="$(cd "$cwd" 2>/dev/null && pwd || true)"
if [[ -z "$cwd" ]]; then
    echo "Error: invalid --cwd path" >&2
    exit 1
fi

project_root="$(find_project_root "$cwd")"
project_name="$(basename "$project_root")"

optout_path="$project_root/$OPTOUT_MARKER"
if [[ "$never" == true ]]; then
    {
        echo "# agent-do bootstrap opt-out"
        echo "# This root never wants agent-do bootstrap: recommend reports nothing"
        echo "# pending and session hooks stop asking. Remove this file (or run"
        echo "# 'agent-do bootstrap --allow') to opt back in."
        echo "opted_out_at: $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    } > "$optout_path"
    echo "Opted out: $project_name ($project_root) will not be asked to bootstrap."
    echo "Marker: $optout_path"
    exit 0
fi
if [[ "$allow" == true ]]; then
    if [[ -f "$optout_path" ]]; then
        rm "$optout_path"
        echo "Opt-out removed: $project_name ($project_root) may be offered bootstrap again."
    else
        echo "No opt-out marker at $optout_path; nothing to remove."
    fi
    exit 0
fi
opted_out=false
[[ -f "$optout_path" ]] && opted_out=true

project_detected=false
if [[ -e "$project_root/.git" ]] \
    || [[ -f "$project_root/CLAUDE.md" ]] \
    || [[ -f "$project_root/AGENTS.md" ]] \
    || [[ -f "$project_root/package.json" ]] \
    || [[ -f "$project_root/pyproject.toml" ]] \
    || [[ -f "$project_root/Cargo.toml" ]] \
    || [[ -f "$project_root/go.mod" ]] \
    || [[ -f "$project_root/requirements.txt" ]] \
    || [[ -f "$project_root/pnpm-workspace.yaml" ]] \
    || [[ -f "$project_root/turbo.json" ]]; then
    project_detected=true
fi

doc_files=()
for file in "$project_root/CLAUDE.md" "$project_root/AGENTS.md" "$project_root/README.md"; do
    [[ -f "$file" ]] && doc_files+=("$file")
done

wants_context=false
wants_zpc=false
wants_manna=false
wants_browse=false
wants_design=false

if doc_contains "agent-do context" "${doc_files[@]}"; then
    wants_context=true
fi
if [[ -d "$project_root/.zpc" ]] \
    || doc_contains "agent-do zpc" "${doc_files[@]}" \
    || doc_contains "Zero Point Coder" "${doc_files[@]}" \
    || doc_contains ".zpc" "${doc_files[@]}"; then
    wants_zpc=true
fi
if [[ "$project_detected" == true ]] \
    || [[ -d "$project_root/.manna" ]] \
    || doc_contains "agent-do manna" "${doc_files[@]}" \
    || doc_contains ".manna" "${doc_files[@]}"; then
    wants_manna=true
fi
if doc_contains "agent-do browse" "${doc_files[@]}"; then
    wants_browse=true
fi
if doc_contains "agent-do design" "${doc_files[@]}"; then
    wants_design=true
fi

detected_tools=()
[[ "$wants_context" == true ]] && detected_tools+=("context")
[[ "$wants_zpc" == true ]] && detected_tools+=("zpc")
[[ "$wants_manna" == true ]] && detected_tools+=("manna")
[[ "$wants_browse" == true ]] && detected_tools+=("browse")
[[ "$wants_design" == true ]] && detected_tools+=("design")

pending_actions=()
pending_labels=()
pending_commands=()

if [[ "$wants_context" == true ]] && { [[ "$force" == true ]] || [[ ! -d "$AGENT_DO_HOME/context" ]]; }; then
    pending_actions+=("context_init")
    pending_labels+=("context")
    pending_commands+=("agent-do context init")
fi

if [[ "$wants_zpc" == true ]] && { [[ "$force" == true ]] || [[ ! -d "$project_root/.zpc" ]]; }; then
    pending_actions+=("zpc_init")
    pending_labels+=("zpc")
    pending_commands+=("agent-do zpc init")
fi

manna_strict_marker=false
if { [[ -f "$project_root/.manna/board.yaml" ]] \
        && grep -Eq '^workflow:[[:space:]]*strict[[:space:]]*$' "$project_root/.manna/board.yaml"; } \
    || [[ -e "$project_root/.manna/workflow.yaml" || -L "$project_root/.manna/workflow.yaml" \
    || -e "$project_root/.handoff" || -L "$project_root/.handoff" ]] \
    || { [[ -f "$project_root/.manna/issues.jsonl" ]] \
        && grep -Eq '"(prompt|handoff_digest)":("\.handoff/|"sha256:)' "$project_root/.manna/issues.jsonl"; }; then
    manna_strict_marker=true
fi

# A nonempty board with no strict identity or workflow config predates the v2
# admission gate. It must migrate, not loop through init. A live board-init
# journal is the one exception: init owns and recovers that transaction.
manna_legacy_board=false
if [[ -d "$project_root/.manna" ]] \
    && [[ -f "$project_root/.manna/issues.jsonl" ]] \
    && grep -Eq '[^[:space:]]' "$project_root/.manna/issues.jsonl" \
    && [[ ! -e "$project_root/.manna/workflow.yaml" && ! -L "$project_root/.manna/workflow.yaml" ]] \
    && ! { [[ -f "$project_root/.manna/board.yaml" ]] \
        && grep -Eq '^workflow:[[:space:]]*strict[[:space:]]*$' "$project_root/.manna/board.yaml"; } \
    && [[ ! -f "$project_root/.manna/transactions/board-init.yaml" ]]; then
    manna_legacy_board=true
fi

manna_workflow_healthy=false
if [[ -f "$project_root/.manna/board.yaml" && ! -L "$project_root/.manna/board.yaml" \
    && -f "$project_root/.manna/workflow.yaml" && ! -L "$project_root/.manna/workflow.yaml" \
    && -f "$project_root/.manna/federation.yaml" && ! -L "$project_root/.manna/federation.yaml" \
    && -f "$project_root/.handoff/README.md" && ! -L "$project_root/.handoff/README.md" ]] \
    && grep -Eq '^workflow:[[:space:]]*strict[[:space:]]*$' "$project_root/.manna/board.yaml" \
    && grep -Eq '^version:[[:space:]]*2[[:space:]]*$' "$project_root/.manna/workflow.yaml"; then
    manna_workflow_healthy=true
fi

if [[ "$wants_manna" == true ]]; then
    if [[ "$manna_legacy_board" == true ]]; then
        pending_actions+=("manna_migrate")
        pending_labels+=("legacy manna board migration")
        pending_commands+=("agent-do manna migrate")
    elif [[ "$force" == true ]] \
        || [[ ! -d "$project_root/.manna" ]] \
        || [[ ! -f "$project_root/.manna/board.yaml" ]] \
        || { [[ "$manna_strict_marker" == true ]] && [[ "$manna_workflow_healthy" != true ]]; }; then
        pending_actions+=("manna_init")
        pending_labels+=("manna + handoff + federation workflow")
        pending_commands+=("agent-do manna init")
    fi
fi

if [[ "$opted_out" == true && "$force" != true ]]; then
    # The root said never: nothing is pending here, by declaration.
    pending_actions=()
    pending_labels=()
    pending_commands=()
fi

needs_bootstrap=false
[[ ${#pending_actions[@]} -gt 0 ]] && needs_bootstrap=true

ask_prompt=""
if [[ "$needs_bootstrap" == true ]]; then
    if [[ "$manna_legacy_board" == true ]]; then
        ask_prompt="Legacy board in $project_name ($project_root): run agent-do manna migrate now?"
    else
        ask_prompt="Bootstrap agent-do for $project_name ($project_root)? It will initialize: $(join_by ', ' "${pending_labels[@]}")."
    fi
fi

if [[ "$recommend" == true ]]; then
    if [[ "$json" == true ]]; then
        python3 - "$project_root" "$project_name" "$needs_bootstrap" \
            "$(printf '%s\n' "${detected_tools[@]:-}")" \
            "$(printf '%s\n' "${pending_actions[@]:-}")" \
            "$(printf '%s\n' "${pending_commands[@]:-}")" \
            "$ask_prompt" "$manna_legacy_board" "$opted_out" <<'PYTHON'
import json, sys

project_root, project_name, needs_bootstrap, detected_blob, pending_blob, commands_blob, ask_prompt, legacy_board, opted_out = sys.argv[1:10]

def split_lines(blob):
    return [line for line in blob.splitlines() if line]

print(json.dumps({
    "project_root": project_root,
    "project_name": project_name,
    "needs_bootstrap": needs_bootstrap == "true",
    "detected_tools": split_lines(detected_blob),
    "pending_actions": split_lines(pending_blob),
    "commands": split_lines(commands_blob),
    "ask_prompt": ask_prompt,
    "legacy_board": legacy_board == "true",
    "opted_out": opted_out == "true",
}, ensure_ascii=False))
PYTHON
    else
        echo "agent-do bootstrap recommendation"
        echo "  Project: $project_root"
        if [[ ${#detected_tools[@]} -gt 0 ]]; then
            echo "  Detected: $(join_by ', ' "${detected_tools[@]}")"
        else
            echo "  Detected: none"
        fi
        if [[ "$needs_bootstrap" == true ]]; then
            echo "  Pending:"
            local_cmd=""
            for local_cmd in "${pending_commands[@]}"; do
                echo "    - $local_cmd"
            done
            echo "  Ask: $ask_prompt"
        elif [[ "$opted_out" == true ]]; then
            echo "  Pending: none (opted out via $OPTOUT_MARKER; 'agent-do bootstrap --allow' re-enables)"
        else
            echo "  Pending: none"
        fi
    fi
    exit 0
fi

if [[ "$opted_out" == true && "$force" != true ]]; then
    echo "This root is opted out of bootstrap ($OPTOUT_MARKER present)."
    echo "Run 'agent-do bootstrap --allow' first, or pass --force."
    exit 0
fi

executed=()

for action in "${pending_actions[@]}"; do
    case "$action" in
        context_init)
            "$AGENT_DO" context init >/dev/null
            executed+=("context")
            ;;
        zpc_init)
            (
                cd "$project_root"
                "$AGENT_DO" zpc init >/dev/null
            )
            executed+=("zpc")
            ;;
        manna_init)
            (
                cd "$project_root"
                "$AGENT_DO" manna init >/dev/null
            )
            executed+=("manna")
            ;;
        manna_migrate)
            (
                cd "$project_root"
                "$AGENT_DO" manna migrate >/dev/null
            )
            executed+=("manna")
            ;;
    esac
done

verified=()

# Re-read Manna state after bootstrap. The preflight booleans describe what
# needed repair, not what the command just produced.
manna_strict_marker=false
if { [[ -f "$project_root/.manna/board.yaml" ]] \
        && grep -Eq '^workflow:[[:space:]]*strict[[:space:]]*$' "$project_root/.manna/board.yaml"; } \
    || [[ -e "$project_root/.manna/workflow.yaml" || -L "$project_root/.manna/workflow.yaml" \
    || -e "$project_root/.handoff" || -L "$project_root/.handoff" ]] \
    || { [[ -f "$project_root/.manna/issues.jsonl" ]] \
        && grep -Eq '"(prompt|handoff_digest)":("\.handoff/|"sha256:)' "$project_root/.manna/issues.jsonl"; }; then
    manna_strict_marker=true
fi
manna_workflow_healthy=false
if [[ -f "$project_root/.manna/board.yaml" && ! -L "$project_root/.manna/board.yaml" \
    && -f "$project_root/.manna/workflow.yaml" && ! -L "$project_root/.manna/workflow.yaml" \
    && -f "$project_root/.manna/federation.yaml" && ! -L "$project_root/.manna/federation.yaml" \
    && -f "$project_root/.handoff/README.md" && ! -L "$project_root/.handoff/README.md" ]] \
    && grep -Eq '^workflow:[[:space:]]*strict[[:space:]]*$' "$project_root/.manna/board.yaml" \
    && grep -Eq '^version:[[:space:]]*2[[:space:]]*$' "$project_root/.manna/workflow.yaml"; then
    manna_workflow_healthy=true
fi

if [[ -d "$AGENT_DO_HOME/context" ]]; then
    verified+=("context")
fi
if [[ -d "$project_root/.zpc" ]]; then
    verified+=("zpc")
fi
if [[ -d "$project_root/.manna" ]] \
    && [[ -f "$project_root/.manna/board.yaml" ]] \
    && [[ -f "$project_root/.manna/federation.yaml" && ! -L "$project_root/.manna/federation.yaml" ]] \
    && { { [[ "$manna_strict_marker" != true ]] \
            && grep -Eq '^workflow:[[:space:]]*legacy[[:space:]]*$' "$project_root/.manna/board.yaml"; } \
        || [[ "$manna_workflow_healthy" == true ]]; }; then
    verified+=("manna")
fi

if [[ "$json" == true ]]; then
    python3 - "$project_root" "$project_name" \
        "$(printf '%s\n' "${executed[@]:-}")" \
        "$(printf '%s\n' "${verified[@]:-}")" \
        "$(printf '%s\n' "${detected_tools[@]:-}")" <<'PYTHON'
import json, sys

project_root, project_name, executed_blob, verified_blob, detected_blob = sys.argv[1:6]

def split_lines(blob):
    return [line for line in blob.splitlines() if line]

print(json.dumps({
    "success": True,
    "project_root": project_root,
    "project_name": project_name,
    "detected_tools": split_lines(detected_blob),
    "executed": split_lines(executed_blob),
    "verified": split_lines(verified_blob),
}, ensure_ascii=False))
PYTHON
else
    echo "agent-do bootstrap"
    echo "  Project: $project_root"
    if [[ ${#detected_tools[@]} -gt 0 ]]; then
        echo "  Detected: $(join_by ', ' "${detected_tools[@]}")"
    else
        echo "  Detected: none"
    fi
    if [[ ${#executed[@]} -gt 0 ]]; then
        echo "  Initialized: $(join_by ', ' "${executed[@]}")"
    else
        echo "  Initialized: nothing to do"
    fi
    if [[ ${#verified[@]} -gt 0 ]]; then
        echo "  Verified: $(join_by ', ' "${verified[@]}")"
    fi
fi
